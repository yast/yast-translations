msgstr "ກຳລັງຊິງໂຄຣໄນກັບເຊີເວີ NTP..."

#. update time widgets
#: src/clients/ntp-client_proposal.rb:530
msgid "Connection to selected NTP server failed."
msgstr "ການເຊື່ອມຕໍ່ກັບເຊີເວີ NTP ທີ່ເລືອກຫຼົ້ມເຫຼວ."

#. TRANSLATORS: Popup message. %1 is the missing package name.
#: src/clients/ntp-client_proposal.rb:538
#, ycp-format
msgid "Cannot save NTP configuration because the package %1 is not available."
msgstr "ບໍ່ສາມາດບັນທຶກການກຳນົດຄ່າ NTP ໄດ້ ເພາະວ່າແພັກເກດ %1 ບໍ່ມີໃຫ້ໃຊ້."

#. Translators: yes-no popup,
#. ntpdate is a command, %1 is the server address
#: src/clients/ntp-client_proposal.rb:578
#, ycp-format
msgid ""
"Test query to server '%1' failed.\n"
"If server is not yet accessible or network is not configured\n"
"click 'No' to ignore. Revisit NTP server configuration?"
msgstr ""
"ການທົດສອບຄຳຖາມໄປຍັງເຊີເວີ '%1' ຫຼົ້ມເຫຼວ.\n"
"ຫາກຍັງບໍ່ສາມາດເຂົ້າເຖິງເຊີເວີໄດ້ ຫຼື ຍັງບໍ່ໄດ້ກຳນົດຄ່າເຄືອຂ່າຍ\n"
"ໃຫ້ກົດ 'ບໍ່' ເພື່ອຂ້າມໄປ. ຕ້ອງການກັບໄປກຳນົດຄ່າເຊີເວີ NTP ຄືນໃໝ່ຫຼືບໍ່?"

#. Otherwise, prompt user for confirming pkg installation
#: src/clients/ntp-client_proposal.rb:611
#, ycp-format
msgid ""
"Synchronization with NTP server is not possible\n"
"without package %1 installed."
msgstr ""
"ການຊິງໂຄຣໄນກັບເຊີເວີ NTP ບໍ່ສາມາດເຮັດໄດ້\n"
"ໂດຍທີ່ບໍ່ມີການຕິດຕັ້ງແພັກເກດ %1."

#. TRANSLATORS: combo box label, ntp source can be either "server" or "pool"
#: src/clients/ntp-client_proposal.rb:690
msgid "&NTP Source Address"
msgstr "&ທີ່ຢູ່ແຫຼ່ງຂໍ້ມູນ NTP"

#. command line help text for NTP client module
#: src/include/ntp-client/commandline.rb:20
msgid "Please use 'chronyc' instead."
msgstr "ກະລຸນາໃຊ້ 'chronyc' ແທນ."

#. Read dialog help 1/2
#: src/include/ntp-client/helps.rb:16
msgid ""
"<p><b><big>Initializing NTP Client Configuration</big></b><br>\n"
"Please wait...<br></p>"
msgstr ""
"<p><b><big>ກຳລັງເລີ່ມຕົ້ນການກຳນົດຄ່າ NTP Client</big></b><br>\n"
"ກະລຸນາລໍຖ້າ...<br></p>"

#. Read dialog help 2/2
#: src/include/ntp-client/helps.rb:20
msgid ""
"<p><b><big>Aborting Initialization:</big></b><br>\n"
"Safely abort the configuration utility by pressing <b>Abort</b> now.</p>"
msgstr ""
"<p><b><big>ການຍົກເລີກການເລີ່ມຕົ້ນ:</big></b><br>\n"
"ຍົກເລີກເຄື່ອງມືການກຳນົດຄ່າຢ່າງປອດໄພໂດຍການກົດ <b>ຍົກເລີກ</b> ດຽວນີ້.</p>"

#. Write dialog help 1/2
#: src/include/ntp-client/helps.rb:25
msgid ""
"<p><b><big>Saving NTP Client Configuration</big></b><br>\n"
"Please wait...<br></p>"
msgstr ""
"<p><b><big>ກຳລັງບັນທຶກການກຳນົດຄ່າ NTP Client</big></b><br>\n"
"ກະລຸນາລໍຖ້າ...<br></p>"

#. Write dialog help 2/2
#: src/include/ntp-client/helps.rb:29
msgid ""
"<p><b><big>Aborting Saving:</big></b><br>\n"
"Abort the save procedure by pressing  <b>Abort</b>.\n"
"An additional dialog will inform you whether it is safe to do so.</p>"
msgstr ""
"<p><b><big>ການຍົກເລີກການບັນທຶກ:</big></b><br>\n"
"ຍົກເລີກຂັ້ນຕອນການບັນທຶກໂດຍການກົດ <b>ຍົກເລີກ</b>.\n"
"ຈະມີກ່ອງຂໍ້ຄວາມແຈ້ງໃຫ້ຊາບວ່າການເຮັດແບບນັ້ນປອດໄພຫຼືບໍ່.</p>"

