#. Command line help text for the hardware detection module, %1 is "hwinfo"
#: src/clients/hwinfo.rb:52
#, ycp-format
msgid ""
"Hardware Detection - this module does not support the command line "
"interface, use '%1' instead."
msgstr ""
"ການກວດຫາຮາດແວ - ໂມດູນນີ້ບໍ່ຮອງຮັບການເຮັດວຽກຜ່ານຄຳສັ່ງ (command line), ກະລຸນາໃຊ້ '%1' ແທນ."

#. translators: popup heading
#: src/clients/hwinfo.rb:76
msgid "Probing Hardware..."
msgstr "ກຳລັງກວດຫາຮາດແວ..."

#. progress bar label
#: src/clients/hwinfo.rb:79
msgid "Progress"
msgstr "ຄວາມຄືບໜ້າ"

#. title label
#: src/clients/hwinfo.rb:330
msgid "&All Entries"
msgstr "&ລາຍການທັງໝົດ"

#: src/clients/hwinfo.rb:342
msgid "&Save to File..."
msgstr "&ບັນທຶກລົງໄຟລ໌..."

#. dialog header
#: src/clients/hwinfo.rb:351
msgid "Hardware Information"
msgstr "ຂໍ້ມູນຮາດແວ"

#. help text
#: src/clients/hwinfo.rb:354
msgid ""
"<P>The <B>Hardware Information</B> module displays the hardware\n"
"details of your computer. Click any node for more information.</p>\n"
msgstr ""
"<P>ໂມດູນ <B>ຂໍ້ມູນຮາດແວ</B> ສະແດງລາຍລະອຽດຮາດແວ\n"
"ຂອງຄອມພິວເຕີທ່ານ. ຄລິກທີ່ລາຍການໃດໜຶ່ງເພື່ອເບິ່ງຂໍ້ມູນເພີ່ມເຕີມ.</p>\n"

#: src/clients/hwinfo.rb:357
msgid ""
"<P>You can save hardware information to a file. Click <B>Save to File</B> "
"and enter the filename.</P>"
msgstr ""
"<P>ທ່ານສາມາດບັນທຶກຂໍ້ມູນຮາດແວລົງໃນໄຟລ໌ໄດ້. ຄລິກ <B>ບັນທຶກລົງໄຟລ໌</B> ແລ້ວປ້ອນຊື່ໄຟລ໌.</P>"

