#. Command line interface for One Click Install
#: src/clients/OneClickInstallCLI.rb:16
msgid "One Click Install Command Line Installer"
msgstr "ຕົວຕິດຕັ້ງແບບບັນທັດຄຳສັ່ງ ສຳລັບການຕິດຕັ້ງແບບຄລິກດຽວ"

#: src/clients/OneClickInstallCLI.rb:20 src/clients/OneClickInstallCLI.rb:27
msgid "Processes a YMP file, ready for installation"
msgstr "ປະມວນຜົນໄຟລ໌ YMP, ພ້ອມສຳລັບການຕິດຕັ້ງ"

#: src/clients/OneClickInstallCLI.rb:36
msgid "URL of .ymp file"
msgstr "URL ຂອງໄຟລ໌ .ymp"

#: src/clients/OneClickInstallCLI.rb:40
msgid "File to put internal representation of YMP into"
msgstr "ໄຟລ໌ທີ່ຈະໃຊ້ເກັບຂໍ້ມູນພາຍໃນຂອງ YMP"

#: src/clients/OneClickInstallCLI.rb:44
msgid ""
"File containing internal representation of <b>One Click Install</b> "
"instructions"
msgstr "ໄຟລ໌ທີ່ມີຂໍ້ມູນຄຳສັ່ງພາຍໃນຂອງ <b>ການຕິດຕັ້ງແບບຄລິກດຽວ</b>"

#: src/clients/OneClickInstallCLI.rb:65
msgid "Error: Nothing to do specified in the YMP file."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ມີການລະບຸສິ່ງທີ່ຈະເຮັດໃນໄຟລ໌ YMP."

#: src/clients/OneClickInstallCLI.rb:71
msgid "If you continue, the following repositories will be subscribed:"
msgstr "ຖ້າທ່ານສືບຕໍ່, ຄັງຊອບແວດັ່ງຕໍ່ໄປນີ້ຈະຖືກຕິດຕາມ:"

#: src/clients/OneClickInstallCLI.rb:81
msgid "If you continue, the following software packages will be installed:"
