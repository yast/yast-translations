msgid "Software to be installed:"
msgstr "ຊອບແວທີ່ຈະຖືກຕິດຕັ້ງ:"

#: src/modules/OneClickInstallWidgets.rb:414
msgid "Proposal"
msgstr "ຂໍ້ສະເໜີ"

#: src/modules/OneClickInstallWidgets.rb:416
msgid "Customize"
msgstr "ປັບແຕ່ງ"

#: src/modules/OneClickInstallWidgets.rb:485
msgid "Software installation"
msgstr "ການຕິດຕັ້ງຊອບແວ"

#: src/modules/OneClickInstallWidgets.rb:494
msgid "Installation was successful"
msgstr "ການຕິດຕັ້ງສຳເລັດແລ້ວ"

#: src/modules/OneClickInstallWidgets.rb:499
msgid "Installation was only partially successful."
msgstr "ການຕິດຕັ້ງສຳເລັດພຽງແຕ່ບາງສ່ວນເທົ່ານັ້ນ."

#: src/modules/OneClickInstallWidgets.rb:507
msgid ""
"The installation has failed. For more information, see the log file at <tt>/"
"var/log/YaST2/y2log</tt>. Failure stage was: "
msgstr ""
"ການຕິດຕັ້ງລົ້ມເຫຼວ. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ເບິ່ງໄດ້ທີ່ໄຟລ໌ບັນທຶກ <tt>/var/log/YaST2/y2log</tt>. ຂັ້ນຕ"
"ອນທີ່ລົ້ມເຫຼວຄື: "

#: src/modules/OneClickInstallWidgets.rb:515
msgid "Error Message"
msgstr "ຂໍ້ຄວາມຜິດພາດ"

#: src/modules/OneClickInstallWidgets.rb:524
msgid "The following repositories could not be added"
msgstr "ບໍ່ສາມາດເພີ່ມຄັງຊອບແວດັ່ງຕໍ່ໄປນີ້ໄດ້"

#: src/modules/OneClickInstallWidgets.rb:534
msgid "The following patterns could not be installed"
msgstr "ບໍ່ສາມາດຕິດຕັ້ງຮູບແບບ (patterns) ດັ່ງຕໍ່ໄປນີ້ໄດ້"

#: src/modules/OneClickInstallWidgets.rb:544
msgid "The following packages could not be installed"
msgstr "ບໍ່ສາມາດຕິດຕັ້ງແພັກເກດດັ່ງຕໍ່ໄປນີ້ໄດ້"

#. * Subscribe to all the specified repositories
#. * return true if all catalogues were added successfully, false otherwise.
#: src/modules/OneClickInstallWorkerFunctions.rb:103
msgid "Loading Package Management"
msgstr "ກຳລັງໂຫຼດການຈັດການແພັກເກດ"

#: src/modules/OneClickInstallWorkerFunctions.rb:107
#, ycp-format
msgid "Adding repository %1"
msgstr "ກຳລັງເພີ່ມຄັງຊອບແວ %1"

#: src/modules/OneClickInstallWorkerFunctions.rb:123
msgid "An error occurred while initializing the software repository."
msgstr "ເກີດຂໍ້ຜິດພາດຂຶ້ນໃນຂະນະທີ່ກຳລັງເລີ່ມຕົ້ນຄັງຊອບແວ."

#: src/modules/OneClickInstallWorkerFunctions.rb:126
msgid "Details:"
msgstr "ລາຍລະອຽດ:"

#: src/modules/OneClickInstallWorkerFunctions.rb:131
msgid "Try again?"
msgstr "ລອງໃໝ່ອີກຄັ້ງ?"

#. * Install all the specified packages
#. * return true if all installations were successful, false otherwise
#: src/modules/OneClickInstallWorkerFunctions.rb:185
#, ycp-format
msgid "Marking package %1 for installation"
msgstr "ກຳລັງໝາຍແພັກເກດ %1 ເພື່ອຕິດຕັ້ງ"

#. If we didn't find it in the repos specified in the YMP try any repo.
#: src/modules/OneClickInstallWorkerFunctions.rb:211
#, ycp-format
msgid "Warning: package %1 could not be installed."
msgstr "ຄຳເຕືອນ: ບໍ່ສາມາດຕິດຕັ້ງແພັກເກດ %1 ໄດ້."

#: src/modules/OneClickInstallWorkerFunctions.rb:225
msgid "Performing Installation..."
msgstr "ກຳລັງດຳເນີນການຕິດຕັ້ງ..."

#. * Install all the specified patterns
#. * return true if all installations were successful, false otherwise
#: src/modules/OneClickInstallWorkerFunctions.rb:252
#, ycp-format
msgid "Warning: pattern %1 could not be installed."
msgstr "ຄຳເຕືອນ: ບໍ່ສາມາດຕິດຕັ້ງຮູບແບບ (pattern) %1 ໄດ້."

#. encoding: utf-8
#: src/modules/OneClickInstallWorkerResponse.rb:12
msgid "unknown"
msgstr "ບໍ່ຮູ້ຈັກ"

#: src/modules/OneClickInstallWorkerResponse.rb:13
msgid ""
"Root privileges are required. Either they were not supplied, or an unknown "
"error occurred."
msgstr ""
"ຕ້ອງການສິດທິ Root. ອາດຈະເປັນຍ້ອນບໍ່ມີການໃຫ້ສິດທິ ຫຼື ເກີດຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກ."
