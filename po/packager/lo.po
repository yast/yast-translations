"Cannot configure online update repository \n"
"without having package %1 installed"
msgstr ""
"ບໍ່ສາມາດຕັ້ງຄ່າຄັງຊອບແວອັບເດດອອນລາຍໄດ້ \n"
"ໂດຍທີ່ບໍ່ມີແພັກເກດ %1 ຕິດຕັ້ງໄວ້ກ່ອນ"

#: src/clients/sw_single.rb:632
#, fuzzy, ycp-format
#| msgid ""
#| "Cannot search for SLP repositories\n"
#| "without having %1 package installed.\n"
msgid ""
"Cannot search packages in online repositories\n"
"without having package %1 installed"
msgstr ""
"ບໍ່ສາມາດຄົ້ນຫາຄັງຊອບແວ SLP ໄດ້\n"
"ຖ້າບໍ່ມີການຕິດຕັ້ງແພັກເກດ %1 ໄວ້.\n"

#. error report, %1 is a list of packages
#: src/clients/sw_single.rb:658
#, ycp-format
msgid ""
"The following packages have not been found on the medium:\n"
"%1\n"
msgstr ""
"ບໍ່ພົບແພັກເກດຕໍ່ໄປນີ້ໃນສື່:\n"
"%1\n"

#. rich text message, %1 medium number, e.g. CD1,CD2...
#: src/include/checkmedia/ui.rb:105
#, ycp-format
msgid "<UL><LI>Medium: %1</LI></UL>"
msgstr "<UL><LI>ສື່: %1</LI></UL>"

#. rich text message, %1 = size of the medium
#: src/include/checkmedia/ui.rb:109
#, ycp-format
msgid "<UL><LI>Size: %1</LI></UL>"
msgstr "<UL><LI>ຂະໜາດ: %1</LI></UL>"

#. rich text message, %1 = result of the check
#. the check has been canceled
#: src/include/checkmedia/ui.rb:113 src/include/checkmedia/ui.rb:506
#, ycp-format
msgid "<UL><LI>Result: %1</LI></UL>"
msgstr "<UL><LI>ຜົນການກວດສອບ: %1</LI></UL>"

#. rich text message, %1 = signature check
#: src/include/checkmedia/ui.rb:117
#, ycp-format
msgid "<UL><LI>Signature: %1</LI></UL>"
msgstr "<UL><LI>ລາຍເຊັນ: %1</LI></UL>"

#. rich text -  error message
#: src/include/checkmedia/ui.rb:122
msgid "The drive does not contain a medium or the ISO file system is broken."
msgstr "ໄດຣຟ໌ບໍ່ມີສື່ ຫຼື ລະບົບໄຟລ໌ ISO ເສຍຫາຍ."

#. result of the check - success
#: src/include/checkmedia/ui.rb:132
msgid "<B>OK</B> -- The medium has been successfully verified."
msgstr "<B>ຕົກລົງ</B> -- ສື່ນີ້ໄດ້ຮັບການກວດສອບວ່າຖືກຕ້ອງແລ້ວ."

#. wrong MD5
#: src/include/checkmedia/ui.rb:136
msgid ""
"<B>Error</B> -- MD5 sum does not match<BR>This medium should not be used."
msgstr "<B>ຂໍ້ຜິດພາດ</B> -- ຄ່າລວມ MD5 ບໍ່ກົງກັນ<BR>ບໍ່ຄວນໃຊ້ສື່ນີ້."

#. the correct MD5 is unknown
#: src/include/checkmedia/ui.rb:141
msgid "<B>Unknown</B> -- The correct MD5 sum of the medium is unknown."
msgstr "<B>ບໍ່ຮູ້ຈັກ</B> -- ບໍ່ຮູ້ຄ່າລວມ MD5 ທີ່ຖືກຕ້ອງຂອງສື່ນີ້."

#. warning popup - the CD/DVD drive doesn't contain the first medium (CD1/DVD1)
#: src/include/checkmedia/ui.rb:235
msgid "Insert the first installation medium."
msgstr "ກະລຸນາໃສ່ສື່ຕິດຕັ້ງແຜ່ນທຳອິດ."

#. dialog header
#: src/include/checkmedia/ui.rb:283
msgid "Media Check"
msgstr "ກວດສອບສື່"

#. help text - media check (header) 1/8
#: src/include/checkmedia/ui.rb:286
msgid "<P><B>Media Check</B></P>"
msgstr "<P><B>ກວດສອບສື່</B></P>"

#. help text - media check 2/8
#: src/include/checkmedia/ui.rb:288
msgid ""
"<P>When you have a problem with\n"
"the installation and you are using a CD or DVD installation medium, you "
"should check\n"
"whether the medium is broken.</P>\n"
msgstr ""
"<P>ເມື່ອທ່ານມີບັນຫາກັບ\n"
"ການຕິດຕັ້ງ ແລະ ທ່ານກຳລັງໃຊ້ສື່ຕິດຕັ້ງແບບ CD ຫຼື DVD, ທ່ານຄວນກວດສອບ\n"
"ວ່າສື່ນັ້ນເສຍຫາຍຫຼືບໍ່.</P>\n"

#. help text - media check 3/8
#: src/include/checkmedia/ui.rb:294
msgid ""
"<P>Select a drive, insert a medium into the drive and press <B>Start Check</"
"B>\n"
"or use <B>Check ISO File</B> and select an ISO file.\n"
"The check can take several minutes depending on speed of the\n"
"drive and size of the medium. The check verifies the MD5 checksum.</P> "
msgstr ""
"<P>ເລືອກໄດຣຟ໌, ໃສ່ສື່ເຂົ້າໃນໄດຣຟ໌ ແລ້ວກົດ <B>ເລີ່ມການກວດສອບ</B>\n"
"ຫຼື ໃຊ້ <B>ກວດສອບໄຟລ໌ ISO</B> ແລະ ເລືອກໄຟລ໌ ISO.\n"
"ການກວດສອບອາດໃຊ້ເວລາຫຼາຍນາທີ ຂຶ້ນຢູ່ກັບຄວາມໄວຂອງ\n"
"ໄດຣຟ໌ ແລະ ຂະໜາດຂອງສື່. ການກວດສອບຈະຢືນຢັນຄ່າ MD5 checksum.</P> "

#. help text - media check 4/8
#: src/include/checkmedia/ui.rb:301
msgid ""
"<P>If the check of the medium fails, you should not continue the "
"installation.\n"
"It may fail or you may lose your data. Better replace the broken medium.</"
"P>\n"
msgstr ""
"<P>ຫາກການກວດສອບສື່ລົ້ມເຫຼວ, ທ່ານບໍ່ຄວນດຳເນີນການຕິດຕັ້ງຕໍ່.\n"
"ມັນອາດຈະລົ້ມເຫຼວ ຫຼື ທ່ານອາດຈະສູນເສຍຂໍ້ມູນ. ຄວນປ່ຽນສື່ທີ່ເສຍຫາຍໃໝ່.</P>\n"

#. help text - media check 5/8
#: src/include/checkmedia/ui.rb:306
msgid ""
"After the check, insert the next medium and start the procedure again. \n"
"The order of the media is irrelevant.\n"
msgstr ""
"ຫຼັງຈາກກວດສອບແລ້ວ, ໃຫ້ໃສ່ສື່ແຜ່ນຖັດໄປ ແລະ ເລີ່ມຂັ້ນຕອນຄືນໃໝ່. \n"
"ລຳດັບຂອງສື່ແມ່ນບໍ່ມີຜົນຫຍັງ.\n"

#. help text - media check 6/8
#: src/include/checkmedia/ui.rb:311
msgid ""
"<P><B>Note:</B> You cannot change the medium while it is used by the system."
"</P>"
msgstr "<P><B>ໝາຍເຫດ:</B> ທ່ານບໍ່ສາມາດປ່ຽນສື່ໄດ້ໃນຂະນະທີ່ລະບົບກຳລັງໃຊ້ງານມັນຢູ່.</P>"

#. help text - media check 7/8
#: src/include/checkmedia/ui.rb:315
msgid ""
"<P>To check media before the installation, use the media check item in the "
"boot menu.</P>"
msgstr "<P>ເພື່ອສອບສື່ກ່ອນການຕິດຕັ້ງ, ໃຫ້ໃຊ້ລາຍການກວດສອບສື່ໃນເມນູການບູດ (boot menu).</P>"

#. help text - media check 8/8
#: src/include/checkmedia/ui.rb:320
msgid ""
"<P>If you burn the media yourself, use the <B>pad</B> option in your "
"recording\n"
"software. It avoids read errors at the end of the media during the check.</"
"P>\n"
msgstr ""
"<P>ຫາກທ່ານຂຽນແຜ່ນສື່ດ້ວຍຕົນເອງ, ໃຫ້ໃຊ້ຕົວເລືອກ <B>pad</B> ໃນຊອບແວ\n"
"ບັນທຶກຂອງທ່ານ. ມັນຈະຊ່ວຍຫຼີກລ່ຽງຂໍ້ຜິດພາດໃນການອ່ານຢູ່ສ່ວນທ້າຍຂອງສື່ໃນລະຫວ່າງການກວດສອບ.</P>\n"

