msgstr ""
"<p><big><b>ສື່ CD ຫຼື DVD</b></big><br>\n"
"ຕັ້ງຄ່າ <b>CD-ROM</b> ຫຼື <b>DVD-ROM</b> ເພື່ອລະບຸປະເພດຂອງສື່.</p>"

#. dialog caption
#: src/modules/SourceDialogs.rb:949
msgid "ISO Image File"
msgstr "ໄຟລ໌ ISO Image"

#. error popup - the entered path is not a directory
#: src/modules/SourceDialogs.rb:972
msgid ""
"The entered path is not a directory\n"
"or the directory does not exist.\n"
msgstr ""
"ເສັ້ນທາງທີ່ປ້ອນເຂົ້າບໍ່ແມ່ນໂຟນເດີ\n"
"ຫຼື ບໍ່ມີໂຟນເດີນີ້ຢູ່.\n"

#. error popup - the entered path is not a regular file
#: src/modules/SourceDialogs.rb:1002
msgid ""
"The entered path is not a file\n"
"or the file does not exist.\n"
msgstr ""
"ເສັ້ນທາງທີ່ປ້ອນເຂົ້າບໍ່ແມ່ນໄຟລ໌\n"
"ຫຼື ບໍ່ມີໄຟລ໌ນີ້ຢູ່.\n"

#. continue/cancel popup, %1 is a file name
#: src/modules/SourceDialogs.rb:1023
#, ycp-format
msgid ""
"File '%1'\n"
"does not seem to be an ISO image.\n"
"Use it anyway?\n"
msgstr ""
"ໄຟລ໌ '%1'\n"
"ເບິ່ງຄືວ່າບໍ່ແມ່ນ ISO image.\n"
"ຕ້ອງການໃຊ້ມັນຕໍ່ບໍ່?\n"

#. text entry
#: src/modules/SourceDialogs.rb:1045
msgid "&Path to Directory"
msgstr "&ເສັ້ນທາງໄປຫາໂຟນເດີ"

#. checkbox label
#: src/modules/SourceDialogs.rb:1053 src/modules/SourceDialogs.rb:1305
#: src/modules/SourceDialogs.rb:1371
msgid "&Plain RPM Directory"
msgstr "&ໂຟນເດີ RPM ທົ່ວໄປ"

#: src/modules/SourceDialogs.rb:1068
msgid ""
"<p><big><b>Local Directory</b></big><br>\n"
"Use <b>Path to Directory</b> to specify the path to the\n"
"directory. If the directory contains only RPM packages without\n"
"any metadata (i.e. there is no product information), then check option\n"
"<b>Plain RPM Directory</b>.</p>\n"
msgstr ""
"<p><big><b>ໂຟນເດີພາຍໃນເຄື່ອງ</b></big><br>\n"
"ໃຊ້ <b>ເສັ້ນທາງໄປຫາໂຟນເດີ</b> ເພື່ອລະບຸເສັ້ນທາງໄປຫາ\n"
"ໂຟນເດີ. ຫາກໂຟນເດີມີພຽງແຕ່ແພັກເກດ RPM ໂດຍບໍ່ມີ\n"
"ຂໍ້ມູນເມຕາ (metadata) ໃດໆ (ເຊັ່ນ: ບໍ່ມີຂໍ້ມູນຜະລິດຕະພັນ), ໃຫ້ໝາຍເລືອກຕົວເລືອກ\n"
"<b>ໂຟນເດີ RPM ທົ່ວໄປ</b>.</p>\n"

#. `opt(`hstretch),
#: src/modules/SourceDialogs.rb:1298
msgid "&USB Mass Storage Device"
msgstr "&ອຸປະກອນເກັບຂໍ້ມູນ USB"

#. the spacing is added to make the widget wider
#: src/modules/SourceDialogs.rb:1303 src/modules/SourceDialogs.rb:1369
msgid "&File System"
msgstr "&ລະບົບໄຟລ໌"

#: src/modules/SourceDialogs.rb:1304 src/modules/SourceDialogs.rb:1370
msgid "Dire&ctory"
msgstr "ໂຟນ&ເດີ"

#: src/modules/SourceDialogs.rb:1309
msgid ""
"<p><big><b>USB Stick or Disk</b></big><br>\n"
"Select the USB device on which the repository is located.\n"
"Use <b>Path to Directory</b> to specify the directory of the repository.\n"
"If the path is omitted, the system will use the root directory of the disk.\n"
"If the directory contains only RPM packages without\n"
"any metadata (i.e. there is no product information), then check option\n"
"<b>Plain RPM Directory</b>.</p>\n"
msgstr ""
"<p><big><b>USB Stick ຫຼື Disk</b></big><br>\n"
"ເລືອກອຸປະກອນ USB ທີ່ຄັງຊອບແວຕັ້ງຢູ່.\n"
"ໃຊ້ <b>ເສັ້ນທາງໄປຫາໂຟນເດີ</b> ເພື່ອລະບຸໂຟນເດີຂອງຄັງຊອບແວ.\n"
"ຫາກບໍ່ລະບຸເສັ້ນທາງ, ລະບົບຈະໃຊ້ root directory ຂອງດິສກ໌.\n"
"ຫາກໂຟນເດີມີພຽງແຕ່ແພັກເກດ RPM ໂດຍບໍ່ມີ\n"
"ຂໍ້ມູນເມຕາໃດໆ, ໃຫ້ໝາຍເລືອກຕົວເລືອກ\n"
"<b>ໂຟນເດີ RPM ທົ່ວໄປ</b>.</p>\n"

#. 'auto' is a value in the combo box widget, do not translate it!
#. 'auto' is a value in the combo box widget, do not translate it!
#: src/modules/SourceDialogs.rb:1319 src/modules/SourceDialogs.rb:1385
msgid ""
"<p>The file system used on the device will be detected automatically\n"
"if you select file system 'auto'. If the detection fails or you\n"
"want to use a certain file system, select it from the list.</p>\n"
msgstr ""
"<p>ລະບົບໄຟລ໌ທີ່ໃຊ້ໃນອຸປະກອນຈະຖືກກວດພົບໂດຍອັດຕະໂນມັດ\n"
"ຫາກທ່ານເລືອກລະບົບໄຟລ໌ 'auto'. ຫາກການກວດພົບລົ້ມເຫຼວ ຫຼື ທ່ານ\n"
"ຕ້ອງການໃຊ້ລະບົບໄຟລ໌ໃດໜຶ່ງໂດຍສະເພາະ, ໃຫ້ເລືອກຈາກລາຍການ.</p>\n"

#. combobox title
#: src/modules/SourceDialogs.rb:1368
msgid "&Disk Device"
msgstr "&ອຸປະກອນດິສກ໌"

#: src/modules/SourceDialogs.rb:1375
msgid ""
"<p><big><b>Disk</b></big><br>\n"
"Select the disk on which the repository is located.\n"
"Use <b>Path to Directory</b> to specify the directory of the repository.\n"
"If the path is omitted, the system will use the root directory of the disk.\n"
"If the directory contains only RPM packages without\n"
"any metadata (i.e. there is no product information), then check option\n"
"<b>Plain RPM Directory</b>.</p>\n"
msgstr ""
"<p><big><b>ດິສກ໌</b></big><br>\n"
"ເລືອກດິສກ໌ທີ່ຄັງຊອບແວຕັ້ງຢູ່.\n"
"ໃຊ້ <b>ເສັ້ນທາງໄປຫາໂຟນເດີ</b> ເພື່ອລະບຸໂຟນເດີຂອງຄັງຊອບແວ.\n"
"ຫາກບໍ່ລະບຸເສັ້ນທາງ, ລະບົບຈະໃຊ້ root directory ຂອງດິສກ໌.\n"
"ຫາກໂຟນເດີມີພຽງແຕ່ແພັກເກດ RPM ໂດຍບໍ່ມີ\n"
"ຂໍ້ມູນເມຕາໃດໆ, ໃຫ້ໝາຍເລືອກຕົວເລືອກ\n"
"<b>ໂຟນເດີ RPM ທົ່ວໄປ</b>.</p>\n"

#. text entry
#: src/modules/SourceDialogs.rb:1401
msgid "&Path to ISO Image"
msgstr "&ເສັ້ນທາງໄປຫາ ISO Image"

#. push button
#: src/modules/SourceDialogs.rb:1421
msgid ""
"<p><big><b>Local ISO Image</b></big><br>\n"
"Use <b>Path to ISO Image</b> to specify the path to the\n"
"ISO image file.</p>"
msgstr ""
"<p><big><b>ISO Image ພາຍໃນເຄື່ອງ</b></big><br>\n"
"ໃຊ້ <b>ເສັ້ນທາງໄປຫາ ISO Image</b> ເພື່ອລະບຸເສັ້ນທາງໄປຫາ\n"
"ໄຟລ໌ ISO image.</p>"

#. text entry
#: src/modules/SourceDialogs.rb:1614
