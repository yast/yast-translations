#. TRANSLATORS: Error message.
#: src/lib/y2partitioner/actions/add_bcache.rb:59
msgid "There are not enough suitable unused devices to create a bcache."
msgstr "ມີອຸປະກອນທີ່ບໍ່ໄດ້ໃຊ້ງານທີ່ເໝາະສົມບໍ່ພຽງພໍເພື່ອສ້າງ bcache."

#. TRANSLATORS: wizard title when creating a new Btrfs filesystem.
#: src/lib/y2partitioner/actions/add_btrfs.rb:95
msgid "Add Btrfs"
msgstr "ເພີ່ມ Btrfs"

#. TRANSLATORS: error message
#: src/lib/y2partitioner/actions/add_btrfs.rb:103
msgid "There are not enough suitable unused devices to create a Btrfs."
msgstr "ມີອຸປະກອນທີ່ບໍ່ໄດ້ໃຊ້ງານທີ່ເໝາະສົມບໍ່ພຽງພໍເພື່ອສ້າງ Btrfs."

#. TRANSLATORS: %s is a volume group name (e.g. "system")
#: src/lib/y2partitioner/actions/add_lvm_lv.rb:112
#, c-format
msgid "No free space left in the volume group \"%s\"."
msgstr "ບໍ່ມີພື້ນທີ່ວ່າງເຫຼືອໃນກຸ່ມວໍລຸມ \"%s\"."

#. @see TransactionWizard
#. @note The action is only run when there are available devices to create a new
#. volume group (see {Controllers::LvmVg#available_devices}).
#.
#. @return [Boolean] true whether there are available devices; false otherwise.
#: src/lib/y2partitioner/actions/add_lvm_vg.rb:79
msgid ""
"There are not enough suitable unused devices to create a volume group.\n"
msgstr "ມີອຸປະກອນທີ່ບໍ່ໄດ້ໃຊ້ງານທີ່ເໝາະສົມບໍ່ພຽງພໍເພື່ອສ້າງກຸ່ມວໍລຸມ.\n"

#: src/lib/y2partitioner/actions/add_lvm_vg.rb:80
msgid ""
"To use LVM, at least one unused partition of type 0x8e (or 0x83) or one "
"disk\n"
"or one RAID device is required. Change your partition table accordingly."
msgstr ""
"ເພື່ອໃຊ້ LVM, ຕ້ອງການຢ່າງໜ້ອຍໜຶ່ງສ່ວນແບ່ງທີ່ບໍ່ໄດ້ໃຊ້ງານປະເພດ 0x8e (ຫຼື 0x83) ຫຼື ໜຶ່ງດິສກ໌\n"
"ຫຼື ໜຶ່ງອຸປະກອນ RAID. ກະລຸນາປ່ຽນຕາຕະລາງສ່ວນແບ່ງຂອງທ່ານໃຫ້ເໝາະສົມ."

#. @see TransactionWizard
#: src/lib/y2partitioner/actions/add_md.rb:76
msgid "There are not enough suitable unused devices to create a RAID."
msgstr "ມີອຸປະກອນທີ່ບໍ່ໄດ້ໃຊ້ງານທີ່ເໝາະສົມບໍ່ພຽງພໍເພື່ອສ້າງ RAID."

#. Checks whether the device is not used
#.
#. @see Controllers::Partition#device_used?
#.
#. @return [Boolean] true if device is not used; false otherwise.
#: src/lib/y2partitioner/actions/add_partition.rb:136
msgid "The device is in use and cannot be modified."
msgstr "ອຸປະກອນກຳລັງຖືກໃຊ້ງານຢູ່ ແລະ ບໍ່ສາມາດແກ້ໄຂໄດ້."

#. TRANSLATORS: %{name} is a device name (e.g. "/dev/sda")
#: src/lib/y2partitioner/actions/add_partition.rb:157
#, perl-brace-format
msgid ""
"The device %{name} is directly formatted.\n"
"Remove the filesystem on %{name}?"
msgstr ""
"ອຸປະກອນ %{name} ຖືກຟໍແມັດໂດຍກົງ.\n"
"ລຶບລະບົບໄຟລ໌ໃນ %{name} ອອກບໍ່?"

#. TRANSLATORS: %{name} is a device name (e.g. "/dev/sda")
#: src/lib/y2partitioner/actions/add_partition.rb:188
#, perl-brace-format
msgid "It is not possible to create a partition on %{name}."
msgstr "ບໍ່ສາມາດສ້າງສ່ວນແບ່ງໃນ %{name} ໄດ້."

#. TRANSLATORS: Note added to the dialog for trying to unmount devices
#: src/lib/y2partitioner/actions/add_partition.rb:202
msgid "A new partition cannot be created while the file system is mounted."
msgstr "ບໍ່ສາມາດສ້າງສ່ວນແບ່ງໃໝ່ໄດ້ໃນຂະນະທີ່ລະບົບໄຟລ໌ກຳລັງຖືກເມົາທ໌ຢູ່."

#. TRANSLATORS: wizard title when creating a new Tmpfs filesystem.
#: src/lib/y2partitioner/actions/add_tmpfs.rb:74
msgid "Add Tmpfs"
msgstr "ເພີ່ມ Tmpfs"

#. Error message when the device has no partition table
#.
#. @return [String, nil] nil if the device has partition table.
#: src/lib/y2partitioner/actions/clone_partition_table.rb:91
msgid ""
"There are no partitions on this device, but a clonable\n"
"device must have at least one partition.\n"
"Create partitions before cloning the device."
msgstr ""
"ບໍ່ມີສ່ວນແບ່ງໃນອຸປະກອນນີ້, ແຕ່ອຸປະກອນທີ່ຈະໂຄລນໄດ້\n"
"ຕ້ອງມີຢ່າງໜ້ອຍໜຶ່ງສ່ວນແບ່ງ.\n"
"ກະລຸນາສ້າງສ່ວນແບ່ງກ່ອນທີ່ຈະໂຄລນອຸປະກອນ."

#. Error message when there are no suitable devices where to clone the device
#.
#. @return [String, nil] nil if there are suitable devices.
#: src/lib/y2partitioner/actions/clone_partition_table.rb:102
msgid ""
"This device cannot be cloned. There are no suitable\n"
"devices that could have the same partitioning layout."
msgstr ""
"ອຸປະກອນນີ້ບໍ່ສາມາດໂຄລນໄດ້. ບໍ່ມີອຸປະກອນທີ່ເໝາະສົມ\n"
"ທີ່ຈະມີຮູບແບບການແບ່ງສ່ວນຄືກັນໄດ້."

#. @see ConfigureAction#warning_text
#: src/lib/y2partitioner/actions/configure_actions.rb:188
msgid ""
"Rescanning crypt devices cancels all current changes.\n"
"Really activate crypt devices?"
msgstr ""
"ການສະແກນອຸປະກອນເຂົ້າລະຫັດໃໝ່ຈະຍົກເລີກການປ່ຽນແປງທັງໝົດໃນຕອນນີ້.\n"
"ຢືນຢັນການເປີດໃຊ້ງານອຸປະກອນເຂົ້າລະຫັດບໍ່?"

#. @see ConfigureAction#warning_text
#: src/lib/y2partitioner/actions/configure_actions.rb:214
msgid ""
"Calling iSCSI configuration cancels all current changes.\n"
"Really call iSCSI configuration?"
msgstr ""
"ການເອີ້ນໃຊ້ການຕັ້ງຄ່າ iSCSI ຈະຍົກເລີກການປ່ຽນແປງທັງໝົດໃນຕອນນີ້.\n"
"ຢືນຢັນການເອີ້ນໃຊ້ການຕັ້ງຄ່າ iSCSI ບໍ່?"

#. @see ConfigureAction#warning_text
#: src/lib/y2partitioner/actions/configure_actions.rb:235
msgid ""
"Calling FCoE configuration cancels all current changes.\n"
"Really call FCoE configuration?"
msgstr ""
"ການເອີ້ນໃຊ້ການຕັ້ງຄ່າ FCoE ຈະຍົກເລີກການປ່ຽນແປງທັງໝົດໃນຕອນນີ້.\n"
"ຢືນຢັນການເອີ້ນໃຊ້ການຕັ້ງຄ່າ FCoE ບໍ່?"

#. @see ConfigureAction#warning_text
#: src/lib/y2partitioner/actions/configure_actions.rb:269
msgid ""
"Calling DASD configuration cancels all current changes.\n"
"Really call DASD configuration?"
msgstr ""
"ການເອີ້ນໃຊ້ການຕັ້ງຄ່າ DASD ຈະຍົກເລີກການປ່ຽນແປງທັງໝົດໃນຕອນນີ້.\n"
"ຢືນຢັນການເອີ້ນໃຊ້ການຕັ້ງຄ່າ DASD ບໍ່?"

#. @see ConfigureAction#warning_text
#: src/lib/y2partitioner/actions/configure_actions.rb:285
msgid ""
"Calling zFCP configuration cancels all current changes.\n"
"Really call zFCP configuration?"
msgstr ""
"ການເອີ້ນໃຊ້ການຕັ້ງຄ່າ zFCP ຈະຍົກເລີກການປ່ຽນແປງທັງໝົດໃນຕອນນີ້.\n"
"ຢືນຢັນການເອີ້ນໃຊ້ການຕັ້ງຄ່າ zFCP ບໍ່?"

#. @see ConfigureAction#warning_text
#: src/lib/y2partitioner/actions/configure_actions.rb:301
msgid ""
"Calling XPRAM configuration cancels all current changes.\n"
"Really call XPRAM configuration?"
msgstr ""
"ການເອີ້ນໃຊ້ການຕັ້ງຄ່າ XPRAM ຈະຍົກເລີກການປ່ຽນແປງທັງໝົດໃນຕອນນີ້.\n"
"ຢືນຢັນການເອີ້ນໃຊ້ການຕັ້ງຄ່າ XPRAM ບໍ່?"

#. TRANSLATORS: dialog title. %s is a device name like /dev/sda
#: src/lib/y2partitioner/actions/controllers/add_partition.rb:203
#, c-format
msgid "Add Partition on %s"
msgstr "ເພີ່ມສ່ວນແບ່ງໃນ %s"

#. starting block must be in a region,
#. TRANSLATORS: text for an error popup
#: src/lib/y2partitioner/actions/controllers/add_partition.rb:219
msgid "The block entered as start is not available."
msgstr "ບລັອກທີ່ປ້ອນເປັນຈຸດເລີ່ມຕົ້ນແມ່ນບໍ່ສາມາດໃຊ້ໄດ້."

#. TRANSLATORS: text for an error popup
#: src/lib/y2partitioner/actions/controllers/add_partition.rb:222
msgid "The end block cannot be before the start."
msgstr "ບລັອກຈຸດສິ້ນສຸດບໍ່ສາມາດຢູ່ກ່ອນຈຸດເລີ່ມຕົ້ນໄດ້."

#. ending block must be in the same region than the start
#. TRANSLATORS: text for an error popup
#: src/lib/y2partitioner/actions/controllers/add_partition.rb:227
msgid "The region entered collides with the existing partitions."
msgstr "ຂອບເຂດທີ່ປ້ອນເຂົ້າໄປທັບຊ້ອນກັບສ່ວນແບ່ງທີ່ມີຢູ່ແລ້ວ."

#. It's so small that we already know that we can't align both
#. start and end
#. TRANSLATORS: text for an error popup
#: src/lib/y2partitioner/actions/controllers/add_partition.rb:233
msgid "The region entered is too small, not supported by this device."
msgstr "ຂອບເຂດທີ່ປ້ອນເຂົ້າໄປນ້ອຍເກີນໄປ, ອຸປະກອນນີ້ບໍ່ຮອງຮັບ."

#. Almost pathological case, but still can happen if the user tries
#. to break stuff
#. TRANSLATORS: text for an error popup
#: src/lib/y2partitioner/actions/controllers/add_partition.rb:239
msgid "Invalid region entered, increase the size or align the start."
msgstr ""
"ຂອບເຂດທີ່ປ້ອນເຂົ້າບໍ່ຖືກຕ້ອງ, ກະລຸນາເພີ່ມຂະໜາດ ຫຼື ປັບຈຸດເລີ່ມຕົ້ນໃຫ້ກົງ."

#. Title to display in the dialog during the process
#.
#. @return [String]
#: src/lib/y2partitioner/actions/controllers/encryption.rb:207
#, c-format
msgid "Encryption for %s"
msgstr "ການເຂົ້າລະຫັດສຳລັບ %s"

#: src/lib/y2partitioner/actions/controllers/encryption.rb:209
#, c-format
msgid "Modify encryption of %s"
msgstr "ແກ້ໄຂການເຂົ້າລະຫັດຂອງ %s"

#: src/lib/y2partitioner/actions/controllers/encryption.rb:211
#, c-format
msgid "Encrypt %s"
msgstr "ເຂົ້າລະຫັດ %s"

#. TRANSLATORS: %{mount_points} is replaced by a list of mount points, please
#. do not modify it.
#: src/lib/y2partitioner/actions/controllers/fstabs.rb:149
#, perl-brace-format
msgid ""
"The following mount points cannot be imported:\n"
"%{mount_points}"
msgstr ""
"ຈຸດເມົາທ໌ຕໍ່ໄປນີ້ບໍ່ສາມາດນຳເຂົ້າໄດ້:\n"
"%{mount_points}"

#. TRANSLATORS: dialog title. %s is a device name like /dev/vg0
#: src/lib/y2partitioner/actions/controllers/lvm_lv.rb:245
#, c-format
msgid "Add Logical Volume on %s"
msgstr "ເພີ່ມວໍລຸມໂລຈິກໃນ %s"

#. TRANSLATORS: Error message when there is no name for the new logical volume
#: src/lib/y2partitioner/actions/controllers/lvm_lv.rb:322
msgid "Enter a name for the logical volume."
msgstr "ປ້ອນຊື່ສຳລັບວໍລຸມໂລຈິກ."

#. TRANSLATORS: Error message when the name of the logical volume is too long
#: src/lib/y2partitioner/actions/controllers/lvm_lv.rb:332
msgid "The name for the logical volume is longer than 128 characters."
msgstr "ຊື່ສຳລັບວໍລຸມໂລຈິກຍາວເກີນ 128 ຕົວອັກສອນ."

#. TRANSLATORS: Error message when the name of the logical volume contains
#. illegal characters
#: src/lib/y2partitioner/actions/controllers/lvm_lv.rb:343
msgid ""
"The name for the logical volume contains illegal characters.\n"
"Allowed are alphanumeric characters, \".\", \"_\", \"-\" and \"+\"."
msgstr ""
"ຊື່ສຳລັບວໍລຸມໂລຈິກມີຕົວອັກສອນທີ່ບໍ່ຖືກຕ້ອງ.\n"
"ຕົວອັກສອນທີ່ອະນຸຍາດແມ່ນຕົວເລກ, ຕົວອັກສອນ, \".\", \"_\", \"-\" ແລະ \"+\"."

#. TRANSLATORS: Error message when the name of the volume group is already used.
#. %{lv_name} is replaced by a logical volume name (e.g., lv1) and %{vg_name} is
#. replaced by a volume group name (e.g., system)
#: src/lib/y2partitioner/actions/controllers/lvm_lv.rb:359
#, perl-brace-format
msgid ""
"A logical volume named \"%{lv_name}\" already exists\n"
"in volume group \"%{vg_name}\"."
msgstr ""
"ມີວໍລຸມໂລຈິກຊື່ \"%{lv_name}\" ຢູ່ແລ້ວ\n"
"ໃນກຸ່ມວໍລຸມ \"%{vg_name}\"."

#. TRANSLATORS: dialog title when creating an LVM volume group
#: src/lib/y2partitioner/actions/controllers/lvm_vg.rb:81
msgid "Add Volume Group"
msgstr "ເພີ່ມກຸ່ມວໍລຸມ"

#. TRANSLATORS: dialog title when resizing an LVM volume group, where %s is replaced
#. by a device name (e.g., /dev/vg0)
#: src/lib/y2partitioner/actions/controllers/lvm_vg.rb:85
#, c-format
msgid "Resize Volume Group %s"
msgstr "ປ່ຽນຂະໜາດກຸ່ມວໍລຸມ %s"

#. Error message to show when the given volume group name is empty
#.
#. @return [String]
#: src/lib/y2partitioner/actions/controllers/lvm_vg.rb:303
msgid "Enter a name for the volume group."
msgstr "ປ້ອນຊື່ສຳລັບກຸ່ມວໍລຸມ."

#. Error message to show when the given volume group name contains illegal
#. characters
#.
#. @return [String]
#: src/lib/y2partitioner/actions/controllers/lvm_vg.rb:321
msgid ""
"The name for the volume group contains illegal characters. Allowed\n"
"are alphanumeric characters, \".\", \"_\", \"-\" and \"+\""
msgstr ""
"ຊື່ສຳລັບກຸ່ມວໍລຸມມີຕົວອັກສອນທີ່ບໍ່ຖືກຕ້ອງ. ຕົວອັກສອນທີ່\n"
"ອະນຸຍາດແມ່ນຕົວເລກ, ຕົວອັກສອນ, \".\", \"_\", \"-\" ແລະ \"+\""

#. TRANSLATORS: %{vg_name} is replaced by the name of the volume group
#: src/lib/y2partitioner/actions/controllers/lvm_vg.rb:344
#, perl-brace-format
msgid ""
"The volume group name \"%{vg_name}\" conflicts\n"
"with another entry in the /dev directory."
msgstr ""
"ຊື່ກຸ່ມວໍລຸມ \"%{vg_name}\" ຂັດແຍ້ງ\n"
"ກັບລາຍການອື່ນໃນໄດເຣັກທໍຣີ /dev."

#. Error message to show when the given extent size is not valid
#.
#. @see #invalid_extent_size?
#.
#. @return [String]
#: src/lib/y2partitioner/actions/controllers/lvm_vg.rb:369
msgid ""
"The data entered is invalid. Insert a physical extent size larger than 1 "
"KiB\n"
"in powers of 2 and multiple of 128 KiB, for example, \"512 KiB\" or \"4 MiB\""
msgstr ""
"ຂໍ້ມູນທີ່ປ້ອນເຂົ້າບໍ່ຖືກຕ້ອງ. ກະລຸນາໃສ່ຂະໜາດ physical extent ທີ່ໃຫຍ່ກວ່າ 1 KiB\n"
"ໃນຮູບແບບເລກກຳລັງຂອງ 2 ແລະ ເປັນຕົວຄູນຂອງ 128 KiB, ຕົວຢ່າງ: \"512 KiB\" ຫຼື \"4 MiB\""

#. TRANSLATORS: dialog title when creating a MD RAID.
#. %s is a device name like /dev/md0
#: src/lib/y2partitioner/actions/controllers/md.rb:196
#, c-format
msgid "Add RAID %s"
msgstr "ເພີ່ມ RAID %s"

#. TRANSLATORS: dialog title when editing the devices of a Software RAID.
#. %s is a device name (e.g., /dev/md0)
#: src/lib/y2partitioner/actions/controllers/md.rb:200
#, c-format
msgid "Edit devices of RAID %s"
msgstr "ແກ້ໄຂອຸປະກອນຂອງ RAID %s"

#. TRANSLATORS: %s is a device name (e.g. "/dev/sda")
#: src/lib/y2partitioner/actions/create_partition_table.rb:113
#, c-format
msgid "It is not possible to create a new partition table on %s."
msgstr "ບໍ່ສາມາດສ້າງຕາຕະລາງສ່ວນແບ່ງໃໝ່ໃນ %s ໄດ້."

#. @see #confirm
#: src/lib/y2partitioner/actions/create_partition_table.rb:151
msgid "Confirm Deleting of Current Devices"
msgstr "ຢືນຢັນການລຶບອຸປະກອນທີ່ມີຢູ່ໃນປັດຈຸບັນ"

#: src/lib/y2partitioner/actions/create_partition_table.rb:152
msgid "If you proceed, the following devices will be deleted:"
msgstr "ຫາກທ່ານດຳເນີນການຕໍ່, ອຸປະກອນຕໍ່ໄປນີ້ຈະຖືກລຶບອອກ:"

#. TRANSLATORS %s is the disk device name ("/dev/sda" or similar)
#: src/lib/y2partitioner/actions/create_partition_table.rb:154
#, c-format
msgid "Really create a new partition table on %s"
msgstr "ຢືນຢັນການສ້າງຕາຕະລາງສ່ວນແບ່ງໃໝ່ໃນ %s ບໍ່"

#. TRANSLATORS: the first %s is replaced by the type of the filesystem
#. (for example, "Btrfs" or "Ext2"), the second one by the disk device name
#. ("/dev/sda" or similar).
#: src/lib/y2partitioner/actions/create_partition_table.rb:175
#, c-format
msgid ""
"This will delete all data from the %s file system in the device.\n"
"\n"
"Really create a new partition table on %s?"
msgstr ""
"ນີ້ຈະລຶບຂໍ້ມູນທັງໝົດຈາກລະບົບໄຟລ໌ %s ໃນອຸປະກອນ.\n"
"\n"
"ຢືນຢັນການສ້າງຕາຕະລາງສ່ວນແບ່ງໃໝ່ໃນ %s ບໍ່?"

#. TRANSLATORS: Note added to the dialog for trying to unmount devices
#: src/lib/y2partitioner/actions/create_partition_table.rb:210
msgid "A new partition table cannot be created while the devices are mounted."
msgstr "ບໍ່ສາມາດສ້າງຕາຕະລາງສ່ວນແບ່ງໃໝ່ໄດ້ໃນຂະນະທີ່ອຸປະກອນກຳລັງຖືກເມົາທ໌ຢູ່."

#. TRANSLATORS: error message, %{name} is replaced by a bcache name (e.g., /dev/bcache0)
#: src/lib/y2partitioner/actions/delete_bcache.rb:58
#, perl-brace-format
msgid ""
"The device %{name} is a flash-only bcache. Deleting this kind of devices\n"
"is not supported yet."
msgstr ""
"ອຸປະກອນ %{name} ເປັນ bcache ແບບ flash-only. ການລຶບອຸປະກອນປະເພດນີ້\n"
"ແມ່ນຍັງບໍ່ທັນຮອງຮັບເທື່ອ."

#. TRANSLATORS: Error message when detach is not a safe action
#: src/lib/y2partitioner/actions/delete_bcache.rb:73
msgid ""
"The bcache cannot be deleted because it shares its cache set with other "
"devices.\n"
"Deleting it without detaching the device first can result in unreachable "
"space.\n"
"Unfortunately detaching can take a very long time in some situations."
msgstr ""
"ບໍ່ສາມາດລຶບ bcache ໄດ້ ເພາະມັນໃຊ້ cache set ຮ່ວມກັບອຸປະກອນອື່ນ.\n"
"ການລຶບໂດຍບໍ່ທັນຕັດການເຊື່ອມຕໍ່ (detach) ອຸປະກອນກ່ອນ ອາດເຮັດໃຫ້ເສຍພື້ນທີ່ບາງສ່ວນໄປ.\n"
"ແຕ່ການຕັດການເຊື່ອມຕໍ່ອາດໃຊ້ເວລາດົນຫຼາຍໃນບາງກໍລະນີ."

#. no note if there is no bcache cset associated or if cset is shared by more devices
#: src/lib/y2partitioner/actions/delete_bcache.rb:102
msgid ""
"The selected bcache is the only one using its caching set.\n"
"The caching set will be also deleted.\n"
"\n"
msgstr ""
"bcache ທີ່ເລືອກແມ່ນອັນດຽວທີ່ໃຊ້ caching set ຂອງມັນ.\n"
"caching set ດັ່ງກ່າວຈະຖືກລຶບອອກນຳ.\n"
"\n"

#. TRANSLATORS: Message when deleting a Btrfs filesystem, where %{name} is replaced by the Btrfs
#. name (e.g., "BtrFS sda1").
#: src/lib/y2partitioner/actions/delete_btrfs.rb:45
#, perl-brace-format
msgid "Really delete the file system %{name}?"
msgstr "ຢືນຢັນການລຶບລະບົບໄຟລ໌ %{name} ບໍ່?"

#. TRANSLATORS: Message when deleting a Btrfs subvolume, where %{name} is replaced by the Btrfs
#. subvolume (e.g., "@/home").
#: src/lib/y2partitioner/actions/delete_btrfs_subvolume.rb:50
#, perl-brace-format
msgid "Really delete the Btrfs subvolume %{path}?"
msgstr "ຢືນຢັນການລຶບ Btrfs subvolume %{path} ບໍ່?"

#. FIXME: unify message for recursive deleting devices instead of having one specific message for
#. each case.
#: src/lib/y2partitioner/actions/delete_device.rb:101
msgid "Confirm Deleting of Devices"
msgstr "ຢືນຢັນການລຶບອຸປະກອນ"

#: src/lib/y2partitioner/actions/delete_device.rb:102
msgid ""
"The selected device is used by other devices in the system.\n"
"To keep the system in a consistent state, the following devices\n"
"will also be deleted:"
msgstr ""
"ອຸປະກອນທີ່ເລືອກຖືກໃຊ້ງານໂດຍອຸປະກອນອື່ນໃນລະບົບ.\n"
"ເພື່ອໃຫ້ລະບົບຢູ່ໃນສະພາບທີ່ຖືກຕ້ອງ, ອຸປະກອນຕໍ່ໄປນີ້\n"
"ຈະຖືກລຶບອອກນຳ:"

#. FIXME: unify message for recursive deleting devices instead of having one specific message for
#. each case.
#: src/lib/y2partitioner/actions/delete_device.rb:119
msgid "Confirm Deleting Device with Partitions"
msgstr "ຢືນຢັນການລຶບອຸປະກອນທີ່ມີສ່ວນແບ່ງ"

#: src/lib/y2partitioner/actions/delete_device.rb:120
msgid ""
"The selected device contains partitions.\n"
"To keep the system in a consistent state, the following partitions\n"
"and its associated devices will also be deleted:"
msgstr ""
"ອຸປະກອນທີ່ເລືອກມີສ່ວນແບ່ງຢູ່.\n"
"ເພື່ອໃຫ້ລະບົບຢູ່ໃນສະພາບທີ່ຖືກຕ້ອງ, ສ່ວນແບ່ງຕໍ່ໄປນີ້\n"
"ແລະ ອຸປະກອນທີ່ກ່ຽວຂ້ອງຈະຖືກລຶບອອກນຳ:"

#. TRANSLATORS %s is a kernel name like /dev/sda1
#: src/lib/y2partitioner/actions/delete_device.rb:136
#, c-format
msgid "Really delete %s and all the affected devices?"
msgstr "ຢືນຢັນການລຶບ %s ແລະ ອຸປະກອນທີ່ໄດ້ຮັບຜົນກະທົບທັງໝົດບໍ່?"

#. TRANSLATORS %s is the name of the device (e.g., /dev/sda1)
#. TRANSLATORS: Confirmation to delete an NFS mount, %s is replaced by
#. something like 'server:/path'
#: src/lib/y2partitioner/actions/delete_device.rb:144
#: src/lib/y2partitioner/actions/delete_nfs.rb:47
#, c-format
msgid "Really delete %s?"
msgstr "ຢືນຢັນການລຶບ %s ບໍ່?"

#. TRANSLATORS: Note added to the dialog for trying to unmount a device
#: src/lib/y2partitioner/actions/delete_device.rb:154
msgid "Devices cannot be deleted while mounted."
msgstr "ບໍ່ສາມາດລຶບອຸປະກອນໄດ້ໃນຂະນະທີ່ຖືກເມົາທ໌ຢູ່."

#. Confirmation when deleting the device affects other volumes
#.
#. @see ConfirmRecursiveDelete#confirm_recursive_delete
#.
#. @return [Boolean]
#: src/lib/y2partitioner/actions/delete_lvm_lv.rb:70
msgid "Confirm Deleting of LVM Thin Pool"
msgstr "ຢືນຢັນການລຶບ LVM Thin Pool"

#: src/lib/y2partitioner/actions/delete_lvm_lv.rb:72
msgid "Confirm Deleting of LVM Logical Volume"
msgstr "ຢືນຢັນການລຶບ LVM Logical Volume"

#. TRANSLATORS: Confirmation message when a LVM logical volume is going to be deleted,
#. where %{name} is replaced by the name of the volume (e.g., /dev/system/pool)
#: src/lib/y2partitioner/actions/delete_lvm_lv.rb:83
#, perl-brace-format
msgid ""
"The volume %{name} is used by at least one another volume.\n"
"If you proceed, the following volumes will be unmounted (if mounted)\n"
"and deleted:"
msgstr ""
"ວໍລຸມ %{name} ຖືກໃຊ້ງານໂດຍຢ່າງໜ້ອຍໜຶ່ງວໍລຸມອື່ນ.\n"
"ຫາກທ່ານດຳເນີນການຕໍ່, ວໍລຸມຕໍ່ໄປນີ້ຈະຖືກຍົກເລີກການເມົາທ໌ (ຖ້າເມົາທ໌ຢູ່)\n"
"ແລະ ຖືກລຶບອອກ:"

#. TRANSLATORS: %{name} is replaced by the name of the logical volume (e.g., /dev/system/pool)
#: src/lib/y2partitioner/actions/delete_lvm_lv.rb:90
#, perl-brace-format
msgid "Really delete \"%{name}\" and all related volumes?"
msgstr "ຢືນຢັນການລຶບ \"%{name}\" ແລະ ວໍລຸມທີ່ກ່ຽວຂ້ອງທັງໝົດບໍ່?"

#. FIXME: unify message for recursive deleting devices instead of having one specific message for
#. each case.
#: src/lib/y2partitioner/actions/delete_lvm_vg.rb:62
msgid "Confirm Deleting of Volume Group"
msgstr "ຢືນຢັນການລຶບກຸ່ມວໍລຸມ"

#. TRANSLATORS: %s is the name of the volume group (e.g. "system")
#: src/lib/y2partitioner/actions/delete_lvm_vg.rb:64
#, c-format
msgid ""
"The volume group \"%s\" contains at least one logical volume.\n"
"If you proceed, the following volumes will be unmounted (if mounted)\n"
"and deleted:"
msgstr ""
"ກຸ່ມວໍລຸມ \"%s\" ມີຢ່າງໜ້ອຍໜຶ່ງວໍລຸມໂລຈິກ.\n"
"ຫາກທ່ານດຳເນີນການຕໍ່, ວໍລຸມຕໍ່ໄປນີ້ຈະຖືກຍົກເລີກການເມົາທ໌ (ຖ້າເມົາທ໌ຢູ່)\n"
"ແລະ ຖືກລຶບອອກ:"

#. TRANSLATORS: %s is the name of the volume group (e.g. "system")
#: src/lib/y2partitioner/actions/delete_lvm_vg.rb:69
#, c-format
msgid "Really delete volume group \"%s\" and all related logical volumes?"
msgstr "ຢືນຢັນການລຶບກຸ່ມວໍລຸມ \"%s\" ແລະ ວໍລຸມໂລຈິກທີ່ກ່ຽວຂ້ອງທັງໝົດບໍ່?"

#. Error when the partition is implicit
#.
#. @return [String, nil] nil if the partition is not implicit
#: src/lib/y2partitioner/actions/delete_partition.rb:58
msgid "This is an implicit partition and cannot be deleted."
msgstr "ນີ້ແມ່ນສ່ວນແບ່ງແບບແຝງ (implicit) ແລະ ບໍ່ສາມາດລຶບໄດ້."

#. TRANSLATORS: Message when deleting a Tmpfs filesystem, where %{mount_path} is replaced by a
#. mount path (e.g., "/tmp").
#: src/lib/y2partitioner/actions/delete_tmpfs.rb:47
#, perl-brace-format
msgid "Really delete the temporary file system mounted at %{mount_path}?"
msgstr "ຢືນຢັນການລຶບລະບົບໄຟລ໌ຊົ່ວຄາວທີ່ເມົາທ໌ຢູ່ %{mount_path} ບໍ່?"

#. TRANSLATORS: error message, %{name} is replaced by a bcache name (e.g., /dev/bcache0)
#: src/lib/y2partitioner/actions/edit_bcache.rb:64
#, perl-brace-format
msgid ""
"The device %{name} is a flash-only bcache and its caching cannot be modified."
msgstr ""
"ອຸປະກອນ %{name} ເປັນ bcache ແບບ flash-only ແລະ ບໍ່ສາມາດແກ້ໄຂ caching ຂອງມັນໄດ້."

#. TRANSLATORS: error message, %{name} is replaced by a bcache name (e.g., /dev/bcache0)
#: src/lib/y2partitioner/actions/edit_bcache.rb:77
#, perl-brace-format
msgid ""
"The bcache %{name} is already created on disk. Such device cannot be "
"modified\n"
"because that might imply a detaching operation. Unfortunately detaching can "
"take\n"
"a very long time in some situations."
msgstr ""
"bcache %{name} ຖືກສ້າງໄວ້ໃນດິສກ໌ແລ້ວ. ອຸປະກອນດັ່ງກ່າວບໍ່ສາມາດແກ້ໄຂໄດ້\n"
"ເພາະມັນອາດຕ້ອງມີການຕັດການເຊື່ອມຕໍ່ (detach). ແຕ່ການຕັດການເຊື່ອມຕໍ່ອາດໃຊ້\n"
"ເວລາດົນຫຼາຍໃນບາງກໍລະນີ."

#. TRANSLATORS: dialog title. %s is a device name like /dev/md0
#: src/lib/y2partitioner/actions/edit_blk_device.rb:80
#, c-format
msgid "Edit RAID %s"
msgstr "ແກ້ໄຂ RAID %s"

#. TRANSLATORS: dialog title. %{lv_name} is an LVM LV name (e.g.'root'),
#. %{vg} is the device name of an LVM VG (e.g. '/dev/system').
#: src/lib/y2partitioner/actions/edit_blk_device.rb:85
#, perl-brace-format
msgid "Edit Logical Volume %{lv_name} on %{vg}"
msgstr "ແກ້ໄຂວໍລຸມໂລຈິກ %{lv_name} ໃນ %{vg}"

#. TRANSLATORS: dialog title. %s is a device name like /dev/sda1
#: src/lib/y2partitioner/actions/edit_blk_device.rb:88
#, c-format
msgid "Edit Partition %s"
msgstr "ແກ້ໄຂສ່ວນແບ່ງ %s"

#. TRANSLATORS: dialog title. %s is a device name like /dev/sda
#: src/lib/y2partitioner/actions/edit_blk_device.rb:91
#, c-format
msgid "Edit Device %s"
msgstr "ແກ້ໄຂອຸປະກອນ %s"

#. TRANSLATORS: %{name} is replaced by a device name (e.g., /dev/sda1)
#. and %{users} is replaced by a comma-separated list of name devices
#. (devices using the first one).
#: src/lib/y2partitioner/actions/edit_blk_device.rb:142
#, perl-brace-format
msgid ""
"The device %{name} is in use (%{users}).\n"
"It cannot be edited.\n"
"To edit %{name}, make sure it is not used."
msgstr ""
"ອຸປະກອນ %{name} ກຳລັງຖືກໃຊ້ງານຢູ່ (%{users}).\n"
"ບໍ່ສາມາດແກ້ໄຂໄດ້.\n"
"ເພື່ອແກ້ໄຂ %{name}, ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າມັນບໍ່ໄດ້ຖືກໃຊ້ງານ."

#. TRANSLATORS: %{name} is replaced by a device name (e.g., /dev/sda1).
#. Since device names can be rather long, make sure the lines
#. containing %{name} are sorter than the others.
#: src/lib/y2partitioner/actions/edit_blk_device.rb:161
#, perl-brace-format
msgid ""
"The device %{name} belongs to a Btrfs.\n"
"It cannot be edited.\n"
"\n"
"To modify the settings of the Btrfs, edit the filesystem itself\n"
"instead of its individual block devices.\n"
"\n"
"To use %{name} for other purpose, make sure it does not\n"
"belong to the Btrfs filesystem, either deleting the filesystem or\n"
"removing %{name} from it."
msgstr ""
"ອຸປະກອນ %{name} ເປັນສ່ວນໜຶ່ງຂອງ Btrfs.\n"
"ບໍ່ສາມາດແກ້ໄຂໄດ້.\n"
"\n"
"ເພື່ອແກ້ໄຂການຕັ້ງຄ່າຂອງ Btrfs, ໃຫ້ແກ້ໄຂທີ່ຕົວລະບົບໄຟລ໌ໂດຍກົງ\n"
"ແທນທີ່ຈະແກ້ໄຂແຕ່ລະອຸປະກອນບລັອກແຍກກັນ.\n"
"\n"
"ເພື່ອໃຊ້ %{name} ສຳລັບຈຸດປະສົງອື່ນ, ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າມັນ\n"
"ບໍ່ໄດ້ເປັນຂອງລະບົບໄຟລ໌ Btrfs, ໂດຍການລຶບລະບົບໄຟລ໌ ຫຼື\n"
"ເອົາ %{name} ອອກຈາກລະບົບໄຟລ໌ນັ້ນ."

#. TRANSLATORS: %{name} is replaced by a device name (e.g., /dev/sda1).
#. Since device names can be rather long, make sure the lines
#. containing %{name} are sorter than the others.
#: src/lib/y2partitioner/actions/edit_blk_device.rb:183
#, perl-brace-format
msgid ""
"The device %{name} belongs to a multi-device filesystem.\n"
"It cannot be edited."
msgstr ""
"ອຸປະກອນ %{name} ເປັນສ່ວນໜຶ່ງຂອງລະບົບໄຟລ໌ແບບຫຼາຍອຸປະກອນ.\n"
"ບໍ່ສາມາດແກ້ໄຂໄດ້."

#. TRANSLATORS: %{name} is replaced by a device name (e.g., /dev/sda1).
#: src/lib/y2partitioner/actions/edit_blk_device.rb:197
#, perl-brace-format
msgid ""
"The device %{name} contains partitions.\n"
"It cannot be edited directly.\n"
"To edit %{name}, first delete all its partitions."
msgstr ""
"ອຸປະກອນ %{name} ມີສ່ວນແບ່ງຢູ່.\n"
"ບໍ່ສາມາດແກ້ໄຂໂດຍກົງໄດ້.\n"
"ເພື່ອແກ້ໄຂ %{name}, ໃຫ້ລຶບສ່ວນແບ່ງທັງໝົດຂອງມັນອອກກ່ອນ."

#. TRANSLATORS: Error message when trying to edit an extented partition
#: src/lib/y2partitioner/actions/edit_blk_device.rb:211
msgid "An extended partition cannot be edited."
msgstr "ສ່ວນແບ່ງແບບຂະຫຍາຍ (extended partition) ບໍ່ສາມາດແກ້ໄຂໄດ້."

#. TRANSLATORS: Error message when trying to edit an LVM thin pool. %{name} is
#. replaced by a logical volume name (e.g., /dev/system/lv1)
#: src/lib/y2partitioner/actions/edit_blk_device.rb:222
#, perl-brace-format
msgid ""
"The volume %{name} is a thin pool.\n"
"It cannot be edited."
msgstr ""
"ວໍລຸມ %{name} ແມ່ນ thin pool.\n"
"ບໍ່ສາມາດແກ້ໄຂໄດ້."

#. TRANSLATORS: Error message when trying to edit an LVM cache pool. %{name} is
#. replaced by a logical volume name (e.g., /dev/system/lv1)
#: src/lib/y2partitioner/actions/edit_blk_device.rb:233
#, perl-brace-format
msgid ""
"The volume %{name} is a cache pool.\n"
"It cannot be edited."
msgstr ""
"ວໍລຸມ %{name} ແມ່ນ cache pool.\n"
"ບໍ່ສາມາດແກ້ໄຂໄດ້."

#. TRANSLATORS: Error message when trying to edit an unusable block device. %{name} is
#. replaced by a name (e.g., /dev/system/cache-pool)
#: src/lib/y2partitioner/actions/edit_blk_device.rb:246
#, perl-brace-format
msgid ""
"The device %{name} is not a block device for common use.\n"
"It cannot be edited."
msgstr ""
"ອຸປະກອນ %{name} ບໍ່ແມ່ນອຸປະກອນບລັອກສຳລັບການໃຊ້ງານທົ່ວໄປ.\n"
"ບໍ່ສາມາດແກ້ໄຂໄດ້."

#. TRANSLATORS: Error message when trying to edit an LVM LV snapshot. %{name} and %{origin}
#. are replaced by logical volume names (e.g., /dev/system/user-data-snapshot and
#. /dev/system/user-data)
#: src/lib/y2partitioner/actions/edit_blk_device.rb:260
#, perl-brace-format
msgid ""
"The device %{name} is an LVM snapshot volume of %{origin}.\n"
"Do you really want to edit it?"
msgstr ""
"ອຸປະກອນ %{name} ເປັນວໍລຸມ LVM snapshot ຂອງ %{origin}.\n"
"ທ່ານຕ້ອງການແກ້ໄຂມັນແທ້ບໍ່?"

#. TRANSLATORS: Wizard step title, where %{basename} is replaced by the device
#. base name (e.g., sda1).
#: src/lib/y2partitioner/actions/edit_btrfs.rb:53
#, perl-brace-format
msgid "Edit Btrfs %{basename}"
msgstr "ແກ້ໄຂ Btrfs %{basename}"

#. Wizard title
#.
#. @return [String]
#: src/lib/y2partitioner/actions/edit_btrfs_devices.rb:75
#, perl-brace-format
msgid "Edit devices of Btrfs %{name}"
msgstr "ແກ້ໄຂອຸປະກອນຂອງ Btrfs %{name}"

#. TRANSLATORS: error message, where %{name} is replaced by a device base name (e.g., sda1)
#: src/lib/y2partitioner/actions/edit_btrfs_devices.rb:111
#, perl-brace-format
msgid ""
"The Btrfs %{name} is already created on disk and its used devices\n"
"cannot be modified. To modify the used devices, remove the Btrfs\n"
"and create it again."
msgstr ""
"Btrfs %{name} ຖືກສ້າງໄວ້ໃນດິສກ໌ແລ້ວ ແລະ ອຸປະກອນທີ່ໃຊ້ງານ\n"
"ບໍ່ສາມາດແກ້ໄຂໄດ້. ເພື່ອແກ້ໄຂອຸປະກອນທີ່ໃຊ້, ໃຫ້ລຶບ Btrfs ອອກ\n"
"ແລ້ວສ້າງໃໝ່ອີກຄັ້ງ."

#. TRANSLATORS: error message, %{name} is replaced by a device name (e.g., /dev/md1)
#: src/lib/y2partitioner/actions/edit_md_devices.rb:100
#, perl-brace-format
msgid ""
"The RAID %{name} is already created on disk and its used devices\n"
"cannot be modified. To modify the used devices, remove the RAID\n"
"and create it again."
msgstr ""
"RAID %{name} ຖືກສ້າງໄວ້ໃນດິສກ໌ແລ້ວ ແລະ ອຸປະກອນທີ່ໃຊ້ງານ\n"
"ບໍ່ສາມາດແກ້ໄຂໄດ້. ເພື່ອແກ້ໄຂອຸປະກອນທີ່ໃຊ້, ໃຫ້ລຶບ RAID ອອກ\n"
"ແລ້ວສ້າງໃໝ່ອີກຄັ້ງ."

#. TRANSLATORS: error message, %{name} is replaced by a device name (e.g., /dev/md1)
#: src/lib/y2partitioner/actions/edit_md_devices.rb:115
#, perl-brace-format
msgid ""
"The RAID %{name} is in use. To modify the used devices,\n"
"make sure %{name} is not used."
msgstr ""
"RAID %{name} ກຳລັງຖືກໃຊ້ງານຢູ່. ເພື່ອແກ້ໄຂອຸປະກອນທີ່ໃຊ້,\n"
"ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າ %{name} ບໍ່ໄດ້ຖືກໃຊ້ງານ."

#. TRANSLATORS: error message, %{name} is replaced by a device name (e.g., /dev/md1)
#: src/lib/y2partitioner/actions/edit_md_devices.rb:129
#, perl-brace-format
msgid ""
"The RAID %{name} is partitioned. To modify the used devices,\n"
"make sure %{name} has no partitions."
msgstr ""
"RAID %{name} ຖືກແບ່ງສ່ວນແລ້ວ. ເພື່ອແກ້ໄຂອຸປະກອນທີ່ໃຊ້,\n"
"ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າ %{name} ບໍ່ມີສ່ວນແບ່ງ."

#. TRANSLATORS: wizard title when editing a tmpfs filesystem, where %s is
#. replaced by the path where tmpfs is mounted
#: src/lib/y2partitioner/actions/edit_tmpfs.rb:74
#, c-format
msgid "Edit Tmpfs at %s"
msgstr "ແກ້ໄຂ Tmpfs ທີ່ %s"

#. Error message when no fstab file was detected
#.
#. @return [String, nil] nil if there is some fstab
#: src/lib/y2partitioner/actions/import_mount_points.rb:82
msgid "YaST has scanned your hard disks but no fstab file was found."
msgstr "YaST ໄດ້ສະແກນຮາດດິສກ໌ຂອງທ່ານແລ້ວ ແຕ່ບໍ່ພົບໄຟລ໌ fstab."

#. FIXME: This message is copied from old partitioner, but it could be improved.
#: src/lib/y2partitioner/actions/move_partition.rb:108
msgid ""
"Hard disks, BIOS RAIDs and multipath\n"
"devices cannot be moved."
msgstr ""
"ຮາດດິສກ໌, BIOS RAID ແລະ ອຸປະກອນ multipath\n"
"ບໍ່ສາມາດຍ້າຍໄດ້."

#. Error when a extended partition is tried to be moved
#.
#. @return [String, nil] nil when the partition is not extended
#: src/lib/y2partitioner/actions/move_partition.rb:118
msgid "An extended partition cannot be moved."
msgstr "ສ່ວນແບ່ງແບບຂະຫຍາຍ (extended partition) ບໍ່ສາມາດຍ້າຍໄດ້."

#. TRANSLATORS: error message where %{name} is replaced by a partition name (e.g. /dev/sda1)
#: src/lib/y2partitioner/actions/move_partition.rb:130
#, perl-brace-format
msgid ""
"The partition %{name} is already created on disk\n"
"and cannot be moved."
msgstr ""
"ສ່ວນແບ່ງ %{name} ຖືກສ້າງໄວ້ໃນດິສກ໌ແລ້ວ\n"
"ແລະ ບໍ່ສາມາດຍ້າຍໄດ້."

#. FIXME: This message is copied from old partitioner, but it could be improved.
#. TRANSLATORS: error message where %{name} is replaced by a partition name (e.g. /dev/sda1)
#: src/lib/y2partitioner/actions/move_partition.rb:145
#, perl-brace-format
msgid "No space to move partition %{name}"
msgstr "ບໍ່ມີພື້ນທີ່ພຽງພໍເພື່ອຍ້າຍສ່ວນແບ່ງ %{name}"

#. Confirmation popup before quitting the Expert Partitioner
#.
#. @return [:symbol] :yes, :no
#: src/lib/y2partitioner/actions/quit_partitioner.rb:75
msgid ""
"You have modified some devices. These changes will be lost\n"
"if you exit the Partitioner.\n"
"Really exit?"
msgstr ""
"ທ່ານໄດ້ແກ້ໄຂບາງອຸປະກອນ. ການປ່ຽນແປງເຫຼົ່ານີ້ຈະສູນຫາຍ\n"
"ຫາກທ່ານອອກຈາກໂປຣແກຣມແບ່ງສ່ວນ.\n"
"ຢືນຢັນການອອກບໍ່?"

#. Action class to rescan (reprobe) all devices
#: src/lib/y2partitioner/actions/rescan_devices.rb:53
msgid ""
"Re-scanning the storage devices will invalidate all the configuration\n"
"options set in the installer regarding storage, with no possibility\n"
"to withdraw.\n"
"That includes the result and settings of the guided setup as well as\n"
"the manual changes performed in the expert partitioner."
msgstr ""
"ການສະແກນອຸປະກອນຈັດເກັບຂໍ້ມູນໃໝ່ຈະເຮັດໃຫ້ການຕັ້ງຄ່າທັງໝົດ\n"
"ໃນຕົວຕິດຕັ້ງທີ່ກ່ຽວກັບບ່ອນຈັດເກັບຂໍ້ມູນເປັນໂມຄະ, ໂດຍບໍ່ສາມາດ\n"
"ເອົາຄືນໄດ້.\n"
"ເຊິ່ງລວມເຖິງຜົນລັບ ແລະ ການຕັ້ງຄ່າຂອງການຕິດຕັ້ງແບບແນະນຳ ຕະຫຼອດຮອດ\n"
"ການປ່ຽນແປງດ້ວຍຕົນເອງໃນໂປຣແກຣມແບ່ງສ່ວນແບບຊ່ຽວຊານ."

#: src/lib/y2partitioner/actions/rescan_devices.rb:59
msgid ""
"Re-scanning the storage devices will invalidate all the previous\n"
"changes with no possibility to withdraw."
msgstr ""
"ການສະແກນອຸປະກອນຈັດເກັບຂໍ້ມູນໃໝ່ຈະເຮັດໃຫ້ການປ່ຽນແປງ\n"
"ກ່ອນໜ້ານີ້ທັງໝົດເປັນໂມຄະ ໂດຍບໍ່ສາມາດເອົາຄືນໄດ້."

#. If the device in the probed deviceraph has descendants
#. something was probed on it. Note: In the staging deviceraph
#. this something might have been removed so this check must
#. not be done on the staging deviceraph.
#: src/lib/y2partitioner/actions/resize_blk_device.rb:105
msgid ""
"Neither a file system nor a storage system was detected on the\n"
"device. In case the device does contain a file system or a\n"
"storage system that is not supported by YaST, resizing will\n"
"most likely cause data loss. Really continue?"
msgstr ""
"ບໍ່ພົບທັງລະບົບໄຟລ໌ ຫຼື ລະບົບຈັດເກັບຂໍ້ມູນໃນອຸປະກອນ.\n"
"ໃນກໍລະນີທີ່ອຸປະກອນມີລະບົບໄຟລ໌ ຫຼື ລະບົບຈັດເກັບຂໍ້ມູນ\n"
"ທີ່ YaST ບໍ່ຮອງຮັບ, ການປ່ຽນຂະໜາດອາດເຮັດໃຫ້\n"
"ຂໍ້ມູນສູນຫາຍໄດ້. ຢືນຢັນການດຳເນີນການຕໍ່ບໍ່?"

#. Resizing a thin snapshot does not make too much sense. The user has to confirm a warning
#. before continue.
#.
#. @return [Boolean] true if device is not a thin snapshot or user decided go ahead
#: src/lib/y2partitioner/actions/resize_blk_device.rb:122
msgid ""
"Selected device is an LVM Thin Snapshot. Do you really want to resize it?"
msgstr "ອຸປະກອນທີ່ເລືອກແມ່ນ LVM Thin Snapshot. ທ່ານຕ້ອງການປ່ຽນຂະໜາດມັນແທ້ບໍ່?"

#. TRANSLATORS: %{name} is replaced by a device name (e.g., /dev/sda1) and %{users} is replaced
#. by a list of name devices (devices using the first one).
#: src/lib/y2partitioner/actions/resize_blk_device.rb:150
#, perl-brace-format
msgid ""
"The device %{name} is being used by:\n"
"%{users}\n"
"\n"
"It cannot be resized.\n"
"To resize %{name}, make sure it is not used."
msgstr ""
"ອຸປະກອນ %{name} ກຳລັງຖືກໃຊ້ງານໂດຍ:\n"
"%{users}\n"
"\n"
"ບໍ່ສາມາດປ່ຽນຂະໜາດໄດ້.\n"
"ເພື່ອປ່ຽນຂະໜາດ %{name}, ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າມັນບໍ່ໄດ້ຖືກໃຊ້ງານ."

#. Error when the filesystem type cannot be resized
#.
#. @return [String, nil] nil if the filesystem can be resized.
#: src/lib/y2partitioner/actions/resize_blk_device.rb:165
msgid "This filesystem type cannot be resized."
msgstr "ລະບົບໄຟລ໌ປະເພດນີ້ບໍ່ສາມາດປ່ຽນຂະໜາດໄດ້."

#. Error when the device cannot be resized
#. This might be a multi-line message reporting more than one reason.
#.
#. @return [String, nil] nil if the device can be resized.
#: src/lib/y2partitioner/actions/resize_blk_device.rb:176
msgid "This device cannot be resized:"
msgstr "ອຸປະກອນນີ້ບໍ່ສາມາດປ່ຽນຂະໜາດໄດ້:"

#. TRANSLATORS: Note added to the dialog for trying to unmount a device
#: src/lib/y2partitioner/actions/resize_blk_device.rb:191
msgid ""
"It is not possible to check whether a NTFS\n"
"can be resized while it is mounted."
msgstr ""
"ບໍ່ສາມາດກວດສອບໄດ້ວ່າ NTFS ຈະປ່ຽນຂະໜາດໄດ້ບໍ່\n"
"ໃນຂະນະທີ່ມັນຖືກເມົາທ໌ຢູ່."

#. Popup to alert the user about using the Partitioner
#.
#. @return [Symbol] user's answer (:yes, :no)
#: src/lib/y2partitioner/clients/main.rb:114
msgid ""
"Only use this program if you are familiar with partitioning hard disks.\n"
"\n"
"Never partition disks that may, in any way, be in use\n"
"(mounted, swap, etc.) unless you know exactly what you are\n"
"doing. Otherwise, the partitioning table will not be forwarded to the\n"
"kernel, which will most likely lead to data loss.\n"
"\n"
"To continue despite this warning, click Yes."
msgstr ""
"ໃຫ້ໃຊ້ໂປຣແກຣມນີ້ກໍຕໍ່ເມື່ອທ່ານມີຄວາມຊຳນານໃນການແບ່ງສ່ວນຮາດດິສກ໌ເທົ່ານັ້ນ.\n"
"\n"
"ຫ້າມແບ່ງສ່ວນດິສກ໌ທີ່ອາດຈະຖືກໃຊ້ງານຢູ່ (ເມົາທ໌ຢູ່, swap, ແລະ ອື່ນໆ)\n"
"ເວັ້ນເສຍແຕ່ວ່າທ່ານຮູ້ແນ່ຊັດວ່າ\n"
"ກຳລັງເຮັດຫຍັງຢູ່. ບໍ່ດັ່ງນັ້ນ, ຕາຕະລາງສ່ວນແບ່ງ\n"
"ຈະບໍ່ຖືກສົ່ງໄປຫາ kernel, ເຊິ່ງອາດເຮັດໃຫ້ຂໍ້ມູນສູນຫາຍໄດ້.\n"
"\n"
"ເພື່ອດຳເນີນການຕໍ່ເຖິງວ່າຈະມີຄຳເຕືອນນີ້, ໃຫ້ຄລິກ \"ແມ່ນ\"."

#. TRANSLATORS: this comment is only for testing purposes. Do not care too much.
#: src/lib/y2partitioner/clients/main.rb:129
msgid "Nothing gets written because commit is not allowed."
msgstr "ບໍ່ມີຫຍັງຖືກຂຽນລົງ ເພາະບໍ່ອະນຸຍາດໃຫ້ຢືນຢັນ (commit)."

#. @macro seeDialog
#: src/lib/y2partitioner/dialogs/bcache.rb:48
msgid "Bcache Device"
msgstr "ອຸປະກອນ Bcache"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/dialogs/bcache.rb:196
msgid "Backing Device"
msgstr "ອຸປະກອນ Backing"

#. TRANSLATORS: %{label} is replaced by the label of the option to select a backing device.
#: src/lib/y2partitioner/dialogs/bcache.rb:208
#, perl-brace-format
msgid ""
"<p><b>%{label}</b> is the device that will be used as backing device for "
"bcache. It will define the size of the resulting bcache device. The device "
"will be formatted so any previous content will be wiped out.</p>"
msgstr ""
"<p><b>%{label}</b> ແມ່ນອຸປະກອນທີ່ຈະຖືກໃຊ້ເປັນ backing device ສຳລັບ bcache. ມັນຈະກຳນົດຂະ"
"ໜາດຂອງອຸປະກອນ bcache ທີ່ຈະໄດ້ຮັບ. ອຸປະກອນຈະຖືກຟໍແມັດ ດັ່ງນັ້ນຂໍ້ມູນເກົ່າທັງໝົດຈະຖືກລຶບອອກ.</p>"

#. Value can be an empty string if there is no items
#: src/lib/y2partitioner/dialogs/bcache.rb:235
msgid "Backing and Caching devices cannot be identical."
msgstr "ອຸປະກອນ Backing ແລະ Caching ບໍ່ສາມາດເປັນອັນດຽວກັນໄດ້."

#: src/lib/y2partitioner/dialogs/bcache.rb:236
msgid "Cannot Create Bcache"
msgstr "ບໍ່ສາມາດສ້າງ Bcache ໄດ້"

#. @macro seeAbstractWidget
#. TRANSLATORS: table column label.
#: src/lib/y2partitioner/dialogs/bcache.rb:257
#: src/lib/y2partitioner/widgets/columns/caching_device.rb:37
msgid "Caching Device"
msgstr "ອຸປະກອນ Caching"

#. TRANSLATORS: %{label} is replaced by the label of the option to select a caching device.
#: src/lib/y2partitioner/dialogs/bcache.rb:271
#, perl-brace-format
msgid ""
"<p><b>%{label}</b> is the device that will be used as caching device for "
"bcache.It should be faster and usually is smaller than the backing device, "
"but that is not strictly required. The device will be formatted so any "
"previous content will be wiped out.</p><p>If you are thinking about using "
"bcache later, it is recommended to setup your slow devices as bcache backing "
"devices without a cache. You can add a caching device later.</p>"
msgstr ""
"<p><b>%{label}</b> ແມ່ນອຸປະກອນທີ່ຈະຖືກໃຊ້ເປັນ caching device ສຳລັບ bcache. ມັນຄວນຈະໄວຂຶ້"
"ນ ແລະ ປົກກະຕິຈະມີຂະໜາດນ້ອຍກວ່າ backing device, ແຕ່ບໍ່ໄດ້ບັງຄັບຢ່າງເຄັ່ງຄັດ. ອຸປະກອນຈະຖືກຟໍແມັດ ດັ່"
"ງນັ້ນຂໍ້ມູນເກົ່າທັງໝົດຈະຖືກລຶບອອກ.</p><p>ຫາກທ່ານຄິດທີ່ຈະໃຊ້ bcache ໃນພາຍຫຼັງ, ແນະນຳໃຫ້ຕັ້ງຄ່າອຸປະກອນ"
"ທີ່ຊ້າຂອງທ່ານເປັນ bcache backing devices ໂດຍບໍ່ຕ້ອງມີ cache. ທ່ານສາມາດເພີ່ມ caching "
"device ໄດ້ໃນພາຍຫຼັງ.</p>"

#: src/lib/y2partitioner/dialogs/bcache.rb:289
msgid "Without caching"
msgstr "ໂດຍບໍ່ມີ caching"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/dialogs/bcache.rb:320
msgid "Cache Mode"
msgstr "ໂໝດ Cache"

#. TRANSLATORS: %{label} is replaced by the label of the option to select a cache mode.
#: src/lib/y2partitioner/dialogs/bcache.rb:336
#, perl-brace-format
msgid ""
"<p><b>%{label}</b> is the operating mode for bcache. There are currently "
"four supported modes.<ul> <li><i>Writethrough</i> reading operations are "
"cached, writing is done in parallel to both devices. No data is lost in case "
"of failure of the caching device. This is the default mode.</"
"li><li><i>Writeback</i> both reading and writing operations are cached. This "
"result in better performance when writing.</li><li><i>Writearound</i> "
"reading is cached, new content is written only to the backing device.</"
"li><li><i>None</i> means cache is neither used for reading nor for writing. "
"This is useful mainly for temporarily disabling the cache before any big "
"sequential read or write, otherwise that would result in intensive "
"overwriting on the cache device.</li></p>"
msgstr ""
"<p><b>%{label}</b> ແມ່ນໂໝດການເຮັດວຽກສຳລັບ bcache. ປັດຈຸບັນມີ 4 ໂໝດທີ່ຮອງຮັບ:<ul> <li>"
"<i>Writethrough</i> ການອ່ານຈະຖືກເກັບໃນ cache, ການຂຽນຈະເຮັດໄປພ້ອມໆກັນທັງສອງອຸປະກອນ. ຂໍ້ມູ"
"ນຈະບໍ່ສູນຫາຍຫາກ caching device ເພ. ນີ້ແມ່ນໂໝດເລີ່ມຕົ້ນ.</li><li><i>Writeback</i> ທັງການອ່"
"ານ ແລະ ການຂຽນຈະຖືກເກັບໃນ cache. ນີ້ຈະຊ່ວຍໃຫ້ປະສິດທິພາບການຂຽນດີຂຶ້ນ.</li><li><i>"
"Writearound</i> ການອ່ານຈະຖືກເກັບໃນ cache, ຂໍ້ມູນໃໝ່ຈະຖືກຂຽນລົງໃນ backing device ເທົ່ານັ້"
"ນ.</li><li><i>None</i> ໝາຍເຖິງບໍ່ໃຊ້ cache ທັງການອ່ານ ແລະ ການຂຽນ. ນີ້ມີປະໂຫຍດໃນການປິດໃຊ້"
"ງານ cache ຊົ່ວຄາວກ່ອນທີ່ຈະມີການອ່ານ ຫຼື ຂຽນຂໍ້ມູນຂະໜາດໃຫຍ່ຕໍ່ເນື່ອງ, ບໍ່ດັ່ງນັ້ນມັນອາດຈະເຮັດໃຫ້ມີການຂຽນທັ"
"ບໃນ cache device ຫຼາຍເກີນໄປ.</li></p>"

