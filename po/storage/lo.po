#. All boot warnings detected in the setup, for example, when required partition is too small
#.
#. @note This method should be overloaded for derived classes.
#.
#. @see SetupError
#.
#. @return [Array<SetupError>]
#: src/lib/y2storage/boot_requirements_strategies/base.rb:90
msgid ""
"The grub boot loader cannot access the file system mounted at /boot. Only "
"LUKS1 and LUKS2 with PBKDF2 encryption is supported. Another boot loader can "
"be selected in the boot loader section, for example systemd_boot or "
"grub2_bls."
msgstr ""
"ຕົວໂຫຼດບູດ grub ບໍ່ສາມາດເຂົ້າເຖິງລະບົບໄຟລ໌ທີ່ mount ຢູ່ /boot ໄດ້. ຮອງຮັບສະເພາະການເຂົ້າລະຫັດ "
"LUKS1 ແລະ LUKS2 ດ້ວຍ PBKDF2 ເທົ່ານັ້ນ. ເຈົ້າສາມາດເລືອກຕົວໂຫຼດບູດອື່ນໄດ້ໃນພາກສ່ວນຕົວໂຫຼດບູດ, ເຊັ່"
"ນ systemd_boot ຫຼື grub2_bls."

#: src/lib/y2storage/boot_requirements_strategies/base.rb:100
msgid ""
"The device mounted at '/boot' should not be in a thinly provisioned LVM VG."
msgstr "ອຸປະກອນທີ່ mount ຢູ່ '/boot' ບໍ່ຄວນຢູ່ໃນ LVM VG ແບບ thinly provisioned."

#: src/lib/y2storage/boot_requirements_strategies/base.rb:106
msgid "The device mounted at '/boot' should not be in a BCache."
msgstr "ອຸປະກອນທີ່ mount ຢູ່ '/boot' ບໍ່ຄວນຢູ່ໃນ BCache."

#. All fatal boot errors detected in the setup, for example, when a / partition
#. is missing
#.
#. @note errors must be raised only in those scenarios making the installation impossible.
#. For any other circumstance please use {#warnings} instead.
#.
#. @note This method can be overloaded for derived classes.
#.
#. @see SetupError
#.
#. @return [Array<SetupError>]
#: src/lib/y2storage/boot_requirements_strategies/base.rb:135
msgid "There is no device mounted at '/'"
msgstr "ບໍ່ມີອຸປະກອນໃດຖືກ mount ຢູ່ '/'"

#: src/lib/y2storage/boot_requirements_strategies/base.rb:141
msgid ""
"The device mounted at '/boot' does not have enough space to contain a kernel."
msgstr "ອຸປະກອນທີ່ mount ຢູ່ '/boot' ມີພື້ນທີ່ບໍ່ພຽງພໍທີ່ຈະເກັບເຄີເນລ (kernel)."

#. TRANSLATORS: error message
#: src/lib/y2storage/boot_requirements_strategies/base.rb:227
msgid ""
"Boot requirements cannot be determined because there is no '/' mount point"
msgstr "ບໍ່ສາມາດກຳນົດຄວາມຕ້ອງການການບູດໄດ້ ເພາະບໍ່ມີຈຸດ mount '/'"

#. TRANSLATORS: error message
#: src/lib/y2storage/boot_requirements_strategies/legacy.rb:232
msgid "Boot disk has no partition table."
msgstr "ດິດບູດບໍ່ມີຕາຕະລາງພາທິຊັນ."

#. TRANSLATORS: error message; %s is a human readable disk size like 256 KiB
#: src/lib/y2storage/boot_requirements_strategies/legacy.rb:244
#, c-format
msgid ""
"Not enough space before the first partition to install the bootloader. Leave "
"at least %s."
msgstr ""
"ພື້ນທີ່ກ່ອນພາທິຊັນທຳອິດບໍ່ພຽງພໍທີ່ຈະຕິດຕັ້ງຕົວໂຫຼດບູດ. ຕ້ອງມີຢ່າງໜ້ອຍ %s."

#. TRANSLATORS: %s is a partition type, e.g. "BIOS Boot"
#: src/lib/y2storage/boot_requirements_strategies/legacy.rb:259
#, c-format
msgid "A partition of type %s is needed to install the bootloader."
msgstr "ຈຳເປັນຕ້ອງມີພາທິຊັນປະເພດ %s ເພື່ອຕິດຕັ້ງຕົວໂຫຼດບູດ."

#. Specific warning when the current setup is not supported
#.
#. @return [SetupError]
#: src/lib/y2storage/boot_requirements_strategies/legacy.rb:269
msgid ""
"Such a setup is not supported and may cause problems with the bootloader now "
"or in the future."
msgstr ""
"ການຕັ້ງຄ່າແບບນີ້ບໍ່ໄດ້ຮັບການຮອງຮັບ ແລະ ອາດເຮັດໃຫ້ເກີດບັນຫາກັບຕົວໂຫຼດບູດໃນຕອນນີ້ ຫຼື ໃນອະນາຄົດ."

#. Specific error when we are quite sure the current setup will not work
#.
#. @return [SetupError]
#: src/lib/y2storage/boot_requirements_strategies/legacy.rb:280
msgid "It will not be possible to install the bootloader."
msgstr "ຈະບໍ່ສາມາດຕິດຕັ້ງຕົວໂຫຼດບູດໄດ້."

#. TRANSLATORS: %s is single or list of partitions that are too big.
#: src/lib/y2storage/boot_requirements_strategies/prep.rb:82
#, c-format
msgid "The following PReP partition is too big: %s. "
msgid_plural "The following PReP partitions are too big: %s."
msgstr[0] "ພາທິຊັນ PReP ຕໍ່ໄປນີ້ໃຫຍ່ເກີນໄປ: %s. "
msgstr[1] "ພາທິຊັນ PReP ຕໍ່ໄປນີ້ໃຫຍ່ເກີນໄປ: %s."

#. TRANSLATORS: %s is human readable partition size like 8 MiB.
#: src/lib/y2storage/boot_requirements_strategies/prep.rb:90
#, c-format
msgid ""
"Some firmwares can fail to load PReP partitions bigger than %s and thus "
"prevent booting."
msgstr ""
"ເຟີມແວບາງອັນອາດຈະບໍ່ສາມາດໂຫຼດພາທິຊັນ PReP ທີ່ໃຫຍ່ກວ່າ %s ໄດ້ ເຊິ່ງຈະເຮັດໃຫ້ບູດບໍ່ໄດ້."

#. Missing EFI does not need to be a fatal (e.g. when boot from network).
#. User just has to not select grub2-efi bootloader.
#: src/lib/y2storage/boot_requirements_strategies/uefi.rb:70
msgid "EFI System Partition cannot be encrypted."
msgstr "ພາທິຊັນລະບົບ EFI ບໍ່ສາມາດເຂົ້າລະຫັດໄດ້."

#: src/lib/y2storage/boot_requirements_strategies/uefi.rb:75
msgid "EFI System Partition cannot be on LVM."
msgstr "ພາທິຊັນລະບົບ EFI ບໍ່ສາມາດຢູ່ເທິງ LVM ໄດ້."

#: src/lib/y2storage/boot_requirements_strategies/uefi.rb:81
msgid ""
"EFI System Partition is on a software RAID1. That setup is not guaranteed to "
"boot in all cases."
msgstr ""
"ພາທິຊັນລະບົບ EFI ຢູ່ເທິງຊອບແວ RAID1. ການຕັ້ງຄ່າດັ່ງກ່າວບໍ່ຮັບປະກັນການບູດໄດ້ໃນທຸກກໍລະນີ."

#: src/lib/y2storage/boot_requirements_strategies/uefi.rb:86
msgid "EFI System Partition cannot be on software RAID."
msgstr "ພາທິຊັນລະບົບ EFI ບໍ່ສາມາດຢູ່ເທິງຊອບແວ RAID ໄດ້."

#. TRANSLATORS: error message
#: src/lib/y2storage/boot_requirements_strategies/zipl.rb:107
msgid ""
"Looks like the system is going to be installed on an LDL device.\n"
"Booting from such device is not supported."
msgstr ""
"ເບິ່ງຄືວ່າລະບົບກຳລັງຈະຖືກຕິດຕັ້ງລົງໃນອຸປະກອນ LDL.\n"
"ບໍ່ຮອງຮັບການບູດຈາກອຸປະກອນດັ່ງກ່າວ."

