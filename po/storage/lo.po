msgstr "ເຊື່ອມຕໍ່ແບບ&ອ່ານຢ່າງດຽວ"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:509
msgid ""
"<p><b>Mount Read-Only:</b>\n"
"Writing to the file system is not possible. Default is false. During "
"installation\n"
"the file system is always mounted read-write.</p>"
msgstr ""
"<p><b>ເຊື່ອມຕໍ່ແບບອ່ານຢ່າງດຽວ:</b>\n"
"ຈະບໍ່ສາມາດຂຽນຂໍ້ມູນລົງໃນລະບົບໄຟລ໌ໄດ້. ຄ່າມາດຕະຖານແມ່ນ ບໍ່ (false). ໃນລະຫວ່າງການຕິດຕັ້ງ\n"
"ລະບົບໄຟລ໌ຈະຖືກເຊື່ອມຕໍ່ແບບອ່ານ-ຂຽນສະເໝີ.</p>"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:523
msgid "Mountable by User"
msgstr "ຜູ້ໃຊ້ສາມາດເຊື່ອມຕໍ່ໄດ້"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:528
msgid ""
"<p><b>Mountable by User:</b>\n"
"The file system may be mounted by an ordinary user. Default is false.</p>\n"
msgstr ""
"<p><b>ຜູ້ໃຊ້ສາມາດເຊື່ອມຕໍ່ໄດ້:</b>\n"
"ລະບົບໄຟລ໌ອາດຖືກເຊື່ອມຕໍ່ໂດຍຜູ້ໃຊ້ທົ່ວໄປ. ຄ່າມາດຕະຖານແມ່ນ ບໍ່ (false).</p>\n"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:542
msgid "Enable &Quota Support"
msgstr "ເປີດໃຊ້ການຮອງຮັບ&ໂຄວຕາ"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:547
msgid ""
"<p><b>Enable Quota Support:</b>\n"
"The file system is mounted with user quotas enabled.\n"
"Default is false.</p>"
msgstr ""
"<p><b>ເປີດໃຊ້ການຮອງຮັບໂຄວຕາ:</b>\n"
"ລະບົບໄຟລ໌ຈະຖືກເຊື່ອມຕໍ່ໂດຍເປີດໃຊ້ໂຄວຕາຜູ້ໃຊ້.\n"
"ຄ່າມາດຕະຖານແມ່ນ ບໍ່ (false).</p>"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:657
msgid "Data &Journaling Mode"
msgstr "ໂໝດ &Journaling ຂອງຂໍ້ມູນ"

#: src/lib/y2partitioner/widgets/fstab_options.rb:666
msgid "journal"
msgstr "journal"

#: src/lib/y2partitioner/widgets/fstab_options.rb:667
msgid "ordered"
msgstr "ordered"

#: src/lib/y2partitioner/widgets/fstab_options.rb:668
msgid "writeback"
msgstr "writeback"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:680
msgid ""
"<p><b>Data Journaling Mode:</b>\n"
"Specifies the journaling mode for file data.\n"
"<tt>journal</tt> -- All data is committed to the journal prior to being\n"
"written into the main file system. Highest performance impact.<br>\n"
"<tt>ordered</tt> -- All data is forced directly out to the main file system\n"
"prior to its metadata being committed to the journal. Medium performance "
"impact.<br>\n"
"<tt>writeback</tt> -- Data ordering is not preserved. No performance impact."
"</p>\n"
msgstr ""
"<p><b>ໂໝດ Data Journaling:</b>\n"
"ກຳນົດໂໝດ journaling ສຳລັບຂໍ້ມູນໄຟລ໌.\n"
"<tt>journal</tt> -- ຂໍ້ມູນທັງໝົດຈະຖືກບັນທຶກລົງ journal ກ່ອນທີ່ຈະ\n"
"ຂຽນລົງໃນລະບົບໄຟລ໌ຫຼັກ. ມີຜົນກະທົບຕໍ່ປະສິດທິພາບສູງສຸດ.<br>\n"
"<tt>ordered</tt> -- ຂໍ້ມູນທັງໝົດຈະຖືກສົ່ງໄປທີ່ລະບົບໄຟລ໌ຫຼັກໂດຍກົງ\n"
"ກ່ອນທີ່ເມຕາເດຕາຈະຖືກບັນທຶກລົງ journal. ມີຜົນກະທົບຕໍ່ປະສິດທິພາບປານກາງ.<br>\n"
"<tt>writeback</tt> -- ບໍ່ຮັກສາລຳດັບຂໍ້ມູນ. ບໍ່ມີຜົນກະທົບຕໍ່ປະສິດທິພາບ.</p>\n"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:712
msgid "Arbitrary Option &Value"
msgstr "&ຄ່າຕົວເລືອກຕາມໃຈ"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:740
msgid ""
"<p><b>Arbitrary Option Value:</b> Enter any other mount options here, "
"separated with commas. Notice that this does not do any checking, so be "
"careful what you enter here!<br>If you want to have utf8 encoded filenames "
"with limited case-insensitivity then add 'utf8' here and leave the Charset "
"for File Names field empty.</p>"
msgstr ""
"<p><b>ຄ່າຕົວເລືອກຕາມໃຈ:</b> ປ້ອນຕົວເລືອກການເຊື່ອມຕໍ່ອື່ນໆທີ່ນີ້, ແຍກດ້ວຍຈຸດ. ກະລຸນາຮັບຊາບວ່າຈະບໍ່ມີກາ"
"ນກວດສອບໃດໆ, ສະນັ້ນຄວນລະວັງສິ່ງທີ່ທ່ານປ້ອນທີ່ນີ້!<br>ຫາກທ່ານ ຕ້ອງການໃຫ້ຊື່ໄຟລ໌ເຂົ້າລະຫັດແບບ utf8 ໂດຍ"
"ໃຫ້ມີການແຍກອັກສອນຕົວພິມໃຫຍ່-ນ້ອຍແບບຈຳກັດ ໃຫ້ຕື່ມ 'utf8' ທີ່ນີ້ ແລະ ປະຊ່ອງຊຸດຕົວອັກສອນສຳລັບຊື່ໄຟລ໌ໃຫ້ວ່"
"າງໄວ້.</p>"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:829
msgid "Swap &Priority"
msgstr "ລຳດັບຄວາມສຳຄັນຂອງ &Swap"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:840
msgid ""
"<p><b>Swap Priority:</b>\n"
"Enter the swap priority. Higher numbers mean higher priority.</p>\n"
msgstr ""
"<p><b>ລຳດັບຄວາມສຳຄັນຂອງ Swap:</b>\n"
"ປ້ອນລຳດັບຄວາມສຳຄັນຂອງ swap. ຕົວເລກຫຼາຍໝາຍເຖິງຄວາມສຳຄັນສູງ.</p>\n"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:860
msgid "Max Size"
msgstr "ຂະໜາດສູງສຸດ"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:875
msgid ""
"The size must be a number,\n"
"optionally followed by a unit (k, m or g) or by a percent sign (%)."
msgstr ""
"ຂະໜາດຕ້ອງເປັນຕົວເລກ,\n"
"ຕາມດ້ວຍຫົວໜ່ວຍ (k, m ຫຼື g) ຫຼື ເຄື່ອງໝາຍເປີເຊັນ (%) ກໍໄດ້."

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:886
msgid ""
"<p><b>Max Size:</b>\n"
"Upper limit on the size of the file system. The size is given in bytes by "
"default, optionally followed by a <b>k</b>, <b>m</b> or <b>g</b> suffix to "
"specify KiB, MiB or GiB. The size may also have a <b>% </b> suffix to limit "
"this instance to a percentage of physical RAM. The default, when neither "
"this option nor nr_blocks is specified, is 50%.</p>\n"
msgstr ""
"<p><b>ຂະໜາດສູງສຸດ:</b>\n"
"ຂີດຈຳກັດສູງສຸດຂອງຂະໜາດລະບົບໄຟລ໌. ຂະໜາດຈະເປັນໄບຕ໌ໂດຍມາດຕະຖານ, ສາມາດຕາມດ້ວຍ <b>k</b>, "
"<b>m</b> ຫຼື <b>g</b> ເພື່ອກຳນົດເປັນ KiB, MiB ຫຼື GiB. ຂະໜາດອາດມີເຄື່ອງໝາຍ <b>% </b> ຕໍ່ທ້າ"
"ຍເພື່ອຈຳກັດໃຫ້ເປັນເປີເຊັນຂອງ RAM. ຄ່າມາດຕະຖານແມ່ນ 50% ຫາກບໍ່ໄດ້ກຳນົດຕົວເລືອກນີ້ ຫຼື nr_blocks ໄ"
"ວ້.</p>\n"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:928
msgid "Char&set for File Names"
msgstr "&ຊຸດຕົວອັກສອນສຳລັບຊື່ໄຟລ໌"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:933
msgid ""
"<p><b>Charset for File Names:</b>\n"
"Set the charset used for display of file names in Windows partitions.<br>\n"
"Note that choosing 'utf8' here will implicitly make filename comparison case-"
"sensitve.<br>\n"
"To avoid this, leave this field empty and instead add 'utf8' to the "
"Arbitrary Option Value field.</p>\n"
msgstr ""
"<p><b>ຊຸດຕົວອັກສອນສຳລັບຊື່ໄຟລ໌:</b><br>\n"
"ກຳນົດຊຸດຕົວອັກສອນທີ່ໃຊ້ໃນການສະແດງຜົນຂອງຊື່ໄຟລ໌ໃນພາທິຊັນ Windows.<br>\n"
"ໝາຍເຫດ: ການເລືອກ 'utf8' ຢູ່ທີ່ນີ້ຈະເຮັດໃຫ້ການປຽບທຽບຊື່ໄຟລ໌ມີການແຍກຕົວອັກສອນນ້ອຍ-ໃຫຍ່.<br>\n"
"ເພື່ອຫຼີກລ່ຽງບັນຫານີ້, ໃຫ້ປະຊ່ອງນີ້ຫວ່າງໄວ້ ແລະ ໃຫ້ເພີ່ມ 'utf8' ເຂົ້າໃນຊ່ອງ Arbitrary Option "
"Value ແທນ.</p>\n"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:958
msgid "Code&page for Short FAT Names"
msgstr "Code&page ສຳລັບຊື່ FAT ແບບສັ້ນ"

#. @macro seeAbstractWidget
#: src/lib/y2partitioner/widgets/fstab_options.rb:963
msgid ""
"<p><b>Codepage for Short FAT Names:</b>\n"
"This codepage is used for converting to shortname characters on FAT file "
"systems.</p>\n"
msgstr ""
"<p><b>Codepage ສຳລັບຊື່ FAT ແບບສັ້ນ:</b>\n"
"Codepage ນີ້ໃຊ້ສຳລັບແປງຕົວອັກສອນຊື່ແບບສັ້ນໃນລະບົບໄຟລ໌ FAT.</p>\n"

#. Checks whether the mount points of the selected fstab can be imported
#.
#. It shows a popup with the errors detected in the selected fstab.
#.
#. @see Actions::Controllers::Fstabs#selected_fstab_errors
#.
#. @return [Boolean]
#. so only warnings there
#. FIXME: improve Yast2::Popup to allow some text before the buttons
#: src/lib/y2partitioner/widgets/fstab_selector.rb:71
#: src/lib/y2partitioner/widgets/overview.rb:195
msgid "Do you want to continue?"
msgstr "ທ່ານຕ້ອງການສືບຕໍ່ຫຼືບໍ່?"

#. @return [String]
#: src/lib/y2partitioner/widgets/fstab_selector.rb:97
msgid ""
"<p>YaST has scanned your hard disks and found one or several existing Linux "
"systems with mount points. The old mount points are shown in the table.</p>"
msgstr ""
"<p>YaST ໄດ້ສະແກນຮາດດິດຂອງທ່ານ ແລະ ພົບລະບົບ Linux ທີ່ມີຢູ່ແລ້ວໜຶ່ງ ຫຼື ຫຼາຍລະບົບ ພ້ອມກັບຈຸດເຊື່ອມຕໍ່. "
"ຈຸດເຊື່ອມຕໍ່ເກົ່າຖືກສະແດງຢູ່ໃນຕາຕະລາງ.</p>"

#. Button to go to the previous fstab file
#.
#. @return [Yast::UI::Term]
#: src/lib/y2partitioner/widgets/fstab_selector.rb:126
msgid "Show &Previous"
msgstr "ສະແດງອັນ&ກ່ອນໜ້າ"

#. Button to go to the next fstab file
#.
#. @return [Yast::UI::Term]
#: src/lib/y2partitioner/widgets/fstab_selector.rb:133
msgid "Show &Next"
msgstr "ສະແດງອັນ&ຖັດໄປ"

#. TRANSLATORS: %{device_name} is replaced by the name of a device (e.g., /dev/sda1)
#: src/lib/y2partitioner/widgets/fstab_selector.rb:219
#, perl-brace-format
msgid "/etc/fstab found on %{device_name} contains:"
msgstr "ພົບ /etc/fstab ໃນ %{device_name} ເຊິ່ງປະກອບດ້ວຍ:"

#. helptexts for table column and overview entry
#: src/lib/y2partitioner/widgets/help.rb:37
msgid ""
"<b>BIOS ID</b> shows the BIOS ID of the hard\n"
"disk. This field can be empty."
msgstr ""
"<b>BIOS ID</b> ສະແດງ BIOS ID ຂອງຮາດ\n"
"ດິດ. ຊ່ອງນີ້ອາດວ່າງເປົ່າໄດ້."

#: src/lib/y2partitioner/widgets/help.rb:40
msgid ""
"<b>Excl. Size</b> shows the size of the exclusive space\n"
"of the BtrFS subvolume. This is the space that would be\n"
"freed by deleting the subvolume. Known and displayed only\n"
"if quotas were active for the corresponding BtrFS file\n"
"system during the hardware detection."
msgstr ""
"<b>ຂະໜາດສະເພາະ</b> ສະແດງຂະໜາດຂອງພື້ນທີ່ສະເພາະ\n"
"ຂອງວໍລຸມຍ່ອຍ BtrFS. ນີ້ຄືພື້ນທີ່ທີ່ຈະໄດ້ຮັບຄືນ\n"
"ຈາກການລຶບວໍລຸມຍ່ອຍ. ຈະຮູ້ ແລະ ສະແດງຜົນກໍຕໍ່ເມື່ອ\n"
"ມີການເປີດໃຊ້ໂຄວຕາສຳລັບລະບົບໄຟລ໌ BtrFS ນັ້ນ\n"
"ໃນລະຫວ່າງການກວດຫາຮາດແວ."

#: src/lib/y2partitioner/widgets/help.rb:46
msgid ""
"<b>Ref. Size</b> shows the size of the referenced space\n"
"of the BtrFS subvolume. This is the total size of all files\n"
"in the subvolume. Known and displayed only if quotas were\n"
"active for the corresponding BtrFS file system during the\n"
"hardware detection."
msgstr ""
"<b>ຂະໜາດອ້າງອີງ</b> ສະແດງຂະໜາດຂອງພື້ນທີ່ອ້າງອີງ\n"
"ຂອງວໍລຸມຍ່ອຍ BtrFS. ນີ້ຄືຂະໜາດລວມຂອງໄຟລ໌ທັງໝົດ\n"
"ໃນວໍລຸມຍ່ອຍ. ຈະຮູ້ ແລະ ສະແດງຜົນກໍຕໍ່ເມື່ອມີການເປີດ\n"
"ໃຊ້ໂຄວຕາສຳລັບລະບົບໄຟລ໌ BtrFS ນັ້ນໃນລະຫວ່າງການ\n"
"ກວດຫາຮາດແວ."

#: src/lib/y2partitioner/widgets/help.rb:52
msgid ""
"<b>Size Limit</b> shows the max size of the referenced\n"
"space for the BtrFS subvolume, if BtrFS quotas are active in\n"
"the corresponding BtrFS file system."
msgstr ""
"<b>ຂີດຈຳກັດຂະໜາດ</b> ສະແດງຂະໜາດສູງສຸດຂອງພື້ນທີ່ອ້າງອີງ\n"
"ສຳລັບວໍລຸມຍ່ອຍ BtrFS, ຫາກມີການເປີດໃຊ້ໂຄວຕາ BtrFS ໃນ\n"
"ລະບົບໄຟລ໌ BtrFS ທີ່ກ່ຽວຂ້ອງ."

#: src/lib/y2partitioner/widgets/help.rb:56
msgid ""
"<b>Bus</b> shows how the device is connected to\n"
"the system. This field can be empty, e.g. for multipath disks."
msgstr ""
"<b>Bus</b> ສະແດງວິທີທີ່ອຸປະກອນເຊື່ອມຕໍ່ກັບ\n"
"ລະບົບ. ຊ່ອງນີ້ອາດວ່າງໄດ້, ເຊັ່ນ ສຳລັບດິດ multipath."

#: src/lib/y2partitioner/widgets/help.rb:59
msgid ""
"<b>Chunk Size</b> shows the chunk size for RAID\n"
"devices."
msgstr ""
"<b>ຂະໜາດ Chunk</b> ສະແດງຂະໜາດ chunk ສຳລັບອຸປະກອນ\n"
"RAID."

#: src/lib/y2partitioner/widgets/help.rb:61
msgid ""
"<b>Cylinder Size</b> shows the size of the\n"
"cylinders of the hard disk."
msgstr ""
"<b>ຂະໜາດ Cylinder</b> ສະແດງຂະໜາດຂອງ\n"
"ໄຊລິນເດີ (cylinder) ຂອງຮາດດິດ."

#: src/lib/y2partitioner/widgets/help.rb:64
msgid "<b>Number of Sectors</b> shows how many sectors the hard disk has."
msgstr "<b>ຈຳນວນເຊັກເຕີ</b> ສະແດງວ່າຮາດດິດມີຈັກເຊັກເຕີ (sector)."

#: src/lib/y2partitioner/widgets/help.rb:67
msgid ""
"<b>Sector Size</b> shows the size of the\n"
"sectors of the hard disk."
msgstr ""
"<b>ຂະໜາດເຊັກເຕີ</b> ສະແດງຂະໜາດຂອງ\n"
"ເຊັກເຕີຂອງຮາດດິດ."

#: src/lib/y2partitioner/widgets/help.rb:70
msgid ""
"<b>Device</b> shows the name to identify the device, e.g. the kernel name "
"when it applies."
msgstr ""
"<b>ອຸປະກອນ</b> ສະແດງຊື່ເພື່ອລະບຸອຸປະກອນ, ເຊັ່ນ ຊື່ເຄີເນິລ (kernel name)."

#: src/lib/y2partitioner/widgets/help.rb:73
msgid ""
"<b>Partition Table</b> shows the partition table\n"
"type of the disk, e.g <tt>MS-DOS</tt> or <tt>GPT</tt>."
msgstr ""
"<b>ຕາຕະລາງພາທິຊັນ</b> ສະແດງປະເພດຕາຕະລາງພາທິຊັນ\n"
"ຂອງດິດ, ເຊັ່ນ <tt>MS-DOS</tt> ຫຼື <tt>GPT</tt>."

#: src/lib/y2partitioner/widgets/help.rb:76
msgid ""
"<b>Encrypted</b> shows whether the device is\n"
"encrypted."
msgstr ""
"<b>ເຂົ້າລະຫັດແລ້ວ</b> ສະແດງວ່າອຸປະກອນຖືກ\n"
"ເຂົ້າລະຫັດຫຼືບໍ່."

#: src/lib/y2partitioner/widgets/help.rb:78
msgid ""
"<b>End</b> shows the end block of\n"
"the partition."
msgstr ""
"<b>ສິ້ນສຸດ</b> ສະແດງບລັອກສິ້ນສຸດຂອງ\n"
"ພາທິຊັນ."

#: src/lib/y2partitioner/widgets/help.rb:80
msgid ""
"<b>LUN</b> shows the Logical Unit Number for\n"
"Fibre Channel disks."
msgstr ""
"<b>LUN</b> ສະແດງໝາຍເລກ Logical Unit ສຳລັບ\n"
"ດິດ Fibre Channel."

#: src/lib/y2partitioner/widgets/help.rb:83
msgid ""
"<b>Port ID</b> shows the port id for Fibre\n"
"Channel disks."
msgstr ""
"<b>Port ID</b> ສະແດງ port id ສຳລັບດິດ Fibre\n"
"Channel."

#: src/lib/y2partitioner/widgets/help.rb:85
msgid ""
"<b>WWPN</b> shows the World Wide Port Name for\n"
"Fibre Channel disks."
msgstr ""
"<b>WWPN</b> ສະແດງ World Wide Port Name ສຳລັບ\n"
"ດິດ Fibre Channel."

#: src/lib/y2partitioner/widgets/help.rb:88
msgid ""
"<b>File Path</b> shows the path of the file for\n"
"an encrypted loop device."
msgstr ""
"<b>ເສັ້ນທາງໄຟລ໌</b> ສະແດງເສັ້ນທາງຂອງໄຟລ໌ສຳລັບ\n"
"ອຸປະກອນ loop ທີ່ເຂົ້າລະຫັດ."

#: src/lib/y2partitioner/widgets/help.rb:91
msgid ""
"<b>Format</b> shows some flags: <tt>F</tt>\n"
"means the device is selected to be formatted."
msgstr ""
"<b>ຟໍແມັດ</b> ສະແດງບາງເຄື່ອງໝາຍ: <tt>F</tt>\n"
"ໝາຍເຖິງອຸປະກອນຖືກເລືອກເພື່ອຟໍແມັດ."

#: src/lib/y2partitioner/widgets/help.rb:94
msgid "<b>Partition ID</b> shows the partition id."
msgstr "<b>ID ຂອງພາທິຊັນ</b> ສະແດງ id ຂອງພາທິຊັນ."

#: src/lib/y2partitioner/widgets/help.rb:96
msgid "<b>FS Type</b> shows the file system type."
msgstr "<b>ປະເພດ FS</b> ສະແດງປະເພດລະບົບໄຟລ໌."

#: src/lib/y2partitioner/widgets/help.rb:98
msgid ""
"<b>Label</b> shows the label of the file\n"
"system."
msgstr ""
"<b>ປ້າຍຊື່</b> ສະແດງປ້າຍຊື່ຂອງລະບົບ\n"
"ໄຟລ໌."

#: src/lib/y2partitioner/widgets/help.rb:100
msgid ""
"<b>Metadata</b> shows the LVM metadata type for\n"
"volume groups."
msgstr ""
"<b>ເມຕາເດຕາ</b> ສະແດງປະເພດເມຕາເດຕາ LVM ສຳລັບ\n"
"ກຸ່ມວໍລຸມ (volume groups)."

#: src/lib/y2partitioner/widgets/help.rb:103
msgid "<b>Model</b> shows the device model."
msgstr "<b>ລຸ້ນ (Model)</b> ສະແດງລຸ້ນຂອງອຸປະກອນ."

#: src/lib/y2partitioner/widgets/help.rb:105
msgid ""
"<b>Mount by</b> indicates how the file system\n"
"is mounted: (Kernel) by kernel name, (Label) by file system label, (UUID) "
"by\n"
" file system UUID, (ID) by device ID, and (Path) by device path.\n"
msgstr ""
"<b>ເຊື່ອມຕໍ່ໂດຍ (Mount by)</b> ລະບຸວິທີການເຊື່ອມຕໍ່ລະບົບໄຟລ໌:\n"
"(Kernel) ຕາມຊື່ເຄີເນິລ, (Label) ຕາມປ້າຍຊື່ລະບົບໄຟລ໌, (UUID) ຕາມ\n"
"UUID ຂອງລະບົບໄຟລ໌, (ID) ຕາມ ID ອຸປະກອນ, ແລະ (Path) ຕາມເສັ້ນທາງອຸປະກອນ.\n"

#: src/lib/y2partitioner/widgets/help.rb:110
msgid ""
"<b>Mount Options</b> shows the options used to mount the volume, typically "
"specified at <tt>/etc/fstab</tt>."
msgstr ""
"<b>ຕົວເລືອກການເຊື່ອມຕໍ່</b> ສະແດງຕົວເລືອກທີ່ໃຊ້ເຊື່ອມຕໍ່ວໍລຸມ, ປົກກະຕິແລ້ວຈະລະບຸໄວ້ທີ່ <tt>/etc/"
"fstab</tt>."

#: src/lib/y2partitioner/widgets/help.rb:113
msgid ""
"<b>Mount Point</b> shows where the file system\n"
"is mounted."
msgstr ""
"<b>ຈຸດເຊື່ອມຕໍ່</b> ສະແດງບ່ອນທີ່ລະບົບໄຟລ໌\n"
"ຖືກເຊື່ອມຕໍ່."

#: src/lib/y2partitioner/widgets/help.rb:115
msgid ""
"<b>Number of Cylinders</b> shows how many\n"
"cylinders the hard disk has."
msgstr ""
"<b>ຈຳນວນໄຊລິນເດີ</b> ສະແດງວ່າຮາດດິດມີ\n"
"ຈັກໄຊລິນເດີ (cylinders)."

#: src/lib/y2partitioner/widgets/help.rb:118
msgid ""
"<b>Parity Algorithm</b> shows the parity\n"
"algorithm for RAID devices with RAID type 5, 6 or 10."
msgstr ""
"<b>ອັລກໍຣິທຶມ Parity</b> ສະແດງອັລກໍຣິທຶມ parity\n"
"ສຳລັບອຸປະກອນ RAID ປະເພດ 5, 6 ຫຼື 10."

#: src/lib/y2partitioner/widgets/help.rb:121
msgid ""
"<b>PE Size</b> shows the physical extent size\n"
"for LVM volume groups."
msgstr ""
"<b>ຂະໜາດ PE</b> ສະແດງຂະໜາດ physical extent\n"
"ສຳລັບກຸ່ມວໍລຸມ LVM."

#: src/lib/y2partitioner/widgets/help.rb:124
msgid "<b>RAID Version</b> shows the RAID version."
msgstr "<b>ເວີຊັນ RAID</b> ສະແດງເວີຊັນຂອງ RAID."

#: src/lib/y2partitioner/widgets/help.rb:126
msgid ""
"<b>RAID Type</b> shows the RAID type, also\n"
"called RAID level, for RAID devices."
msgstr ""
"<b>ປະເພດ RAID</b> ສະແດງປະເພດ RAID ຫຼື ທີ່ເອີ້ນວ່າ\n"
"ລະດັບ RAID, ສຳລັບອຸປະກອນ RAID."

#: src/lib/y2partitioner/widgets/help.rb:129
msgid "<b>Size</b> shows the size of the device."
msgstr "<b>ຂະໜາດ</b> ສະແດງຂະໜາດຂອງອຸປະກອນ."

#: src/lib/y2partitioner/widgets/help.rb:131
msgid ""
"<b>Start</b> shows the start block\n"
"of the partition."
msgstr ""
"<b>ເລີ່ມຕົ້ນ</b> ສະແດງບລັອກເລີ່ມຕົ້ນ\n"
"ຂອງພາທິຊັນ."

#: src/lib/y2partitioner/widgets/help.rb:133
msgid ""
"<b>Stripes</b> shows the stripe number for LVM\n"
"logical volumes and, if greater than one, the stripe size in parenthesis."
msgstr ""
"<b>Stripes</b> ສະແດງໝາຍເລກ stripe ສຳລັບວໍລຸມໂລຈິກຄໍ LVM\n"
"ແລະ ຫາກຫຼາຍກວ່າໜຶ່ງ, ຈະສະແດງຂະໜາດ stripe ໃນວົງເລັບ."

#: src/lib/y2partitioner/widgets/help.rb:137
msgid ""
"<b>Snapshots</b> shows the snapshots, if any, for an LVM logical volume."
msgstr "<b>ສະແນັບຊັອດ</b> ສະແດງສະແນັບຊັອດ (ຫາກມີ) ສຳລັບວໍລຸມໂລຈິກຄໍ LVM."

#: src/lib/y2partitioner/widgets/help.rb:140
msgid ""
"<b>Type</b> gives a general overview about the\n"
"device type."
msgstr ""
"<b>ປະເພດ</b> ໃຫ້ພາບລວມທົ່ວໄປກ່ຽວກັບ\n"
"ປະເພດຂອງອຸປະກອນ."

#: src/lib/y2partitioner/widgets/help.rb:142
msgid ""
"<b>Device ID</b> shows the persistent device\n"
"IDs. This field can be empty."
msgstr ""
"<b>ID ອຸປະກອນ</b> ສະແດງ ID ຂອງອຸປະກອນແບບຖາວອນ.\n"
"ຊ່ອງນີ້ອາດວ່າງໄດ້."

#: src/lib/y2partitioner/widgets/help.rb:145
msgid ""
"<b>Device Path</b> shows the persistent device\n"
"path. This field can be empty."
msgstr ""
"<b>ເສັ້ນທາງອຸປະກອນ</b> ສະແດງເສັ້ນທາງອຸປະກອນແບບຖາວອນ.\n"
"ຊ່ອງນີ້ອາດວ່າງໄດ້."

#: src/lib/y2partitioner/widgets/help.rb:148
msgid ""
"<b>Used By</b> shows if a device is used by\n"
"e.g. RAID or LVM. If not, this column is empty."
msgstr ""
"<b>ໃຊ້ໂດຍ</b> ສະແດງວ່າອຸປະກອນຖືກໃຊ້ໂດຍ\n"
"ເຊັ່ນ RAID ຫຼື LVM ຫຼື ບໍ່. ຫາກບໍ່ມີ, ຖັນນີ້ຈະວ່າງ."

#: src/lib/y2partitioner/widgets/help.rb:151
msgid ""
"<b>UUID</b> shows the Universally Unique\n"
"Identifier of the file system."
msgstr ""
"<b>UUID</b> ສະແດງລະຫັດ \n"
"UUID ຂອງລະບົບໄຟລ໌."

#: src/lib/y2partitioner/widgets/help.rb:154
msgid "<b>Vendor</b> shows the device vendor."
msgstr "<b>ຜູ້ຜະລິດ (Vendor)</b> ສະແດງຜູ້ຜະລິດອຸປະກອນ."

#: src/lib/y2partitioner/widgets/help.rb:156
msgid ""
"<b>Backing Device</b> shows the device used as backing device for bcache."
msgstr ""
"<b>ອຸປະກອນຮອງຮັບ</b> ສະແດງອຸປະກອນທີ່ໃຊ້ເປັນອຸປະກອນຮອງຮັບ (backing device) ສຳລັບ bcache."

#: src/lib/y2partitioner/widgets/help.rb:159
msgid ""
"<b>Caching UUID</b> shows the UUID of the used caching set. This field is "
"empty if no caching is used."
msgstr ""
"<b>UUID ການແຄຊ</b> ສະແດງ UUID ຂອງຊຸດການແຄຊທີ່ໃຊ້. ຊ່ອງນີ້ຈະວ່າງຫາກບໍ່ໄດ້ໃຊ້ການແຄຊ."

#: src/lib/y2partitioner/widgets/help.rb:162
msgid ""
"<b>Caching Device</b> shows the device used for caching. This field is empty "
"if no caching is used."
msgstr ""
"<b>ອຸປະກອນແຄຊ</b> ສະແດງອຸປະກອນທີ່ໃຊ້ສຳລັບການແຄຊ. ຊ່ອງນີ້ຈະວ່າງຫາກບໍ່ໄດ້ໃຊ້ການແຄຊ."

#: src/lib/y2partitioner/widgets/help.rb:165
msgid ""
"<b>Cache Mode</b> shows the operating mode for bcache. Currently there are "
"four supported modes: Writethrough, Writeback, Writearound and None."
msgstr ""
"<b>ໂໝດແຄຊ</b> ສະແດງໂໝດການເຮັດວຽກສຳລັບ bcache. ປະຈຸບັນມີ 4 ໂໝດທີ່ຮອງຮັບ: "
"Writethrough, Writeback, Writearound ແລະ None."

#: src/lib/y2partitioner/widgets/help.rb:169
msgid "<b>Journal Device</b> shows the device holding the external journal."
msgstr "<b>ອຸປະກອນ Journal</b> ສະແດງອຸປະກອນທີ່ເກັບ journal ພາຍນອກ."

#: src/lib/y2partitioner/widgets/help.rb:172
msgid ""
"<b>Devices</b> shows the kernel name of the devices used by a Btrfs file "
"system."
msgstr "<b>ອຸປະກອນ</b> ສະແດງຊື່ເຄີເນິລຂອງອຸປະກອນທີ່ໃຊ້ໂດຍລະບົບໄຟລ໌ Btrfs."

#: src/lib/y2partitioner/widgets/help.rb:175
msgid "<b>Metadata RAID Level</b> shows the RAID level for the Btrfs metadata."
msgstr "<b>ລະດັບ RAID ຂອງເມຕາເດຕາ</b> ສະແດງລະດັບ RAID ສຳລັບເມຕາເດຕາ Btrfs."

#: src/lib/y2partitioner/widgets/help.rb:178
msgid "<b>Data RAID Level</b> shows the RAID level for the Btrfs data."
msgstr "<b>ລະດັບ RAID ຂອງຂໍ້ມູນ</b> ສະແດງລະດັບ RAID ສຳລັບຂໍ້ມູນ Btrfs."

#: src/lib/y2partitioner/widgets/help.rb:180
msgid "<b>Server</b> shows host name or IP address of the NFS server."
msgstr "<b>ເຊີເວີ</b> ສະແດງຊື່ໂຮສ (host name) ຫຼື ທີ່ຢູ່ IP ຂອງເຊີເວີ NFS."

#: src/lib/y2partitioner/widgets/help.rb:182
msgid "<b>Remote Directory</b> shows the directory on the NFS server."
msgstr "<b>ໄດເຣັກທໍຣີປາຍທາງ</b> ສະແດງໄດເຣັກທໍຣີໃນເຊີເວີ NFS."

#: src/lib/y2partitioner/widgets/help.rb:184
msgid ""
"<b>NFS Version</b> shows the version of the protocol used to connect to the "
"server. It may happen that some NFS share is mounted using an old method to "
"specify the protocol version, like the usage of 'nfs4' as file system type "
"or the usage of 'minorversion' in the mount options. Those methods do not "
"longer work as they used to. So if such circumstance is detected, the real "
"used version is displayed next to a warning message. Those entries can be "
"edited to make sure they use more current ways of specifying the version."
msgstr ""
"<b>ເວີຊັນ NFS</b> ສະແດງເວີຊັນຂອງໂປຣໂຕຄໍທີ່ໃຊ້ເຊື່ອມຕໍ່ກັບເຊີເວີ. ອາດເປັນໄປໄດ້ວ່າບາງ NFS share ຖື"
"ກເຊື່ອມຕໍ່ໂດຍໃຊ້ວິທີເກົ່າເພື່ອລະບຸ ເວີຊັນຂອງໂປຣໂຕຄໍ, ເຊັ່ນ ການໃຊ້ 'nfs4' ເປັນປະເພດລະບົບໄຟລ໌ ຫຼື ການໃ"
"ຊ້ 'minorversion' ໃນຕົວເລືອກການເຊື່ອມຕໍ່. ວິທີການເຫຼົ່ານັ້ນ ບໍ່ສາມາດໃຊ້ໄດ້ອີກຕໍ່ໄປ. ດັ່ງນັ້ນ ຫາກກວດພົບສ"
"ະຖານະການດັ່ງກ່າວ, ເວີຊັນ ທີ່ໃຊ້ແທ້ຈິງຈະຖືກສະແດງຖັດຈາກຂໍ້ຄວາມເຕືອນ. ລາຍການເຫຼົ່ານັ້ນສາມາດ ແກ້ໄຂໄດ້ເພື່"
"ອໃຫ້ແນ່ໃຈວ່າພວກມັນໃຊ້ວິທີການລະບຸເວີຊັນທີ່ທັນສະໄໝກວ່າ."

#: src/lib/y2partitioner/widgets/help.rb:195
msgid ""
"An asterisk (*) after the mount point\n"
"indicates a file system that is currently not mounted (for example, because "
"it\n"
"has the <tt>noauto</tt> option set in <tt>/etc/fstab</tt>)."
msgstr ""
"ເຄື່ອງໝາຍດອກຈັນ (*) ຫຼັງຈຸດເຊື່ອມຕໍ່\n"
"ລະບຸເຖິງລະບົບໄຟລ໌ທີ່ບໍ່ໄດ້ເຊື່ອມຕໍ່ໃນປະຈຸບັນ (ຕົວຢ່າງ, ເພາະມັນ\n"
"ມີການຕັ້ງຄ່າຕົວເລືອກ <tt>noauto</tt> ໃນ <tt>/etc/fstab</tt>)."

#. help texts that are appended to the common help only in Mode.normal
#: src/lib/y2partitioner/widgets/help.rb:201
msgid ""
"A question mark (?) indicates that\n"
"the file system is not listed in <tt>/etc/fstab</tt>. It is either mounted\n"
"manually or by some automount system. When changing settings for this "
"volume\n"
"YaST will not update <tt>/etc/fstab</tt>.\n"
msgstr ""
"ເຄື່ອງໝາຍຄຳຖາມ (?) ລະບຸວ່າ\n"
"ລະບົບໄຟລ໌ບໍ່ໄດ້ຢູ່ໃນລາຍການຂອງ <tt>/etc/fstab</tt>. ມັນອາດຖືກເຊື່ອມຕໍ່\n"
"ດ້ວຍຕົນເອງ ຫຼື ໂດຍລະບົບເຊື່ອມຕໍ່ອັດຕະໂນມັດ. ເມື່ອປ່ຽນແປງການຕັ້ງຄ່າສຳລັບວໍລຸມນີ້\n"
"YaST ຈະບໍ່ອັບເດດ <tt>/etc/fstab</tt>.\n"

#. TRANSLATORS: button label to add a LVM volume group
#: src/lib/y2partitioner/widgets/lvm_buttons.rb:39
msgid "Add Volume Group..."
