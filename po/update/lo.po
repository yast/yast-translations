msgstr "ພາທິຊັນ ຫຼື ລະບົບທີ່ຈະບູດ:"

#. TRANSLATORS: help text for root partition dialog (for boot)
#: src/include/update/rootpart.rb:212
msgid ""
"<p>\n"
"Select the partition or system to boot.\n"
"</p>\n"
msgstr ""
"<p>\n"
"ເລືອກພາທິຊັນ ຫຼື ລະບົບທີ່ຈະບູດ.\n"
"</p>\n"

#. TRANSLATORS: label for selection of root partition (for update)
#: src/include/update/rootpart.rb:219
msgid "Partition or System to Update:"
msgstr "ພາທິຊັນ ຫຼື ລະບົບທີ່ຈະອັບເດດ:"

#. TRANSLATORS: help text for root partition dialog (for update)
#: src/include/update/rootpart.rb:222
msgid ""
"<p>\n"
"Select the partition or system to update.\n"
"</p>\n"
msgstr ""
"<p>\n"
"ເລືອກພາທິຊັນ ຫຼື ລະບົບທີ່ຈະອັບເດດ.\n"
"</p>\n"

#. TRANSLATORS: headline for dialog "Select for update"
#: src/include/update/rootpart.rb:230
msgid "Select for Update"
msgstr "ເລືອກສຳລັບການອັບເດດ"

#. TRANSLATORS: help text for root partition dialog (general part)
#: src/include/update/rootpart.rb:237
msgid ""
"<p>\n"
"<b>Show All Partitions</b> expands the list to a\n"
"general overview of your system's partitions.\n"
"</p>\n"
msgstr ""
"<p>\n"
"<b>ສະແດງພາທິຊັນທັງໝົດ</b> ຈະຂະຫຍາຍລາຍການໃຫ້ເປັນ\n"
"ພາບລວມທົ່ວໄປຂອງພາທິຊັນໃນລະບົບຂອງທ່ານ.\n"
"</p>\n"

#. TRANSLATORS: table header
#: src/include/update/rootpart.rb:257
msgid "System"
msgstr "ລະບົບ"

#. TRANSLATORS: table header item
#: src/include/update/rootpart.rb:259
msgid "Partition"
msgstr "ພາທິຊັນ"

#. TRANSLATORS: table header item
#: src/include/update/rootpart.rb:261
msgid "Architecture"
msgstr "ສະຖາປັດຕະຍະກຳ"

#. TRANSLATORS: table header item
#: src/include/update/rootpart.rb:263
msgid "File System"
msgstr "ລະບົບໄຟລ໌"

#. TRANSLATORS: table header item
#: src/include/update/rootpart.rb:265
msgid "Label"
msgstr "ປ້າຍຊື່"

#. TRANSLATORS: check box
#: src/include/update/rootpart.rb:275
msgid "&Show All Partitions"
msgstr "&ສະແດງພາທິຊັນທັງໝົດ"

#. TRANSLATORS: pushbutton to (rightaway) boot the system selected above
#: src/include/update/rootpart.rb:307
msgid "&Boot"
msgstr "&ບູດ"

#. TRANSLATORS: error message
#: src/include/update/rootpart.rb:377
msgid ""
"ReiserFS is not supported anymore.\n"
"Please migrate your data to another filesystem before performing the "
"upgrade.\n"
"\n"
msgstr ""
"ReiserFS ບໍ່ໄດ້ຮັບການຮອງຮັບອີກຕໍ່ໄປ.\n"
"ກະລຸນາຍ້າຍຂໍ້ມູນຂອງທ່ານໄປຍັງລະບົບໄຟລ໌ອື່ນກ່ອນທີ່ຈະດຳເນີນການອັບເກຣດ.\n"
"\n"

#. TRANSLATORS: error popup
#: src/include/update/rootpart.rb:384
msgid ""
"No installed system that can be upgraded with this product was found\n"
"on the selected partition."
msgstr ""
"ບໍ່ພົບລະບົບທີ່ຕິດຕັ້ງໄວ້ເຊິ່ງສາມາດອັບເກຣດດ້ວຍຜະລິດຕະພັນນີ້ໄດ້\n"
"ໃນພາທິຊັນທີ່ເລືອກ."

#. TRANSLATORS: continue-cancel popup
#: src/include/update/rootpart.rb:395
msgid ""
"The architecture of the system installed in the selected partition\n"
" is different from the one of this product.\n"
msgstr ""
"ສະຖາປັດຕະຍະກຳຂອງລະບົບທີ່ຕິດຕັ້ງໃນພາທິຊັນທີ່ເລືອກ\n"
" ແຕກຕ່າງຈາກສະຖາປັດຕະຍະກຳຂອງຜະລິດຕະພັນນີ້.\n"

#. TRANSLATORS: pop-up question
#: src/include/update/rootpart.rb:426
msgid ""
"A possibly incomplete installation has been detected on the selected "
"partition.\n"
"Are sure you want to use it anyway?"
msgstr ""
"ພົບການຕິດຕັ້ງທີ່ອາດຈະບໍ່ສົມບູນໃນພາທິຊັນທີ່ເລືອກ.\n"
"ທ່ານແນ່ໃຈຫຼືບໍ່ວ່າຕ້ອງການໃຊ້ມັນຕໍ່ໄປ?"

#. TRANSLATORS: button label
#: src/include/update/rootpart.rb:431
msgid "&Yes, Use It"
msgstr "&ແມ່ນແລ້ຍ, ໃຊ້ມັນ"

#. TRANSLATORS: error message
#. TRANSLATORS: error message
#: src/include/update/rootpart.rb:477 src/include/update/rootpart.rb:502
msgid ""
"Initializing the system for upgrade has failed for unknown reason.\n"
"It is highly recommended not to continue the upgrade process.\n"
"\n"
"Are you sure you want to continue?"
msgstr ""
"ການເລີ່ມຕົ້ນລະບົບສຳລັບການອັບເກຣດລົ້ມເຫຼວດ້ວຍເຫດຜົນທີ່ບໍ່ຮູ້ຈັກ.\n"
"ຂໍແນະນຳຢ່າງຍິ່ງວ່າບໍ່ຄວນດຳເນີນການຂະບວນການອັບເກຣດຕໍ່ໄປ.\n"
"\n"
"ທ່ານແນ່ໃຈຫຼືບໍ່ວ່າຕ້ອງການດຳເນີນການຕໍ່?"

#. TRANSLATORS: button label
#. TRANSLATORS: button label
#: src/include/update/rootpart.rb:484 src/include/update/rootpart.rb:509
msgid "&Yes, Continue"
msgstr "&ແມ່ນແລ້ວ, ດຳເນີນການຕໍ່"

#. TRANSLATORS: error message
#: src/lib/update/clients/inst_update_partition_auto.rb:74
msgid "A possibly incomplete installation has been detected."
msgstr "ພົບການຕິດຕັ້ງທີ່ອາດຈະບໍ່ສົມບູນ."

#. TRANSLATORS: label - name of system to update
#: src/modules/RootPart.rb:136
msgid "Unknown Linux System"
msgstr "ລະບົບລິນຸກຊ໌ທີ່ບໍ່ຮູ້ຈັກ"

#. TRANSLATORS: label - name of system to update
#: src/modules/RootPart.rb:141
msgid "Non-Linux System"
msgstr "ລະບົບທີ່ບໍ່ແມ່ນລິນຸກຊ໌"

#. TRANSLATORS: error report, %1 is device (eg. /dev/hda1)
#: src/modules/RootPart.rb:199
#, ycp-format
msgid ""
"Cannot unmount partition %1.\n"
"\n"
"It is currently in use. If the partition stays mounted,\n"
"the data may be lost. Unmount the partition manually\n"
"or restart your computer.\n"
msgstr ""
"ບໍ່ສາມາດຍົກເລີກການເຊື່ອມຕໍ່ພາທິຊັນ %1.\n"
"\n"
"ມັນກຳລັງຖືກໃຊ້ງານຢູ່. ຖ້າພາທິຊັນຍັງຄົງຖືກເຊື່ອມຕໍ່ໄວ້,\n"
"ຂໍ້ມູນອາດຈະສູນຫາຍ. ໃຫ້ຍົກເລີກການເຊື່ອມຕໍ່ພາທິຊັນດ້ວຍຕົນເອງ\n"
"ຫຼື ເລີ່ມຕົ້ນຄອມພິວເຕີຂອງທ່ານໃໝ່.\n"

#. TRANSLATORS: label, %1 is partition
#: src/modules/RootPart.rb:265
#, ycp-format
msgid "Checking partition %1"
msgstr "ກຳລັງກວດສອບພາທິຊັນ %1"

#. TRANSLATORS: check box label
#: src/modules/RootPart.rb:300
msgid "Show &Details"
msgstr "ສະແດງ&ລາຍລະອຽດ"

#. TRANSLATORS: progress status, %1 is a device name, e.g. "/dev/sda1"
#: src/modules/RootPart.rb:385
#, ycp-format
msgid "Checking file system on %1..."
msgstr "ກຳລັງກວດສອບລະບົບໄຟລ໌ໃນ %1..."

#. TRANSLATORS: popup headline
#: src/modules/RootPart.rb:425
msgid "File System Check Failed"
msgstr "ການກວດສອບລະບົບໄຟລ໌ລົ້ມເຫຼວ"

#. TRANSLATORS: popup question (continue/cancel dialog)
#. %1 is a device name such as /dev/hda5
#: src/modules/RootPart.rb:429
#, ycp-format
msgid ""
"The file system check of device %1 has failed.\n"
"\n"
"Do you want to continue mounting the device?\n"
msgstr ""
"ການກວດສອບລະບົບໄຟລ໌ຂອງອຸປະກອນ %1 ລົ້ມເຫຼວ.\n"
"\n"
"ທ່ານຕ້ອງການດຳເນີນການເຊື່ອມຕໍ່ອຸປະກອນຕໍ່ໄປຫຼືບໍ່?\n"

#. TRANSLATORS: button label
#: src/modules/RootPart.rb:438
msgid "&Skip Mounting"
msgstr "&ຂ້າມການເຊື່ອມຕໍ່"

#. TRANSLATORS: a popup headline
#: src/modules/RootPart.rb:743
msgid "Warning"
msgstr "ຄຳເຕືອນ"

#. TRANSLATORS: error message,
#. %1 is replaced with the current /boot partition size
#. %2 with the recommended size
#: src/modules/RootPart.rb:748
#, ycp-format
msgid ""
"Your /boot partition is too small (%1 MB).\n"
"We recommend a size of no less than %2 MB or else the new Kernel may not "
"fit.\n"
"It is safer to either enlarge the partition\n"
"or not use a /boot partition at all.\n"
"\n"
"Do you want to continue updating the current system?\n"
msgstr ""
"ພາທິຊັນ /boot ຂອງທ່ານມີຂະໜາດນ້ອຍເກີນໄປ (%1 MB).\n"
"ພວກເຮົາແນະນຳໃຫ້ມີຂະໜາດບໍ່ນ້ອຍກວ່າ %2 MB ບໍ່ດັ່ງນັ້ນ Kernel ໃໝ່ອາດຈະໃສ່ບໍ່ໄດ້.\n"
"ມັນຈະປອດໄພກວ່າຖ້າຈະຂະຫຍາຍພາທິຊັນ\n"
"ຫຼື ບໍ່ໃຊ້ພາທິຊັນ /boot ເລີຍ.\n"
"\n"
"ທ່ານຕ້ອງການດຳເນີນການອັບເດດລະບົບປັດຈຸບັນຕໍ່ໄປຫຼືບໍ່?\n"

#. TRANSLATORS: label in a popup, %1 is device (eg. /dev/hda1),
#. %2 is output of the 'mount' command
#: src/modules/RootPart.rb:910
#, ycp-format
msgid ""
"The partition %1 could not be mounted.\n"
"\n"
"%2\n"
"\n"
"If you are sure that the partition is not necessary for the\n"
"update (not a system partition), click Continue.\n"
"To check or fix the mount options, click Specify Mount Options.\n"
"To abort the update, click Cancel.\n"
msgstr ""
"ພາທິຊັນ %1 ບໍ່ສາມາດເຊື່ອມຕໍ່ໄດ້.\n"
"\n"
"%2\n"
"\n"
"ຖ້າທ່ານແນ່ໃຈວ່າພາທິຊັນນັ້ນບໍ່ຈຳເປັນສຳລັບການ\n"
"ອັບເດດ (ບໍ່ແມ່ນພາທິຊັນລະບົບ), ໃຫ້ຄລິກ ດຳເນີນການຕໍ່.\n"
"ເພື່ອທົດສອບ ຫຼື ແກ້ໄຂຕົວເລືອກການເຊື່ອມຕໍ່, ໃຫ້ຄລິກ ກຳນົດຕົວເລືອກການເຊື່ອມຕໍ່.\n"
"ເພື່ອຍົກເລີກການອັບເດດ, ໃຫ້ຄລິກ ຍົກເລີກ.\n"

#. TRANSLATORS: button label
#: src/modules/RootPart.rb:928
msgid "&Specify Mount Options"
msgstr "&ກຳນົດຕົວເລືອກການເຊື່ອມຕໍ່"

#. TRANSLATORS: dialog heading
#: src/modules/RootPart.rb:957
msgid "Mount Options"
msgstr "ຕົວເລືອກການເຊື່ອມຕໍ່"

#. TRANSLATORS: input field
#: src/modules/RootPart.rb:960
msgid "&Mount Point"
msgstr "&ຈຸດເຊື່ອມຕໍ່"

#. TRANSLATORS: input field
#: src/modules/RootPart.rb:963
msgid "&Device"
msgstr "&ອຸປະກອນ"

#. TRANSLATORS: input field
#: src/modules/RootPart.rb:966
msgid ""
"&File System\n"
"(empty for autodetection)"
msgstr ""
"&ລະບົບໄຟລ໌\n"
"(ປະຫວ່າງໄວ້ສຳລັບການກວດຫາອັດຕະໂນມັດ)"

#. TRANSLATORS: popup message, %1 will be replace with the name of the logfile
#: src/modules/RootPart.rb:1013
#, ycp-format
msgid ""
"Partitions could not be mounted.\n"
"\n"
"Check the log file %1."
msgstr ""
"ບໍ່ສາມາດເຊື່ອມຕໍ່ພາທິຊັນໄດ້.\n"
"\n"
"ກວດສອບໄຟລ໌ບັນທຶກ %1."

#. TRANSLATORS: warning popup
#: src/modules/RootPart.rb:1064
#, ycp-format
msgid ""
"Some partitions in the system on %1 are mounted by kernel-device name. This "
"is\n"
"not reliable for the update since kernel-device names are unfortunately not\n"
"persistent. It is strongly recommended to start the old system and change "
"the\n"
"mount-by method to any other method for all partitions."
msgstr ""
"ບາງພາທິຊັນໃນລະບົບ %1 ຖືກເຊື່ອມຕໍ່ໂດຍໃຊ້ຊື່ kernel-device. ນີ້\n"
"ບໍ່ໜ້າເຊື່ອຖືສຳລັບການອັບເດດ ເພາະວ່າຊື່ kernel-device ອາດຈະ\n"
"ປ່ຽນແປງໄດ້. ຂໍແນະນຳຢ່າງຍິ່ງໃຫ້ເລີ່ມຕົ້ນລະບົບເກົ່າ ແລະ ປ່ຽນ\n"
"ວິທີການເຊື່ອມຕໍ່ເປັນວິທີອື່ນສຳລັບທຸກພາທິຊັນ."

#. TRANSLATORS: warning popup
#: src/modules/RootPart.rb:1082
#, ycp-format
msgid ""
"Some home directories in the system on %1 are encrypted. This release does "
"not\n"
"support cryptconfig any longer and those home directories will not be "
"accessible\n"
"after upgrade. In order to access these home directories, they need to be "
"decrypted\n"
"before performing upgrade.\n"
"You can consider encrypting whole volume via LUKS."
msgstr ""
"ບາງໂຟນເດີຫຼັກ (home) ໃນລະບົບ %1 ຖືກເຂົ້າລະຫັດໄວ້. ເວີຊັນນີ້ບໍ່\n"
"ຮອງຮັບ cryptconfig ອີກຕໍ່ໄປ ແລະ ໂຟນເດີຫຼັກເຫຼົ່ານັ້ນຈະບໍ່ສາມາດເຂົ້າເຖິງໄດ້\n"
"ຫຼັງຈາກການອັບເກຣດ. ເພື່ອທີ່ຈະເຂົ້າເຖິງໂຟນເດີເຫຼົ່ານີ້, ພວກມັນຈຳເປັນຕ້ອງໄດ້ຮັບການ\n"
"ຖອດລະຫັດກ່ອນທີ່ຈະດຳເນີນການອັບເກຣດ.\n"
"ທ່ານສາມາດພິຈາລະນາການເຂົ້າລະຫັດທັງໝົດຜ່ານ LUKS."

#. TRANSLATORS: error message
#: src/modules/RootPart.rb:1099
msgid "No fstab found."
msgstr "ບໍ່ພົບ fstab."

#. TRANSLATORS: popup message
#: src/modules/RootPart.rb:1123
#, ycp-format
msgid ""
"The mount points listed below are using legacy filesystems that are not "
"supported anymore:\n"
"\n"
"%1\n"
"\n"
"Before upgrade you should migrate all your data to another filesystem.\n"
msgstr ""
"ຈຸດເຊື່ອມຕໍ່ທີ່ລະບຸໄວ້ຂ້າງລຸ່ມນີ້ແມ່ນໃຊ້ລະບົບໄຟລ໌ແບບເກົ່າທີ່ບໍ່ໄດ້ຮັບການຮອງຮັບອີກຕໍ່ໄປ:\n"
"\n"
"%1\n"
"\n"
"ກ່ອນການອັບເກຣດ ທ່ານຄວນຍ້າຍຂໍ້ມູນທັງໝົດຂອງທ່ານໄປຍັງລະບົບໄຟລ໌ອື່ນ.\n"

#. TRANSLATORS: Error message, where %{root} and %{tmp} are replaced by
#. device names (e.g., /dev/sda1 and /dev/sda2).
#: src/modules/RootPart.rb:1145
#, perl-brace-format
msgid ""
"The root partition in /etc/fstab has an invalid root device.\n"
"It is currently mounted as %{root} but listed as %{tmp}."
msgstr ""
"ພາທິຊັນຮາກ (root) ໃນ /etc/fstab ມີອຸປະກອນຮາກທີ່ບໍ່ຖືກຕ້ອງ.\n"
"ປັດຈຸບັນມັນຖືກເຊື່ອມຕໍ່ເປັນ %{root} ແຕ່ຖືກລະບຸໄວ້ເປັນ %{tmp}."

#. TRANSLATORS: progress bar label
#: src/modules/RootPart.rb:1464
msgid "Evaluating root partition. One moment please..."
msgstr "ກຳລັງປະເມີນພາທິຊັນຮາກ. ກະລຸນາລໍຖ້າຈັກຄູ່..."

#. TRANSLATORS: intermediate popup while mounting partitions
#: src/modules/RootPart.rb:1508
msgid "Mounting partitions. One moment please..."
msgstr "ກຳລັງເຊື່ອມຕໍ່ພາທິຊັນ. ກະລຸນາລໍຖ້າຈັກຄູ່..."

#. TRANSLATORS: dialog caption
#: src/modules/RootPart.rb:1523
msgid "Searching for Available Systems"
msgstr "ກຳລັງຄົ້ນຫາລະບົບທີ່ມີຢູ່"

#. TRANSLATORS: error message
#: src/modules/RootPart.rb:1816
msgid ""
"A pre-update snapshot could not be created. You can continue with the \n"
"installation, but beware that you cannot roll back to a pre-update state \n"
"unless you have created a snapshot manually."
msgstr ""
"ບໍ່ສາມາດສ້າງສະແນັບຊັອດກ່ອນການອັບເດດໄດ້. ທ່ານສາມາດດຳເນີນການ\n"
"ຕິດຕັ້ງຕໍ່ໄປໄດ້, ແຕ່ໃຫ້ລະວັງວ່າທ່ານຈະບໍ່ສາມາດຍ້ອນກັບໄປສູ່ສະພາບກ່ອນການອັບເດດໄດ້\n"
"ນອກຈາກວ່າທ່ານໄດ້ສ້າງສະແນັບຊັອດດ້ວຍຕົນເອງ."

#. TRANSLATORS: error message, %{file} is replaced with file name
