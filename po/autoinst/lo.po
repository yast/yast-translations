#: src/include/autoinstall/classes.rb:446
msgid "&Merge with Empty Control File"
msgstr "ລວມເຂົ້າກັບໄຟລ໌ຄວບຄຸມທີ່ວ່າງເປົ່າ(&M)"

#: src/include/autoinstall/classes.rb:453
msgid "Merge with &Currently-Loaded Control File"
msgstr "ລວມເຂົ້າກັບໄຟລ໌ຄວບຄຸມທີ່ໂຫຼດຢູ່ຕອນນີ້(&C)"

#: src/include/autoinstall/classes.rb:458
msgid "Merge Cla&sses"
msgstr "ລວມຄລາສ(&s)"

#: src/include/autoinstall/classes.rb:463
msgid ""
"<p>If you have defined and created <b>\n"
"classes</b>, you will be able to merge them using this interface to create\n"
"a new <i>Profile</i>, which will contain information from every class\n"
"depending on the priority (order) set when\n"
"creating the classes.</P>\n"
msgstr ""
"<p>ຖ້າທ່ານໄດ້ກຳນົດ ແລະ ສ້າງ <b>\n"
"ຄລາສ</b> ແລ້ວ, ທ່ານຈະສາມາດລວມພວກມັນເຂົ້າກັນໂດຍໃຊ້ສ່ວນຕິດຕໍ່ນີ້ເພື່ອສ້າງ\n"
"<i>ໂປຣໄຟລ໌</i> ໃໝ່, ເຊິ່ງຈະມີຂໍ້ມູນຈາກທຸກຄລາສ\n"
"ໂດຍຂຶ້ນກັບລຳດັບບຸລິມະສິດທີ່ຕັ້ງໄວ້ຕອນ\n"
"ສ້າງຄລາສ.</P>\n"

#: src/include/autoinstall/classes.rb:473
msgid ""
"<P>To merge the classes, an <b>XSLT</b>\n"
"script is used.</P>\n"
msgstr ""
"<P>ເພື່ອລວມຄລາສເຂົ້າກັນ, ຈະມີການໃຊ້\n"
"ສະຄຣິບ <b>XSLT</b>.</P>\n"

#: src/include/autoinstall/classes.rb:513
#, ycp-format
msgid ""
"Select at least %1  configurations\n"
"to perform a merge.\n"
msgstr ""
"ເລືອກຢ່າງໜ້ອຍ %1 ການກຳນົດຄ່າ\n"
"ເພື່ອເຮັດການລວມເຂົ້າກັນ.\n"

#: src/include/autoinstall/classes.rb:551
msgid "Class Configuration"
msgstr "ການກຳນົດຄ່າຄລາສ"

#: src/include/autoinstall/classes.rb:552
msgid ""
"<p>Choose one or more of the listed classes to which the current control\n"
"file should belong.</p>\n"
msgstr ""
"<p>ເລືອກໜຶ່ງ ຫຼື ຫຼາຍຄລາສທີ່ຢູ່ໃນລາຍການ ເພື່ອໃຫ້ໄຟລ໌ຄວບຄຸມປັດຈຸບັນ\n"
"ສັງກັດຢູ່.</p>\n"

#: src/include/autoinstall/classes.rb:585
