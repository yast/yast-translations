#. All helps are here
#: src/include/autoinstall/helps.rb:14
msgid "<p><b><big>Profile Validation</big></b><br>"
msgstr "<p><b><big>ການຢືນຢັນຄວາມຖືກຕ້ອງຂອງໂປຣໄຟລ໌</big></b><br>"

#: src/include/autoinstall/helps.rb:15
msgid ""
"<p>This tool uses <em>xmllint</em> to validate the profile against the DTD "
"and\n"
"it checks for missing data. Some missing data might be intentional and any\n"
"reported errors can be ignored, for example, when creating classes.</p>\n"
msgstr ""
"<p>ເຄື່ອງມືນີ້ໃຊ້ <em>xmllint</em> ເພື່ອຢືນຢັນຄວາມຖືກຕ້ອງຂອງໂປຣໄຟລ໌ທຽບກັບ DTD ແລະ\n"
"ກວດສອບຂໍ້ມູນທີ່ຫາຍໄປ. ຂໍ້ມູນບາງຢ່າງທີ່ຫາຍໄປອາດຈະເປັນຄວາມຕັ້ງໃຈ ແລະ \n"
"ຂໍ້ຜິດພາດທີ່ລາຍງານບາງຢ່າງສາມາດເມີນເສີຍໄດ້, ຕົວຢ່າງ: ໃນເວລາສ້າງຄລາສ.</p>\n"

#: src/include/autoinstall/helps.rb:20
msgid ""
"<p>Load a profile first. Otherwise an empty file\n"
"is validated.</p>\n"
msgstr ""
"<p>ໃຫ້ໂຫຼດໂປຣໄຟລ໌ກ່ອນ. ບໍ່ດັ່ງນັ້ນ ໄຟລ໌ວ່າງເປົ່າ\n"
"ຈະຖືກນຳໄປຢືນຢັນຄວາມຖືກຕ້ອງ.</p>\n"

#: src/include/autoinstall/helps.rb:23
msgid ""
"<p>This tool creates a reference profile by reading\n"
"information from this system. Select the resources to read from this system\n"
"in addition to the default resources, like partitioning and package "
"selections.</p>\n"
msgstr ""
"<p>ເຄື່ອງມືນີ້ສ້າງໂປຣໄຟລ໌ອ້າງອີງໂດຍການອ່ານ\n"
"ຂໍ້ມູນຈາກລະບົບນີ້. ເລືອກຊັບພະຍາກອນທີ່ຈະອ່ານຈາກລະບົບນີ້\n"
"ເພີ່ມເຕີມຈາກຊັບພະຍາກອນເລີ່ມຕົ້ນ, ເຊັ່ນ: ການແບ່ງພາກສ່ວນ (partitioning) ແລະ ການເລືອກແພັກເກັ"
"ດ.</p>\n"

#: src/include/autoinstall/helps.rb:28
msgid "<p> Partition your hard disks... </p>"
msgstr "<p> ແບ່ງພາກສ່ວນຮາດດິດຂອງທ່ານ... </p>"

#: src/include/autoinstall/helps.rb:29
msgid ""
"<p>The table to the right shows the partitions to create on the target "
"system.\n"
"</p>\n"
msgstr ""
"<p>ຕາຕະລາງທາງຂວາສະແດງພາກສ່ວນ (partitions) ທີ່ຈະສ້າງໃນລະບົບເປົ້າໝາຍ.\n"
"</p>\n"

#: src/include/autoinstall/helps.rb:32
msgid "<p><b>Hard disks</b> are designated like this </p>"
msgstr "<p><b>ຮາດດິດ</b> ຖືກກຳນົດຄືແນວນີ້ </p>"

#: src/include/autoinstall/helps.rb:33
msgid ""
"<tt>/dev/hda </tt>1st EIDE disk\n"
"<tt>/dev/hdb </tt>2nd EIDE disk\n"
"<tt>/dev/hdc </tt>3rd EIDE disk"
msgstr ""
"<tt>/dev/hda </tt>1st EIDE disk\n"
"<tt>/dev/hdb </tt>2nd EIDE disk\n"
"<tt>/dev/hdc </tt>3rd EIDE disk"

#: src/include/autoinstall/helps.rb:38
msgid "<p>etc.</p>"
msgstr "<p>ແລະ ອື່ນໆ.</p>"

#: src/include/autoinstall/helps.rb:39
msgid "<p>- or - </p>"
msgstr "<p>- ຫຼື - </p>"

#: src/include/autoinstall/helps.rb:40
msgid ""
"<p><tt>/dev/sda </tt>1st SCSI disk\n"
"<tt>/dev/sdb </tt>2nd SCSI disk\n"
"<tt>/dev/sdc </tt>3rd SCSI disk</p>"
msgstr ""
"<p><tt>/dev/sda </tt>ດິດ SCSI ທີ 1\n"
"<tt>/dev/sdb </tt>ດິດ SCSI ທີ 2\n"
"<tt>/dev/sdc </tt>ດິດ SCSI ທີ 3</p>"

#: src/include/autoinstall/helps.rb:45
msgid ""
"If no partitions are defined and the specified drive is also\n"
"the drive where the root partition should reside, the following partitions "
"are\n"
"created automatically:"
msgstr ""
"ຖ້າບໍ່ມີການກຳນົດພາກສ່ວນໄວ້ ແລະ ໄດຣຟ໌ທີ່ລະບຸເປັນ\n"
"ໄດຣຟ໌ທີ່ພາກສ່ວນ root ຄວນຢູ່, ພາກສ່ວນຕໍ່ໄປນີ້ຈະ\n"
"ຖືກສ້າງຂຶ້ນໂດຍອັດຕະໂນມັດ:"

#: src/include/autoinstall/helps.rb:50
msgid ""
" <tt>/boot</tt>, <tt>swap</tt>, and a root partition <tt>/</tt>.\n"
"Sizes are calculated automatically.\n"
msgstr ""
" <tt>/boot</tt>, <tt>swap</tt>, ແລະ ພາກສ່ວນ root <tt>/</tt>.\n"
"ຂະໜາດຈະຖືກຄິດໄລ່ໂດຍອັດຕະໂນມັດ.\n"

#: src/include/autoinstall/helps.rb:54
msgid "<p><b>Advanced Options</b></p>"
msgstr "<p><b>ຕົວເລືອກຂັ້ນສູງ</b></p>"

#: src/include/autoinstall/helps.rb:55
msgid ""
"By default, AutoYaST will create an extended partition and adds all new "
"partitions as logical devices. It is possible, however, to instruct AutoYaST "
"to create a certain partition as a primary partition or as extended "
"partition. Additionally, it is possible to specify the size of a partition "
"using sectors rather than size in MBytes."
msgstr ""
"ຕາມຄ່າເລີ່ມຕົ້ນ, AutoYaST ຈະສ້າງພາກສ່ວນ extended ແລະ ເພີ່ມພາກສ່ວນໃໝ່ທັງໝົດເປັນອຸປະກອນ "
"logical. ຢ່າງໃດກໍຕາມ, ທ່ານສາມາດສັ່ງໃຫ້ AutoYaST ສ້າງພາກສ່ວນໃດໜຶ່ງເປັນພາກສ່ວນ primary ຫຼື ເປັ"
"ນພາກສ່ວນ extended ໄດ້. ນອກຈາກນັ້ນ, ທ່ານຍັງສາມາດລະບຸຂະໜາດຂອງພາກສ່ວນໂດຍໃຊ້ sectors ແທນທີ່ຈ"
"ະເປັນຂະໜາດເປັນ MBytes."

#: src/include/autoinstall/helps.rb:62
msgid ""
"These options and other advanced options cannot be configured using this\n"
"interface.  Instead, add them manually to the control file.\n"
msgstr ""
"ຕົວເລືອກເຫຼົ່ານີ້ ແລະ ຕົວເລືອກຂັ້ນສູງອື່ນໆ ບໍ່ສາມາດກຳນົດຄ່າໄດ້ໂດຍໃຊ້\n"
"ສ່ວນຕິດຕໍ່ນີ້. ແທນທີ່ຈະເຮັດແນວນັ້ນ, ໃຫ້ເພີ່ມພວກມັນເອງໃສ່ໃນໄຟລ໌ຄວບຄຸມ.\n"

#: src/include/autoinstall/helps.rb:66
msgid ""
"<p>\n"
"For LVM and RAID setup, consult the documentation and add the configuration\n"
"to an existing control file. You can only create unformatted LVM and RAID "
"partitions as\n"
"a preparation.\n"
"</p>\n"
msgstr ""
"<p>\n"
"ສຳລັບການຕັ້ງຄ່າ LVM ແລະ RAID, ໃຫ້ສຶກສາຈາກເອກະສານປະກອບ ແລະ ເພີ່ມການກຳນົດຄ່າ\n"
"ໃສ່ໃນໄຟລ໌ຄວບຄຸມທີ່ມີຢູ່. ທ່ານສາມາດສ້າງໄດ້ແຕ່ພາກສ່ວນ LVM ແລະ RAID ທີ່ຍັງບໍ່ທັນໄດ້ຟໍແມັດເທົ່ານັ້ນ\n"
"ເພື່ອເປັນການກຽມພ້ອມ.\n"
"</p>\n"

#. init scripts does not have interpreter. Is it correct?
#: src/include/autoinstall/script_dialogs.rb:29
msgid "Available Scripts"
msgstr "ສະຄຣິບທີ່ມີໃຫ້ໃຊ້"

#: src/include/autoinstall/script_dialogs.rb:33
msgid "Script Name"
msgstr "ຊື່ສະຄຣິບ"

#: src/include/autoinstall/script_dialogs.rb:33
msgid "Type"
msgstr "ປະເພດ"

#: src/include/autoinstall/script_dialogs.rb:33
msgid "Interpreter"
msgstr "ຕົວແປພາສາ (Interpreter)"

#. help 1/6
#: src/include/autoinstall/script_dialogs.rb:61
msgid ""
"\n"
"<h3>Preinstallation Scripts</h3>\n"
"<P>Add commands to run on the system  before the installation begins. </P>\n"
msgstr ""
"\n"
"<h3>ສະຄຣິບກ່ອນການຕິດຕັ້ງ</h3>\n"
"<P>ເພີ່ມຄຳສັ່ງເພື່ອໃຫ້ເຮັດວຽກໃນລະບົບ ກ່ອນທີ່ການຕິດຕັ້ງຈະເລີ່ມຕົ້ນ. </P>\n"

#. help 2/6
#: src/include/autoinstall/script_dialogs.rb:69
msgid ""
"\n"
"<h3>Postinstallation Scripts</h3>\n"
"<P>You can also add commands to execute on the system after the "
"installation\n"
"is completed. These scripts are run outside the chroot environment.\n"
"</P>"
msgstr ""
"\n"
"<h3>ສະຄຣິບຫຼັງການຕິດຕັ້ງ</h3>\n"
"<P>ທ່ານຍັງສາມາດເພີ່ມຄຳສັ່ງເພື່ອໃຫ້ເຮັດວຽກໃນລະບົບ ຫຼັງຈາກການຕິດຕັ້ງ\n"
"ສຳເລັດແລ້ວ. ສະຄຣິບເຫຼົ່ານີ້ຈະເຮັດວຽກຢູ່ນອກສະພາບແວດລ້ອມ chroot.\n"
"</P>"

#. help 3/6
#: src/include/autoinstall/script_dialogs.rb:80
msgid ""
"\n"
"<H3>Chroot Scripts</H3>\n"
"<P>For your postinstallation script to run inside the chroot\n"
"environment, choose the <i>chroot scripts</i> options. Those scripts are\n"
"run before the system reboots for the first time. By default, the chroot \n"
"scripts are run in the installation system. To access files in the "
"installed \n"
"system, always use the mount point \"/mnt\" in your scripts.\n"
"</P>\n"
msgstr ""
"\n"
"<H3>ສະຄຣິບ Chroot</H3>\n"
"<P>ເພື່ອໃຫ້ສະຄຣິບຫຼັງການຕິດຕັ້ງຂອງທ່ານເຮັດວຽກພາຍໃນສະພາບແວດລ້ອມ\n"
"chroot, ໃຫ້ເລືອກຕົວເລືອກ <i>ສະຄຣິບ chroot</i>. ສະຄຣິບເຫຼົ່ານັ້ນຈະ\n"
"ເຮັດວຽກກ່ອນທີ່ລະບົບຈະເລີ່ມຕົ້ນໃໝ່ເປັນຄັ້ງທຳອິດ. ຕາມຄ່າເລີ່ມຕົ້ນ, ສະຄຣິບ chroot \n"
"ຈະເຮັດວຽກໃນລະບົບການຕິດຕັ້ງ. ເພື່ອເຂົ້າເຖິງໄຟລ໌ໃນລະບົບທີ່ຕິດຕັ້ງແລ້ວ, \n"
"ໃຫ້ໃຊ້ຈຸດເມົາທ໌ \"/mnt\" ໃນສະຄຣິບຂອງທ່ານສະເໝີ.\n"
"</P>\n"

#. help 4/6
#: src/include/autoinstall/script_dialogs.rb:94
msgid ""
"\n"
"<p>It is possible to run chroot scripts in a later stage after\n"
"the boot loader has been configured using the special boolean tag "
"\"chrooted\".\n"
"This runs the scripts in the installed system. \n"
"</p>\n"
msgstr ""
"\n"
"<p>ທ່ານສາມາດເປີດໃຊ້ສະຄຣິບ chroot ໃນຂັ້ນຕອນຕໍ່ມາ ຫຼັງຈາກທີ່\n"
"ບູດໂຫຼດເດີ (boot loader) ຖືກກຳນົດຄ່າແລ້ວ ໂດຍການໃຊ້ແທັກບູລີນພິເສດ \"chrooted\".\n"
"ນີ້ຈະເຮັດໃຫ້ສະຄຣິບເຮັດວຽກໃນລະບົບທີ່ຕິດຕັ້ງແລ້ວ. \n"
"</p>\n"

#. help 5/6
#: src/include/autoinstall/script_dialogs.rb:105
msgid ""
"\n"
"<H3>Init Scripts</H3>\n"
"<P>These scripts are executed during the initial boot process and after\n"
"YaST has finished configuring the system. The final scripts are executed \n"
"using a special <b>rc</b> script that is executed only once. \n"
"The final scripts are executed toward the end of the boot\n"
"process and after network has been initialized.\n"
"</P>\n"
msgstr ""
"\n"
"<H3>ສະຄຣິບເລີ່ມຕົ້ນ</H3>\n"
"<P>ສະຄຣິບເຫຼົ່ານີ້ຈະເຮັດວຽກໃນລະຫວ່າງຂະບວນການບູດຄັ້ງທຳອິດ ແລະ ຫຼັງຈາກທີ່\n"
"YaST ກຳນົດຄ່າລະບົບສຳເລັດແລ້ວ. ສະຄຣິບສຸດທ້າຍຈະເຮັດວຽກໂດຍ \n"
"ໃຊ້ສະຄຣິບ <b>rc</b> ພິເສດທີ່ຈະເຮັດວຽກພຽງຄັ້ງດຽວເທົ່ານັ້ນ. \n"
"ສະຄຣິບສຸດທ້າຍຈະເຮັດວຽກໃນຕອນທ້າຍຂອງຂະບວນການບູດ\n"
"ແລະ ຫຼັງຈາກທີ່ເຄືອຂ່າຍຖືກເລີ່ມຕົ້ນແລ້ວ.\n"
"</P>\n"

#. help 6/6
#: src/include/autoinstall/script_dialogs.rb:120
msgid ""
"\n"
"<H3>Interpreter:</H3>\n"
"<P>Preinstallation scripts can only be shell scripts. Do not use <i>Perl</i> "
"or \n"
"<i>Python</i> for preinstallation scripts.\n"
"</P>\n"
msgstr ""
"\n"
"<H3>ຕົວແປພາສາ (Interpreter):</H3>\n"
"<P>ສະຄຣິບກ່ອນການຕິດຕັ້ງສາມາດເປັນໄດ້ແຕ່ shell scripts ເທົ່ານັ້ນ. ຫ້າມໃຊ້ <i>Perl</i> ຫຼື \n"
"<i>Python</i> ສຳລັບສະຄຣິບກ່ອນການຕິດຕັ້ງ.\n"
"</P>\n"

#: src/include/autoinstall/script_dialogs.rb:130
msgid ""
"\n"
"<H3>Feedback and Debug:</H3>\n"
"<P>All scripts except the init scripts can show STDOUT+STDERR in a pop-up "
"box as feedback.\n"
"If you turn on debugging, you get more output in the feedback dialog that "
"might help\n"
"you to debug your script.</P>\n"
msgstr ""
"\n"
"<H3>ຄຳຕິຊົມ ແລະ ການດີບັກ (Feedback and Debug):</H3>\n"
"<P>ສະຄຣິບທັງໝົດຍົກເວັ້ນສະຄຣິບເລີ່ມຕົ້ນ ສາມາດສະແດງ STDOUT+STDERR ໃນກ່ອງຂໍ້ຄວາມປັອບອັບເພື່ອເປັນຄຳຕິ"
"ຊົມ.\n"
"ຖ້າທ່ານເປີດການດີບັກ, ທ່ານຈະໄດ້ຮັບຂໍ້ມູນອອກຫຼາຍຂຶ້ນໃນກ່ອງຂໍ້ຄວາມຄຳຕິຊົມ ເຊິ່ງອາດຈະຊ່ວຍ\n"
"ໃຫ້ທ່ານດີບັກສະຄຣິບຂອງທ່ານໄດ້.</P>\n"

