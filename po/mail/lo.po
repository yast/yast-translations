msgstr "ໃຊ້"

#: src/include/mail/ui.rb:408
msgid "Enforce"
msgstr "ບັງຄັບໃຊ້"

#: src/include/mail/ui.rb:412
msgid "&Masquerading"
msgstr "ການ&ແທນທີ່ທີ່ຢູ່"

#: src/include/mail/ui.rb:413
msgid "&Authentication"
msgstr "ການ&ຢືນຢັນຕົວຕົນ"

#. Translators: dialog caption
#: src/include/mail/ui.rb:479
msgid "Incoming Mail"
msgstr "ເມລຂາເຂົ້າ"

#. pushbutton
#: src/include/mail/ui.rb:519
msgid "&Details..."
msgstr "&ລາຍລະອຽດ..."

#: src/include/mail/ui.rb:525
msgid "Start &fetchmail"
msgstr "ເລີ່ມ &fetchmail"

#: src/include/mail/ui.rb:526
msgid "manual"
msgstr "ດ້ວຍຕົນເອງ"

#: src/include/mail/ui.rb:526
msgid "daemon"
msgstr "ເດມອນ (daemon)"

#. frame label: mail downloading (fetchmail)
#: src/include/mail/ui.rb:532
msgid "&Downloading"
