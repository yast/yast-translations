#. Only root can start process
#: src/lib/ydocker/main_dialog.rb:75
msgid ""
"Docker service does not run. Should YaST start docker? Otherwise YaST quits."
msgstr ""
"ບໍລິການ Docker ບໍ່ທຳງານ. ຕ້ອງການໃຫ້ YaST ເລີ່ມ Docker ບໍ່? ຖ້າບໍ່ດັ່ງນັ້ນ YaST ຈະປິດອອກ."

#: src/lib/ydocker/main_dialog.rb:80
msgid ""
"Docker service does not run. \\\n"
"Run this module as root or start docker service manually."
msgstr ""
"ບໍລິການ Docker ບໍ່ທຳງານ. \\\n"
"ໃຫ້ຮັນໂມດູນນີ້ໃນນາມ root ຫຼື ເລີ່ມບໍລິການ docker ດ້ວຍຕົນເອງ."

#: src/lib/ydocker/main_dialog.rb:145
#, c-format
msgid "Communication with docker failed with error: %s. Please try again."
msgstr "ການຕິດຕໍ່ສື່ສານກັບ docker ຜິດພາດ: %s. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#: src/lib/ydocker/main_dialog.rb:157
msgid "Do you really want to stop the running container?"
msgstr "ທ່ານຕ້ອງການຢຸດຄອນເທນເນີທີ່ກຳລັງທຳງານຢູ່ແທ້ຫຼືບໍ່?"

#: src/lib/ydocker/main_dialog.rb:160 src/lib/ydocker/main_dialog.rb:171
msgid "Do you want to remove the container?"
msgstr "ທ່ານຕ້ອງການລຶບຄອນເທນເນີຫຼືບໍ່?"

#: src/lib/ydocker/main_dialog.rb:168
msgid "Do you really want to kill the running container?"
msgstr "ທ່ານຕ້ອງການບັງຄັບປິດ (kill) ຄອນເທນເນີທີ່ກຳລັງທຳງານຢູ່ແທ້ຫຼືບໍ່?"

