#. Popup text
#: src/include/security/dialogs.rb:825
msgid ""
"The minimum number of days cannot be larger\n"
"than the maximum."
msgstr "ຈຳນວນມື້ຕໍ່າສຸດບໍ່ສາມາດຫຼາຍກວ່າຄ່າສູງສຸດໄດ້."

#. Popup text, %1 is number
#: src/include/security/dialogs.rb:842
#, ycp-format
msgid ""
"The minimum password length cannot be larger than the maximum.\n"
"The maximum password length for the selected encryption method is %1."
msgstr ""
"ຄວາມຍາວລະຫັດຜ່ານຕໍ່າສຸດບໍ່ສາມາດຫຼາຍກວ່າຄ່າສູງສຸດໄດ້.\n"
"ຄວາມຍາວລະຫັດຜ່ານສູງສຸດສຳລັບວິທີການເຂົ້າລະຫັດທີ່ເລືອກແມ່ນ %1."

#. Login dialog caption
#: src/include/security/dialogs.rb:875 src/include/security/wizards.rb:56
msgid "Login Settings"
msgstr "ການຕັ້ງຄ່າການເຂົ້າສູ່ລະບົບ"

#. Frame label
#: src/include/security/dialogs.rb:884
msgid "Login"
msgstr "ເຂົ້າສູ່ລະບົບ"

#. Read dialog help 1/2
#: src/include/security/helps.rb:39
msgid ""
"<p><b><big>Initializing Security Configuration</big></b>\n"
"<br>Please wait...<br></p>"
msgstr ""
"<p><b><big>ກຳລັງເລີ່ມຕົ້ນການຕັ້ງຄ່າຄວາມປອດໄພ</big></b>\n"
"<br>ກະລຸນາລໍຖ້າ...<br></p>"

#. Read dialog help 2/2
#: src/include/security/helps.rb:44
msgid ""
"<p><b><big>Aborting the Initialization</big></b><br>\n"
"Safely abort the configuration utility by pressing <b>Abort</b> now.</p>"
msgstr ""
"<p><b><big>ກຳລັງຍົກເລີກການເລີ່ມຕົ້ນ</big></b><br>\n"
"ຍົກເລີກເຄື່ອງມືການຕັ້ງຄ່າຢ່າງປອດໄພໂດຍການກົດ <b>ຍົກເລີກ (Abort)</b> ດຽວນີ້.</p>"

#. Write dialog help 1/2
#: src/include/security/helps.rb:49
msgid ""
"<p><b><big>Saving Security Configuration</big></b>\n"
"<br>Please wait...<br></p>"
msgstr ""
"<p><b><big>ກຳລັງບັນທຶກການຕັ້ງຄ່າຄວາມປອດໄພ</big></b>\n"
"<br>ກະລຸນາລໍຖ້າ...<br></p>"

#. Write dialog help 2/2
#: src/include/security/helps.rb:53
msgid ""
"<p><b><big>Aborting Saving</big></b><br>\n"
"Abort the save procedure by pressing <b>Abort</b>.</p>"
msgstr ""
"<p><b><big>ກຳລັງຍົກເລີກການບັນທຶກ</big></b><br>\n"
"ຍົກເລີກຂັ້ນຕອນການບັນທຶກໂດຍການກົດ <b>ຍົກເລີກ (Abort)</b>.</p>"

#. Main dialog help 1/8
#: src/include/security/helps.rb:60
msgid ""
"<P><BIG><B>Configuring Local Security</B></BIG></P>\n"
"<p>Using predefined defaults, change the local security settings, which "
"include\n"
"    booting, login, password, user creation, and file permissions. The "
"default\n"
"    settings can be modified as needed.\n"
"</p>"
msgstr ""
"<P><BIG><B>ການຕັ້ງຄ່າຄວາມປອດໄພພາຍໃນເຄື່ອງ</B></BIG></P>\n"
"<p>ປ່ຽນການຕັ້ງຄ່າຄວາມປອດໄພພາຍໃນເຄື່ອງໂດຍໃຊ້ຄ່າເລີ່ມຕົ້ນທີ່ກຳນົດໄວ້, ເຊິ່ງລວມມີ\n"
"    ການບູດ, ການເຂົ້າສູ່ລະບົບ, ລະຫັດຜ່ານ, ການສ້າງຜູ້ໃຊ້, ແລະ ສິດການເຂົ້າເຖິງໄຟລ໌. \n"
"    ທ່ານສາມາດປັບປ່ຽນຄ່າເລີ່ມຕົ້ນໄດ້ຕາມຄວາມຕ້ອງການ.\n"
"</p>"

#. Main dialog help 5/8
#: src/include/security/helps.rb:68
msgid ""
"<p><b>Workstation</b>: For a computer connected\n"
"to any type of network including the Internet.</p>"
msgstr ""
"<p><b>ສະຖານີວຽກ (Workstation)</b>: ສຳລັບຄອມພິວເຕີທີ່ເຊື່ອມຕໍ່ກັບ\n"
"ເຄືອຂ່າຍປະເພດໃດໜຶ່ງ ລວມທັງອິນເຕີເນັດ.</p>"

#. Main dialog help 6/8
#: src/include/security/helps.rb:73
msgid ""
"<p><b>Roaming Device</b>: For a laptop, tablet or similar device\n"
"that connects to different networks.</p>"
msgstr ""
"<p><b>ອຸປະກອນເຄື່ອນທີ່ (Roaming Device)</b>: ສຳລັບແລັບທັອບ, ແທັບເລັດ ຫຼື ອຸປະກອນທີ່ຄ້າຍຄືກັນ\n"
"ທີ່ເຊື່ອມຕໍ່ກັບເຄືອຂ່າຍຕ່າງໆ.</p>"

#. Main dialog help 7/8
#: src/include/security/helps.rb:78
msgid ""
"<p><b>Network Server</b>: For a computer that provides\n"
"any type of service.</p>"
msgstr ""
"<p><b>ເຊີເວີເຄືອຂ່າຍ (Network Server)</b>: ສຳລັບຄອມພິວເຕີທີ່ໃຫ້ບໍລິການ\n"
"ປະເພດໃດໜຶ່ງ.</p>"

#. Main dialog help 8/8
#: src/include/security/helps.rb:82
msgid "<p><b>Custom Settings</b>: Create your own configuration.</p>"
msgstr "<p><b>ການຕັ້ງຄ່າກຳນົດເອງ</b>: ສ້າງການຕັ້ງຄ່າຂອງທ່ານເອງ.</p>"

#. Login dialog help 1/4
#: src/include/security/helps.rb:84
msgid ""
"<p><big><b>Login Security</b></big></p>\n"
"<p>These login settings\n"
"are mainly stored in the /etc/login.defs file.</p>"
msgstr ""
"<p><big><b>ຄວາມປອດໄພໃນການເຂົ້າສູ່ລະບົບ</b></big></p>\n"
"<p>ການຕັ້ງຄ່າການເຂົ້າສູ່ລະບົບເຫຼົ່ານີ້\n"
"ສ່ວນໃຫຍ່ຈະຖືກເກັບໄວ້ໃນໄຟລ໌ /etc/login.defs.</p>"

#. Login dialog help 2/4
#: src/include/security/helps.rb:90
msgid ""
"<p><b>Delay after Incorrect Login Attempt:</b>\n"
"It is advisable to wait some time after an incorrect login attempt to "
"prevent\n"
"password guessing. Make the time small enough that users do not need to wait "
"to\n"
"retry if a password is mistyped. A sensible value is three seconds (<tt>3</"
"tt>).</p>"
msgstr ""
"<p><b>ການໜ່ວງເວລາຫຼັງຈາກການເຂົ້າສູ່ລະບົບຜິດພາດ:</b>\n"
"ແນະນຳໃຫ້ລໍຖ້າໄລຍະໜຶ່ງຫຼັງຈາກການເຂົ້າສູ່ລະບົບຜິດພາດ ເພື່ອປ້ອງກັນ\n"
"ການເດົາລະຫັດຜ່ານ. ຄວນຕັ້ງເວລາໃຫ້ສັ້ນພໍທີ່ຜູ້ໃຊ້ບໍ່ຕ້ອງລໍຖ້ານານເກີນໄປ\n"
"ຫາກພິມລະຫັດຜ່ານຜິດ. ຄ່າທີ່ເໝາະສົມແມ່ນ 3 ວິນາທີ (<tt>3</tt>).</p>"

#. Login dialog help 3/4
#: src/include/security/helps.rb:97
msgid ""
"<p><b>Record Successful Login Attempts:</b> Logging successful login\n"
"attempts is useful. It can warn you of unauthorized access to the\n"
"system (for example, a user logging in from a different location than "
"usual).\n"
"</p>\n"
msgstr ""
"<p><b>ບັນທຶກການເຂົ້າສູ່ລະບົບທີ່ສຳເລັດ:</b> ການບັນທຶກການເຂົ້າສູ່ລະບົບທີ່ສຳເລັດ\n"
"ແມ່ນມີປະໂຫຍດ. ມັນສາມາດເຕືອນທ່ານກ່ຽວກັບການເຂົ້າເຖິງລະບົບໂດຍບໍ່ໄດ້ຮັບອະນຸຍາດ\n"
"(ຕົວຢ່າງ: ມີຜູ້ໃຊ້ເຂົ້າສູ່ລະບົບຈາກສະຖານທີ່ອື່ນທີ່ບໍ່ຄືປົກກະຕິ).\n"
"</p>\n"

#. Login dialog help 4/4
#: src/include/security/helps.rb:104
msgid ""
"<p><b>Allow Remote Graphical Login:</b> Checking this allows access\n"
"to a graphical login screen for this machine over the network. Remote "
"access\n"
"to your machine using a display manager might be a security risk.</p>"
msgstr ""
"<p><b>ອະນຸຍາດການເຂົ້າສູ່ລະບົບແບບກຣາຟິກຈາກທາງໄກ:</b> ການເລືອກຂໍ້ນີ້ຈະອະນຸຍາດໃຫ້ເຂົ້າເຖິງ\n"
"ໜ້າຈໍການເຂົ້າສູ່ລະບົບແບບກຣາຟິກຂອງເຄື່ອງນີ້ຜ່ານເຄືອຂ່າຍ. ການເຂົ້າເຖິງເຄື່ອງຂອງທ່ານຈາກທາງໄກ\n"
"ໂດຍໃຊ້ຕົວຈັດການການສະແດງຜົນອາດຈະມີຄວາມສ່ຽງດ້ານຄວາມປອດໄພ.</p>"

#. Password dialog help 1/8
#: src/include/security/helps.rb:110
msgid ""
"<p>These password settings\n"
"are mainly stored in the /etc/login.defs file.</p>"
msgstr ""
"<p>ການຕັ້ງຄ່າລະຫັດຜ່ານເຫຼົ່ານີ້\n"
"ສ່ວນໃຫຍ່ຈະຖືກເກັບໄວ້ໃນໄຟລ໌ /etc/login.defs.</p>"

#. Password dialog help 2/8
#: src/include/security/helps.rb:114
msgid ""
"<p><b>Check New Passwords</b>: It is wise to choose a password that\n"
"cannot be found in a dictionary and is not a name or other simple, common "
"word.\n"
"By checking the box, enforce password checking in regard to these rules.</p>"
msgstr ""
"<p><b>ກວດສອບລະຫັດຜ່ານໃໝ່</b>: ຄວນເລືອກລະຫັດຜ່ານທີ່\n"
"ບໍ່ສາມາດຊອກຫາໄດ້ໃນວັດຈະນານຸກົມ ແລະ ບໍ່ແມ່ນຊື່ ຫຼື ຄຳສັບທົ່ວໄປທີ່ງ່າຍ.\n"
"ໂດຍການເລືອກຊ່ອງນີ້, ຈະເປັນການບັງຄັບໃຫ້ມີການກວດສອບລະຫັດຜ່ານຕາມກົດເຫຼົ່ານີ້.</p>"

#. Password dialog help
#: src/include/security/helps.rb:120
msgid ""
"<p><b>Minimum Acceptable Password Length:</b>\n"
"The minimum acceptable size for the new password reduced by the number\n"
"of different character classes (other, upper, lower and digit) used in the "
"new\n"
"password. See man pam_cracklib for a more detailed explanation.\n"
"This option can only be modified when <b>Check New Passwords</b> is set.</p>"
msgstr ""
"<p><b>ຄວາມຍາວລະຫັດຜ່ານຕໍ່າສຸດທີ່ຍອມຮັບໄດ້:</b>\n"
"ຂະໜາດຕໍ່າສຸດທີ່ຍອມຮັບໄດ້ສຳລັບລະຫັດຜ່ານໃໝ່ ເຊິ່ງຈະຖືກຫຼຸດລົງຕາມຈຳນວນ\n"
"ປະເພດຕົວອັກສອນທີ່ແຕກຕ່າງກັນ (ອື່ນໆ, ຕົວພິມໃຫຍ່, ຕົວພິມນ້ອຍ ແລະ ຕົວເລກ) ທີ່ໃຊ້ໃນລະຫັດຜ່ານໃໝ່.\n"
"ເບິ່ງ man pam_cracklib ສຳລັບຄຳອະທິບາຍລະອຽດ.\n"
"ຕົວເລືອກນີ້ສາມາດປ່ຽນແປງໄດ້ກໍຕໍ່ເມື່ອມີການເລືອກ <b>ກວດສອບລະຫັດຜ່ານໃໝ່</b> ເທົ່ານັ້ນ.</p>"

#. Password dialog help 4/8
#: src/include/security/helps.rb:128
msgid ""
"<p><b>Passwords to Remember</b>:\n"
"Enter the number of user passwords to store and prevent the user from "
"reusing.\n"
"Enter 0 if passwords should not be stored.</p>"
msgstr ""
"<p><b>ລະຫັດຜ່ານທີ່ຈະຈື່ໄວ້</b>:\n"
"ປ້ອນຈຳນວນລະຫັດຜ່ານຂອງຜູ້ໃຊ້ທີ່ຈະເກັບໄວ້ເພື່ອປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ກັບມາໃຊ້ລະຫັດເກົ່າ.\n"
"ປ້ອນ 0 ຖ້າບໍ່ຕ້ອງການໃຫ້ເກັບລະຫັດຜ່ານໄວ້.</p>"

#. Password dialog help 5a/8
#: src/include/security/helps.rb:134
msgid "<p><b>Password Encryption Method:</b></p>"
msgstr "<p><b>ວິທີການເຂົ້າລະຫັດຜ່ານ:</b></p>"

#. Password dialog help 5b/8
#: src/include/security/helps.rb:136
msgid ""
"<p><b>DES</b>, the Linux default method, works in all network environments,\n"
"but it restricts you to passwords no longer than eight characters. If you "
"need\n"
"compatibility with other systems, use this method.</p>"
msgstr ""
"<p><b>DES</b>, ວິທີການເລີ່ມຕົ້ນຂອງ Linux, ໃຊ້ໄດ້ໃນທຸກສະພາບແວດລ້ອມເຄືອຂ່າຍ,\n"
"ແຕ່ມັນຈຳກັດລະຫັດຜ່ານບໍ່ໃຫ້ເກີນ 8 ຕົວອັກສອນ. ຖ້າທ່ານຕ້ອງການ\n"
"ຄວາມເຂົ້າກັນໄດ້ກັບລະບົບອື່ນໆ, ໃຫ້ໃຊ້ວິທີນີ້.</p>"

#. Password dialog help 5c/8
#: src/include/security/helps.rb:142
msgid ""
"<p><b>MD5</b> allows longer passwords and is supported by all current "
"Linux \n"
"distributions, but not by other systems or old software.</p>"
msgstr ""
"<p><b>MD5</b> ອະນຸຍາດໃຫ້ໃຊ້ລະຫັດຜ່ານທີ່ຍາວກວ່າ ແລະ ໄດ້ຮັບການຮອງຮັບໂດຍ Linux "
"distribution \n"
"ປັດຈຸບັນທັງໝົດ, ແຕ່ບໍ່ຮອງຮັບໂດຍລະບົບອື່ນ ຫຼື ຊອບແວເກົ່າ.</p>"

#. Password dialog help 5d/8
#: src/include/security/helps.rb:147
msgid ""
"<p><b>SHA-512</b> is the current standard hash method, using other "
"algorithms is not recommended unless needed for compatibility purpose.</p>"
msgstr ""
"<p><b>SHA-512</b> ແມ່ນວິທີການແຮຊ (hash) ມາດຕະຖານໃນປັດຈຸບັນ, ບໍ່ແນະນຳໃຫ້ໃຊ້ algorithm ອື່"
"ນ \n"
"ນອກຈາກມີຄວາມຈຳເປັນເພື່ອຄວາມເຂົ້າກັນໄດ້.</p>"

#. Password dialog help 7/8
#: src/include/security/helps.rb:152
msgid ""
"<p><b>Password Age:</b> Set the minimum and\n"
"maximum number of days a password may be used.</p>"
msgstr ""
"<p><b>ອາຍຸຂອງລະຫັດຜ່ານ:</b> ຕັ້ງຈຳນວນມື້ຕໍ່າສຸດ ແລະ\n"
"ສູງສຸດທີ່ສາມາດໃຊ້ລະຫັດຜ່ານນັ້ນໄດ້.</p>"

#. Password dialog help 8/8
#: src/include/security/helps.rb:157
msgid ""
"<p><b>Days before Password Expires Warning</b>: This entry sets the\n"
"number of days users are warned before their passwords expire. The longer "
"the\n"
"time, the less likely it is that someone can guess passwords.</p>"
msgstr ""
"<p><b>ຈຳນວນມື້ເຕືອນກ່ອນລະຫັດຜ່ານໝົດອາຍຸ</b>: ຄ່ານີ້ຕັ້ງຈຳນວນມື້\n"
"ທີ່ຈະເຕືອນຜູ້ໃຊ້ກ່ອນທີ່ລະຫັດຜ່ານຂອງພວກເຂົາຈະໝົດອາຍຸ. ຍິ່ງເວລານານເທົ່າໃດ,\n"
"ໂອກາດທີ່ຄົນອື່ນຈະເດົາລະຫັດຜ່ານກໍຍິ່ງໜ້ອຍລົງ.</p>"

#. Adduser dialog help 1/2
#: src/include/security/helps.rb:163
msgid ""
"<p><big><b>User Security</b></big></P>\n"
"<p>In this dialog, change various settings used to create users.</p>"
msgstr ""
"<p><big><b>ຄວາມປອດໄພຂອງຜູ້ໃຊ້</b></big></P>\n"
"<p>ໃນສ່ວນນີ້, ທ່ານສາມາດປ່ຽນການຕັ້ງຄ່າຕ່າງໆທີ່ໃຊ້ໃນການສ້າງຜູ້ໃຊ້.</p>"

#. Adduser dialog help 2/3
#: src/include/security/helps.rb:168
msgid ""
"<p><b>User ID Limitations:</b>\n"
"Set the minimum and maximum possible user ID.</p>"
msgstr ""
"<p><b>ຂໍ້ຈຳກັດ User ID:</b>\n"
"ຕັ້ງຄ່າ User ID ຕໍ່າສຸດ ແລະ ສູງສຸດທີ່ເປັນໄປໄດ້.</p>"

#. Adduser dialog help 3/3
#: src/include/security/helps.rb:172
msgid ""
"<p><b>Group ID Limitations</b>:\n"
"Set the minimum and maximum possible group ID.</p>"
msgstr ""
"<p><b>ຂໍ້ຈຳກັດ Group ID</b>:\n"
"ຕັ້ງຄ່າ Group ID ຕໍ່າສຸດ ແລະ ສູງສຸດທີ່ເປັນໄປໄດ້.</p>"

#. Misc dialog help 1/14
#: src/include/security/helps.rb:176
msgid ""
"<p><big><b>Other Security Settings</b></big></P>\n"
"<p>In this dialog, change miscellaneous settings related to local security.</"
"p>"
msgstr ""
"<p><big><b>ການຕັ້ງຄ່າຄວາມປອດໄພອື່ນໆ</b></big></P>\n"
"<p>ໃນສ່ວນນີ້, ທ່ານສາມາດປ່ຽນການຕັ້ງຄ່າຕ່າງໆ ທີ່ກ່ຽວຂ້ອງກັບຄວາມປອດໄພພາຍໃນເຄື່ອງ.</p>"

#. Misc dialog help 2/14
#: src/include/security/helps.rb:181
msgid ""
"<p><b>File Permissions</b>: Settings for the permissions\n"
"of certain system files are set according to the data in /etc/permissions."
"secure\n"
"or /etc/permissions.easy. Which file is used depends on this selection.\n"
"Launching SuSEconfig sets these permissions according to /etc/permissions."
"*.\n"
"This fixes files with incorrect permissions, whether this occurred "
"accidentally\n"
"or by intruders.</p><p>\n"
"With <b>Easy</b>, most of the system files that are only readable by root\n"
"in Secure are modified so other users can also read these files.\n"
"Using <b>Secure</b>, certain system files, such as /var/log/messages, can "
"only\n"
"be viewed by the user root. Some programs can only be launched by root or "
"by\n"
"daemons, not by ordinary users.\n"
"The most secure setting is <b>Paranoid</B>. With it, you must\n"
"decide which users are able to run X applications and setuid programs.</p>\n"
msgstr ""
"<p><b>ສິດການເຂົ້າເຖິງໄຟລ໌</b>: ການຕັ້ງຄ່າສິດສຳລັບໄຟລ໌ລະບົບບາງຢ່າງ\n"
"ຈະຖືກຕັ້ງຕາມຂໍ້ມູນໃນ /etc/permissions.secure ຫຼື /etc/permissions.easy. \n"
"ການເລືອກໄຟລ໌ໃດແມ່ນຂຶ້ນກັບການເລືອກນີ້. ການເປີດໃຊ້ SuSEconfig ຈະຕັ້ງສິດເຫຼົ່ານີ້ຕາມ /etc/"
"permissions.*.\n"
"ສິ່ງນີ້ຈະຊ່ວຍແກ້ໄຂໄຟລ໌ທີ່ມີສິດບໍ່ຖືກຕ້ອງ, ບໍ່ວ່າຈະເກີດຈາກຄວາມຜິດພາດ ຫຼື ຈາກຜູ້ບຸກລຸກ.</p><p>\n"
"ດ້ວຍ <b>ແບບງ່າຍ (Easy)</b>, ໄຟລ໌ລະບົບສ່ວນໃຫຍ່ທີ່ປົກກະຕິ root ເທົ່ານັ້ນທີ່ອ່ານໄດ້\n"
"ຈະຖືກປັບໃຫ້ຜູ້ໃຊ້ອື່ນສາມາດອ່ານໄດ້ນຳ. \n"
"ດ້ວຍ <b>ແບບປອດໄພ (Secure)</b>, ໄຟລ໌ລະບົບບາງຢ່າງ ເຊັ່ນ /var/log/messages ຈະສາມາດເບິ່ງໄ"
"ດ້\n"
"ໂດຍ root ເທົ່ານັ້ນ. ບາງໂປຣແກຣມຈະສາມາດລັນໄດ້ໂດຍ root ຫຼື ດີມອນເທົ່ານັ້ນ.\n"
"ການຕັ້ງຄ່າທີ່ປອດໄພທີ່ສຸດແມ່ນ <b>ແບບເຄັ່ງຄັດທີ່ສຸດ (Paranoid)</b>. ເຊິ່ງທ່ານຕ້ອງ\n"
"ຕັດສິນໃຈເອງວ່າຜູ້ໃຊ້ໃດສາມາດລັນແອັບພລິເຄຊັນ X ແລະ ໂປຣແກຣມ setuid ໄດ້.</p>\n"

#. Misc dialog help 6/14
#: src/include/security/helps.rb:197
msgid ""
"<p><b>User Launching updatedb</b>: The program updatedb runs \n"
"once a day. It scans your entire file system and creates a database "
"(locatedb)\n"
"that stores the location of every file. The database can be searched by the\n"
"program \"locate\".  Here, set the user that runs this command: <b>nobody</"
"b>\n"
"    (few files) or <b>root</b> (all files).</p>"
msgstr ""
"<p><b>ຜູ້ໃຊ້ທີ່ລັນ updatedb</b>: ໂປຣແກຣມ updatedb ຈະເຮັດວຽກມື້ລະເທື່ອ. \n"
"ມັນຈະສະແກນລະບົບໄຟລ໌ທັງໝົດ ແລະ ສ້າງຖານຂໍ້ມູນ (locatedb) \n"
"ທີ່ເກັບສະຖານທີ່ຂອງທຸກໄຟລ໌. ຖານຂໍ້ມູນນີ້ສາມາດຄົ້ນຫາໄດ້ດ້ວຍໂປຣແກຣມ \"locate\". \n"
"ທີ່ນີ້, ໃຫ້ຕັ້ງຜູ້ໃຊ້ທີ່ຈະລັນຄຳສັ່ງນີ້: <b>nobody</b> (ເຫັນໄຟລ໌ໜ້ອຍ) ຫຼື <b>root</b> (ເຫັນທຸກໄຟລ໌).</"
"p>"

#. Misc dialog help 10/14
#: src/include/security/helps.rb:205
msgid ""
"<p><b>Current Directory in root's Path</b> On a DOS system,\n"
"the system first searches for executable files (programs) in the current\n"
"directory then in the current path variable. In contrast, a UNIX-like "
"system\n"
"searches for them exclusively via the search path (variable PATH).</p>"
msgstr ""
"<p><b>ໄດເຣັກທໍຣີປັດຈຸບັນໃນ Path ຂອງ root</b> ໃນລະບົບ DOS,\n"
"ລະບົບຈະຄົ້ນຫາໄຟລ໌ທີ່ລັນໄດ້ (ໂປຣແກຣມ) ໃນໄດເຣັກທໍຣີປັດຈຸບັນກ່ອນ\n"
"ແລ້ວຈຶ່ງຫາໃນຕົວປ່ຽນ path. ໃນທາງກົງກັນຂ້າມ, ລະບົບທີ່ຄ້າຍຄື UNIX \n"
"ຈະຄົ້ນຫາຜ່ານ search path (ຕົວປ່ຽນ PATH) ເທົ່ານັ້ນ.</p>"

#. Misc dialog help 11/14
#: src/include/security/helps.rb:212
msgid ""
"<p><b>Current Directory in the Path of Regular Users</b><br> A DOS\n"
"system first searches for executable files (programs) in the current "
"directory\n"
"then in the current path variable. In contrast, a UNIX-like system searches\n"
"for them exclusively via the search path (variable PATH).</p>"
msgstr ""
"<p><b>ໄດເຣັກທໍຣີປັດຈຸບັນໃນ Path ຂອງຜູ້ໃຊ້ທົ່ວໄປ</b><br> ໃນລະບົບ DOS,\n"
"ລະບົບຈະຄົ້ນຫາໄຟລ໌ທີ່ລັນໄດ້ (ໂປຣແກຣມ) ໃນໄດເຣັກທໍຣີປັດຈຸບັນກ່ອນ\n"
"ແລ້ວຈຶ່ງຫາໃນຕົວປ່ຽນ path. ໃນທາງກົງກັນຂ້າມ, ລະບົບທີ່ຄ້າຍຄື UNIX \n"
"ຈະຄົ້ນຫາຜ່ານ search path (ຕົວປ່ຽນ PATH) ເທົ່ານັ້ນ.</p>"

#. Misc dialog help 12/14
#: src/include/security/helps.rb:219
msgid ""
"<p>Some systems set up a work-around by adding the dot (\".\") to the\n"
"search path, enabling files in the current path to be found and executed.\n"
"This is highly dangerous because you may accidentally launch unknown "
"programs in\n"
"the current directory instead of the usual systemwide files. As a result,\n"
"executing <i>Trojan Horses</i>, which exploit this weakness and invade your "
"system,\n"
"is rather easy if you set this option.</p>"
msgstr ""
"<p>ບາງລະບົບມີການແກ້ໄຂໂດຍການເພີ່ມຈຸດ (\".\") ເຂົ້າໃນ search path,\n"
"ເພື່ອໃຫ້ສາມາດຫາໄຟລ໌ໃນ path ປັດຈຸບັນ ແລະ ລັນໄດ້. ສິ່ງນີ້ເປັນອັນຕະລາຍຫຼາຍ\n"
"ເພາະທ່ານອາດຈະລັນໂປຣແກຣມທີ່ບໍ່ຮູ້ຈັກໃນໄດເຣັກທໍຣີປັດຈຸບັນໂດຍບັງເອີນ\n"
"ແທນທີ່ຈະເປັນໄຟລ໌ລະບົບປົກກະຕິ. ສົ່ງຜົນໃຫ້ການລັນ <i>ມ້ານົດ (Trojan Horses)</i> \n"
"ເຊິ່ງໃຊ້ຈຸດອ່ອນນີ້ເຂົ້າບຸກລຸກລະບົບຂອງທ່ານເຮັດໄດ້ງ່າຍຂຶ້ນ ຖ້າທ່ານເປີດຕົວເລືອກນີ້.</p>"

#. Misc dialog help 13/14
#: src/include/security/helps.rb:229
msgid ""
"<p>\"yes\": the dot (\".\") is attached to the end of the search\n"
"path of root, making it the last to be searched.</p>"
msgstr ""
"<p>\"yes\": ຈຸດ (\".\") ຈະຖືກເພີ່ມເຂົ້າທາງທ້າຍຂອງ search path \n"
"ຂອງ root, ເຮັດໃຫ້ມັນເປັນບ່ອນສຸດທ້າຍທີ່ຈະຖືກຄົ້ນຫາ.</p>"

#. Misc dialog help 14/14
#: src/include/security/helps.rb:234
msgid ""
"<p>\"no\": the user root always must launch programs in the\n"
"current directory prefixed with a \"./\". Example: \"./configure\".</p>"
msgstr ""
"<p>\"no\": ຜູ້ໃຊ້ root ຈະຕ້ອງລັນໂປຣແກຣມໃນໄດເຣັກທໍຣີປັດຈຸບັນ\n"
"ໂດຍການໃຊ້ \"./\" ນຳໜ້າສະເໝີ. ຕົວຢ່າງ: \"./configure\".</p>"

#. Misc dialog help 14/14
#: src/include/security/helps.rb:239
msgid ""
"<p><b>Enable Magic SysRq Keys</b><br> If you check this option, you\n"
"will have some control over the system even if it crashes (for example, "
"during kernel\n"
"debugging). For details, see /usr/src/linux/Documentation/sysrq.txt</p>"
msgstr ""
"<p><b>ເປີດໃຊ້ Magic SysRq Keys</b><br> ຖ້າທ່ານເລືອກຕົວເລືອກນີ້, ທ່ານ\n"
"ຈະສາມາດຄວບຄຸມລະບົບບາງຢ່າງໄດ້ ເຖິງແມ່ນວ່າລະບົບຈະຄ້າງ (ຕົວຢ່າງ: ໃນລະຫວ່າງ\n"
"ການດີບັກ kernel). ສຳລັບລາຍລະອຽດ, ເບິ່ງ /usr/src/linux/Documentation/sysrq.txt</p>"

#. help text: security overview dialog 1/
#: src/include/security/helps.rb:246
msgid ""
"<P><B>Security Overview</B><BR>This overview shows the most important "
"security settings.</P>"
msgstr ""
"<P><B>ພາບລວມຄວາມປອດໄພ</B><BR>ພາບລວມນີ້ສະແດງການຕັ້ງຄ່າຄວາມປອດໄພທີ່ສຳຄັນທີ່ສຸດ.</P>"

#. help text: security overview dialog 1/
#: src/include/security/helps.rb:251
msgid ""
"<P>To change the current value, click the link associated to the option.</P>"
msgstr "<P>ເພື່ອປ່ຽນຄ່າປັດຈຸບັນ, ໃຫ້ຄລິກທີ່ລິ້ງທີ່ກ່ຽວຂ້ອງກັບຕົວເລືອກນັ້ນ.</P>"

#. help text: security overview dialog 1/
#: src/include/security/helps.rb:255
msgid ""
"<P> A check mark in the <B>Security Status</B> column means that the current "
"value of the option is secure.</P>"
msgstr ""
"<P> ເຄື່ອງໝາຍຖືກໃນຖັນ <B>ສະຖານະຄວາມປອດໄພ (Security Status)</B> ໝາຍຄວາມວ່າຄ່າປັດຈຸບັນຂອ"
"ງຕົວເລືອກນັ້ນປອດໄພແລ້ວ.</P>"

#. an error message (rich text)
#: src/include/security/helps.rb:260
msgid ""
"<P><B>The current value could not be read. The service is probably not "
"installed or the option is missing on the system.</B></P>"
msgstr ""
"<P><B>ບໍ່ສາມາດອ່ານຄ່າປັດຈຸບັນໄດ້. ການບໍລິການອາດຈະບໍ່ໄດ້ຕິດຕັ້ງ ຫຼື ບໍ່ມີຕົວເລືອກນີ້ໃນລະບົບ.</B></P>"

#: src/include/security/helps.rb:267
msgid ""
"<P>A display manager provides a graphical login screen and can be accessed\n"
"across the network by an X server running on another system if so\n"
"configured.</P><P>The windows that are being displayed would then transmit\n"
"their data across the network. If that network is not fully trusted, then "
"the\n"
"network traffic can be eavesdropped by an attacker, gaining access not only "
"to\n"
"the graphical content of the display, but also to usernames and passwords "
"that\n"
"are being used.</P><P>If you do not need <EM>XDMCP</EM> for remote "
"graphical\n"
"logins, then disable this option.</P>"
msgstr ""
"<P>ຕົວຈັດການການສະແດງຜົນມີໜ້າຈໍການເຂົ້າສູ່ລະບົບແບບກຣາຟິກ ແລະ ສາມາດເຂົ້າເຖິງ\n"
"ຜ່ານເຄືອຂ່າຍໂດຍ X server ທີ່ເຮັດວຽກຢູ່ໃນລະບົບອື່ນໄດ້ ຖ້າຖືກຕັ້ງຄ່າໄວ້.</P><P>ໜ້າຕ່າງທີ່ສະແດງ\n"
"ຈະສົ່ງຂໍ້ມູນຜ່ານເຄືອຂ່າຍ. ຫາກເຄືອຂ່າຍນັ້ນບໍ່ປອດໄພ, \n"
"ຂໍ້ມູນອາດຈະຖືກລັກດັກຟັງໂດຍຜູ້ບຸກລຸກ, ເຮັດໃຫ້ພວກເຂົາເຂົ້າເຖິງໄດ້ບໍ່ພຽງແຕ່\n"
"ເນື້ອໃນກຣາຟິກເທົ່ານັ້ນ, ແຕ່ຍັງລວມເຖິງຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານນຳ.</P><P>ຖ້າທ່ານບໍ່ຈຳເປັນຕ້ອງໃຊ້ <EM>"
"XDMCP</EM> \n"
"ສຳລັບການເຂົ້າສູ່ລະບົບແບບກຣາຟິກຈາກທາງໄກ, ໃຫ້ປິດໃຊ້ຕົວເລືອກນີ້.</P>"

#: src/include/security/helps.rb:277
msgid ""
"<P>Malfunctions in a system are usually detected by anomalies in its "
"behaviour. Syslog messages about events that reoccur on a regular basis are "
"important to find causes of problems. And the absence of a single record can "
"tell more than the absence of all log records.</P><P>Therefore, syslog "
"messages of system events are only useful if they are present.</P>"
msgstr ""
"<P>ການເຮັດວຽກທີ່ຜິດປົກກະຕິຂອງລະບົບມັກຈະກວດພົບໄດ້ຈາກພຶດຕິກຳທີ່ແປກໄປ. ຂໍ້ຄວາມ Syslog ກ່ຽວກັບເຫດກາ"
"ນທີ່ເກີດຂຶ້ນຊໍ້າໆ ເປັນສິ່ງສຳຄັນໃນການຫາສາເຫດຂອງບັນຫາ. ແລະ ການທີ່ບໍ່ມີບັນທຶກບາງຢ່າງອາດຈະບອກຫຍັງໄດ້ຫຼາຍ"
"ກວ່າການທີ່ບໍ່ມີບັນທຶກເລີຍ.</P><P>ດັ່ງນັ້ນ, ຂໍ້ຄວາມ syslog ຂອງເຫດການລະບົບຈະມີປະໂຫຍດກໍຕໍ່ເມື່ອມີການບັນທຶ"
"ກໄວ້.</P>"

#: src/include/security/helps.rb:284
msgid ""
"<P>Chroot execution environments restrict a process to only access files "
"that it needs by placing them in a separate subdirectory and running the "
"process with a changed root (chroot) set to that directory.</P>"
msgstr ""
"<P>ສະພາບແວດລ້ອມການເຮັດວຽກແບບ Chroot ຈະຈຳກັດໃຫ້ໂປຣເຊສເຂົ້າເຖິງໄດ້ສະເພາະໄຟລ໌ທີ່ຈຳເປັນ ໂດຍກາ"
"ນວາງພວກມັນໄວ້ໃນໄດເຣັກທໍຣີຍ່ອຍແຍກຕ່າງຫາກ ແລະ ລັນໂປຣເຊສດ້ວຍການປ່ຽນ root (chroot) ໄປທີ່ໄດເຣັກ"
"ທໍຣີນັ້ນ.</P>"

#: src/include/security/helps.rb:289
msgid ""
"<P>The DHCP client daemon should run as the user <EM>dhcpd</EM> to minimize "
"a possible threat if the service is found vulnerable to a weakness in its "
"program code.</P><P>Note that dhcpd must never run as <EM>root</EM> or with "
"the <EM>CAP_SYS_CHROOT</EM> capability for the chroot execution confinement "
"to be effective.</P>"
msgstr ""
"<P>ດີມອນ DHCP client ຄວນເຮັດວຽກໃນນາມຜູ້ໃຊ້ <EM>dhcpd</EM> ເພື່ອຫຼຸດຜ່ອນໄພຄຸກຄາມທີ່ອາດເກີດຂຶ້"
"ນ ຫາກພົບວ່າການບໍລິການມີຈຸດອ່ອນໃນໂຄ້ດໂປຣແກຣມ.</P><P>ໝາຍເຫດ: dhcpd ຈະຕ້ອງບໍ່ລັນໃນນາມ <EM>"
"root</EM> ຫຼື ໃຊ້ຄວາມສາມາດ <EM>CAP_SYS_CHROOT</EM> ເພື່ອໃຫ້ການຈຳກັດດ້ວຍ chroot ມີປະສິດທິ"
"ພາບ.</P>"

#: src/include/security/helps.rb:296
msgid ""
"<P>Administrators should never log on as <EM>root</EM> into an X Window "
"session to minimize the usage of the root privileges.</P><P>This option does "
"not help against careless administrators, but shall prevent attackers to be "
"able to log on as <EM>root</EM> via the display manager if they guess or "
"otherwise acquire the password.</P>"
msgstr ""
"<P>ຜູ້ດູແລລະບົບບໍ່ຄວນເຂົ້າສູ່ລະບົບດ້ວຍ <EM>root</EM> ໃນເຊດຊັນ X Window ເພື່ອຫຼຸດຜ່ອນການໃຊ້ສິດ "
"root ໂດຍບໍ່ຈຳເປັນ.</P><P>ຕົວເລືອກນີ້ບໍ່ໄດ້ຊ່ວຍປ້ອງກັນຜູ້ດູແລລະບົບທີ່ປະໝາດ, ແຕ່ຈະຊ່ວຍປ້ອງກັນບໍ່ໃຫ້ຜູ້ບຸກລຸກສ"
"າມາດເຂົ້າສູ່ລະບົບເປັນ <EM>root</EM> ຜ່ານຕົວຈັດການການສະແດງຜົນໄດ້ ຫາກພວກເຂົາເດົາ ຫຼື ໄດ້ລະຫັດຜ່ານ"
"ໄປ.</P>"

#: src/include/security/helps.rb:303
msgid ""
"<P>X Window clients, e.g. programs that open a window on your display, "
"connect\n"
"to the X server that runs on the physical machine. Programs can also run on "
"a\n"
"different system and display their content on the X server through network\n"
"connections.</P><P>When enabled, the X server listens on a port 6000 plus "
"the\n"
"display number. Since network traffic is transferred unencrypted and "
"therefore\n"
"subject to network sniffing, and since the port held open by the X server\n"
"offers attack options, the secure setting is to disable it.</P><P>To display "
"X\n"
"Window clients across a network, we recommend the use of secure shell "
"(<EM>ssh</EM>), which allows the X Window clients to connect to the X server "
"through the encrypted ssh connection.</P>"
msgstr ""
"<P>X Window clients ເຊັ່ນ ໂປຣແກຣມທີ່ເປີດໜ້າຕ່າງເທິງຈໍພາບຂອງທ່ານ, ຈະເຊື່ອມຕໍ່\n"
"ກັບ X server ທີ່ເຮັດວຽກຢູ່ໃນເຄື່ອງ. ໂປຣແກຣມຍັງສາມາດເຮັດວຽກໃນ\n"
"ລະບົບອື່ນ ແລະ ສະແດງເນື້ອໃນໃນ X server ຜ່ານການເຊື່ອມຕໍ່ເຄືອຂ່າຍໄດ້.</P><P>ເມື່ອເປີດໃຊ້ງານ, X "
"server ຈະລໍຖ້າການເຊື່ອມຕໍ່ທີ່ພອດ 6000 ບວກກັບ\n"
"ໝາຍເລກ display. ເນື່ອງຈາກຂໍ້ມູນເຄືອຂ່າຍຖືກສົ່ງໂດຍບໍ່ໄດ້ເຂົ້າລະຫັດ ແລະ \n"
"ອາດຖືກດັກຟັງໄດ້, ແລະ ພອດທີ່ເປີດໄວ້ໂດຍ X server ອາດເປັນຊ່ອງທາງໃຫ້ບຸກລຸກ, ການຕັ້ງຄ່າທີ່ປອດໄພຄືການປິ"
"ດໃຊ້ມັນ.</P><P>ເພື່ອສະແດງ X Window clients ຜ່ານເຄືອຂ່າຍ, ພວກເຮົາແນະນຳໃຫ້ໃຊ້ secure "
"shell (<EM>ssh</EM>), \n"
"ເຊິ່ງຊ່ວຍໃຫ້ X Window clients ເຊື່ອມຕໍ່ກັບ X server ຜ່ານການເຊື່ອມຕໍ່ ssh ທີ່ເຂົ້າລະຫັດໄວ້.</P>"

#: src/include/security/helps.rb:315
msgid ""
"<P>The email delivery subsystem is always started. However, it does not "
"expose\n"
"itself outside the system by default, since it does not listen on the SMTP "
"network port 25.</P><P>If you do not deliver emails to your system through "
"the SMTP protocol, then disable this option.</P>"
msgstr ""
"<P>ລະບົບຍ່ອຍການສົ່ງອີເມວຈະຖືກເລີ່ມຕົ້ນສະເໝີ. ເຖິງຢ່າງໃດກໍຕາມ, ໂດຍເລີ່ມຕົ້ນມັນຈະບໍ່ເປີດ\n"
"ໃຫ້ພາຍນອກເຂົ້າເຖິງໄດ້ ເພາະມັນບໍ່ໄດ້ລໍຖ້າການເຊື່ອມຕໍ່ທີ່ພອດ SMTP 25.</P><P>ຖ້າທ່ານບໍ່ໄດ້ຮັບອີເມວເຂົ້າລະບົ"
"ບຂອງທ່ານຜ່ານໂປຣໂຕຄໍ SMTP, ໃຫ້ປິດໃຊ້ຕົວເລືອກນີ້.</P>"

#: src/include/security/helps.rb:321
msgid ""
"<P>If a package containing a service that is currently running is being\n"
"updated, the service is restarted after the files in the package have been\n"
"installed.</P><P>This makes sense in most cases, and it is safe to do,\n"
"considering that many services either need their binaries or configuration\n"
"files accessible in the file system. Otherwise these services would "
"continue\n"
"to run until the services are stopped, e.g. running daemons are\n"
"killed.</P><P>This setting should only be changed if there is a specific\n"
"reason to do so.</P>"
msgstr ""
"<P>ຫາກແພັກເກັດທີ່ມີການບໍລິການທີ່ກຳລັງເຮັດວຽກຢູ່ຖືກອັບເດດ,\n"
"ການບໍລິການນັ້ນຈະຖືກເລີ່ມໃໝ່ຫຼັງຈາກໄຟລ໌ໃນແພັກເກັດຖືກຕິດຕັ້ງແລ້ວ.</P><P>ສິ່ງນີ້ເໝາະສົມໃນເກືອບທຸກກໍລະນີ ແລ"
"ະ ປອດໄພທີ່ຈະເຮັດ,\n"
"ເນື່ອງຈາກຫຼາຍການບໍລິການຈຳເປັນຕ້ອງເຂົ້າເຖິງໄຟລ໌ binary ຫຼື ໄຟລ໌ຕັ້ງຄ່າໃໝ່.\n"
"ຖ້າບໍ່ດັ່ງນັ້ນ, ການບໍລິການເຫຼົ່ານີ້ຈະຍັງເຮັດວຽກຕໍ່ໄປຈົນກວ່າຈະຖືກຢຸດເອງ.</P><P>ການຕັ້ງຄ່ານີ້ຄວນປ່ຽນແປງກໍຕໍ່ເມື່"
"ອມີເຫດຜົນສະເພາະເທົ່ານັ້ນ.</P>"

#: src/include/security/helps.rb:331
msgid ""
"<P>If a package containing a service that is currently running is being\n"
"uninstalled, the service is stopped before the files of the package are\n"
"removed.</P><P>This makes sense in most cases, and it is safe to do,\n"
"considering that many services either need their binaries or configuration\n"
"files accessible in the file system. Otherwise these services would "
"continue\n"
"to run until they are stopped, e.g. running daemons are\n"
"killed.</P><P>This setting should only be changed if there is a specific\n"
"reason to do so.</P>"
msgstr ""
"<P>ຫາກແພັກເກັດທີ່ມີການບໍລິການທີ່ກຳລັງເຮັດວຽກຢູ່ຖືກຖອນການຕິດຕັ້ງ,\n"
"ການບໍລິການນັ້ນຈະຖືກຢຸດກ່ອນທີ່ໄຟລ໌ຂອງແພັກເກັດຈະຖືກລຶບອອກ.</P><P>ສິ່ງນີ້ເໝາະສົມໃນເກືອບທຸກກໍລະນີ ແລະ ປອ"
"ດໄພທີ່ຈະເຮັດ,\n"
"ເນື່ອງຈາກຫຼາຍການບໍລິການຈຳເປັນຕ້ອງເຂົ້າເຖິງໄຟລ໌ໃນລະບົບ. ຖ້າບໍ່ດັ່ງນັ້ນ,\n"
"ການບໍລິການຈະຍັງເຮັດວຽກຕໍ່ໄປຈົນກວ່າຈະຖືກຢຸດ.</P><P>ການຕັ້ງຄ່ານີ້ຄວນປ່ຽນແປງກໍຕໍ່ເມື່ອມີເຫດຜົນສະເພາະເທົ່າ"
"ນັ້ນ.</P>"

#: src/include/security/helps.rb:341
msgid ""
"<P>A system can be overwhelmed with numerous connection attempts so that the "
"system runs out of memory, leading to a Denial of Service (DoS) "
"vulnerability.</P><P>The use of syncookies is a method that can help in such "
"situations. But in configurations with a very large number of legitimate "
"connection attempts from one source, the <EM>Enabled</EM> setting can cause "
"problems with denied TCP connections under high load.</P><P>Still, for most "
"environments, syncookies are the first line of defense against SYN flood DoS "
"attacks, so the secure setting is <EM>Enabled</EM>.</P>"
msgstr ""
"<P>ລະບົບອາດຈະຖືກໂຈມຕີດ້ວຍການພະຍາຍາມເຊື່ອມຕໍ່ຈຳນວນມະຫາສານຈົນເຮັດໃຫ້ໜ່ວຍຄວາມຈຳເຕັມ, ນຳໄປສູ່ຊ່ອງ"
"ໂຫວ່ Denial of Service (DoS).</P><P>ການໃຊ້ syncookies ແມ່ນວິທີໜຶ່ງທີ່ຊ່ວຍໃນສະຖານະການນີ້ໄ"
"ດ້. ແຕ່ໃນການຕັ້ງຄ່າທີ່ມີການເຊື່ອມຕໍ່ທີ່ຖືກຕ້ອງຈຳນວນຫຼາຍຈາກແຫຼ່ງດຽວ, ການ <EM>ເປີດໃຊ້</EM> ອາດເຮັດໃຫ້ເ"
"ກີດບັນຫາການປະຕິເສດການເຊື່ອມຕໍ່ TCP ພາຍໃຕ້ການເຮັດວຽກໜັກ.</P><P>ແນວໃດກໍຕາມ, ສຳລັບສະພາບແວດລ້ອ"
"ມສ່ວນໃຫຍ່, syncookies ແມ່ນດ່ານທຳອິດໃນການປ້ອງກັນການໂຈມຕີ SYN flood DoS, ດັ່ງນັ້ນການຕັ້ງຄ່າທີ່ປອ"
"ດໄພຄື <EM>ເປີດໃຊ້ (Enabled)</EM>.</P>"

#: src/include/security/helps.rb:352 src/include/security/helps.rb:361
msgid ""
"<P>IP forwarding means to pass on network packets that have been received, "
"but that are not destined for one of the system's configured network "
"interfaces, e.g. network interface addresses.</P><P>If a system forwards "
"network traffic on ISO/OSI layer 3, it is called a router. If you do not "
"need that routing functionality, then disable this option.</P>"
msgstr ""
"<P>IP forwarding ໝາຍເຖິງການສົ່ງຕໍ່ແພັກເກັດເຄືອຂ່າຍທີ່ໄດ້ຮັບມາ ແຕ່ບໍ່ໄດ້ມີປາຍທາງມາທີ່ອິນເຕີເຟດເຄືອຂ່າຍ"
"ຂອງລະບົບນີ້.</P><P>ຫາກລະບົບສົ່ງຕໍ່ຂໍ້ມູນເຄືອຂ່າຍໃນ ISO/OSI layer 3, ມັນຈະຖືກເອີ້ນວ່າ ເຣົາເຕີ "
"(router). ຖ້າທ່ານບໍ່ຈຳເປັນຕ້ອງໃຊ້ຟັງຊັນການເຣົາຕິ້ງນັ້ນ, ໃຫ້ປິດໃຊ້ຕົວເລືອກນີ້.</P>"

#: src/include/security/helps.rb:360
msgid "<P>This setting applies to <EM>IPv4</EM> only.</P>"
msgstr "<P>ການຕັ້ງຄ່ານີ້ໃຊ້ກັບ <EM>IPv4</EM> ເທົ່ານັ້ນ.</P>"

#: src/include/security/helps.rb:369
msgid "<P>This setting applies to <EM>IPv6</EM> only.</P>"
msgstr "<P>ການຕັ້ງຄ່ານີ້ໃຊ້ກັບ <EM>IPv6</EM> ເທົ່ານັ້ນ.</P>"

#: src/include/security/helps.rb:370
msgid ""
"<P>Magic SysRq Keys enable some control over the system even if it crashes "
"(e.g. during kernel debugging) or if the system does not respond.</P>"
msgstr ""
"<P>Magic SysRq Keys ຊ່ວຍໃຫ້ສາມາດຄວບຄຸມລະບົບບາງຢ່າງໄດ້ ເຖິງແມ່ນວ່າລະບົບຈະຄ້າງ (ເຊັ່ນ: ໃນລະຫ"
"ວ່າງການດີບັກ kernel) ຫຼື ເມື່ອລະບົບບໍ່ຕອບສະໜອງ.</P>"

#: src/include/security/helps.rb:375
msgid ""
"<P>There are predefined file permissions in /etc/permissions.* files. The "
"most restrictive file permissions are defined 'secure' or 'paranoid' file.</"
"P>"
msgstr ""
"<P>ມີການກຳນົດສິດການເຂົ້າເຖິງໄຟລ໌ໄວ້ລ່ວງໜ້າໃນໄຟລ໌ /etc/permissions.*. ສິດທີ່ເຄັ່ງຄັດທີ່ສຸດຈະຖືກກຳນົດ"
"ໄວ້ໃນໄຟລ໌ 'secure' ຫຼື 'paranoid'.</P>"

#: src/include/security/helps.rb:380
msgid ""
"<P>Basic system services must be enabled to provide system consistency and "
"to run the security-related services.</P>"
msgstr ""
"<P>ການບໍລິການລະບົບພື້ນຖານຕ້ອງຖືກເປີດໃຊ້ເພື່ອໃຫ້ລະບົບເຮັດວຽກໄດ້ຢ່າງຕໍ່ເນື່ອງ ແລະ ເພື່ອລັນການບໍລິການທີ່ກ່ຽວ"
"ຂ້ອງກັບຄວາມປອດໄພ.</P>"

#: src/include/security/helps.rb:384
msgid ""
"<P>Every running service is a potential target of a security attack. "
"Therefore it is recommended to turn off all services which are not used by "
"the system.</P>"
msgstr ""
"<P>ທຸກໆການບໍລິການທີ່ກຳລັງເຮັດວຽກລ້ວນແຕ່ເປັນເປົ້າໝາຍຂອງການໂຈມຕີ. ດັ່ງນັ້ນ ຈຶ່ງແນະນຳໃຫ້ປິດການບໍລິການທັງ"
"ໝົດທີ່ບໍ່ໄດ້ຖືກໃຊ້ງານໃນລະບົບ.</P>"

#: src/include/security/helps.rb:393
msgid ""
"<p><b><big>Boot Security</big></b></p>\n"
"<p>In this dialog, change various boot settings related to security.</p>"
msgstr ""
"<p><b><big>ຄວາມປອດໄພໃນການບູດ</big></b></p>\n"
"<p>ໃນສ່ວນນີ້, ທ່ານສາມາດປ່ຽນການຕັ້ງຄ່າການບູດຕ່າງໆ ທີ່ກ່ຽວຂ້ອງກັບຄວາມປອດໄພ.</p>"

#. TRANSLATORS: part of help text - default action (the default is
#. reboot)
#: src/include/security/helps.rb:401
msgid ""
"Usually the system reboots. Sometimes it is desirable\n"
"to ignore this event, for example, when the system serves as both\n"
"workstation and server."
msgstr ""
"ໂດຍປົກກະຕິລະບົບຈະເລີ່ມໃໝ່ (reboot). ບາງຄັ້ງອາດຈະຕ້ອງການ\n"
"ໃຫ້ລະບົບເມີນເສີຍຕໍ່ເຫດການນີ້, ຕົວຢ່າງ: ເມື່ອລະບົບເຮັດວຽກເປັນທັງ\n"
"ສະຖານີວຽກ ແລະ ເຊີເວີ."

#. TRANSLATORS: part of help text - default action (the default is halt)
#: src/include/security/helps.rb:408
msgid ""
"By default the system halts but sometimes it is desirable\n"
"to ignore this event, for example, when the system serves as both\n"
"workstation and server."
msgstr ""
"ໂດຍເລີ່ມຕົ້ນລະບົບຈະຢຸດເຮັດວຽກ (halt) ແຕ່ບາງຄັ້ງອາດຈະຕ້ອງການ\n"
"ໃຫ້ລະບົບເມີນເສີຍຕໍ່ເຫດການນີ້, ຕົວຢ່າງ: ເມື່ອລະບົບເຮັດວຽກເປັນທັງ\n"
"ສະຖານີວຽກ ແລະ ເຊີເວີ."

#. Boot dialog help 2/4
#. TRANSLATORS: %s is help text - default action
#: src/include/security/helps.rb:417
#, c-format
msgid ""
"<p><b>Interpretation of Ctrl + Alt + Del</b>:\n"
"Configure what the system should do in response to\n"
"someone at the console pressing the CTRL + ALT + DEL key\n"
"combination. %s</p>"
msgstr ""
"<p><b>ການຕີຄວາມໝາຍຂອງ Ctrl + Alt + Del</b>:\n"
"ຕັ້ງຄ່າວ່າລະບົບຄວນເຮັດແນວໃດ ເມື່ອມີຄົນຢູ່ໜ້າເຄື່ອງກົດປຸ່ມ\n"
"CTRL + ALT + DEL ພ້ອມກັນ. %s</p>"

#. Boot dialog help 3/4
#: src/include/security/helps.rb:426
#, c-format
msgid ""
"<p><b>Shutdown Behaviour of Login Manager</b>:\n"
"Set who is allowed to shut down the machine from %s.</p>\n"
msgstr ""
"<p><b>ພຶດຕິກຳການປິດເຄື່ອງຂອງຕົວຈັດການການເຂົ້າສູ່ລະບົບ</b>:\n"
"ຕັ້ງຄ່າວ່າໃຜແດ່ທີ່ໄດ້ຮັບອະນຸຍາດໃຫ້ປິດເຄື່ອງຈາກ %s.</p>\n"

#. Boot dialog help 4/4
#: src/include/security/helps.rb:431
msgid ""
"<p><b>Hibernate System</b>:\n"
"Set the conditions for allowing users to hibernate the system. By default, "
"user on active console has such right.\n"
"Other options are allowing the action to any user or requiring "
"authentication in all cases.</p>\n"
msgstr ""
"<p><b>ການພັກເຄື່ອງ (Hibernate)</b>:\n"
"ຕັ້ງເງື່ອນໄຂໃນການອະນຸຍາດໃຫ້ຜູ້ໃຊ້ພັກເຄື່ອງ. ໂດຍເລີ່ມຕົ້ນ, ຜູ້ໃຊ້ທີ່ຢູ່ໜ້າເຄື່ອງມີສິດນີ້.\n"
"ຕົວເລືອກອື່ນແມ່ນອະນຸຍາດໃຫ້ຜູ້ໃຊ້ທຸກຄົນ ຫຼື ຕ້ອງມີການຢືນຢັນຕົວຕົນໃນທຸກກໍລະນີ.</p>\n"

