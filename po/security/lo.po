#. translators: command line help text for Security module
#: src/clients/security.rb:55
msgid "Security configuration module"
msgstr "ໂມດູນການຕັ້ງຄ່າຄວາມປອດໄພ"

#. command line help text for 'summary' action
#: src/clients/security.rb:68
msgid "View summary of current configuration"
msgstr "ເບິ່ງບົດສະຫຼຸບຂອງການຕັ້ງຄ່າປັດຈຸບັນ"

#. command line help text for 'level' action
#: src/clients/security.rb:75
msgid "Set the security level"
msgstr "ຕັ້ງລະດັບຄວາມປອດໄພ"

#. command line help text for 'set' action
#: src/clients/security.rb:82
msgid "Set the value of the specific option"
msgstr "ຕັ້ງຄ່າຂອງຕົວເລືອກທີ່ລະບຸ"

#. command line help text for 'level workstation' option
#: src/clients/security.rb:90
msgid "Workstation security level"
msgstr "ລະດັບຄວາມປອດໄພສຳລັບສະຖານີວຽກ"

#. command line help text for 'level roaming' option
#: src/clients/security.rb:96
msgid "Roaming Device (e.g. laptop or tablet) security level"
msgstr "ລະດັບຄວາມປອດໄພສຳລັບອຸປະກອນເຄື່ອນທີ່ (ເຊັ່ນ: ແລັບທັອບ ຫຼື ແທັບເລັດ)"

#. command line help text for 'level server' option
#: src/clients/security.rb:102
msgid "Network Server security level"
msgstr "ລະດັບຄວາມປອດໄພສຳລັບເຊີເວີເຄືອຂ່າຍ"

#. command line help text for 'set passwd' option
#: src/clients/security.rb:108
msgid "Password encryption method"
msgstr "ວິທີການເຂົ້າລະຫັດຜ່ານ"

#. command line help text for 'set crack' option
#: src/clients/security.rb:116
msgid "Check new passwords"
msgstr "ກວດສອບລະຫັດຜ່ານໃໝ່"

#. command line help text for 'set permissions' option
#: src/clients/security.rb:124
msgid "Set file permissions to desired type"
msgstr "ຕັ້ງສິດການເຂົ້າເຖິງໄຟລ໌ຕາມປະເພດທີ່ຕ້ອງການ"

#. command line help text for 'set remember' option
#: src/clients/security.rb:132
msgid "Set the number of remembered user passwords"
msgstr "ຕັ້ງຈຳນວນລະຫັດຜ່ານຂອງຜູ້ໃຊ້ທີ່ຈະຈື່ໄວ້"

#. error message
#: src/clients/security.rb:245
msgid "The number of passwords to remember must be between 0 an 400."
msgstr "ຈຳນວນລະຫັດຜ່ານທີ່ຈະຈື່ໄວ້ຕ້ອງຢູ່ລະຫວ່າງ 0 ຫາ 400."

#. Checking value semantic
#: src/clients/security_auto.rb:95
msgid "Wrong SELinux mode. Possible values: "
msgstr "ໂໝດ SELinux ບໍ່ຖືກຕ້ອງ. ຄ່າທີ່ເປັນໄປໄດ້ແມ່ນ: "

#. Main dialog caption
#: src/include/security/complex.rb:56
msgid "Local Security Configuration"
msgstr "ການຕັ້ງຄ່າຄວາມປອດໄພພາຍໃນເຄື່ອງ"

#. RadioButton label
#: src/include/security/complex.rb:91
msgid "&Custom Settings"
msgstr "ການຕັ້ງຄ່າ&ກຳນົດເອງ"

#. Frame caption
#: src/include/security/complex.rb:105
msgid "Security Settings"
msgstr "ການຕັ້ງຄ່າຄວາມປອດໄພ"

