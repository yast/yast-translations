#: src/include/security/dialogs.rb:69
msgid "Remote access to the display manager"
msgstr "ການເຂົ້າເຖິງຕົວຈັດການການສະແດງຜົນຈາກທາງໄກ"

#: src/include/security/dialogs.rb:72
msgid "Always generate syslog message for cron scripts"
msgstr "ສ້າງຂໍ້ຄວາມ syslog ສຳລັບສະຄຣິບ cron ສະເໝີ"

#: src/include/security/dialogs.rb:75
msgid "Run the DHCP daemon in a chroot"
msgstr "ລັນດີມອນ DHCP ໃນ chroot"

#: src/include/security/dialogs.rb:78
msgid "Run the DHCP daemon as dhcp user"
msgstr "ລັນດີມອນ DHCP ໃນນາມຜູ້ໃຊ້ dhcp"

#: src/include/security/dialogs.rb:81
msgid "Remote root login in the display manager"
msgstr "ການເຂົ້າສູ່ລະບົບດ້ວຍ root ຈາກທາງໄກໃນຕົວຈັດການການສະແດງຜົນ"

#: src/include/security/dialogs.rb:84
msgid "Remote access to the X server"
msgstr "ການເຂົ້າເຖິງ X server ຈາກທາງໄກ"

#: src/include/security/dialogs.rb:87
msgid "Remote access to the email delivery subsystem"
msgstr "ການເຂົ້າເຖິງລະບົບຍ່ອຍການສົ່ງອີເມວຈາກທາງໄກ"

#: src/include/security/dialogs.rb:90
msgid "Restart services on update"
msgstr "ເລີ່ມການບໍລິການໃໝ່ເມື່ອມີການອັບເດດ"

#: src/include/security/dialogs.rb:93
msgid "Stop services on removal"
msgstr "ຢຸດການບໍລິການເມື່ອມີການຖອນການຕິດຕັ້ງ"

#: src/include/security/dialogs.rb:96
msgid "Enable TCP syncookies"
msgstr "ເປີດໃຊ້ TCP syncookies"

#: src/include/security/dialogs.rb:99
msgid "IPv4 forwarding"
msgstr "ການສົ່ງຕໍ່ IPv4"

#: src/include/security/dialogs.rb:100
msgid "IPv6 forwarding"
msgstr "ການສົ່ງຕໍ່ IPv6"

#: src/include/security/dialogs.rb:101
msgid "Enable basic system services"
msgstr "ເປີດໃຊ້ການບໍລິການລະບົບພື້ນຖານ"

#: src/include/security/dialogs.rb:104
msgid "Disable extra services"
msgstr "ປິດໃຊ້ການບໍລິການເສີມ"

#. handle the special cases at first
#: src/include/security/dialogs.rb:149
msgid "Configure"
msgstr "ຕັ້ງຄ່າ"

#: src/include/security/dialogs.rb:151
msgid "Enabled"
msgstr "ເປີດໃຊ້ງານ"

#. All known SELinux modes
#.
#. This is _the main_ or _base_ configuration for known SELinux modes. However, note that,
#. mode is no longer driver by kernel command line, but by selinux config file.
#. For more see https://jira.suse.com/browse/PED-12400
#.
#. Additionally, removing the "lsm" from the kernel params does not mean to use none
#. LSM module. Instead, it just fallback to the kernel configuration at the compile
#. time, which in SUSE is to use AppArmor according to the CONFIG_LSM variable. So, it
#. could be said that dropping all mode param to disabling SELinux is safe enough.
#.
#. To know more, please visit the LSM Usage documentation at
#. https://www.kernel.org/doc/html/latest/admin-guide/LSM/index.html
#. and/or grep for CONFIG_LSM in /boot/config-*
#: src/include/security/dialogs.rb:153 src/lib/y2security/lsm/selinux.rb:395
msgid "Disabled"
msgstr "ປິດໃຊ້ງານ"

