#. to browse the file system to select a PPD file:
#: src/include/printer/driveradd.rb:236
msgid "&Browse"
msgstr "&ເອີ້ນເບິ່ງ"

#. Header for a AskForExistingFile popup dialog
#. to browse the file system to select a PPD file:
#: src/include/printer/driveradd.rb:275
