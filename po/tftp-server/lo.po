#. description map for command line
#: src/clients/tftp-server.rb:35
msgid "Configure a TFTP server"
msgstr "ຕັ້ງຄ່າເຊີບເວີ TFTP"

#. command line: help text for "status" command
#: src/clients/tftp-server.rb:39
msgid "Status of the TFTP server"
msgstr "ສະຖານະຂອງເຊີບເວີ TFTP"

#. command line: help text for "directory" command
#: src/clients/tftp-server.rb:49
msgid "Directory of the TFTP server"
msgstr "ໄດເຣັກທໍຣີຂອງເຊີບເວີ TFTP"

#. command line: help text for "enable" command
#: src/clients/tftp-server.rb:61
msgid "Enable the TFTP service"
msgstr "ເປີດໃຊ້ງານບໍລິການ TFTP"

#. command line: help text for "disable" command
#: src/clients/tftp-server.rb:67
msgid "Disable the TFTP service"
msgstr "ປິດໃຊ້ງານບໍລິການ TFTP"

#. command line: help text for "show" command
#: src/clients/tftp-server.rb:73
msgid "Show the status of the TFTP service"
msgstr "ສະແດງສະຖານະຂອງບໍລິການ TFTP"

#. command line: help text for "path" command
#: src/clients/tftp-server.rb:80
msgid "Set the directory for the TFTP server"
msgstr "ກຳນົດໄດເຣັກທໍຣີໃຫ້ເຊີບເວີ TFTP"

#. command line: help text for "list" command
#: src/clients/tftp-server.rb:86
msgid "Show the directory for the TFTP server"
msgstr "ສະແດງໄດເຣັກທໍຣີຂອງເຊີບເວີ TFTP"

#. command line: show status of tftp-server
#: src/clients/tftp-server.rb:120
#, ycp-format
msgid "Service Status: %1"
msgstr "ສະຖານະບໍລິການ: %1"

#. command line: show directory server by tftp-server
#: src/clients/tftp-server.rb:140
#, ycp-format
msgid "Directory Path: %1"
msgstr "ເສັ້ນທາງໄດເຣັກທໍຣີ: %1"

#. Tftp-server dialog caption
#. Tftp-server dialog caption
#. Tftp-server dialog caption
#: src/include/tftp-server/dialogs.rb:69 src/include/tftp-server/wizards.rb:43
#: src/include/tftp-server/wizards.rb:78
msgid "TFTP Server Configuration"
msgstr "ການຕັ້ງຄ່າເຊີບເວີ TFTP"

#. Directory where served files (usually boot images) reside
#: src/include/tftp-server/dialogs.rb:104
msgid "&Boot Image Directory"
msgstr "ໄດເຣັກທໍຣີອິມເມຈ&ບູດ"

#. Select a directory from the filesystem
#: src/include/tftp-server/dialogs.rb:107
msgid "Bro&wse..."
msgstr "ເລືອກ&ເບິ່ງ..."

#. Display a log file
#: src/include/tftp-server/dialogs.rb:113
msgid "&View Log"
msgstr "&ເບິ່ງບັນທຶກເຫດການ"

#. Help text
#.
#. @return [String]
#: src/include/tftp-server/dialogs.rb:155
msgid "<p><big><b>Configuring a TFTP Server</b></big></p>"
msgstr "<p><big><b>ການຕັ້ງຄ່າເຊີບເວີ TFTP</b></big></p>"

#: src/include/tftp-server/dialogs.rb:156
msgid ""
"<p>Use this to enable a server for TFTP (trivial file transfer protocol). "
"The server will be started using xinetd.</p>"
msgstr ""
"<p>ໃຊ້ສິ່ງນີ້ເພື່ອເປີດໃຊ້ງານເຊີບເວີສຳລັບ TFTP (trivial file transfer protocol). ເຊີບເວີຈະຖືກ"
"ເລີ່ມຕົ້ນໂດຍໃຊ້ xinetd.</p>"

#: src/include/tftp-server/dialogs.rb:157
msgid "<p>Note that TFTP and FTP are not the same.</p>"
msgstr "<p>ໝາຍເຫດ: TFTP ແລະ FTP ແມ່ນບໍ່ຄືກັນ.</p>"

#: src/include/tftp-server/dialogs.rb:158
msgid ""
"<p><b>Boot Image Directory</b>:\n"
"Specify the directory where served files are located. The usual value is\n"
"<tt>/tftpboot</tt>. The directory will be created if it does not exist. \n"
"The server uses this as its root directory (using the <tt>-s</tt> option).</"
"p>\n"
msgstr ""
"<p><b>ໄດເຣັກທໍຣີອິມເມຈບູດ</b>:\n"
"ກຳນົດໄດເຣັກທໍຣີທີ່ເກັບໄຟລ໌ສຳລັບໃຫ້ບໍລິການ. ຄ່າປົກກະຕິແມ່ນ\n"
"<tt>/tftpboot</tt>. ໄດເຣັກທໍຣີຈະຖືກສ້າງຂຶ້ນຖ້າຍັງບໍ່ມີ. \n"
"ເຊີບເວີຈະໃຊ້ສິ່ງນີ້ເປັນໄດເຣັກທໍຣີຮາກ (ໂດຍໃຊ້ຕົວເລືອກ <tt>-s</tt>).</p>\n"

#. Opens a popup to indicate the error when the given directory path is not valid
#: src/include/tftp-server/dialogs.rb:242
msgid ""
"The directory must start with a slash (/)\n"
"and must not contain spaces."
msgstr ""
"ໄດເຣັກທໍຣີຕ້ອງເລີ່ມຕົ້ນດ້ວຍເຄື່ອງໝາຍທັບ (/)\n"
"ແລະ ຕ້ອງບໍ່ມີຊ່ອງຫວ່າງ."

#. progress label
#: src/include/tftp-server/wizards.rb:46
msgid "Initializing..."
msgstr "ກຳລັງເລີ່ມຕົ້ນ..."

#. progress label
#: src/include/tftp-server/wizards.rb:81
msgid "Initializing ..."
msgstr "ກຳລັງເລີ່ມຕົ້ນ ..."

#. error popup
#. %1 is a command name (or a comma (, ) separated list of them)
#: src/modules/TftpServer.rb:143
#, ycp-format
msgid ""
"This module can only use systemd socket to set up TFTP.\n"
"However, another program is serving TFTP: %1.\n"
"Exiting.\n"
msgstr ""
"ໂມດູນນີ້ສາມາດໃຊ້ໄດ້ພຽງແຕ່ systemd socket ເພື່ອຕັ້ງຄ່າ TFTP.\n"
"ແນວໃດກໍຕາມ, ມີໂປຣແກຣມອື່ນກຳລັງໃຫ້ບໍລິການ TFTP ຢູ່: %1.\n"
"ກຳລັງອອກ.\n"

#. summary header
#: src/modules/TftpServer.rb:270
msgid "TFTP Server Enabled:"
msgstr "ເປີດໃຊ້ງານເຊີບເວີ TFTP:"

#. summary item: an option is turned on
#: src/modules/TftpServer.rb:272
msgid "Yes"
msgstr "ແມ່ນ"

#. summary header
#: src/modules/TftpServer.rb:275
msgid "Boot Image Directory:"
msgstr "ໄດເຣັກທໍຣີອິມເມຈບູດ:"
