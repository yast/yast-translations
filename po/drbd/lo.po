"<br></p>\n"

#. encoding: utf-8
#: src/include/drbd/lvm_conf.rb:35
msgid "LVM Filter Configuration of DRBD"
msgstr "ການກຳນົດຄ່າ LVM Filter ຂອງ DRBD"

