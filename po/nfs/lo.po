#. Scans the server and lets the user to select the export
#. @param server [String] server hostname
#. @param v4 [Boolen] if true use NFSv4, NFSv3 otherwise
#: src/include/nfs/ui.rb:728
#, ycp-format
msgid "Getting directory list for \"%1\"..."
msgstr "ກຳລັງດຶງຂໍ້ມູນລາຍຊື່ໄດເຣັກທໍຣີສຳລັບ \"%1\"..."

#. TRANSLATORS: Error message, scanning the NFS server failed
#: src/include/nfs/ui.rb:738
msgid "The NFS scan failed."
msgstr "ການສະແກນ NFS ຫຼົ້ມເຫຼວ."

#. Widget to select the version of the NFS protocol to use in a mount that is
#. being created or edited.
#: src/include/nfs/ui.rb:750
msgid "NFS &Version"
msgstr "ເວີຊັນ &NFS"

#. @see #HandleEvent
#: src/include/nfs/ui.rb:780
msgid ""
"This entry uses old ways of specifying the NFS protocol version that\n"
"do not longer work as they used to do it (like the usage of 'nfs4' as\n"
"file system type or the usage of 'minorversion' in the mount options).\n"
"\n"
"Editing the entry will change how the version is specified, with no\n"
"possibility to use old outdated method again.\n"
"\n"
"Proceed and edit?"
msgstr ""
"ລາຍການນີ້ໃຊ້ວິທີແບບເກົ່າໃນການລະບຸເວີຊັນໂປຣໂຕຄໍ NFS ເຊິ່ງ\n"
"ບໍ່ສາມາດໃຊ້ງານໄດ້ອີກຕໍ່ໄປ (ເຊັ່ນການໃຊ້ 'nfs4' ເປັນ\n"
"ປະເພດລະບົບໄຟລ໌ ຫຼື ການໃຊ້ 'minorversion' ໃນຕົວເລືອກການເມົາທ໌).\n"
"\n"
"ການແກ້ໄຂລາຍການນີ້ຈະປ່ຽນວິທີການລະບຸເວີຊັນ, ໂດຍຈະບໍ່\n"
"ສາມາດກັບໄປໃຊ້ວິທີແບບເກົ່າທີ່ຫຼ້າສະໄໝໄດ້ອີກ.\n"
"\n"
"ດຳເນີນການ ແລະ ແກ້ໄຂຕໍ່ຫຼືບໍ່?"

