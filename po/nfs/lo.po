#. error popup message
#: src/include/nfs/routines.rb:83
#, ycp-format
msgid ""
"The hostname entered is invalid. It must be\n"
"shorter than 50 characters and only use\n"
"valid IPv4, IPv6 or domain name.\n"
"Valid IPv4: %1\n"
"Valid IPv6: %2\n"
"Valid domain: %3"
msgstr ""
"ຊື່ໂຮສຕ໌ທີ່ປ້ອນເຂົ້າບໍ່ຖືກຕ້ອງ. ມັນຕ້ອງ\n"
"ສັ້ນກວ່າ 50 ຕົວອັກສອນ ແລະ ໃຊ້ໄດ້ພຽງແຕ່\n"
"IPv4, IPv6 ຫຼື ຊື່ໂດເມນ ທີ່ຖືກຕ້ອງ.\n"
"IPv4 ທີ່ຖືກຕ້ອງ: %1\n"
"IPv6 ທີ່ຖືກຕ້ອງ: %2\n"
"ໂດເມນ ທີ່ຖືກຕ້ອງ: %3"

#. error popup message
#: src/include/nfs/routines.rb:120
#, ycp-format
msgid ""
"fstab already contains an entry\n"
"with mount point '%1'."
msgstr ""
"fstab ມີລາຍການທີ່ມີ\n"
"ຈຸດເມົາທ໌ '%1' ຢູ່ແລ້ວ."

#. error popup message (spaces are now allowed)
#: src/include/nfs/routines.rb:142
msgid ""
"The path entered is invalid.\n"
"It must be shorter than 70 characters\n"
"and it must begin with a slash (/)."
msgstr ""
"ເສັ້ນທາງທີ່ປ້ອນເຂົ້າບໍ່ຖືກຕ້ອງ.\n"
"ມັນຕ້ອງສັ້ນກວ່າ 70 ຕົວອັກສອນ\n"
"ແລະ ຕ້ອງເລີ່ມຕົ້ນດ້ວຍເຄື່ອງໝາຍ slash (/)."

#. firewall widget using CWM
#: src/include/nfs/ui.rb:67
msgid ""
"<p>The table contains all directories \n"
"exported from remote servers and mounted locally via NFS (NFS shares).</p>"
msgstr ""
"<p>ຕາຕະລາງປະກອບມີທຸກໄດເຣັກທໍຣີ \n"
"ທີ່ຖືກສົ່ງອອກຈາກເຊີບເວີທາງໄກ ແລະ ເມົາທ໌ໄວ້ໃນເຄື່ອງຜ່ານ NFS (NFS shares).</p>"

#: src/include/nfs/ui.rb:69
msgid ""
"<p>Each NFS share is identified by remote NFS server address and\n"
"exported directory, local directory where the remote directory is mounted, \n"
"version of the NFS protocol and mount options. For further information \n"
"about mounting NFS and mount options, refer to <tt>man nfs</tt>.</p>"
msgstr ""
"<p>ແຕ່ລະ NFS share ແມ່ນລະບຸດ້ວຍທີ່ຢູ່ເຊີບເວີ NFS ທາງໄກ ແລະ\n"
"ໄດເຣັກທໍຣີທີ່ສົ່ງອອກ, ໄດເຣັກທໍຣີໃນເຄື່ອງທີ່ໄດເຣັກທໍຣີທາງໄກຖືກເມົາທ໌ໄວ້, \n"
"ເວີຊັນຂອງໂປຣໂຕຄໍ NFS ແລະ ຕົວເລືອກການເມົາທ໌. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ \n"
"ກ່ຽວກັບການເມົາທ໌ NFS ແລະ ຕົວເລືອກການເມົາທ໌, ໃຫ້ເບິ່ງທີ່ <tt>man nfs</tt>.</p>"

#: src/include/nfs/ui.rb:74
msgid ""
"<p>To mount a new NFS share, click <B>Add</B>. To change the configuration "
"of\n"
"a currently mounted share, click <B>Edit</B>. Remove and unmount a selected\n"
"share with <B>Delete</B>.</p>"
msgstr ""
"<p>ເພື່ອເມົາທ໌ NFS share ໃໝ່, ໃຫ້ຄລິກ <B>ເພີ່ມ</B>. ເພື່ອປ່ຽນການກຳນົດຄ່າຂອງ\n"
"share ທີ່ເມົາທ໌ຢູ່ປະຈຸບັນ, ໃຫ້ຄລິກ <B>ແກ້ໄຂ</B>. ລຶບ ແລະ ຍົກເລີກການເມົາທ໌\n"
"share ທີ່ເລືອກດ້ວຍ <B>ລຶບ</B>.</p>"

#: src/include/nfs/ui.rb:79
msgid ""
"<p>If you need to access NFSv4 shares (NFSv4 is a newer version of the NFS\n"
"protocol), check the <b>NFS version</b> option."
msgstr ""
"<p>ຖ້າທ່ານຕ້ອງການເຂົ້າເຖິງ NFSv4 shares (NFSv4 ແມ່ນເວີຊັນໃໝ່ຂອງໂປຣໂຕຄໍ\n"
"NFS), ໃຫ້ກວດເບິ່ງຕົວເລືອກ <b>ເວີຊັນ NFS</b>."

