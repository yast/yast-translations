#. Command line help text for the Xcrowbar module
#: src/clients/crowbar.rb:51
msgid "Configuration of crowbar"
msgstr "ການກຳນົດຄ່າ Crowbar"

#. target platform name
#: src/include/crowbar/complex.rb:94
msgid "SLES 12 SP2"
msgstr "SLES 12 SP2"

#. combobox label
#: src/include/crowbar/complex.rb:106
msgid "&Location of Repositories"
msgstr "&ທີ່ຕັ້ງຂອງຄັງເກັບຊອບແວ"

#: src/include/crowbar/complex.rb:109
msgid ""
"<p>Here you can edit the location of your <b>Update Repositories</b>.</p>\n"
"<p>\n"
"If repositories are stored at SMT server or SUSE Manager server, it's enough "
"to enter server's URL and the paths\n"
"              to repositories will be filled automatically.</p>It is also "
"possible to use custom paths. Some examples of how the URL could look like:\n"
"</p><p>\n"
"<ul>\n"
"<li><i>http://smt.example.com/repo/SUSE/Products/SLE-HA/12-SP2/x86_64/"
"product</i> for SMT server\n"
"<li><i>http://manager.example.com/ks/dist/child/suse-openstack-cloud-7-pool-"
"x86_64/sles12-sp2-pool-x86_64/</i> for SUSE Manager Server.\n"
"</p><p>\n"
"For detailed description, check the Deployment Guide.\n"
"</p>"
msgstr ""
"<p>ຢູ່ນີ້ ເຈົ້າສາມາດແກ້ໄຂທີ່ຕັ້ງຂອງ <b>ຄັງເກັບຊອບແວການອັບເດດ</b> ຂອງເຈົ້າໄດ້.</p>\n"
"<p>\n"
"ຖ້າຄັງເກັບຊອບແວຖືກເກັບໄວ້ທີ່ເຊີເວີ SMT ຫຼື ເຊີເວີ SUSE Manager, ພຽງແຕ່ປ້ອນ URL ຂອງເຊີເວີ ແລ້ວເສັ້ນ"
"ທາງ\n"
"              ໄປຫາຄັງເກັບຊອບແວຈະຖືກຕື່ມໃຫ້ໂດຍອັດຕະໂນມັດ.</p>ນອກນັ້ນ ຍັງສາມາດໃຊ້ເສັ້ນທາງທີ່ກຳນົ"
"ດເອງໄດ້. ຕົວຢ່າງຮູບແບບຂອງ URL:\n"
"</p><p>\n"
"<ul>\n"
"<li><i>http://smt.example.com/repo/SUSE/Products/SLE-HA/12-SP2/x86_64/"
"product</i> ສຳລັບເຊີເວີ SMT\n"
"<li><i>http://manager.example.com/ks/dist/child/suse-openstack-cloud-7-pool-"
"x86_64/sles12-sp2-pool-x86_64/</i> ສຳລັບເຊີເວີ SUSE Manager.\n"
"</p><p>\n"
"ສຳລັບລາຍລະອຽດເພີ່ມເຕີມ, ໃຫ້ກວດເບິ່ງໃນຄູ່ມືການຕິດຕັ້ງ (Deployment Guide).\n"
"</p>"

