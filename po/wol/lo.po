msgid "MAC Address"
msgstr "ທີ່ຢູ່ MAC"

#: src/clients/wol.rb:66
msgid "Host Name"
msgstr "ຊື່ໂຮສຕ໌"

#: src/clients/wol.rb:68
msgid "Wake Up"
msgstr "ປຸກເຄື່ອງ"

#: src/clients/wol.rb:78
msgid "Wake-On-Lan"
msgstr "Wake-On-Lan"

#: src/clients/wol.rb:79
msgid ""
"<h2>Wake on LAN</h2>\n"
"<p>With WOL, you can 'wake up' your PC simply by sending a 'magic packet' \n"
"over the network.</p>"
msgstr ""
"<h2>Wake on LAN</h2>\n"
"<p>ດ້ວຍ WOL, ເຈົ້າສາມາດ 'ປຸກ' ຄອມພິວເຕີຂອງເຈົ້າໄດ້ ໂດຍການສົ່ງ 'magic packet' \n"
"ຜ່ານທາງເຄືອຂ່າຍ.</p>"

#. UI::ChangeWidget(`id(`edit_button), `Enabled, false);
