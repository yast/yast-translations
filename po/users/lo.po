msgstr "ປ້ອນຄ່າສຳລັບຄຸນລັກສະນະ."

#. error popup
#: src/include/users/widgets.rb:840
msgid "Enter the value of the user filter."
msgstr "ປ້ອນຄ່າຂອງຕົວຕອງຜູ້ໃຊ້."

#. yes/no popup question
#: src/include/users/widgets.rb:851
msgid ""
"The new user filter does not contain the default user filter.\n"
"Really use it?\n"
msgstr ""
"ຕົວຕອງຜູ້ໃຊ້ໃໝ່ບໍ່ມີຕົວຕອງຜູ້ໃຊ້ເລີ່ມຕົ້ນ.\n"
"ຕ້ອງການໃຊ້ແທ້ຫຼືບໍ່?\n"

#. error popup
#: src/include/users/widgets.rb:866
msgid "Enter the value of the group filter."
msgstr "ປ້ອນຄ່າຂອງຕົວຕອງກຸ່ມ."

#. yes/no popup question
#: src/include/users/widgets.rb:877
msgid ""
"The new group filter does not contain the default group filter.\n"
"Really use it?\n"
msgstr ""
"ຕົວຕອງກຸ່ມໃໝ່ບໍ່ມີຕົວຕອງກຸ່ມເລີ່ມຕົ້ນ.\n"
"ຕ້ອງການໃຊ້ແທ້ຫຼືບໍ່?\n"

#. helptext 0/3 - caption
#: src/include/users/widgets.rb:931
msgid "<p><b>Login Settings</b></p>"
msgstr "<p><b>ການຕັ້ງຄ່າການເຂົ້າລະບົບ</b></p>"

#. helptext 1/3 - general info
#: src/include/users/widgets.rb:933
msgid ""
"<p>\n"
"The features described below are only available if you are using KDM or GDM "
"as the login manager.\n"
"</p>\n"
msgstr ""
"<p>\n"
"ຄຸນສົມບັດທີ່ອະທິບາຍໄວ້ຂ້າງລຸ່ມນີ້ຈະໃຊ້ໄດ້ກໍຕໍ່ເມື່ອເຈົ້າກຳລັງໃຊ້ KDM ຫຼື GDM ເປັນຕົວຈັດການການເຂົ້າລະບົບ.\n"
"</p>\n"

#. helptext 2/3
#: src/include/users/widgets.rb:939
msgid ""
"<p><b>Auto Login</b><br>\n"
"By setting <b>Auto Login</b>, skip the login procedure. The user chosen from "
"the list is logged in automatically.</p>\n"
msgstr ""
"<p><b>ເຂົ້າລະບົບອັດຕະໂນມັດ</b><br>\n"
"ໂດຍການຕັ້ງຄ່າ <b>ເຂົ້າລະບົບອັດຕະໂນມັດ</b>, ຈະຂ້າມຂັ້ນຕອນການເຂົ້າລະບົບ. ຜູ້ໃຊ້ທີ່ຖືກເລືອກຈາກ ລາຍຊື່ຈະ"
"ຖືກເຂົ້າລະບົບໂດຍອັດຕະໂນມັດ.</p>\n"

#. helptext 3/3
#: src/include/users/widgets.rb:943
msgid ""
"<p><b>Passwordless Logins</b><br>\n"
"If this option is checked, all users are allowed to log in without entering\n"
"passwords. Otherwise, you are asked for the password even if you set a user "
"to log in automatically.</p>\n"
msgstr ""
"<p><b>ການເຂົ້າລະບົບໂດຍບໍ່ໃຊ້ລະຫັດຜ່ານ</b><br>\n"
"ຫາກເລືອກຕົວເລືອກນີ້, ຜູ້ໃຊ້ທັງໝົດຈະຖືກອະນຸຍາດໃຫ້ເຂົ້າລະບົບໄດ້ໂດຍບໍ່ຕ້ອງປ້ອນ\n"
"ລະຫັດຜ່ານ. ຖ້າບໍ່ດັ່ງນັ້ນ, ເຈົ້າຈະຖືກຖາມຫາລະຫັດຜ່ານ ເຖິງແມ່ນວ່າເຈົ້າຈະຕັ້ງຄ່າໃຫ້ຜູ້ໃຊ້ ເຂົ້າລະບົບໂດຍອັດຕະໂນ"
"ມັດກໍຕາມ.</p>\n"

#. dialog label
#: src/include/users/widgets.rb:968
msgid "Display Manager Login Settings"
msgstr "ການຕັ້ງຄ່າການເຂົ້າລະບົບຂອງຕົວຈັດການການສະແດງຜົນ"

#. checkbox label
#: src/include/users/widgets.rb:978
msgid "&Auto Login"
msgstr "ເຂົ້າລະບົບ&ອັດຕະໂນມັດ"

#. textentry label
#: src/include/users/widgets.rb:989
