#. error popup
#: src/modules/Users.pm:4371
msgid "An error occurred while removing users."
msgstr "ເກີດຂໍ້ຜິດພາດຂຶ້ນໃນຂະນະທີ່ກຳລັງລຶບຜູ້ໃຊ້."

#. error popup
#: src/modules/Users.pm:4457
msgid "No UID is available for this type of user."
msgstr "ບໍ່ມີ UID ທີ່ໃຊ້ໄດ້ສຳລັບຜູ້ໃຊ້ປະເພດນີ້."

#. error popup
#: src/modules/Users.pm:4488
#, perl-format
msgid ""
"The selected user ID is not allowed.\n"
"Select a valid integer between %i and %i."
msgstr ""
"User ID ທີ່ເລືອກບໍ່ໄດ້ຮັບອະນຸຍາດ.\n"
"ກະລຸນາເລືອກຕົວເລກຈຳນວນເຕັມລະຫວ່າງ %i ຫາ %i."

#. popup question
#: src/modules/Users.pm:4519
msgid ""
"The user ID entered is already in use.\n"
"Really use it?"
msgstr ""
"User ID ທີ່ປ້ອນແມ່ນມີຄົນໃຊ້ອື່ນແລ້ວ.\n"
"ຕ້ອງການໃຊ້ແທ້ຫຼືບໍ່?"

#. popup question, %i are numbers
#: src/modules/Users.pm:4532
#, perl-format
msgid ""
"The selected user ID is not from a range\n"
"defined for LDAP users (%i-%i).\n"
"Really use it?"
msgstr ""
"User ID ທີ່ເລືອກບໍ່ໄດ້ຢູ່ໃນຊ່ວງ\n"
"ທີ່ກຳນົດໄວ້ສຳລັບຜູ້ໃຊ້ LDAP (%i-%i).\n"
"ຕ້ອງການໃຊ້ແທ້ຫຼືບໍ່?"

#. popup question
#: src/modules/Users.pm:4547
#, perl-format
msgid ""
"The selected user ID is a local ID,\n"
"because the ID is greater than %i.\n"
"Really change the user type to 'local'?"
msgstr ""
"User ID ທີ່ເລືອກແມ່ນ ID ທ້ອງຖິ່ນ,\n"
"ເນື່ອງຈາກ ID ມີຄ່າຫຼາຍກວ່າ %i.\n"
"ຕ້ອງການປ່ຽນປະເພດຜູ້ໃຊ້ເປັນ 'local' ແທ້ຫຼືບໍ່?"

#. popup question
#: src/modules/Users.pm:4561
#, perl-format
msgid ""
"The selected user ID is a system ID,\n"
"because the ID is smaller than %i.\n"
"Really change the user type to 'system'?"
msgstr ""
"User ID ທີ່ເລືອກແມ່ນ ID ລະບົບ,\n"
"ເນື່ອງຈາກ ID ມີຄ່ານ້ອຍກວ່າ %i.\n"
"ຕ້ອງການປ່ຽນປະເພດຜູ້ໃຊ້ເປັນ 'system' ແທ້ຫຼືບໍ່?"

#: src/modules/Users.pm:4595
msgid ""
"\n"
"The existing username might belong to a NIS or LDAP user.\n"
msgstr ""
"\n"
"ຊື່ຜູ້ໃຊ້ທີ່ມີຢູ່ແລ້ວອາດຈະເປັນຂອງຜູ້ໃຊ້ NIS ຫຼື LDAP.\n"

#. error popup, %1 might be additional sentence ("The existing username...")
#: src/modules/Users.pm:4599
msgid ""
"There is a conflict between the entered\n"
"username and an existing username. %1\n"
"Try another one."
msgstr ""
"ມີຄວາມຂັດແຍ້ງລະຫວ່າງຊື່ຜູ້ໃຊ້ທີ່ປ້ອນ\n"
"ກັບຊື່ຜູ້ໃຊ້ທີ່ມີຢູ່ແລ້ວ. %1\n"
"ກະລຸນາລອງໃຊ້ຊື່ອື່ນ."

#. error popup
#: src/modules/Users.pm:4629
msgid ""
"The \"Additional User Information\" entry cannot\n"
"contain a colon (:).  Try again."
msgstr ""
"ຂໍ້ມູນໃນ \"ຂໍ້ມູນຜູ້ໃຊ້ເພີ່ມເຕີມ\" ບໍ່ສາມາດ\n"
"ມີ colon (:) ໄດ້. ກະລຸນາລອງໃໝ່."

#. error popup
#: src/modules/Users.pm:4691
msgid ""
"The home directory may only contain the following characters:\n"
"a-z, A-Z, 0-9, and _-/\n"
"Try again."
msgstr ""
"ໄດເຣັກທໍຣີຫຼັກສາມາດມີໄດ້ສະເພາະຕົວອັກສອນຕໍ່ໄປນີ້:\n"
"a-z, A-Z, 0-9, ແລະ _-/\n"
"ກະລຸນາລອງໃໝ່."

#. error popup
#: src/modules/Users.pm:4714
#, perl-format
msgid ""
"The directory %s is not writable.\n"
"Choose another path for the home directory."
msgstr ""
"ໄດເຣັກທໍຣີ %s ບໍ່ສາມາດຂຽນຂໍ້ມູນລົງໄດ້.\n"
"ກະລຸນາເລືອກເສັ້ນທາງອື່ນສຳລັບໄດເຣັກທໍຣີຫຼັກ."

#. error message
#: src/modules/Users.pm:4725
msgid ""
"The home directory is used by another user.\n"
"Try again."
msgstr ""
"ໄດເຣັກທໍຣີຫຼັກນີ້ຖືກໃຊ້ໂດຍຜູ້ໃຊ້ອື່ນແລ້ວ.\n"
"ກະລຸນາລອງໃໝ່."

#. yes/no popup: user seleceted something strange as a home directory
#: src/modules/Users.pm:4767
msgid ""
"The path for the selected home directory already exists,\n"
"but it is not a directory.\n"
"Really use this path?"
msgstr ""
"ເສັ້ນທາງສຳລັບໄດເຣັກທໍຣີຫຼັກທີ່ເລືອກມີຢູ່ແລ້ວ,\n"
"ແຕ່ມັນບໍ່ແມ່ນໄດເຣັກທໍຣີ.\n"
"ຕ້ອງການໃຊ້ເສັ້ນທາງນີ້ແທ້ຫຼືບໍ່?"

#. yes/no popup
#: src/modules/Users.pm:4778
msgid ""
"The home directory selected already exists.\n"
"Use it and change its owner?"
msgstr ""
"ໄດເຣັກທໍຣີຫຼັກທີ່ເລືອກມີຢູ່ແລ້ວ.\n"
"ຕ້ອງການໃຊ້ມັນ ແລະ ປ່ຽນເຈົ້າຂອງຫຼືບໍ່?"

#. chown is not needed (#25200)
#. yes/no popup
#: src/modules/Users.pm:4785
#, perl-format
msgid ""
"The selected home directory (%s)\n"
"already exists and is owned by the currently edited user.\n"
"Use this directory?\n"
msgstr ""
"ໄດເຣັກທໍຣີຫຼັກທີ່ເລືອກ (%s)\n"
"ມີຢູ່ແລ້ວ ແລະ ເປັນຂອງຜູ້ໃຊ້ທີ່ກຳລັງຖືກແກ້ໄຂໃນປັດຈຸບັນ.\n"
"ຕ້ອງການໃຊ້ໄດເຣັກທໍຣີນີ້ບໍ່?\n"

#. yes/no popup
#: src/modules/Users.pm:4794
#, perl-format
msgid ""
"The home directory selected (%s)\n"
"already exists as a former home directory of\n"
"a user previously marked for deletion.\n"
"Use this directory?"
msgstr ""
"ໄດເຣັກທໍຣີຫຼັກທີ່ເລືອກ (%s)\n"
"ມີຢູ່ແລ້ວ ເຊິ່ງເຄີຍເປັນໄດເຣັກທໍຣີຫຼັກຂອງ\n"
"ຜູ້ໃຊ້ທີ່ຖືກໝາຍໄວ້ເພື່ອລຶບກ່ອນໜ້ານີ້. \n"
"ຕ້ອງການໃຊ້ມັນບໍ່?"

#. popup question
#: src/modules/Users.pm:4822
msgid ""
"If you select a nonexistent shell, the user may be unable to log in.\n"
"Use this shell?"
msgstr ""
"ຫາກເຈົ້າເລືອກ shell ທີ່ບໍ່ມີຢູ່, ຜູ້ໃຊ້ອາດຈະບໍ່ສາມາດເຂົ້າລະບົບໄດ້.\n"
"ຕ້ອງການໃຊ້ shell ນີ້ບໍ່?"

#. error popup
#: src/modules/Users.pm:4842
msgid "No GID is available for this type of group."
msgstr "ບໍ່ມີ GID ທີ່ໃຊ້ໄດ້ສຳລັບກຸ່ມປະເພດນີ້."

#. error popup
#: src/modules/Users.pm:4875
#, perl-format
msgid ""
"The selected group ID is not allowed.\n"
"Select a valid integer between %i and %i."
msgstr ""
"Group ID ທີ່ເລືອກບໍ່ໄດ້ຮັບອະນຸຍາດ.\n"
"ກະລຸນາເລືອກຕົວເລກຈຳນວນເຕັມລະຫວ່າງ %i ຫາ %i."

#. popup question
#: src/modules/Users.pm:4905
msgid ""
"The group ID entered is already in use.\n"
"Really use it?"
msgstr ""
"Group ID ທີ່ປ້ອນແມ່ນມີຄົນໃຊ້ອື່ນແລ້ວ.\n"
"ຕ້ອງການໃຊ້ແທ້ຫຼືບໍ່?"

#. popup question, %i are numbers
#: src/modules/Users.pm:4917
#, perl-format
msgid ""
"The selected group ID is not from a range\n"
"defined for LDAP groups (%i-%i).\n"
"Really use it?"
msgstr ""
"Group ID ທີ່ເລືອກບໍ່ໄດ້ຢູ່ໃນຊ່ວງ\n"
"ທີ່ກຳນົດໄວ້ສຳລັບກຸ່ມ LDAP (%i-%i).\n"
"ຕ້ອງການໃຊ້ແທ້ຫຼືບໍ່?"

#. popup question
#: src/modules/Users.pm:4932
#, perl-format
msgid ""
"The selected group ID is a local ID,\n"
"because the ID is greater than %i.\n"
"Really change the group type to 'local'?"
msgstr ""
"Group ID ທີ່ເລືອກແມ່ນ ID ທ້ອງຖິ່ນ,\n"
"ເນື່ອງຈາກ ID ມີຄ່າຫຼາຍກວ່າ %i.\n"
"ຕ້ອງການປ່ຽນປະເພດກຸ່ມເປັນ 'local' ແທ້ຫຼືບໍ່?"

#. popup question
#: src/modules/Users.pm:4946
#, perl-format
msgid ""
"The selected group ID is a system ID,\n"
"because the ID is smaller than %i.\n"
"Really change the group type to 'system'?"
msgstr ""
"Group ID ທີ່ເລືອກແມ່ນ ID ລະບົບ,\n"
"ເນື່ອງຈາກ ID ມີຄ່ານ້ອຍກວ່າ %i.\n"
"ຕ້ອງການປ່ຽນປະເພດກຸ່ມເປັນ 'system' ແທ້ຫຼືບໍ່?"

#. error popup
#: src/modules/Users.pm:4965
msgid ""
"No group name entered.\n"
"Try again."
msgstr ""
"ບໍ່ໄດ້ປ້ອນຊື່ກຸ່ມ.\n"
"ກະລຸນາລອງໃໝ່."

#. error popup
#: src/modules/Users.pm:4982
#, perl-format
msgid ""
"The group name must be between %i and %i characters in length.\n"
"Try again."
msgstr ""
"ຊື່ກຸ່ມຕ້ອງມີຄວາມຍາວລະຫວ່າງ %i ຫາ %i ຕົວອັກສອນ.\n"
"ກະລຸນາລອງໃໝ່."

#. error popup
#: src/modules/Users.pm:4995
msgid ""
"The group name may contain only\n"
"letters, digits, \"-\", \".\", and \"_\"\n"
"and must begin with a letter.\n"
"Try again."
msgstr ""
"ຊື່ກຸ່ມສາມາດປະກອບດ້ວຍ\n"
"ຕົວອັກສອນ, ຕົວເລກ, \"-\", \".\", ແລະ \"_\"\n"
"ແລະ ຕ້ອງເລີ່ມຕົ້ນດ້ວຍຕົວອັກສອນ.\n"
"ກະລຸນາລອງໃໝ່."

#. error popup
#: src/modules/Users.pm:5003
msgid ""
"There is a conflict between the entered\n"
"group name and an existing group name.\n"
"Try another one."
msgstr ""
"ມີຄວາມຂັດແຍ້ງລະຫວ່າງຊື່ກຸ່ມທີ່ປ້ອນ\n"
"ກັບຊື່ກຸ່ມທີ່ມີຢູ່ແລ້ວ.\n"
"ກະລຸນາລອງໃຊ້ຊື່ອື່ນ."

#: src/modules/Users.pm:5119
#, perl-format
msgid "User %s does not exist."
msgstr "ບໍ່ມີຜູ້ໃຊ້ %s ຢູ່."

#. error message: group cannot be deleted
#: src/modules/Users.pm:5173
msgid ""
"You cannot delete this group because\n"
"there are users that use this group\n"
"as their default group."
msgstr ""
"ເຈົ້າບໍ່ສາມາດລຶບກຸ່ມນີ້ໄດ້ ເພາະວ່າ\n"
"ມີຜູ້ໃຊ້ທີ່ໃຊ້ກຸ່ມນີ້\n"
"ເປັນກຸ່ມເລີ່ມຕົ້ນຂອງພວກເຂົາ."

#. error message: group cannot be deleted
#: src/modules/Users.pm:5180
msgid ""
"You cannot delete this group because\n"
"there are users in the group.\n"
"Remove these users from the group first."
msgstr ""
"ເຈົ້າບໍ່ສາມາດລຶບກຸ່ມນີ້ໄດ້ ເພາະວ່າ\n"
"ມີຜູ້ໃຊ້ຢູ່ໃນກຸ່ມນີ້.\n"
"ກະລຸນາຍ້າຍຜູ້ໃຊ້ເຫຼົ່ານີ້ອອກຈາກກຸ່ມກ່ອນ."

