msgstr "&ຜູ້ໃຊ້ທີ່ຈະເຂົ້າລະບົບ"

#. checkbox label
#: src/include/users/widgets.rb:999
msgid "Password&less Logins"
msgstr "ເຂົ້າລະບົບໂດຍ&ບໍ່ໃຊ້ລະຫັດຜ່ານ"

#. error popup
#: src/include/users/widgets.rb:1090
#, ycp-format
msgid "Cannot delete the user %1. It must be done on the NIS server."
msgstr "ບໍ່ສາມາດລຶບຜູ້ໃຊ້ %1 ໄດ້. ຕ້ອງດຳເນີນການຢູ່ທີ່ເຊີເວີ NIS."

#. Continue/Cancel popup
#: src/include/users/widgets.rb:1099
msgid ""
"The user seems to be currently logged in.\n"
"Continue anyway?"
msgstr ""
"ເບິ່ງຄືວ່າຜູ້ໃຊ້ນີ້ກຳລັງເຂົ້າສູ່ລະບົບຢູ່.\n"
"ຕ້ອງການດຳເນີນການຕໍ່ຫຼືບໍ່?"

#. yes-no popup headline
#: src/include/users/widgets.rb:1117
msgid "Selected User Is System User"
msgstr "ຜູ້ໃຊ້ທີ່ເລືອກແມ່ນຜູ້ໃຊ້ລະບົບ"

#. yes-no popup contents
#: src/include/users/widgets.rb:1119
