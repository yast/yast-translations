#. Check if given group contains a group password for warning about ignoring it
#.
#. @param group_section [Installation::AutoinstProfile::GroupSection]
#. @param issues [Y2Issues::List] Issues list
#: src/lib/y2users/autoinst/reader.rb:255
msgid "Attribute no longer supported by YaST. Ignoring it."
msgstr "ຄຸນລັກສະນະນີ້ບໍ່ຖືກຮອງຮັບໂດຍ YaST ອີກຕໍ່ໄປ. ຈະຂ້າມມັນໄປ."

#. @return [Y2Users::Config] config to validate
#: src/lib/y2users/collision_checker.rb:57
#, perl-brace-format
msgid "Users %{users} have same UID %{uid}."
msgstr "ຜູ້ໃຊ້ %{users} ມີ UID %{uid} ຊ້ຳກັນ."

#: src/lib/y2users/collision_checker.rb:66
#, perl-brace-format
