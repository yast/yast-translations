#. error popup
#: src/modules/UsersPluginLDAPShadowAccount.pm:350
#: src/modules/UsersPluginLDAPShadowAccount.pm:396
msgid ""
"It is not possible to add this plug-in when\n"
"the plug-in for Password Policy is in use.\n"
msgstr ""
"ບໍ່ສາມາດເພີ່ມປລັກອິນນີ້ໄດ້ໃນຂະນະທີ່\n"
"ກຳລັງໃຊ້ປລັກອິນສຳລັບນະໂຍບາຍລະຫັດຜ່ານຢູ່.\n"

#. plugin name
#: src/modules/UsersPluginQuota.pm:239
msgid "Quota Configuration"
msgstr "ການຕັ້ງຄ່າໂຄຕາ (Quota)"

#. user plugin summary (table item)
#: src/modules/UsersPluginQuota.pm:250
msgid "Manage Group Quota"
msgstr "ຈັດການໂຄຕາກຸ່ມ"

#. user plugin summary (table item)
#: src/modules/UsersPluginQuota.pm:253
msgid "Manage User Quota"
msgstr "ຈັດການໂຄຕາຜູ້ໃຊ້"

#. error popup
#: src/modules/UsersPluginQuota.pm:327 src/modules/UsersPluginQuota.pm:367
msgid ""
"Quota is not enabled on your system.\n"
"Enable quota in the partition settings module."
msgstr ""
"ຍັງບໍ່ໄດ້ເປີດໃຊ້ໂຄຕາໃນລະບົບຂອງເຈົ້າ.\n"
"ໃຫ້ເປີດໃຊ້ໂຄຕາໃນໂມດູນການຕັ້ງຄ່າພາກສ່ວນຂໍ້ມູນ (partition)."

#. error popup, %1 is command, %2 command error output
#: src/modules/UsersPluginQuota.pm:426 src/modules/UsersPluginQuota.pm:437
msgid ""
"Error while calling\n"
"\"%1\":\n"
"%2"
msgstr ""
"ມີຂໍ້ຜິດພາດໃນຂະນະທີ່ເອີ້ນໃຊ້\n"
"\"%1\":\n"
"%2"

#: src/modules/UsersRoutines.pm:143
#, perl-format
msgid ""
" Cannot create home directory %s.\n"
"Parent directory is not a Btrfs volume."
msgstr ""
" ບໍ່ສາມາດສ້າງໄດເຣັກທໍຣີຫຼັກ %s ໄດ້.\n"
"ໄດເຣັກທໍຣີແມ່ບໍ່ແມ່ນວໍລູມ Btrfs."

#. popup question
#: src/modules/UsersSimple.pm:309
msgid "You have used the group name as a part of the password."
msgstr "ເຈົ້າໃຊ້ຊື່ກຸ່ມເປັນສ່ວນໜຶ່ງຂອງລະຫັດຜ່ານ."

#. popup question
#: src/modules/UsersSimple.pm:312
msgid "You have used the username as a part of the password."
msgstr "ເຈົ້າໃຊ້ຊື່ຜູ້ໃຊ້ເປັນສ່ວນໜຶ່ງຂອງລະຫັດຜ່ານ."

#. popup question
#: src/modules/UsersSimple.pm:321
msgid "You have used only lowercase letters for the password."
msgstr "ເຈົ້າໃຊ້ສະເພາະຕົວອັກສອນນ້ອຍສຳລັບລະຫັດຜ່ານ."

#. popup question
#: src/modules/UsersSimple.pm:329
msgid "You have used only uppercase letters for the password."
msgstr "ເຈົ້າໃຊ້ສະເພາະຕົວອັກສອນໃຫຍ່ສຳລັບລະຫັດຜ່ານ."

#. popup question
#: src/modules/UsersSimple.pm:336
msgid "You have used a palindrome for the password."
msgstr "ເຈົ້າໃຊ້ຄຳທີ່ອ່ານຖອຍຫຼັງແລ້ວຄືເກົ່າ (palindrome) ສຳລັບລະຫັດຜ່ານ."

#. popup question
#: src/modules/UsersSimple.pm:344
msgid "You have used only digits for the password."
msgstr "ເຈົ້າໃຊ້ສະເພາະຕົວເລກສຳລັບລະຫັດຜ່ານ."

#. popup question
#: src/modules/UsersSimple.pm:366
#, perl-format
msgid ""
"The password is too long for the current encryption method.\n"
"It will be truncated to %s characters."
msgstr ""
"ລະຫັດຜ່ານຍາວເກີນໄປສຳລັບວິທີການເຂົ້າລະຫັດປັດຈຸບັນ.\n"
"ມັນຈະຖືກຕັດໃຫ້ເຫຼືອ %s ຕົວອັກສອນ."

#. error message
#: src/modules/UsersSimple.pm:453
#, perl-format
msgid ""
"The password is too simple:\n"
"%s."
msgstr ""
"ລະຫັດຜ່ານງ່າຍເກີນໄປ:\n"
"%s."

#. popup error, %i is number
#: src/modules/UsersSimple.pm:467
#, perl-format
msgid "The password should have at least %i characters."
msgstr "ລະຫັດຜ່ານຄວນມີຢ່າງໜ້ອຍ %i ຕົວອັກສອນ."

#. busy popup message
#: src/modules/UsersSimple.pm:548
msgid "Retrieving %1 extension..."
msgstr "ກຳລັງດຶງຂໍ້ມູນສ່ວນຂະຫຍາຍ %1..."

#. busy popup message
#: src/modules/UsersSimple.pm:562
msgid "Releasing %1 extension..."
msgstr "ກຳລັງປ່ອຍສ່ວນຂະຫຍາຍ %1..."

#. error popup
#: src/modules/YaPI/ADMINISTRATOR.pm:101
msgid "An error occurred while setting forwarding for root's mail."
msgstr "ເກີດຂໍ້ຜິດພາດໃນຂະນະທີ່ກຳລັງຕັ້ງຄ່າການສົ່ງຕໍ່ເມລຂອງ root."

#. error message
#: src/modules/YaPI/USERS.pm:533
msgid ""
"There is a conflict between the entered\n"
"user name and an existing user name.\n"
"Try another one."
msgstr ""
"ມີຄວາມຂັດແຍ້ງລະຫວ່າງຊື່ຜູ້ໃຊ້ທີ່ປ້ອນ\n"
"ກັບຊື່ຜູ້ໃຊ້ທີ່ມີຢູ່ແລ້ວ.\n"
"ກະລຸນາລອງໃຊ້ຊື່ອື່ນ."

#. error message
#: src/modules/YaPI/USERS.pm:545
msgid ""
"The home directory is used from another user.\n"
"Please try again."
msgstr ""
"ໄດເຣັກທໍຣີຫຼັກນີ້ຖືກໃຊ້ໂດຍຜູ້ໃຊ້ອື່ນແລ້ວ.\n"
"ກະລຸນາລອງໃໝ່."

#. error message
#: src/modules/YaPI/USERS.pm:741 src/modules/YaPI/USERS.pm:858
msgid "No plug-in was defined"
msgstr "ຍັງບໍ່ໄດ້ກຳນົດປລັກອິນ"

#. error message
#: src/modules/YaPI/USERS.pm:795 src/modules/YaPI/USERS.pm:912
msgid "It is not possible to edit a NIS user."
msgstr "ບໍ່ສາມາດແກ້ໄຂຜູ້ໃຊ້ NIS ໄດ້."

#. error message
#: src/modules/YaPI/USERS.pm:1025
msgid "It is not possible to delete a NIS user."
msgstr "ບໍ່ສາມາດລຶບຜູ້ໃຊ້ NIS ໄດ້."

#. error message
#: src/modules/YaPI/USERS.pm:1684 src/modules/YaPI/USERS.pm:1817
#: src/modules/YaPI/USERS.pm:1980
msgid "It is not possible to modify a NIS group."
msgstr "ບໍ່ສາມາດແກ້ໄຂກຸ່ມ NIS ໄດ້."

#. error message
#: src/modules/YaPI/USERS.pm:1761 src/modules/YaPI/USERS.pm:1924
#: src/modules/YaPI/USERS.pm:2403
msgid "No user was specified."
msgstr "ບໍ່ໄດ້ລະບຸຜູ້ໃຊ້."

#. error message
#: src/modules/YaPI/USERS.pm:1858 src/modules/YaPI/USERS.pm:2021
#: src/modules/YaPI/USERS.pm:2476
msgid "User was not correctly specified."
msgstr "ລະບຸຜູ້ໃຊ້ບໍ່ຖືກຕ້ອງ."

#. error message
#: src/modules/YaPI/USERS.pm:2133
msgid "It is not possible to delete a NIS group."
msgstr "ບໍ່ສາມາດລຶບກຸ່ມ NIS ໄດ້."

#. error message
#: src/modules/YaPI/USERS.pm:2451
msgid "There are multiple users satisfying the input conditions."
msgstr "ມີຜູ້ໃຊ້ຫຼາຍຄົນທີ່ກົງກັບເງື່ອນໄຂທີ່ປ້ອນເຂົ້າ."
