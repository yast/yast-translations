msgstr "ການກຳນົດຄ່າຂອງ Rear"

#. command line help text for 'configure' action
#: src/clients/rear.rb:67
msgid "Change the Rear configuration"
msgstr "ປ່ຽນແປງການກຳນົດຄ່າ Rear"

#: src/clients/rear.rb:73
