#. Dialog shown, when system is not supported by rear
#: src/include/rear/ui.rb:165
msgid "This system is not supported by rear, because:"
msgstr "ລະບົບນີ້ບໍ່ໄດ້ຮັບການຮອງຮັບໂດຍ Rear, ເນື່ອງຈາກວ່າ:"

#: src/include/rear/ui.rb:170
msgid ""
"Do NOT expect the created backup to be useful for system recovery if you "
"ignore this warning."
msgstr ""
"ຢ່າຄາດຫວັງວ່າການສຳຮອງຂໍ້ມູນທີ່ສ້າງຂຶ້ນຈະໃຊ້ງານໄດ້ໃນການກູ້ຄືນລະບົບ ຫາກທ່ານລະເລີຍຄຳເຕືອນນີ້."

#: src/include/rear/ui.rb:184
msgid "This system is not supported."
msgstr "ລະບົບນີ້ບໍ່ໄດ້ຮັບການຮອງຮັບ."

#: src/include/rear/ui.rb:188
msgid "&Ignore and continue"
msgstr "&ລະເລີຍ ແລະ ສືບຕໍ່"

#: src/include/rear/ui.rb:189 src/include/rear/ui.rb:233
#: src/include/rear/ui.rb:334
msgid "&Cancel"
msgstr "&ຍົກເລີກ"

#. store original value of directories for the case that the users clicks cancel
#: src/include/rear/ui.rb:223
msgid "Additional Directories to Backup"
msgstr "ໄດເຣັກທໍຣີເພີ່ມເຕີມທີ່ຈະສຳຮອງຂໍ້ມູນ"

#: src/include/rear/ui.rb:232 src/include/rear/ui.rb:333
msgid "&OK"
msgstr "&ຕົກລົງ"

#: src/include/rear/ui.rb:251
msgid "Choose Directory"
msgstr "ເລືອກໄດເຣັກທໍຣີ"

#: src/include/rear/ui.rb:281
msgid "Cannot write rear configuration file."
msgstr "ບໍ່ສາມາດຂຽນໄຟລ໌ການກຳນົດຄ່າ Rear ໄດ້."

#. store original value of modules for the case that the users clicks cancel
#: src/include/rear/ui.rb:302
msgid "Additional Kernel Modules"
msgstr "ໂມດູນເຄີເນິລເພີ່ມເຕີມ"

#: src/include/rear/ui.rb:309
msgid "Available Modules in current System:"
msgstr "ໂມດູນທີ່ມີຢູ່ໃນລະບົບປັດຈຸບັນ:"

#: src/include/rear/ui.rb:326
msgid "Modules added to Rescue System:"
msgstr "ໂມດູນທີ່ຖືກເພີ່ມເຂົ້າໃນລະບົບກູ້ໄພ:"

#: src/include/rear/ui.rb:331
msgid "Modules are sorted in the order they were loaded."
msgstr "ໂມດູນຖືກຈັດລຽງຕາມລຳດັບທີ່ພວກມັນຖືກໂຫລດ."

#. Dialog to run rear
#: src/include/rear/ui.rb:406
msgid "Rear output:"
msgstr "ຜົນອອກຂອງ Rear:"

#: src/include/rear/ui.rb:408
msgid "Preparing for Rear Execution."
msgstr "ກຳລັງກຽມການປະຕິບັດງານ Rear."

#. -v : verbose; without it rear runs completely silent
#: src/include/rear/ui.rb:429
msgid "Running rear..."
msgstr "ກຳລັງເຮັດວຽກ Rear..."

#: src/include/rear/ui.rb:453
#, ycp-format
msgid "Execution failed with return value %1."
msgstr "ການປະຕິບັດງານຫຼົ້ມເຫຼວດ້ວຍຄ່າທີ່ສົ່ງຄືນ %1."

#: src/include/rear/ui.rb:462
msgid "Finished. You are strongly advised to test the created backup."
msgstr "ສຳເລັດແລ້ວ. ຂໍແນະນຳຢ່າງຍິ່ງໃຫ້ທ່ານທົດສອບການສຳຮອງຂໍ້ມູນທີ່ສ້າງຂຶ້ນ."

#. For translators: Caption of the dialog
#: src/include/rear/ui.rb:493
msgid "Rear Configuration"
msgstr "ການກຳນົດຄ່າ Rear"

#. help text for Rear
#: src/include/rear/ui.rb:496
msgid ""
"<p>Configure Rear Relax and Recover (<b>ReaR</b>) backup for your computer.</"
"p>"
msgstr ""
"<p>ກຳນົດຄ່າການສຳຮອງຂໍ້ມູນ Rear Relax and Recover (<b>ReaR</b>) ສຳລັບຄອມພິວເຕີຂອງທ່າ"
"ນ.</p>"

#: src/include/rear/ui.rb:499
msgid ""
"<p>Decide how to start your <b>Recovery System</b>. Choose USB if you want "
"to boot from an USB stick, or ISO for CD-ROM respectively.</p>"
msgstr ""
"<p>ຕັດສິນໃຈວ່າຈະເລີ່ມຕົ້ນ <b>ລະບົບກູ້ຄືນ</b> ຂອງທ່ານແນວໃດ. ເລືອກ USB ຫາກທ່ານຕ້ອງການບູດຈາກ "
"USB stick, ຫຼື ISO ສຳລັບ CD-ROM ຕາມລຳດັບ.</p>"

#: src/include/rear/ui.rb:502
msgid ""
"<p>Choose where the <b>Backup</b> should be stored. Select NFS if you have "
"to use a server that offers Network File System. Please specify the location "
"as follows: <tt>nfs://hostname/directory</tt>. You can also choose USB to "
"store your backup on an USB stick or USB disk.</p>"
msgstr ""
"<p>ເລືອກບ່ອນທີ່ຈະເກັບຮັກສາ <b>ການສຳຮອງຂໍ້ມູນ</b>. ເລືອກ NFS ຫາກທ່ານຕ້ອງໃຊ້ເຊີເວີທີ່ໃຫ້ບໍລິການ "
"Network File System. ກະລຸນາລະບຸຕຳແໜ່ງດັ່ງນີ້: <tt>nfs://hostname/directory</tt>. ທ່ານ"
"ຍັງສາມາດເລືອກ USB ເພື່ອເກັບການສຳຮອງຂໍ້ມູນໄວ້ໃນ USB stick ຫຼື USB disk.</p>"

#: src/include/rear/ui.rb:505
msgid ""
"<p>If no USB devices are shown, attach an USB stick or an USB disk and click "
"<b>Rescan USB Devices</b>.</p>"
msgstr ""
"<p>ຖ້າຫາກບໍ່ມີອຸປະກອນ USB ໃດຖືກສະແດງໃຫ້ເຫັນ, ໃຫ້ສຽບ USB ສະຕິກ ຫຼື USB ດິສ໌ ແລະ ກົດ <b>ສະແກນຫ"
"າອຸປະກອນ USB ຄືນໃໝ່</b>.</p>"

#: src/include/rear/ui.rb:508
msgid ""
"<p>Select <b>Keep old backup</b> if you don't want the previous backup copy "
"to be overwritten.</p>"
msgstr ""
"<p>ເລືອກ <b>ເກັບການສຳຮອງຂໍ້ມູນເກົ່າໄວ້</b> ຫາກທ່ານບໍ່ຕ້ອງການໃຫ້ສຳເນົາການສຳຮອງຂໍ້ມູນກ່ອນໜ້ານີ້ຖືກຂຽນ"
"ທັບ.</p>"

#: src/include/rear/ui.rb:511
msgid ""
"<p>The <b>Advanced</b> menu offers to add <b>additional directories to the "
"backup</b> and <b>additional kernel modules to the rescue system</b>. That's "
"only useful if your backup doesn't contain all the needed directories or the "
"rescue system doesn't boot due to missing kernel modules.</p>"
msgstr ""
"<p>ເມນູ <b>ຂັ້ນສູງ</b> ມີໃຫ້ເພີ່ມ <b>ໄດເຣັກທໍຣີເພີ່ມເຕີມເຂົ້າໃນການສຳຮອງຂໍ້ມູນ</b> ແລະ <b>ໂມດູນເຄີເ"
"ນິລເພີ່ມເຕີມເຂົ້າໃນລະບົບກູ້ໄພ</b>. ສິ່ງນີ້ຈະມີປະໂຫຍດກໍຕໍ່ເມື່ອການສຳຮອງຂໍ້ມູນຂອງທ່ານບໍ່ມີໄດເຣັກທໍຣີທີ່ຈຳເປັນທັງ"
"ໝົດ ຫຼື ລະບົບກູ້ໄພບໍ່ສາມາດບູດໄດ້ເນື່ອງຈາກຂາດໂມດູນເຄີເນິລ.</p>"

#: src/include/rear/ui.rb:514
msgid ""
"<p>The <b>Save and run rear now</b> button runs rear and shows rear's "
"output. <strong>Make sure to test if the created backup works as expected on "
"your system!</strong></p>"
msgstr ""
"<p>ປຸ່ມ <b>ບັນທຶກ ແລະ ເລີ່ມເຮັດວຽກ Rear ດຽວນີ້</b> ຈະເລີ່ມເຮັດວຽກ Rear ແລະ ສະແດງຜົນອອກຂອງ "
"Rear. <strong>ໃຫ້ແນ່ໃຈວ່າໄດ້ທົດສອບວ່າການສຳຮອງຂໍ້ມູນທີ່ສ້າງຂຶ້ນນັ້ນເຮັດວຽກໄດ້ຕາມທີ່ຄາດໄວ້ໃນລະບົບຂອງທ່"
"ານ!</strong></p>"

#: src/include/rear/ui.rb:517
msgid ""
"<p><b>OK</b> saves the configuration and quits while <b>Cancel</b> closes "
"the configuration dialog without saving.<p>"
msgstr ""
"<p><b>ຕົກລົງ</b> ຈະບັນທຶກການກຳນົດຄ່າ ແລະ ອອກຈາກລະບົບ ໃນຂະນະທີ່ <b>ຍົກເລີກ</b> ຈະປິດກ່ອງໂຕ້ຕ"
"ອບການກຳນົດຄ່າໂດຍບໍ່ໄດ້ບັນທຶກ.<p>"

