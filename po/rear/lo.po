msgstr "&ເກັບການສຳຮອງຂໍ້ມູນເກົ່າໄວ້"

#: src/include/rear/ui.rb:664
msgid "Use &dhclient"
msgstr "ໃຊ້ &dhclient"

#: src/include/rear/ui.rb:670
msgid "Rescan USB Devices"
msgstr "ສະແກນອຸປະກອນ USB ຄືນໃໝ່"

#: src/include/rear/ui.rb:673
msgid "&Backup Options"
msgstr "&ຕົວເລືອກການສຳຮອງຂໍ້ມູນ"

#: src/include/rear/ui.rb:679
msgid "Advanced"
msgstr "ຂັ້ນສູງ"

#: src/include/rear/ui.rb:681
