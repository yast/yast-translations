#. command-line help
#: src/lib/proxy/client.rb:41
msgid "Disable proxy settings"
msgstr "ປິດໃຊ້ການຕັ້ງຄ່າພຣັອກຊີ"

#. command-line help
#: src/lib/proxy/client.rb:49
msgid "Change the current proxy settings"
