#. Informative label
#: src/include/proxy/dialogs.rb:98
msgid "No details available."
msgstr "ບໍ່ມີລາຍລະອຽດ."

#. A push button
#: src/include/proxy/dialogs.rb:101
msgid "&Details <<"
msgstr "&ລາຍລະອຽດ <<"

#. avoid confusing Emacs
#. A push button
#: src/include/proxy/dialogs.rb:103
msgid "&Details >>"
msgstr "&ລາຍລະອຽດ >>"

#. The default error code, replaced with the current error code got from
#. proxy if any code found
#: src/include/proxy/dialogs.rb:174
msgid "Unknown Error Code"
msgstr "ລະຫັດຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກ"

#. Error message,
#. %1 is a string "HTTP", "HTTPS" or "FTP"
#. %2 is an error string such as "HTTP/1.0 403 Forbidden"
#: src/include/proxy/dialogs.rb:192
#, ycp-format
msgid ""
"An error occurred during the %1 proxy test.\n"
"Proxy return code: %2.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດລະຫວ່າງການທົດສອບພຣັອກຊີ %1.\n"
"ລະຫັດຕອບກັບຈາກພຣັອກຊີ: %2.\n"

#. Unknown return code,
#. %1 is the string HTTP, "HTTPS" or FTP,
#. %2 is an error string such as "HTTP/1.0 403 Forbidden"
#: src/include/proxy/dialogs.rb:208
#, ycp-format
msgid ""
"An unknown error occurred during the %1 proxy test.\n"
"Proxy return code: %2.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກລະຫວ່າງການທົດສອບພຣັອກຊີ %1.\n"
"ລະຫັດຕອບກັບຈາກພຣັອກຊີ: %2.\n"

#. An informative popup label diring the proxy testings
#: src/include/proxy/dialogs.rb:230
msgid "Testing the current proxy settings..."
msgstr "ກຳລັງທົດສອບການຕັ້ງຄ່າພຣັອກຊີປັດຈຸບັນ..."

#. TRANSLATORS: Error popup message
#: src/include/proxy/dialogs.rb:240
msgid "An error occurred during the HTTP proxy test."
msgstr "ເກີດຂໍ້ຜິດພາດລະຫວ່າງການທົດສອບພຣັອກຊີ HTTP."

#. TRANSLATORS: Error popup message
#: src/include/proxy/dialogs.rb:260
msgid "An error occurred during the HTTPS proxy test."
msgstr "ເກີດຂໍ້ຜິດພາດລະຫວ່າງການທົດສອບພຣັອກຊີ HTTPS."

#. TRANSLATORS: Error popup message
#: src/include/proxy/dialogs.rb:280
msgid "An error occurred during the FTP proxy test."
msgstr "ເກີດຂໍ້ຜິດພາດລະຫວ່າງການທົດສອບພຣັອກຊີ FTP."

#. Popup message
#: src/include/proxy/dialogs.rb:296
msgid "Proxy settings work correctly."
msgstr "ການຕັ້ງຄ່າພຣັອກຊີເຮັດວຽກຢ່າງຖືກຕ້ອງ."

#. Proxy dialog caption
#. Commandline help title
#: src/include/proxy/dialogs.rb:390 src/lib/proxy/client.rb:25
msgid "Proxy Configuration"
msgstr "ການກຳນົດຄ່າພຣັອກຊີ"

#. Proxy dialog help 1/8
#: src/include/proxy/dialogs.rb:396
msgid ""
"<p>Configure your Internet proxy (caching) settings here.</p>\n"
"<p><b>Note:</b> It is generally recommended to relogin for the settings to "
"take effect, \n"
"however in some cases the application may pick up new settings immediately. "
"Please check \n"
"what your application (web browser, ftp client,...) supports. </p>"
msgstr ""
"<p>ຕັ້ງຄ່າພຣັອກຊີອິນເຕີເນັດ (ການເກັບຂໍ້ມູນແຄັດ) ຂອງທ່ານຢູ່ນີ້.</p>\n"
"<p><b>ໝາຍເຫດ:</b> ໂດຍທົ່ວໄປແລ້ວແມ່ນແນະນຳໃຫ້ເຂົ້າສູ່ລະບົບໃໝ່ເພື່ອໃຫ້ການຕັ້ງຄ່າມີຜົນ, \n"
"ແນວໃດກໍຕາມ ໃນບາງກໍລະນີ ແອັບພລິເຄຊັນອາດຈະຮັບເອົາການຕັ້ງຄ່າໃໝ່ໃນທັນທີ. ກະລຸນາກວດສອບ \n"
"ເບິ່ງວ່າແອັບພລິເຄຊັນຂອງທ່ານ (ເວັບບຣາວເຊີ, ຕົວລູກຂ່າຍ ftp,...) ຮອງຮັບຫຍັງແດ່. </p>"

#. Proxy dialog help 2/8
#: src/include/proxy/dialogs.rb:405
msgid ""
"<p><b>HTTP Proxy URL</b> is the name of the proxy server for your access\n"
"to the World Wide Web (WWW).</p>\n"
msgstr ""
"<p><b>HTTP Proxy URL</b> ແມ່ນຊື່ຂອງເຊີເວີພຣັອກຊີສຳລັບການເຂົ້າເຖິງ\n"
"ເວັບ (WWW) ຂອງທ່ານ.</p>\n"

#. Proxy dialog help 3/8
#: src/include/proxy/dialogs.rb:410
msgid ""
"<p><b>HTTPS Proxy URL</b> is the name of the proxy server for your secured "
"access\n"
"to the World Wide Web (WWW).</p>\n"
msgstr ""
"<p><b>HTTPS Proxy URL</b> ແມ່ນຊື່ຂອງເຊີເວີພຣັອກຊີສຳລັບການເຂົ້າເຖິງ\n"
"ເວັບ (WWW) ແບບປອດໄພຂອງທ່ານ.</p>\n"

#. Proxy dialog help 3.5/8
#: src/include/proxy/dialogs.rb:415
msgid "<p>Example: <i>http://proxy.example.com:3128/</i></p>"
msgstr "<p>ຕົວຢ່າງ: <i>http://proxy.example.com:3128/</i></p>"

#. Proxy dialog help 4/8
#: src/include/proxy/dialogs.rb:417
msgid ""
"<p><b>FTP Proxy URL</b> is the name of the proxy server for your access\n"
"to the file transfer services (FTP).</p>"
msgstr ""
"<p><b>FTP Proxy URL</b> ແມ່ນຊື່ຂອງເຊີເວີພຣັອກຊີສຳລັບການເຂົ້າເຖິງ\n"
"ການບໍລິການຮັບສົ່ງໄຟລ໌ (FTP).</p>"

#. Proxy dialog help 5/8
#: src/include/proxy/dialogs.rb:422
msgid ""
"<p>If you check <b>Use the Same Proxy for All Protocols</b>, it is\n"
"enough to fill in the HTTP proxy URL. It will be used for all protocols\n"
"(HTTP, HTTPS and FTP).\n"
msgstr ""
"<p>ຖ້າທ່ານເລືອກ <b>ໃຊ້ພຣັອກຊີດຽວກັນສຳລັບທຸກໂປຣໂຕຄໍ</b>, ມັນ\n"
"ພຽງພໍທີ່ຈະປ້ອນພຽງແຕ່ HTTP proxy URL. ມັນຈະຖືກນຳໃຊ້ສຳລັບທຸກໂປຣໂຕຄໍ\n"
"(HTTP, HTTPS ແລະ FTP).\n"

#. Proxy dialog help 6/8
#: src/include/proxy/dialogs.rb:429
#, ycp-format
msgid ""
"<p><b>No Proxy Domains</b> is a comma-separated list of domains\n"
"for which the requests should be made directly without caching,\n"
"for example, <i>%1</i>.</p>\n"
msgstr ""
"<p><b>ໂດເມນທີ່ບໍ່ຜ່ານພຣັອກຊີ</b> ແມ່ນລາຍຊື່ໂດເມນທີ່ຄັ່ນດ້ວຍເຄື່ອງໝາຍຈຸດ\n"
"ເຊິ່ງການຮ້ອງຂໍຄວນຈະເຮັດໂດຍກົງໂດຍບໍ່ມີການເກັບຂໍ້ມູນແຄັດ,\n"
"ຕົວຢ່າງເຊັ່ນ, <i>%1</i>.</p>\n"

#. Proxy dialog help 7/8
#: src/include/proxy/dialogs.rb:438
msgid ""
"<p>If you are using a proxy server with authorization, enter\n"
"the <b>Proxy User Name</b> and <b>Proxy Password</b>. A valid username\n"
"consists of printable ASCII characters only (except for quotation marks).</"
"p>\n"
msgstr ""
"<p>ຖ້າຫາກທ່ານກຳລັງໃຊ້ງານເຊີເວີພຣັອກຊີທີ່ມີການຢືນຢັນຕົວຕົນ, ໃຫ້ປ້ອນ\n"
"<b>ຊື່ຜູ້ໃຊ້ພຣັອກຊີ</b> ແລະ <b>ລະຫັດຜ່ານພຣັອກຊີ</b>. ຊື່ຜູ້ໃຊ້ທີ່ຖືກຕ້ອງ\n"
"ປະກອບດ້ວຍຕົວອັກສອນ ASCII ທີ່ສາມາດພິມໄດ້ເທົ່ານັ້ນ (ຍົກເວັ້ນເຄື່ອງໝາຍຄຳເວົ້າ).</p>\n"

#. Proxy dialog help 8/8
#: src/include/proxy/dialogs.rb:448
msgid ""
"<p>Press <b>Test Proxy Settings</b> to test\n"
"the current configuration for HTTP, HTTPS, and FTP proxy.</p> \n"
msgstr ""
"<p>ກົດ <b>ທົດສອບການຕັ້ງຄ່າພຣັອກຊີ</b> ເພື່ອທົດສອບ\n"
"ການຕັ້ງຄ່າໃນປັດຈຸບັນສຳລັບພຣັອກຊີ HTTP, HTTPS, ແລະ FTP.</p> \n"

#. CheckBox entry label
#: src/include/proxy/dialogs.rb:466
msgid "&Enable Proxy"
msgstr "&ເປີດໃຊ້ງານພຣັອກຊີ"

#. Frame label
#: src/include/proxy/dialogs.rb:472
msgid "Proxy Settings"
msgstr "ການຕັ້ງຄ່າພຣັອກຊີ"

#. Text entry label
#: src/include/proxy/dialogs.rb:478
msgid "&HTTP Proxy URL"
msgstr "URL ຂອງພຣັອກຊີ &HTTP"

#: src/include/proxy/dialogs.rb:480
msgid "HTTP&S Proxy URL"
msgstr "URL ຂອງພຣັອກຊີ HTTP&S"

#. Text entry label
#: src/include/proxy/dialogs.rb:483
msgid "F&TP Proxy URL"
msgstr "URL ຂອງພຣັອກຊີ F&TP"

#: src/include/proxy/dialogs.rb:489
msgid "Us&e the Same Proxy for All Protocols"
msgstr "ໃ&ຊ້ພຣັອກຊີດຽວກັນສຳລັບທຸກໂປຣໂຕຄໍ"

#. Text entry label
#. domains without proxying
#: src/include/proxy/dialogs.rb:494
msgid "No Proxy &Domains"
msgstr "&ໂດເມນທີ່ບໍ່ໃຊ້ພຣັອກຊີ"

#: src/include/proxy/dialogs.rb:503
msgid "Proxy Authentication"
msgstr "ການຢືນຢັນຕົວຕົນພຣັອກຊີ"

#. Text entry label
#: src/include/proxy/dialogs.rb:512
msgid "Proxy &User Name"
msgstr "&ຊື່ຜູ້ໃຊ້ພຣັອກຊີ"

#. Password entry label
#: src/include/proxy/dialogs.rb:520
msgid "Proxy &Password"
msgstr "&ລະຫັດຜ່ານພຣັອກຊີ"

#. Test Proxy Settings - push button
#: src/include/proxy/dialogs.rb:534
msgid "Test Pr&oxy Settings"
msgstr "ທົດສອບການຕັ້ງຄ່າພຣັ&ອກຊີ"

#. Popup error text - http, https and ftp proxy URLs are blank
#: src/include/proxy/dialogs.rb:611
msgid ""
"Proxy is enabled, but no proxy URL has been specified.\n"
"Really use these settings?"
msgstr ""
"ພຣັອກຊີຖືກເປີດໃຊ້ງານແລ້ວ, ແຕ່ຍັງບໍ່ໄດ້ກຳນົດ URL ຂອງພຣັອກຊີ.\n"
"ຕ້ອງການໃຊ້ການຕັ້ງຄ່ານີ້ແທ້ຫຼືບໍ່?"

#: src/include/proxy/dialogs.rb:623
msgid ""
"Security warning:\n"
"Username and password will be stored unencrypted\n"
"in a worldwide readable plaintext file.\n"
"Really use these settings?"
msgstr ""
"ຄຳເຕືອນຄວາມປອດໄພ:\n"
"ຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານຈະຖືກເກັບໄວ້ໂດຍບໍ່ໄດ້ເຂົ້າລະຫັດ\n"
"ໃນໄຟລ໌ຂໍ້ຄວາມທຳມະດາທີ່ທຸກຄົນສາມາດອ່ານໄດ້.\n"
"ຕ້ອງການໃຊ້ການຕັ້ງຄ່ານີ້ແທ້ຫຼືບໍ່?"

#. Popup::Error text
#: src/include/proxy/dialogs.rb:637
msgid "You cannot enter a password and leave the user name empty."
msgstr "ທ່ານບໍ່ສາມາດປ້ອນລະຫັດຜ່ານໂດຍປະຊື່ຜູ້ໃຊ້ໃຫ້ວ່າງໄວ້ໄດ້."

#. Popup::Error text
#: src/include/proxy/dialogs.rb:645
msgid "HTTP proxy URL is invalid."
msgstr "URL ຂອງພຣັອກຊີ HTTP ບໍ່ຖືກຕ້ອງ."

#. Popup::Error text
#: src/include/proxy/dialogs.rb:653
msgid "HTTP proxy URL must contain a scheme specification (http)."
msgstr "URL ຂອງພຣັອກຊີ HTTP ຕ້ອງມີການກຳນົດຮູບແບບ (http)."

#. Popup::Error text
#: src/include/proxy/dialogs.rb:662
msgid "The HTTPS proxy URL is invalid."
msgstr "URL ຂອງພຣັອກຊີ HTTPS ບໍ່ຖືກຕ້ອງ."

#. Popup::Error text
#: src/include/proxy/dialogs.rb:670
msgid "The HTTPS proxy URL must contain a scheme specification (http)."
msgstr "URL ຂອງພຣັອກຊີ HTTPS ຕ້ອງມີການກຳນົດຮູບແບບ (http)."

#. Popup::Error text
#: src/include/proxy/dialogs.rb:681
msgid "FTP proxy URL is invalid."
msgstr "URL ຂອງພຣັອກຊີ FTP ບໍ່ຖືກຕ້ອງ."

#. Popup::Error text
#: src/include/proxy/dialogs.rb:689
msgid "FTP proxy URL must contain a scheme specification (http)."
msgstr "URL ຂອງພຣັອກຊີ FTP ຕ້ອງມີການກຳນົດຮູບແບບ (http)."

#. Translators: no proxy domain is a domain that can be accessed without proxy
#: src/include/proxy/dialogs.rb:698
msgid ""
"One or more no proxy domains are invalid. \n"
"Check if all domains match one of the following:\n"
"* IP address\n"
"* IP address/netmask\n"
"* Fully qualified hostname\n"
"* Domain name prefixed by '.'"
msgstr ""
"ມີໜຶ່ງໂດເມນ ຫຼື ຫຼາຍກວ່າທີ່ບໍ່ໃຊ້ພຣັອກຊີບໍ່ຖືກຕ້ອງ. \n"
"ກວດສອບວ່າທຸກໂດເມນກົງກັບຂໍ້ໃດໜຶ່ງລຸ່ມນີ້:\n"
"* ທີ່ຢູ່ IP\n"
"* ທີ່ຢູ່ IP/netmask\n"
"* ຊື່ໂຮສທີ່ສົມບູນ (Fully qualified hostname)\n"
"* ຊື່ໂດເມນທີ່ຂຶ້ນຕົ້ນດ້ວຍ '.'"

#. Return a modification status
