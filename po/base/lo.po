msgstr "ກຳລັງຕິດຕັ້ງ..."

#. Help text while software packages are being installed (displayed only in rare cases)
#: library/packages/src/modules/SlideShow.rb:501
msgid "<p>Packages are being installed.</p>"
msgstr "<p>ກຳລັງຕິດຕັ້ງແພັກເກດ.</p>"

#: library/packages/src/modules/SlideShow.rb:502
msgid ""
"<P><B>Aborting Installation</B> Package installation can be aborted using "
"the <B>Abort</B> button. However, the system then can be in an inconsistent "
"or unusable state or it may not boot if the basic system component is not "
"installed.</P>"
msgstr ""
"<P><B>ການຍົກເລີກການຕິດຕັ້ງ</B> ການຕິດຕັ້ງແພັກເກດສາມາດຍົກເລີກໄດ້ໂດຍການກົດປຸ່ມ <B>ຍົກເລີກ</B>. ຢ່"
"າງໃດກໍຕາມ, ລະບົບອາດຈະຢູ່ໃນສະຖານະທີ່ບໍ່ສົມບູນ ຫຼື ບໍ່ສາມາດໃຊ້ງານໄດ້ ຫຼື ອາດຈະເປີດເຄື່ອງບໍ່ຂຶ້ນ ຫາກສ່ວນປະ"
"ກອບພື້ນຖານຂອງລະບົບຍັງຕິດຕັ້ງບໍ່ສຳເລັດ.</P>"

