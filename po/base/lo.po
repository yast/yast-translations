#: library/cwm/src/modules/CWMServiceStart.rb:502
#, ycp-format
msgid ""
"<p><b><big>Switch On or Off</big></b><br>\n"
"To start or stop the service immediately, use \n"
"<b>%1</b> or <b>%2</b>.</p>"
msgstr ""
"<p><b><big>ເປີດ ຫຼື ປິດ</big></b><br>\n"
"ເພື່ອເລີ່ມຕົ້ນ ຫຼື ຢຸດບໍລິການທັນທີ, ໃຫ້ໃຊ້ \n"
"<b>%1</b> ຫຼື <b>%2</b>.</p>"

