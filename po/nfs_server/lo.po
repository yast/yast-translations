#. Command line help text for the nfs-server module
#: src/clients/nfs_server.rb:46
msgid "Configuration of NFS server"
msgstr "ການຕັ້ງຄ່າເຊີເວີ NFS"

#. command line action help
#: src/clients/nfs_server.rb:59
msgid "NFS server configuration summary"
msgstr "ບົດສະຫຼຸບການຕັ້ງຄ່າເຊີເວີ NFS"

#: src/clients/nfs_server.rb:69
msgid "Start NFS server"
msgstr "ເລີ່ມເຊີເວີ NFS"

#: src/clients/nfs_server.rb:73
msgid "Stop NFS server"
msgstr "ຢຸດເຊີເວີ NFS"

#: src/clients/nfs_server.rb:77
msgid "Add a directory to export"
msgstr "ເພີ່ມໂຟນເດີທີ່ຈະສົ່ງອອກ"

#: src/clients/nfs_server.rb:84
msgid "Delete a directory from export"
msgstr "ລົບໂຟນເດີອອກຈາກການສົ່ງອອກ"

#: src/clients/nfs_server.rb:91
msgid "Set the parameters for domain, security and enablev4."
msgstr "ກໍານົດພາຣາມິເຕີສໍາລັບໂດເມນ, ຄວາມປອດໄພ ແລະ ການເປີດໃຊ້ v4."

#: src/clients/nfs_server.rb:99
msgid "Directory to export"
msgstr "ໂຟນເດີທີ່ຈະສົ່ງອອກ"

#: src/clients/nfs_server.rb:103
msgid "Host wild card for setting the access to directory"
msgstr "ຕົວແທນໂຮສ (Host wild card) ສໍາລັບການຕັ້ງຄ່າການເຂົ້າເຖິງໂຟນເດີ"

#. command line option help (do not transl. 'man exports')
#: src/clients/nfs_server.rb:108
msgid "Export options (see 'man exports')"
msgstr "ຕົວເລືອກການສົ່ງອອກ (ເບິ່ງ 'man exports')"

#: src/clients/nfs_server.rb:114
msgid ""
"Domain specification for NFSv4 ID mapping, such as 'localdomain' or 'abc."
"com' etc."
msgstr ""
"ການລະບຸໂດເມນສໍາລັບການຈັບຄູ່ ID ຂອງ NFSv4, ເຊັ່ນ 'localdomain' ຫຼື 'abc.com' ແລະ ອື່ນໆ."

#. TRANSLATORS %{yes} and %{no} are not translated input values "yes"
#. and "no" which is not localized.
#. TRANSLATORS %{yes} and %{no} are not translated input values "yes"
#. and "no" which is not localized.
#: src/clients/nfs_server.rb:124 src/clients/nfs_server.rb:134
#, perl-brace-format
msgid "%{yes}'/'%{no}' option for enabling/disabling support for NFSv4."
msgstr "ຕົວເລືອກ %{yes}'/'%{no} ສໍາລັບການເປີດ/ປິດ ການຮອງຮັບ NFSv4."

#. summary text
#: src/clients/nfs_server.rb:207
msgid "NFS server is enabled"
msgstr "ເປີດໃຊ້ງານເຊີເວີ NFS ແລ້ວ"

#. summary text
#: src/clients/nfs_server.rb:210
msgid "NFS server is disabled"
msgstr "ປິດໃຊ້ງານເຊີເວີ NFS ແລ້ວ"

#. error message
#: src/clients/nfs_server.rb:226
#, ycp-format
msgid "Required packages (%1) are not installed."
msgstr "ແພັກເກດທີ່ຈໍາເປັນ (%1) ຍັງບໍ່ທັນໄດ້ຕິດຕັ້ງ."

#. CLI action handler.
#. @param [Hash] options command options
#. @return whether successful
#: src/clients/nfs_server.rb:240
msgid "NFS server already running."
msgstr "ເຊີເວີ NFS ກໍາລັງເຮັດວຽກຢູ່ແລ້ວ."

#. CLI action handler.
#. @param [Hash] options command options
#. @return whether successful
#: src/clients/nfs_server.rb:253
msgid "NFS server is already stopped."
msgstr "ເຊີເວີ NFS ຖືກຢຸດຢູ່ແລ້ວ."

#. error
#. error
#: src/clients/nfs_server.rb:271 src/clients/nfs_server.rb:301
msgid "No mount point specified."
msgstr "ບໍ່ໄດ້ລະບຸຈຸດເຊື່ອມຕໍ່ (mount point)."

#: src/clients/nfs_server.rb:276
msgid ""
"The exports table already\n"
"contains this directory."
msgstr ""
"ຕາຕະລາງການສົ່ງອອກມີ\n"
"ໂຟນເດີນີ້ຢູ່ແລ້ວ."

#. TRANSLATORS %s is mountpoint that is not found in nfs server configuration.
#: src/clients/nfs_server.rb:316
#, c-format
msgid "Mount point '%s' not found."
msgstr "ບໍ່ພົບຈຸດເຊື່ອມຕໍ່ '%s'."

#. CLI action handler.
#. @param [Hash] options command options
#. @return whether successful
#: src/clients/nfs_server.rb:340
msgid ""
"Domain cannot be set without enabling NFSv4. Use the 'set enablev4=yes' "
"command."
msgstr ""
"ບໍ່ສາມາດຕັ້ງຄ່າໂດເມນໄດ້ຖ້າບໍ່ເປີດໃຊ້ NFSv4. ໃຫ້ໃຊ້ຄໍາສັ່ງ 'set enablev4=yes'."

#: src/clients/nfs_server.rb:351
msgid ""
"Command 'set' must be used in the form 'set option=value'. Use 'set help' to "
"get information about available options."
msgstr ""
"ຄໍາສັ່ງ 'set' ຕ້ອງຢູ່ໃນຮູບແບບ 'set option=value'. ໃຫ້ໃຊ້ 'set help' ເພື່ອເບິ່ງຂໍ້ມູນກ່ຽວກັບຕົວເລື"
"ອກທີ່ມີ."

#. Then no need to check for conflict.
#: src/include/nfs_server/routines.rb:205
#: src/include/nfs_server/routines.rb:215
#, ycp-format
msgid ""
"%3 and %4 are both exported with the option fsid=0\n"
"for the same client '%1' (contained in '%2')"
msgstr ""
"ທັງ %3 ແລະ %4 ຖືກສົ່ງອອກດ້ວຍຕົວເລືອກ fsid=0\n"
"ສໍາລັບໄຄລເອັນ (client) ດຽວກັນ '%1' (ທີ່ມີຢູ່ໃນ '%2')"

#. selection box label
#: src/include/nfs_server/routines.rb:313
msgid "Dire&ctories"
msgstr "ໂຟນເ&ດີ"

#. error popup message
#: src/include/nfs_server/routines.rb:331
msgid ""
"The wild card or options string is invalid.\n"
"It must be shorter than 70 characters and it\n"
"must not contain spaces.\n"
msgstr ""
"ຕົວແທນ ຫຼື ຂໍ້ຄວາມຕົວເລືອກບໍ່ຖືກຕ້ອງ.\n"
"ມັນຕ້ອງສັ້ນກວ່າ 70 ຕົວອັກສອນ ແລະ\n"
"ຕ້ອງບໍ່ມີຫວ່າງວ່າງ.\n"

#. error popup message
#: src/include/nfs_server/routines.rb:353
msgid ""
"Invalid option.\n"
"Only letters, digits, and the characters =/.:,_- are allowed."
msgstr ""
"ຕົວເລືອກບໍ່ຖືກຕ້ອງ.\n"
"ອະນຸຍາດໃຫ້ໃຊ້ສະເພາະຕົວອັກສອນ, ຕົວເລກ ແລະ ເຄື່ອງໝາຍ =/.:,_- ເທົັ້ນັ້ນ."

#. error popup message
#: src/include/nfs_server/routines.rb:401
#, ycp-format
msgid "Unknown option: '%1'"
msgstr "ບໍ່ຮູ້ຈັກຕົວເລືອກ: '%1'"

#. error popup message
#: src/include/nfs_server/routines.rb:406
#, ycp-format
msgid "Invalid option: '%1'"
msgstr "ຕົວເລືອກບໍ່ຖືກຕ້ອງ: '%1'"

#. %1 is a list of exported paths
#: src/include/nfs_server/routines.rb:438
#, ycp-format
msgid ""
"There are unbalanced parentheses in export options\n"
"for %1.\n"
"Likely, there is a spurious whitespace in the configuration file.\n"
msgstr ""
"ມີວົງເລັບບໍ່ຄົບຄູ່ໃນຕົວເລືອກການສົ່ງອອກ\n"
"ສໍາລັບ %1.\n"
"ອາດຈະມີການຍະຫວ່າງທີ່ຜິດພາດໃນໄຟລ໌ການຕັ້ງຄ່າ.\n"

#. text entry label
#: src/include/nfs_server/ui.rb:58
msgid "&Directory to Export"
msgstr "&ໂຟນເດີທີ່ຈະສົ່ງອອກ"

#. button label
#: src/include/nfs_server/ui.rb:64
msgid "&Browse..."
msgstr "&ຊອກຫາ..."

#: src/include/nfs_server/ui.rb:87
msgid "Enter a non-empty export path. For example, /exports."
msgstr "ປ້ອນເສັ້ນທາງການສົ່ງອອກທີ່ບໍ່ວ່າງ. ຕົວຢ່າງ: /exports."

#. error popup message
#: src/include/nfs_server/ui.rb:95
msgid "The exports table already contains this directory."
msgstr "ຕາຕະລາງການສົ່ງອອກມີໂຟນເດີນີ້ຢູ່ແລ້ວ."

#. the dir does not exist
#: src/include/nfs_server/ui.rb:101
msgid "The directory does not exist. Create it?"
msgstr "ບໍ່ມີໂຟນເດີນີ້. ຕ້ອງການສ້າງມັນບໍ່?"

#. title in the file selection dialog
#: src/include/nfs_server/ui.rb:111
msgid "Select the Directory to Export"
msgstr "ເລືອກໂຟນເດີທີ່ຈະສົ່ງອອກ"

#. text entry label
#: src/include/nfs_server/ui.rb:168
msgid "&Host Wild Card"
msgstr "&ຕົວແທນໂຮສ"

#. text entry label
#: src/include/nfs_server/ui.rb:170
msgid "O&ptions"
msgstr "ຕົວເ&ລືອກ"

#. check to see if user has changed options entry in the dialogue
#. thrown due to a "Add Hosts" (as opposed to editing existing ones).
#. If yes, suggest the user with a suitable default option set.
#: src/include/nfs_server/ui.rb:225
msgid ""
"'fsid=0' is not a valid option unless \n"
"NFSv4 is enabled (previous page).\n"
msgstr ""
"'fsid=0' ບໍ່ແມ່ນຕົວເລືອກທີ່ຖືກຕ້ອງ ຍົກເວັ້ນແຕ່ຈະ\n"
"ເປີດໃຊ້ NFSv4 (ໜ້າກ່ອນໜ້ານີ້).\n"

#. error popup message
#: src/include/nfs_server/ui.rb:243
msgid ""
"Options for this wild card\n"
"are already set."
msgstr ""
"ຕົວເລືອກສໍາລັບຕົວແທນນີ້\n"
"ໄດ້ຖືກຕັ້ງຄ່າໄວ້ແລ້ວ."

#. Help, part 1 of 2
#: src/include/nfs_server/ui.rb:282
msgid ""
"<P>Here, choose whether to start an NFS server on your computer\n"
"and export some of your directories to others.</P>"
msgstr ""
"<P>ຢູ່ບ່ອນນີ້, ໃຫ້ເລືອກວ່າຈະເລີ່ມເຊີເວີ NFS ໃນຄອມພິວເຕີຂອງທ່ານ\n"
"ແລະ ສົ່ງອອກບາງໂຟນເດີຂອງທ່ານໃຫ້ກັບຜູ້ອື່ນຫຼືບໍ່.</P>"

#. Help, part 2 of 2
#: src/include/nfs_server/ui.rb:289
msgid ""
"<P>If you choose <B>Start NFS Server</B>, clicking <B>Next</B> opens\n"
"a configuration dialog in which to specify the directories to export.</P>"
msgstr ""
"<P>ຖ້າທ່ານເລືອກ <B>ເລີ່ມເຊີເວີ NFS</B>, ການຄລິກ <B>ຕໍ່ໄປ</B> ຈະເປີດ\n"
"ໜ້າຕ່າງການຕັ້ງຄ່າ ເພື່ອລະບຸໂຟນເດີທີ່ຈະສົ່ງອອກ.</P>"

#: src/include/nfs_server/ui.rb:298
msgid ""
"<P>If the server needs to handle NFSv4 clients, check <B>Enable NFSv4</B>.\n"
"Refer to the man page for idmapd and idmapd.conf if you are not sure with "
"user / group names mappings.</P>\n"
msgstr ""
"<P>ຖ້າເຊີເວີຕ້ອງການຈັດການກັບໄຄລເອັນ NFSv4, ໃຫ້ໝາຍຕິກ <B>ເປີດໃຊ້ NFSv4</B>.\n"
"ໃຫ້ເບິ່ງ man page ສໍາລັບ idmapd ແລະ idmapd.conf ຖ້າທ່ານບໍ່ແນ່ໃຈກ່ຽວກັບການຈັບຄູ່ຊື່ຜູ້ໃຊ້ / ກຸ່ມ.</"
"P>\n"

#. FIXME: use %1 as nfs-utils.src.rpm produces nfs-kernel-server.rpm
#: src/include/nfs_server/ui.rb:307
msgid ""
"<P>If the server and client must authenticate using GSS library, check the\n"
"<B>Enable GSS Security</B> box. To use GSS API, you currently need to have "
"Kerberos and gssapi (nfs-utils > 1.0.7) on your system.</P>\n"
msgstr ""
"<P>ຖ້າເຊີເວີ ແລະ ໄຄລເອັນຕ້ອງຢືນຢັນຕົວຕົນໂດຍໃຊ້ໄລບຣາຣີ GSS, ໃຫ້ໝາຍຕິກໃສ່ຫ້ອງ\n"
"<B>ເປີດໃຊ້ຄວາມປອດໄພ GSS</B>. ເພື່ອໃຊ້ GSS API, ໃນປັດຈຸບັນທ່ານຈໍາເປັນຕ້ອງມີ Kerberos ແລະ "
"gssapi (nfs-utils > 1.0.7) ໃນລະບົບຂອງທ່ານ.</P>\n"

#. frame label
#: src/include/nfs_server/ui.rb:317
msgid "NFS Server"
msgstr "ເຊີເວີ NFS"

#. radio button label
#: src/include/nfs_server/ui.rb:328
msgid "&Start"
msgstr "&ເລີ່ມ"

#. radio button label
#: src/include/nfs_server/ui.rb:337
msgid "Do &Not Start"
msgstr "&ບໍ່ຕ້ອງເລີ່ມ"

#. frame label
#: src/include/nfs_server/ui.rb:355
msgid "Enable NFSv4"
msgstr "ເປີດໃຊ້ NFSv4"

#: src/include/nfs_server/ui.rb:362
msgid "Enable NFS&v4"
msgstr "ເປີດໃຊ້ NFS&v4"

#: src/include/nfs_server/ui.rb:375
msgid "Enable &GSS Security"
msgstr "ເປີດໃຊ້ຄວາມປອດໄພ &GSS"

#. dialog title
#: src/include/nfs_server/ui.rb:395
msgid "NFS Server Configuration"
msgstr "ການຕັ້ງຄ່າເຊີເວີ NFS"

#. Help, part 1 of 4
#: src/include/nfs_server/ui.rb:457
msgid ""
"<P>The upper box contains all the directories to export.\n"
"If a directory is selected, the lower box shows the hosts allowed to\n"
"mount this directory.</P>\n"
msgstr ""
"<P>ຫ້ອງດ້ານເທິງປະກອບມີທຸກໂຟນເດີທີ່ຈະສົ່ງອອກ.\n"
"ຖ້າເລືອກໂຟນເດີໃດໜຶ່ງ, ຫ້ອງດ້ານລຸ່ມຈະສະແດງໂຮສທີ່ໄດ້ຮັບອະນຸຍາດໃຫ້\n"
"ເຊື່ອມຕໍ່ (mount) ໂຟນເດີນີ້.</P>\n"

#. Help, part 2 of 4
#: src/include/nfs_server/ui.rb:465
msgid ""
"<P><b>Host Wild Card</b> sets which hosts can access the selected "
"directory.\n"
"It can be a single host, groups, wild cards, or\n"
"IP networks.</P>\n"
msgstr ""
"<P><b>ຕົວແທນຊື່ໂຮສ໌</b> ກຳນົດວ່າໂຮສ໌ໃດແດ່ທີ່ສາມາດເຂົ້າເຖິງໄດເຣັກທໍຣີທີ່ເລືອກໄດ້.\n"
"ມັນສາມາດເປັນໂຮສ໌ດຽວ, ກຸ່ມ, ຕົວແທນ, ຫຼື\n"
"ເຄືອຂ່າຍ IP.</P>\n"

#. Help, part 3 of 4
#: src/include/nfs_server/ui.rb:473
msgid ""
"<p>Enter an asterisk (<tt>*</tt>) instead of a name to specify all hosts.</p>"
msgstr "<p>ປ້ອນເຄື່ອງໝາຍດອກຈັນ (<tt>*</tt>) ແທນຊື່ເພື່ອລະບຸທຸກໂຮສ.</p>"

#. Help, part 4 of 4
#: src/include/nfs_server/ui.rb:479
