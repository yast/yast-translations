#. Main
#. Definition of command line mode options
#: src/clients/virtualization.rb:54
msgid "Install Hypervisor and Tools"
msgstr "ຕິດຕັ້ງ ໄຮເປີໄວເຊີ ແລະ ເຄື່ອງມື"

#. progress step title
#: src/clients/vm_finish.rb:70
msgid "Configuring the virtual machine..."
msgstr "ກຳລັງກຳນົດຄ່າເຄື່ອງສະເມືອນ..."

#. The tools patterns install gui components. If in text mode we may not want them
#: src/modules/VirtConfig.rb:129
msgid "Running in text mode. Install graphical components anyway?"
msgstr "ກຳລັງເຮັດວຽກໃນໂໝດຕົວອັກສອນ. ຕ້ອງການຕິດຕັ້ງສ່ວນປະກອບກຣາຟິກຫຼືບໍ່?"

#. The tools patterns will pull in graphical components so drop entire pattern if present
#: src/modules/VirtConfig.rb:177
msgid ""
"x86_64 is the only supported architecture for hosting virtual machines. Your "
"architecture is "
msgstr ""
"x86_64 ແມ່ນສະຖາປັດຕະຍະກຳດຽວທີ່ຮອງຮັບສຳລັບການເປັນໂຮສເຄື່ອງສະເມືອນ. ສະຖາປັດຕະຍະກຳຂອງທ່ານແມ່"
"ນ "

#. we are already in UML, nested virtual machine is not supported
#: src/modules/VirtConfig.rb:196
msgid ""
"Virtual machine installation cannot be started inside the UML machine.\n"
"Start installation in the host system.\n"
msgstr ""
"ບໍ່ສາມາດເລີ່ມການຕິດຕັ້ງເຄື່ອງສະເມືອນພາຍໃນເຄື່ອງ UML ໄດ້.\n"
"ກະລຸນາເລີ່ມການຕິດຕັ້ງໃນລະບົບໂຮສ (host system).\n"

#. progress stage 1/2
#: src/modules/VirtConfig.rb:212
msgid "Verify Installed Packages"
msgstr "ກວດສອບແພັກເກດທີ່ຕິດຕັ້ງແລ້ວ"

#. progress stage 2/2
#: src/modules/VirtConfig.rb:214
msgid "Network Bridge Configuration"
msgstr "ການກຳນົດຄ່າບຣິດເຄືອຂ່າຍ"

#. Headline for management domain installation
#: src/modules/VirtConfig.rb:229
msgid "Configuring the VM Server (domain 0)"
msgstr "ກຳລັງກຳນົດຄ່າ VM Server (domain 0)"

#. xen domain0 installation help text - 1/4
#: src/modules/VirtConfig.rb:232
msgid ""
"<p><big><b>VM Server Configuration</b></big></p><p>Configuration of the VM "
"Server (domain 0) has two parts.</p>"
msgstr ""
"<p><big><b>ການກຳນົດຄ່າ VM Server</b></big></p><p>ການກຳນົດຄ່າຂອງ VM Server "
"(domain 0) ມີສອງສ່ວນ.</p>"

#. xen domain0 installation help text - 2/4
#: src/modules/VirtConfig.rb:236
msgid ""
"<p>The required packages are installed into the system first. Then the boot "
"loader is switched to GRUB (if not already used) and the Xen section is "
"added to the boot loader menu if it is missing.</p>"
msgstr ""
"<p>ແພັກເກດທີ່ຈຳເປັນຈະຖືກຕິດຕັ້ງເຂົ້າໃນລະບົບກ່ອນ. ຈາກນັ້ນບູດໂຫລດເດີຈະຖືກປ່ຽນເປັນ GRUB (ຖ້າຍັງບໍ່ທັນໄດ້ໃ"
"ຊ້) ແລະ ຫົວຂໍ້ Xen ຈະຖືກເພີ່ມເຂົ້າໃນເມນູບູດໂຫລດເດີ ຖ້າມັນຍັງບໍ່ມີ.</p>"

#. xen domain0 installation help text - 3/4
#: src/modules/VirtConfig.rb:240
msgid ""
"<p>GRUB is needed because it supports the multiboot standard required to "
"boot Xen and the Linux kernel.</p>"
msgstr ""
"<p>GRUB ແມ່ນຈຳເປັນ ເພາະວ່າມັນຮອງຮັບມາດຕະຖານ multiboot ທີ່ຕ້ອງໃຊ້ໃນການບູດ Xen ແລະ Linux "
"kernel.</p>"

#. xen domain0 installation help text - 4/4
#: src/modules/VirtConfig.rb:244
msgid ""
"<p>When the configuration has finished successfully, you can boot the VM "
"Server from the boot loader menu.</p>"
msgstr ""
"<p>ເມື່ອການກຳນົດຄ່າສຳເລັດແລ້ວ, ທ່ານສາມາດບູດ VM Server ໄດ້ຈາກເມນູບູດໂຫລດເດີ.</p>"

#. error popup
#: src/modules/VirtConfig.rb:249
msgid "The installation will be aborted."
msgstr "ການຕິດຕັ້ງຈະຖືກຍົກເລີກ."

#. progressbar title - check whether Xen packages are installed
#: src/modules/VirtConfig.rb:331
msgid "Checking packages..."
msgstr "ກຳລັງກວດສອບແພັກເກດ..."

#. progressbar title - install the required packages
#: src/modules/VirtConfig.rb:334
msgid "Installing packages..."
msgstr "ກຳລັງຕິດຕັ້ງແພັກເກດ..."

#. error popup
#. Now see if they really were installed (bnc#508347)
#: src/modules/VirtConfig.rb:339 src/modules/VirtConfig.rb:346
msgid "Cannot install required packages."
msgstr "ບໍ່ສາມາດຕິດຕັ້ງແພັກເກດທີ່ຈຳເປັນໄດ້."

#. If grub2 is the bootloader and we succesfully installed Xen, update the grub2 files
#: src/modules/VirtConfig.rb:356
msgid "Updating grub2 configuration files..."
msgstr "ກຳລັງອັບເດດໄຟລ໌ກຳນົດຄ່າ grub2..."

#. create a bridget for SLES host
#. Default Bridge stage
#: src/modules/VirtConfig.rb:369
msgid "Configuring Default Network Bridge..."
msgstr "ກຳລັງກຳນົດຄ່າບຣິດເຄືອຂ່າຍເລີ່ມຕົ້ນ..."

#. Check for the existance of /sys/class/net/*/bridge
#: src/modules/VirtConfig.rb:378
msgid ""
"NetworkManager is being used. Bridge configuration must be done manually."
msgstr "NetworkManager ກຳລັງຖືກໃຊ້ງານ. ຕ້ອງກຳນົດຄ່າບຣິດດ້ວຍຕົນເອງ."

#. Popup yes/no dialog
#: src/modules/VirtConfig.rb:397
msgid "Network Bridge."
msgstr "ບຣິດເຄືອຂ່າຍ (Network Bridge)."

#: src/modules/VirtConfig.rb:398
msgid ""
"<p>For normal network configurations hosting virtual machines, a network "
"bridge is recommended.</p><p>Configure a default network bridge?</p>"
msgstr ""
"<p>ສຳລັບການກຳນົດຄ່າເຄືອຂ່າຍທົ່ວໄປເພື່ອໃຊ້ງານເຄື່ອງສະເມືອນ, ແນະນຳໃຫ້ໃຊ້ບຣິດເຄືອຂ່າຍ.</p><p>ຕ້ອງກາ"
"ນກຳນົດຄ່າບຣິດເຄືອຂ່າຍເລີ່ມຕົ້ນຫຼືບໍ່?</p>"

#. Enable and start the virtlogd socket (libvirt >= 1.3.0) for both KVM and Xen
#: src/modules/VirtConfig.rb:470
msgid "KVM components are installed. Your host is ready to install KVM guests."
msgstr ""
"ຕິດຕັ້ງສ່ວນປະກອບ KVM ແລ້ວ. ເຄື່ອງໂຮສຂອງທ່ານພ້ອມທີ່ຈະຕິດຕັ້ງ KVM guest ແລ້ວ."

#: src/modules/VirtConfig.rb:473
msgid ""
"KVM components are installed. Reboot the machine and select the native "
"kernel in the boot loader menu to install KVM guests."
msgstr ""
"ຕິດຕັ້ງສ່ວນປະກອບ KVM ແລ້ວ. ກະລຸນາຣີສະຕາດເຄື່ອງ ແລະ ເລືອກ native kernel ໃນເມນູບູດໂຫລດເດີ ເພື່"
"ອຕິດຕັ້ງ KVM guest."

#: src/modules/VirtConfig.rb:476
msgid ""
"For installing Xen guests, reboot the machine and select the Xen section in "
"the boot loader menu."
msgstr ""
"ສຳລັບການຕິດຕັ້ງ Xen guest, ໃຫ້ຣີສະຕາດເຄື່ອງ ແລະ ເລືອກຫົວຂໍ້ Xen ໃນເມນູບູດໂຫລດເດີ."

#: src/modules/VirtConfig.rb:479
msgid "Xen Hypervisor and tools are installed."
msgstr "ຕິດຕັ້ງ Xen Hypervisor ແລະ ເຄື່ອງມືຕ່າງໆແລ້ວ."

#: src/modules/VirtConfig.rb:480
msgid "Virtualization client tools are installed."
msgstr "ຕິດຕັ້ງເຄື່ອງມືຄລາຍແອນສຳລັບລະບົບສະເມືອນແລ້ວ."

#: src/modules/VirtConfig.rb:517
msgid "Choose Hypervisor(s) to install"
msgstr "ເລືອກ ໄຮເປີໄວເຊີ (Hypervisor) ທີ່ຈະຕິດຕັ້ງ"

#: src/modules/VirtConfig.rb:520
msgid "Server: Minimal system to get a running Hypervisor"
msgstr "ເຊີເວີ: ລະບົບຂັ້ນຕ່ຳເພື່ອໃຫ້ ໄຮເປີໄວເຊີ ສາມາດເຮັດວຽກໄດ້"

#: src/modules/VirtConfig.rb:521
msgid "Tools: Configure, manage and monitor virtual machines"
msgstr "ເຄື່ອງມື: ກຳນົດຄ່າ, ຈັດການ ແລະ ເຝົ້າຕິດຕາມເຄື່ອງສະເມືອນ"

#: src/modules/VirtConfig.rb:522
msgid ""
"A disabled checkbox means the Hypervisor item has already been installed"
msgstr "ຊ່ອງໝາຍທີ່ຖືກປິດໄວ້ ໝາຍຄວາມວ່າ ໄຮເປີໄວເຊີ ດັ່ງກ່າວໄດ້ຖືກຕິດຕັ້ງແລ້ວ"

