#. Translators: Package status short (!) description
#: src/YQPackageSelectorHelp.cc:169 src/YQPkgStatusFilterView.cc:110
msgid "Do not install"
msgstr "Ne namesti"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:171
msgid "This package is not installed and it will not be installed."
msgstr "Ta paket ni nameščen in ne bo nameščen."

#. Translators: Package status short (!) description
#: src/YQPackageSelectorHelp.cc:175 src/YQPkgObjList.cc:274
#: src/YQPkgStatusFilterView.cc:97
msgid "Install"
msgstr "Namesti"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:177
msgid "This package will be installed. It is not installed yet."
msgstr "Ta paket bo nameščen. Zaenkrat še ni nameščen."

#. Translators: Package status short (!) description
#: src/YQPackageSelectorHelp.cc:181 src/YQPkgObjList.cc:275
#: src/YQPkgStatusFilterView.cc:109
msgid "Keep"
msgstr "Obdrži"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:183
msgid "This package is already installed. Leave it untouched."
msgstr "Ta paket je že nameščen. Obdrži ga kot je."

#. Translators: Package status short (!) description
#. Translators: Keyboard action short (!) description
#: src/YQPackageSelectorHelp.cc:187 src/YQPackageSelectorHelp.cc:299
#: src/YQPkgObjList.cc:279 src/YQPkgStatusFilterView.cc:98
msgid "Update"
msgstr "Posodobi"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:189
msgid ""
"This package is already installed. Update it or reinstall it (if the "
"versions are the same)."
msgstr ""
"Ta paket je že nameščen. Posodobite ga ali ponovno namestite (če sta "
"različici enaki)."

#. Translators: Package status short (!) description
#: src/YQPackageSelectorHelp.cc:194 src/YQPkgObjList.cc:273
#: src/YQPkgStatusFilterView.cc:96
msgid "Delete"
msgstr "Izbriši"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:196
msgid "This package is already installed. Delete it."
msgstr "Ta paket je že nameščen. Izbriši ga."

#. Translators: Package status short (!) description
#. Translators: Keyboard action short (!) description
#: src/YQPackageSelectorHelp.cc:200 src/YQPackageSelectorHelp.cc:316
#: src/YQPkgStatusFilterView.cc:102
msgid "Taboo"
msgstr "Tabu"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:202
msgid ""
"This package is not installed and should not be installed under any "
"circumstances,  especially not because of unresolved dependencies that other "
"packages might have or get."
msgstr ""
"Ta paket ni nameščen in se nikakor ne sme namestiti, zlasti ne zaradi "
"nerazrešenih odvisnosti, ki bi jih drugi paketi lahko imeli ali dobili."

#: src/YQPackageSelectorHelp.cc:206 src/YQPackageSelectorHelp.cc:322
msgid ""
"Packages set to \"taboo\" are treated as if they did not exist on any "
"installation media."
msgstr ""
"Pakete, nastavljene kot »tabu«, se upošteva, kot da niso obstajali na "
"nobenem namestitvenem nosilcu."

#. Translators: Package status short (!) description
#: src/YQPackageSelectorHelp.cc:210 src/YQPkgStatusFilterView.cc:103
msgid "Protected"
msgstr "Zaščiten"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:212
msgid ""
"This package is installed and should not be modified,  especially not "
"because of unresolved dependencies that other packages might have or get."
msgstr ""
"Ta paket je nameščen in naj se ga ne spreminja, zlasti ne zaradi "
"nerazrešenih odvisnosti, ki bi jih drugi paketi lahko imeli ali dobili."

#: src/YQPackageSelectorHelp.cc:216
msgid ""
"Use this status for third-party packages that should not be overwritten by "
"newer versions that may come with the distribution."
msgstr ""
"To stanje uporabite za pakete tretjih proizvajalcev, ki naj se jih ne "
"prepiše z novimi različicami, ki bi lahko prišle z distribucijo."

#. Translators: Package status short (!) description
#: src/YQPackageSelectorHelp.cc:221 src/YQPkgObjList.cc:271
#: src/YQPkgStatusFilterView.cc:100
msgid "Autoinstall"
msgstr "Samodejno namesti"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:223
msgid ""
"This package will be installed automatically because some other package "
"needs it."
msgstr ""
"Ta paket bo nameščen samodejno, ker ga potrebujejo nekateri drugi paketi."

#: src/YQPackageSelectorHelp.cc:225
msgid ""
"<b>Hint:</b> You may have to use \"taboo\" to get rid of such a package."
msgstr ""
"<b>Namig:</b> Da se znebite takšnega paketa, boste morali uporabiti »tabu«."

#. Translators: Package status short (!) description
#: src/YQPackageSelectorHelp.cc:229 src/YQPkgObjList.cc:272
#: src/YQPkgStatusFilterView.cc:101
msgid "Autoupdate"
msgstr "Samodejno posodbi"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:231
msgid ""
"This package is already installed, but some other package needs a newer "
"version, so it will automatically be updated."
msgstr ""
"Ta paket je že nameščen, toda nekateri drugi paketi zahtevajo novejšo "
"različico, zato bo samodejno posodobljen."

#. Translators: Package status short (!) description
#: src/YQPackageSelectorHelp.cc:236 src/YQPkgObjList.cc:270
#: src/YQPkgStatusFilterView.cc:99
msgid "Autodelete"
msgstr "Samodejno izbriši"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:238
msgid ""
"This package is already installed, but package dependencies require that it "
"is deleted."
msgstr ""
"Ta paket je že nameščen, a paketne odvisnosti zahtevajo, da se ga izbriše."

#: src/YQPackageSelectorHelp.cc:239
msgid "This can happen, for example, if some other package obsoletes this one."
msgstr ""
"To se lahko zgodi, če na primer nek drug paket povzroči zastaranje le-tega."

#. Translators: Headline for help about "magic keys" in the package manager
#: src/YQPackageSelectorHelp.cc:271
msgid "Special Keys Overview"
msgstr "Pregled posebnih tipk"

#. Translators: Additional hint that will be added to any of the following keyboard actions.
#. Automatic word wrapping.
#: src/YQPackageSelectorHelp.cc:275
msgid "In any case, go to the next list item."
msgstr "V vsakem primeru pojdite na naslednjo postavko seznama."

#. Translators: Keyboard action short (!) description
#: src/YQPackageSelectorHelp.cc:282
msgid "Add"
msgstr "Dodaj"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:284
msgid ""
"Get this package. Install it if it is not installed yet. Update it to the "
"latest version if it is installed  and there is a newer version."
msgstr ""
"Pridobi ta paket. Če še ni nameščen, ga namesti. Če je nameščen in če "
"obstaja novejša različica, ga posodobi na najnovejšo različico."

#. Translators: Keyboard action short (!) description
#: src/YQPackageSelectorHelp.cc:291
msgid "Remove"
msgstr "Odstrani"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:293
msgid ""
"Get rid of this package. Mark it as \"do not install\" if it is not "
"installed yet. Delete it if it is installed."
msgstr ""
"Znebi se tega paketa. Če še ni nameščen, ga označi kot »ne namesti«. Če je "
"nameščen, ga odstrani."

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:301
msgid ""
"Update this package if it is installed and there is a newer version. Ignore "
"packages that are not installed."
msgstr ""
"Posodobi ta paket, če je že nameščen in obstaja novejša različica. Pakete, "
"ki niso nameščeni, ignoriraj."

#. Translators: Keyboard action short (!) description
#: src/YQPackageSelectorHelp.cc:308
msgid "Undo Update"
msgstr "Razveljavi posodobitev"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:310
msgid ""
"Undo the effect of \">\" above: Set package to \"keep\" if it is currently "
"set to \"update\". Ignore all other packages."
msgstr ""
"Razveljavi učinek »>« zgoraj. Paket nastavi na »obdrži«, če je njegova "
"trenutna nastavitev na »posodobi«. Prezri vse druge pakete."

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:318
msgid ""
"Set this package to \"taboo\" if it is not installed: make sure this package "
"does not get installed, especially not because of unresolved dependencies "
"that other packages might have or get. "
msgstr ""
"Ta paket nastavi na »tabu«, če še ni nameščen: zagotovi, da se ta paket ne "
"namesti, zlasti ne zaradi nerazrešenih odvisnosti, ki bi jih drugi paketi "
"lahko imeli ali dobili. "

#. Translators: Keyboard action short (!) description
#: src/YQPackageSelectorHelp.cc:328
msgid "Protect"
msgstr "Zaščiti"

#. Translators: Automatic word-wrapping.
#: src/YQPackageSelectorHelp.cc:330
msgid ""
"Set this package to \"protected\" if it is installed: make sure this package "
"will not be modified, especially not because of unresolved dependencies that "
"other packages might have or get. "
msgstr ""
"Ta paket nastavi na »zaščiten«, če je nameščen: zagotovi, da ta paket ne bo "
"spremenjen, zlasti ne zaradi nerazrešenih odvisnosti, ki bi jih drugi paketi "
"lahko imeli ali dobili. "

#: src/YQPackageSelectorHelp.cc:334
msgid ""
"Use this for third-party packages that should not be overwritten by newer "
"versions that may come with the distribution."
msgstr ""
"To uporabite za pakete tretjih proizvajalcev, ki naj jih ne prepišejo "
"novejše različice, ki bi lahko prišle z distribucijo."

