#: libyui-qt-pkg/src/YQPkgConflictDialog.cc:379
#: libyui-qt-pkg/src/YQPkgVersionsView.cc:431
msgid "C&ontinue"
msgstr "ສືບ&ຕໍ່"

#. Dialog header
#: libyui-qt-pkg/src/YQPackageSelectorBase.cc:304
msgid "Unsupported Packages"
msgstr "ແພັກເກດທີ່ບໍ່ຮອງຮັບ"

#: libyui-qt-pkg/src/YQPackageSelectorBase.cc:308
msgid ""
"Please realize that the following selected software is either unsupported or "
"requires an additional customer contract for support."
msgstr ""
"ກະລຸນາຮັບຊາບວ່າຊອບແວທີ່ເລືອກຕໍ່ໄປນີ້ ແມ່ນບໍ່ໄດ້ຮັບການຮອງຮັບ ຫຼື ຕ້ອງການສັນຍາ ການຊ່ວຍເຫຼືອເພີ່ມເຕີມ."

#: libyui-qt-pkg/src/YQPackageSelectorBase.cc:414
msgid "Not implemented yet. Sorry."
msgstr "ຍັງບໍ່ທັນເປີດໃຊ້ງານເທື່ອ. ຂໍອະໄພ."

#. Translators: Headline for help about the package manager in general
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:51
msgid "The YaST Package Manager"
msgstr "ຕົວຈັດການແພັກເກດ YaST"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:54
msgid ""
"<b>Note:</b> This is a just a short  overview. Refer to the manual for "
"details."
msgstr ""
"<b>ໝາຍເຫດ:</b> ນີ້ແມ່ນພຽງແຕ່ພາບລວມຫຍໍ້ໆ. ກະລຸນາເບິ່ງລາຍລະອຽດເພີ່ມເຕີມໃນຄູ່ມື."

#. Help specific to online update mode
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:61
msgid "In this dialog, select patches to download and install."
msgstr "ໃນໜ້າຕ່າງນີ້, ໃຫ້ເລືອກແພັດທີ່ຈະດາວໂຫຼດ ແລະ ຕິດຕັ້ງ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:62
msgid ""
"The list on the left side contains available patches along with the "
"respective patch kind (security, recommended, or optional) and the "
"(estimated) download size."
msgstr ""
"ລາຍຊື່ທາງເບື້ອງຊ້າຍປະກອບມີແພັດທີ່ມີໃຫ້ ພ້ອມກັບປະເພດຂອງແພັດ (ຄວາມປອດໄພ, ແນະນຳ, ຫຼື ທາງເລືອກ) ແລ"
"ະ ຂະໜາດດາວໂຫຼດ (ໂດຍປະມານ)."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:65
msgid ""
"This list normally contains only those patches that are not installed on "
"your system yet. You can change that with the <b>Include Installed Patches</"
"b> check box below the list."
msgstr ""
"ໂດຍປົກກະຕິ ລາຍຊື່ນີ້ຈະສະແດງສະເພາະແພັດທີ່ຍັງບໍ່ທັນໄດ້ຕິດຕັ້ງໃນລະບົບເທົ່ານັ້ນ. ທ່ານສາມາດປ່ຽນໄດ້ໂດຍໝາຍຕິກໃ"
"ສ່ <b>ລວມເອົາແພັດທີ່ຕິດຕັ້ງແລ້ວ</b> ຢູ່ລຸ່ມລາຍຊື່."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:67
msgid ""
"The <b>Patch Description</b> field contains a longer explanation of the "
"currently selected patch. Click a patch in the list to view its description "
"here."
msgstr ""
"ຊ່ອງ <b>ຄຳອະທິບາຍແພັດ</b> ຈະສະແດງລາຍລະອຽດຂອງແພັດທີ່ເລືອກ. ຄລິກໃສ່ແພັດ ໃນລາຍຊື່ເພື່ອເບິ່ງຄຳອະທິ"
"ບາຍຢູ່ບ່ອນນີ້."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:69
msgid ""
"The package list on the right side shows the contents of the currently "
"selected patch, i.e., the packages it contains. You cannot install or delete "
"individual packages from a patch, only the patch as a whole. This is "
"intentional to avoid system inconsistencies."
msgstr ""
"ລາຍຊື່ແພັກເກດທາງເບື້ອງຂວາຈະສະແດງເນື້ອໃນຂອງແພັດທີ່ເລືອກ. ທ່ານບໍ່ສາມາດຕິດຕັ້ງ ຫຼື ລົບແພັກເກດແຍກຕ່າງຫາ"
"ກຈາກແພັດໄດ້, ຕ້ອງຈັດການທັງໝົດພ້ອມກັນ. ນີ້ແມ່ນເພື່ອປ້ອງກັນບໍ່ໃຫ້ລະບົບມີຄວາມຂັດແຍ່ງ."

#. Translators: Please keep the reference to "filter views" to distinguish between "filter views" that
#. affect the amount of visible packages in the package list and "details views" ( below the package list )
#. that show details about the ( one ) currently selected package in the package list.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:77
msgid ""
"In addition to <b>Patches</b>, you can also select one of the other filter "
"views from <b>Filter</b> at the upper left:"
msgstr ""
"ນອກຈາກ <b>ແພັດ</b> ແລ້ວ, ທ່ານຍັງສາມາດເລືອກມຸມມອງການກັ່ນຕອງອື່ນໆ ຈາກ <b>ຕົວຕອງ</b> ຢູ່ມຸມຊ້າຍ"
"ເທິງ:"

#. Help specific to normal (non-online-update) mode
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:85
msgid ""
"In this dialog, select which packages to install, update, or delete. You can "
"select individual packages or entire package \"selections\"."
msgstr ""
"ໃນໜ້າຕ່າງນີ້, ໃຫ້ເລືອກແພັກເກດທີ່ຈະຕິດຕັ້ງ, ອັບເດດ, ຫຼື ລົບ. ທ່ານສາມາດເລືອກແຕ່ລະແພັກເກດ ຫຼື ເລືອກເປັນກຸ່"
"ມແພັກເກດກໍໄດ້."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:87
msgid ""
"Click the status icon for a package or selection to change the status or "
"right-click it to open a context menu."
msgstr ""
"ຄລິກໃສ່ໄອຄອນສະຖານະຂອງແພັກເກດ ຫຼື ກຸ່ມທີ່ເລືອກເພື່ອປ່ຽນສະຖານະ ຫຼື ຄລິກຂວາເພື່ອເປີດເມນູເສີມ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:89
msgid ""
"Use the <b>Check Dependencies</b> button to resolve package dependencies. "
"Some packages require other packages to be installed. Some packages can only "
"be installed if certain other packages are not installed, too. This check "
"will automatically mark required packages for installation and it will warn "
"you if there are dependency conflicts."
msgstr ""
"ໃຊ້ປຸ່ມ <b>ກວດສອບຄວາມຈຳເປັນ</b> ແພັກເກດບາງອັນຕ້ອງການແພັກເກດອື່ນເພື່ອຕິດຕັ້ງ. ບາງອັນຈະຕິດຕັ້ງໄດ້ກໍຕໍ່"
"ເມື່ອບໍ່ມີແພັກເກດອື່ນບາງອັນຢູ່ໃນລະບົບ. ການກວດສອບນີ້ ຈະໝາຍແພັກເກດທີ່ຈຳເປັນໃຫ້ໂດຍອັດຕະໂນມັດ ແລະ ຈະແຈ້"
"ງເຕືອນຖ້າມີຄວາມຂັດແຍ່ງ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:94
msgid ""
"When you leave this dialog with <b>Accept</b>, this check will automatically "
"be performed."
msgstr "ເມື່ອທ່ານກົດ <b>ຍອມຮັບ</b>, ລະບົບຈະກວດສອບສິ່ງເຫຼົ່ານີ້ໃຫ້ໂດຍອັດຕະໂນມັດ."

#. Translators: Please keep the reference to "filter views" to distinguish between "filter views" that
#. affect the amount of visible packages in the package list and "details views" (below the package list)
#. that show details about the (one) currently selected package in the package list.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:100
msgid ""
"Select one of the available filter views with the <b>Filter</b> combo-box at "
"the upper left:"
msgstr "ເລືອກມຸມມອງການກັ່ນຕອງຈາກຊ່ອງ <b>ຕົວຕອງ</b> ຢູ່ມຸມຊ້າຍເທິງ:"

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:104
msgid ""
"<b>Selections</b> shows some predefined sets of packages that logically "
"belong together."
msgstr ""
"<b>ສິ່ງທີ່ເລືອກ</b> ຈະສະແດງຊຸດແພັກເກດທີ່ຖືກກຳນົດໄວ້ລ່ວງໜ້າເຊິ່ງກ່ຽວຂ້ອງກັນ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:105
msgid ""
"Use the check box next to the selection to select it as a whole. You can "
"also select or deselect individual packages in the package list at the right."
msgstr ""
"ໃຊ້ກ່ອງໝາຍຕິກຂ້າງລາຍການທີ່ເລືອກເພື່ອເລືອກທັງໝົດ. ທ່ານຍັງສາມາດເລືອກ ຫຼື ຍົກເລີກແຕ່ລະແພັກເກດໃນລາຍຊື່ທາ"
"ງເບື້ອງຂວາໄດ້."

#. Help common to all modes: Description of the various filter views
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:113
msgid ""
"<b>Package Groups</b> shows packages by category. You can expand and "
"collapse tree items to refine or generalize categories. Click any category "
"to display the packages in that category in the package list on the right "
"side."
msgstr ""
"<b>ກຸ່ມແພັກເກດ</b> ສະແດງແພັກເກດຕາມໝວດໝູ່. ທ່ານສາມາດຂະຫຍາຍ ຫຼື ຫຍໍ້ລາຍການ ເພື່ອເບິ່ງໝວດໝູ່ຍ່ອຍ. "
"ຄລິກໃສ່ໝວດໝູ່ໃດໜຶ່ງເພື່ອເບິ່ງແພັກເກດໃນໝວດນັ້ນຢູ່ທາງເບື້ອງຂວາ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:116
msgid ""
" <b>Hint:</b> There is a \"zzz All\" entry at the very end of the list that "
"will show all packages. This may take a few seconds on slow machines."
msgstr ""
" <b>ຄຳແນະນຳ:</b> ມີລາຍການ \"zzz ທັງໝົດ\" ຢູ່ທ້າຍສຸດເຊິ່ງຈະສະແດງແພັກເກດທັງໝົດ. ມັນອາດຈະໃຊ້ເວ"
"ລາຄາວໜຶ່ງໃນເຄື່ອງທີ່ຊ້າ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:119
msgid ""
"<b>Search</b> allows you to search for packages that meet various criteria. "
"This is usually the easiest way to find a package if you know its name."
msgstr ""
"<b>ຄົ້ນຫາ</b> ຊ່ວຍໃຫ້ທ່ານຄົ້ນຫາແພັກເກດຕາມເງື່ອນໄຂຕ່າງໆ. ນີ້ແມ່ນວິທີທີ່ງ່າຍທີ່ສຸດໃນການຫາແພັກເກດຖ້າທ່ານຮູ້"
"ຊື່ຂອງມັນ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:121
msgid ""
"<b>Hint:</b> You can also use this to find out what package contains a "
"certain library.  Search in the <b>Provides</b> RPM field."
msgstr ""
"<b>ຄຳແນະນຳ:</b> ທ່ານສາມາດໃຊ້ຄົ້ນຫາວ່າແພັກເກດໃດມີໄລບຼາຣີ (library) ທີ່ຕ້ອງການ. ໃຫ້ຄົ້ນຫາໃນຊ່ອ"
"ງ RPM <b>Provides</b>."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:124
msgid ""
"<b>Installation Summary</b> by default shows the changes to your system -- "
"what packages will be installed, deleted, or updated."
msgstr ""
"<b>ສັງລວມການຕິດຕັ້ງ</b> ໂດຍປົກກະຕິຈະສະແດງການປ່ຽນແປງໃນລະບົບ -- ວ່າແພັກເກດໃດຈະຖືກຕິດຕັ້ງ, ລົ"
"ບ, ຫຼື ອັບເດດ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:126
msgid ""
"It is generally a good idea to use <b>Check Dependencies</b> then switch to "
"<b>Installation Summary</b> before clicking <b>Accept</b>. This way you can "
"see all changes that will be made to your system."
msgstr ""
"ແນະນຳໃຫ້ໃຊ້ <b>ກວດສອບຄວາມຈຳເປັນ</b> ແລ້ວຈຶ່ງປ່ຽນໄປເບິ່ງ <b>ສັງລວມການຕິດຕັ້ງ</b> ກ່ອນກົດ <b>ຍ"
"ອມຮັບ</b>. ວິທີນີ້ຈະເຮັດໃຫ້ທ່ານເຫັນການປ່ຽນແປງທັງໝົດທີ່ຈະເກີດຂຶ້ນ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:129
msgid ""
"You can also explicitly select what packages with what status to see here; "
"use the check boxes at the left side."
msgstr ""
"ທ່ານຍັງສາມາດເລືອກໄດ້ວ່າຈະໃຫ້ສະແດງແພັກເກດທີ່ມີສະຖານະໃດແດ່ ໂດຍໃຊ້ກ່ອງໝາຍຕິກທາງເບື້ອງຊ້າຍ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:131
msgid ""
"<b>Hint:</b> You can also reverse the effect of this filter. You can see "
"what packages remain the same on your system. Simply check <b>Keep</b> and "
"uncheck everything else."
msgstr ""
"<b>ຄຳແນະນຳ:</b> ທ່ານຍັງສາມາດປ່ຽນຜົນຂອງການກັ່ນຕອງນີ້ໄດ້. ທ່ານສາມາດເບິ່ງໄດ້ວ່າແພັກເກດໃດທີ່ຍັງຄືເກົ່າ"
"ຢູ່ໃນລະບົບຂອງທ່ານ. ພຽງແຕ່ໝາຍເລືອກ <b>ຮັກສາໄວ້</b> ແລະ ຍົກເລີກການໝາຍເລືອກອື່ນໆທັງໝົດ."

#. Make sure all images used here are specified in
#. helpimages_DATA in include/Makefile.am !
#. Translators: Headline for help about package status icons
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:148
msgid "Symbols Overview"
msgstr "ພາບລວມຂອງສັນຍະລັກ"

#. Translators: Package status short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:155
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:95
msgid "Do not install"
msgstr "ບໍ່ຕິດຕັ້ງ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:157
msgid "This package is not installed and it will not be installed."
msgstr "ແພັກເກດນີ້ຍັງບໍ່ທັນຕິດຕັ້ງ ແລະ ຈະບໍ່ຖືກຕິດຕັ້ງ."

#. Translators: Package status short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:161
#: libyui-qt-pkg/src/YQPkgObjList.cc:260
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:82
msgid "Install"
msgstr "ຕິດຕັ້ງ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:163
msgid "This package will be installed. It is not installed yet."
msgstr "ແພັກເກດນີ້ຈະຖືກຕິດຕັ້ງ (ຍັງບໍ່ທັນມີໃນລະບົບ)."

#. Translators: Package status short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:167
#: libyui-qt-pkg/src/YQPkgObjList.cc:261
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:94
msgid "Keep"
msgstr "ຮັກສາໄວ້"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:169
msgid "This package is already installed. Leave it untouched."
msgstr "ແພັກເກດນີ້ຕິດຕັ້ງແລ້ວ ແລະ ຈະບໍ່ມີການປ່ຽນແປງ."

#. Translators: Package status short (!) description
#. Translators: Keyboard action short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:173
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:285
#: libyui-qt-pkg/src/YQPkgObjList.cc:265
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:83
msgid "Update"
msgstr "ອັບເດດ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:175
msgid ""
"This package is already installed. Update it or reinstall it (if the "
"versions are the same)."
msgstr "ແພັກເກດນີ້ຕິດຕັ້ງແລ້ວ. ຈະອັບເດດ ຫຼື ຕິດຕັ້ງໃໝ່ (ຖ້າແມ່ນເວີຊັນດຽວກັນ)."

#. Translators: Package status short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:180
#: libyui-qt-pkg/src/YQPkgObjList.cc:259
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:81
msgid "Delete"
msgstr "ລົບ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:182
msgid "This package is already installed. Delete it."
msgstr "ແພັກເກດນີ້ຕິດຕັ້ງແລ້ວ ແລະ ຈະຖືກລົບອອກ."

#. Translators: Package status short (!) description
#. Translators: Keyboard action short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:186
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:302
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:87
msgid "Taboo"
msgstr "ຫ້າມຕິດຕັ້ງ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:188
msgid ""
"This package is not installed and should not be installed under any "
"circumstances,  especially not because of unresolved dependencies that other "
"packages might have or get."
msgstr ""
"ແພັກເກດນີ້ຍັງບໍ່ທັນຕິດຕັ້ງ ແລະ ບໍ່ຄວນຕິດຕັ້ງໃນທຸກກໍລະນີ, ໂດຍສະເພາະແມ່ນ ບໍ່ໃຫ້ຕິດຕັ້ງຍ້ອນຄວາມຈຳເປັນຂອງແພັກ"
"ເກດອື່ນ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:192
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:308
msgid ""
"Packages set to \"taboo\" are treated as if they did not exist on any "
"installation media."
msgstr ""
"ແພັກເກດທີ່ຕັ້ງເປັນ \"Taboo\" ຈະຖືກປະຕິບັດຄືກັບວ່າມັນບໍ່ມີຢູ່ໃນສື່ການຕິດຕັ້ງໃດໆ."

#. Translators: Package status short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:196
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:88
msgid "Protected"
msgstr "ຖືກປ້ອງກັນ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:198
msgid ""
"This package is installed and should not be modified,  especially not "
"because of unresolved dependencies that other packages might have or get."
msgstr ""
"ແພັກເກດນີ້ຕິດຕັ້ງແລ້ວ ແລະ ບໍ່ຄວນຖືກແກ້ໄຂ, ໂດຍສະເພາະແມ່ນ ບໍ່ໃຫ້ປ່ຽນແປງຍ້ອນຄວາມຈຳເປັນຂອງແພັກເກດອື່ນ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:202
msgid ""
"Use this status for third-party packages that should not be overwritten by "
"newer versions that may come with the distribution."
msgstr ""
"ໃຊ້ສະຖານະນີ້ສຳລັບແພັກເກດຈາກພາກສ່ວນທີສາມ ທີ່ບໍ່ຄວນຖືກຂຽນທັບໂດຍເວີຊັນໃໝ່ ທີ່ມາກັບຊຸດຕິດຕັ້ງຫຼັກ."

#. Translators: Package status short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:207
#: libyui-qt-pkg/src/YQPkgObjList.cc:257
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:85
msgid "Autoinstall"
msgstr "ຕິດຕັ້ງອັດຕະໂນມັດ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:209
msgid ""
"This package will be installed automatically because some other package "
"needs it."
msgstr "ແພັກເກດນີ້ຈະຖືກຕິດຕັ້ງໂດຍອັດຕະໂນມັດ ເພາະມີແພັກເກດອື່ນຕ້ອງການມັນ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:211
msgid ""
"<b>Hint:</b> You may have to use \"taboo\" to get rid of such a package."
msgstr ""
"<b>ຄຳແນະນຳ:</b> ທ່ານອາດຕ້ອງໃຊ້ \"Taboo\" ເພື່ອບໍ່ໃຫ້ແພັກເກດນີ້ຖືກຕິດຕັ້ງ."

#. Translators: Package status short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:215
#: libyui-qt-pkg/src/YQPkgObjList.cc:258
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:86
msgid "Autoupdate"
msgstr "ອັບເດດອັດຕະໂນມັດ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:217
msgid ""
"This package is already installed, but some other package needs a newer "
"version, so it will automatically be updated."
msgstr ""
"ແພັກເກດນີ້ຕິດຕັ້ງແລ້ວ, ແຕ່ແພັກເກດອື່ນຕ້ອງການເວີຊັນທີ່ໃໝ່ກວ່າ ມັນຈຶ່ງຈະຖືກອັບເດດໂດຍອັດຕະໂນມັດ."

#. Translators: Package status short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:222
#: libyui-qt-pkg/src/YQPkgObjList.cc:256
#: libyui-qt-pkg/src/YQPkgStatusFilterView.cc:84
msgid "Autodelete"
msgstr "ລົບອັດຕະໂນມັດ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:224
msgid ""
"This package is already installed, but package dependencies require that it "
"is deleted."
msgstr ""
"ແພັກເກດນີ້ຕິດຕັ້ງແລ້ວ, ແຕ່ຄວາມຈຳເປັນຂອງແພັກເກດອື່ນບັງຄັບໃຫ້ຕ້ອງລົບມັນອອກ."

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:225
msgid "This can happen, for example, if some other package obsoletes this one."
msgstr "ສິ່ງນີ້ອາດເກີດຂຶ້ນໄດ້ ຖ້າມີແພັກເກດອື່ນມາປ່ຽນແທນແພັກເກດນີ້."

#. Translators: Headline for help about "magic keys" in the package manager
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:257
msgid "Special Keys Overview"
msgstr "ພາບລວມຂອງປຸ່ມພິເສດ"

#. Translators: Additional hint that will be added to any of the following keyboard actions.
#. Automatic word wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:261
msgid "In any case, go to the next list item."
msgstr "ບໍ່ວ່າກໍລະນີໃດກໍຕາມ, ໃຫ້ໄປທີ່ລາຍການຖັດໄປ."

#. Translators: Keyboard action short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:268
msgid "Add"
msgstr "ເພີ່ມ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:270
msgid ""
"Get this package. Install it if it is not installed yet. Update it to the "
"latest version if it is installed  and there is a newer version."
msgstr ""
"ເລືອກແພັກເກດນີ້. ຕິດຕັ້ງຖ້າຍັງບໍ່ມີ. ອັບເດດເປັນເວີຊັນຫຼ້າສຸດ ຖ້າມີການຕິດຕັ້ງໄວ້ແລ້ວ ແລະ ມີເວີຊັນໃໝ່ກວ່າ."

#. Translators: Keyboard action short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:277
msgid "Remove"
msgstr "ເອົາອອກ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:279
msgid ""
"Get rid of this package. Mark it as \"do not install\" if it is not "
"installed yet. Delete it if it is installed."
msgstr ""
"ເອົາແພັກເກດນີ້ອອກ. ໝາຍເປັນ \"ບໍ່ຕິດຕັ້ງ\" ຖ້າຍັງບໍ່ມີໃນລະບົບ. ລົບອອກຖ້າຕິດຕັ້ງແລ້ວ."

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:287
msgid ""
"Update this package if it is installed and there is a newer version. Ignore "
"packages that are not installed."
msgstr ""
"ອັບເດດແພັກເກດນີ້ຖ້າຕິດຕັ້ງແລ້ວ ແລະ ມີເວີຊັນໃໝ່ກວ່າ. ຂ້າມແພັກເກດທີ່ຍັງບໍ່ໄດ້ຕິດຕັ້ງ."

#. Translators: Keyboard action short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:294
msgid "Undo Update"
msgstr "ຍົກເລີກການອັບເດດ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:296
msgid ""
"Undo the effect of \">\" above: Set package to \"keep\" if it is currently "
"set to \"update\". Ignore all other packages."
msgstr ""
"ຍົກເລີກຜົນຂອງ \">\": ຕັ້ງແພັກເກດເປັນ \"ຮັກສາໄວ້\" ຖ້າມັນຖືກຕັ້ງເປັນ \"ອັບເດດ\". ຂ້າມແພັກເກດອື່ນທັງ"
"ໝົດ."

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:304
msgid ""
"Set this package to \"taboo\" if it is not installed: make sure this package "
"does not get installed, especially not because of unresolved dependencies "
"that other packages might have or get. "
msgstr ""
"ຕັ້ງຄ່າແພັກເກດນີ້ໃຫ້ເປັນ \"taboo\" ຖ້າມັນບໍ່ໄດ້ຖືກຕິດຕັ້ງ: ໃຫ້ແນ່ໃຈວ່າແພັກເກດນີ້ຈະບໍ່ຖືກຕິດຕັ້ງ, ໂດຍສະເພາະ"
"ແມ່ນບໍ່ແມ່ນຍ້ອນການເພິ່ງພາອາໄສທີ່ຍັງບໍ່ທັນໄດ້ຮັບການແກ້ໄຂ ເຊິ່ງແພັກເກດອື່ນໆອາດມີ ຫຼື ໄດ້ຮັບ. "

#. Translators: Keyboard action short (!) description
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:314
msgid "Protect"
msgstr "ປ້ອງກັນ"

#. Translators: Automatic word-wrapping.
#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:316
msgid ""
"Set this package to \"protected\" if it is installed: make sure this package "
"will not be modified, especially not because of unresolved dependencies that "
"other packages might have or get. "
msgstr ""
"ຕັ້ງຄ່າແພັກເກດນີ້ໃຫ້ເປັນ \"protected\" ຖ້າມັນຖືກຕິດຕັ້ງແລ້ວ: ໃຫ້ແນ່ໃຈວ່າແພັກເກດນີ້ຈະບໍ່ຖືກປ່ຽນແປງ, ໂດຍ"
"ສະເພາະແມ່ນບໍ່ແມ່ນຍ້ອນການເພິ່ງພາອາໄສທີ່ຍັງບໍ່ທັນໄດ້ຮັບການແກ້ໄຂ ເຊິ່ງແພັກເກດອື່ນໆອາດມີ ຫຼື ໄດ້ຮັບ. "

#: libyui-qt-pkg/src/YQPackageSelectorHelp.cc:320
msgid ""
"Use this for third-party packages that should not be overwritten by newer "
"versions that may come with the distribution."
msgstr "ໃຊ້ສຳລັບແພັກເກດພາຍນອກ ທີ່ບໍ່ຄວນຖືກຂຽນທັບໂດຍເວີຊັນໃໝ່ຂອງຊຸດຕິດຕັ້ງຫຼັກ."

#: libyui-qt-pkg/src/YQPatternSelector.cc:168
#: libyui-qt-pkg/src/YQPatternSelector.cc:236
#: libyui-qt-pkg/src/YQSimplePatchSelector.cc:167
#: libyui-qt-pkg/src/YQSimplePatchSelector.cc:193
msgid "&Details..."
msgstr "ລາຍ&ລະອຽດ..."

#: libyui-qt-pkg/src/YQPkgChangeLogView.cc:90
#: libyui-qt-pkg/src/YQPkgFileListView.cc:82
msgid "Information only available for installed packages."
msgstr "ຂໍ້ມູນມີໃຫ້ສະເພາະແພັກເກດທີ່ຕິດຕັ້ງແລ້ວເທົ່ານັ້ນ."

#. TRANSLATORS: The package change log is too long to display, only the latest
#. changes are displayed. %1 is the number of the items which are not displayed,
#. %2 contains a command for getting the full changes manually.
#: libyui-qt-pkg/src/YQPkgChangeLogView.cc:133
msgid ""
"(%1 more change entries are not displayed. Run \"%2\" to see the complete "
"change log.)"
msgstr ""
"(ຍັງມີອີກ %1 ລາຍການທີ່ບໍ່ໄດ້ສະແດງ. ໃຫ້ພິມ \"%2\" ເພື່ອເບິ່ງບັນທຶກການປ່ຽນແປງທັງໝົດ.)"

#. Dialog title
#: libyui-qt-pkg/src/YQPkgChangesDialog.cc:66
msgid "Changed Packages"
msgstr "ແພັກເກດທີ່ປ່ຽນແປງ"

#. add the items.
#: libyui-qt-pkg/src/YQPkgChangesDialog.cc:102
msgid "All"
msgstr "ທັງໝົດ"

#: libyui-qt-pkg/src/YQPkgChangesDialog.cc:103
msgid "Selected by the user"
msgstr "ເລືອກໂດຍຜູ້ໃຊ້"

#: libyui-qt-pkg/src/YQPkgClassFilterView.cc:50
msgid "No Packages"
msgstr "ບໍ່ມີແພັກເກດ"

#: libyui-qt-pkg/src/YQPkgClassFilterView.cc:51
msgid "Recommended Packages"
msgstr "ແພັກເກດທີ່ແນະນຳ"

#: libyui-qt-pkg/src/YQPkgClassFilterView.cc:52
msgid "Suggested Packages"
msgstr "ແພັກເກດທີ່ສະເໜີແນະ"

#: libyui-qt-pkg/src/YQPkgClassFilterView.cc:53
msgid "Orphaned Packages"
msgstr "ແພັກເກດທີ່ບໍ່ມີແຫຼ່ງທີ່ມາ"

#: libyui-qt-pkg/src/YQPkgClassFilterView.cc:54
msgid "Unneeded Packages"
msgstr "ແພັກເກດທີ່ບໍ່ຈຳເປັນ"

#: libyui-qt-pkg/src/YQPkgClassFilterView.cc:55
msgid "Multiversion Packages"
msgstr "ແພັກເກດທີ່ມີຫຼາຍເວີຊັນ"

#: libyui-qt-pkg/src/YQPkgClassFilterView.cc:56
msgid "Retracted Packages"
