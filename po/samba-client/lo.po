#. translators: command line help text for Samba client module
#: src/clients/samba-client.rb:62
msgid ""
"Samba client configuration module.\n"
"See Samba documentation for details."
msgstr ""
"ໂມດູນການຕັ້ງຄ່າໄຄເອັນ Samba.\n"
"ເບິ່ງເອກະສານອ້າງອີງຂອງ Samba ສໍາລັບລາຍລະອຽດ."

#. translators: command line help text for winbind action
#: src/clients/samba-client.rb:75
msgid "Enable or disable the Winbind services (winbindd)"
msgstr "ເປີດ ຫຼື ປິດການໃຊ້ງານບໍລິການ Winbind (winbindd)"

#. translators: command line help text for isdomainmember action
#: src/clients/samba-client.rb:85
msgid "Check if this machine is a member of a domain"
msgstr "ກວດສອບວ່າເຄື່ອງນີ້ເປັນສະມາຊິກຂອງໂດເມນຫຼືບໍ່"

#. translators: command line help text for joindomain action
#: src/clients/samba-client.rb:95
msgid "Join this machine to a domain"
msgstr "ນຳເຄື່ອງນີ້ເຂົ້າຮ່ວມໂດເມນ"

#. translators: command line help text for configure action
#: src/clients/samba-client.rb:105
msgid "Change the global settings of Samba"
msgstr "ປ່ຽນການຕັ້ງຄ່າທົ່ວໄປຂອງ Samba"

#. translators: command line help text for winbind enable option
#: src/clients/samba-client.rb:113
msgid "Enable the service"
msgstr "ເປີດໃຊ້ງານບໍລິການ"

#. translators: command line help text for winbind disable option
#: src/clients/samba-client.rb:119
msgid "Disable the service"
msgstr "ປິດໃຊ້ງານບໍລິການ"

#. translators: command line help text for domain to be checked/joined
#: src/clients/samba-client.rb:125
msgid "The name of a domain to join"
msgstr "ຊື່ຂອງໂດເມນທີ່ຈະເຂົ້າຮ່ວມ"

#. translators: command line help text for joindomain user option
#: src/clients/samba-client.rb:132
msgid ""
"The user used for joining the domain. If omitted, YaST will\n"
"try to join the domain without specifying user and password.\n"
msgstr ""
"ຜູ້ໃຊ້ທີ່ໃຊ້ເຂົ້າຮ່ວມໂດເມນ. ຫາກລະເວັ້ນໄວ້, YaST ຈະ\n"
"ພະຍາຍາມເຂົ້າຮ່ວມໂດເມນໂດຍບໍ່ລະບຸຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານ.\n"

#. translators: command line help text for joindomain password option
#: src/clients/samba-client.rb:139
msgid "The password used for the user when joining the domain"
msgstr "ລະຫັດຜ່ານທີ່ໃຊ້ສຳລັບຜູ້ໃຊ້ເມື່ອເຂົ້າຮ່ວມໂດເມນ"

#. command line help text for machine optioa
#: src/clients/samba-client.rb:146
msgid "The machine account"
msgstr "ບັນຊີເຄື່ອງ"

#. translators: command line help text for the workgroup name option
#: src/clients/samba-client.rb:153
msgid "The name of a workgroup"
msgstr "ຊື່ຂອງກຸ່ມວຽກ (Workgroup)"

