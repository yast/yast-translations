msgstr "ເຄື່ອງນີ້ເປັນສະມາຊິກຂອງ %1."

#. translators: result message for isdomainmember command line action
#: src/clients/samba-client.rb:237
#, ycp-format
msgid "This machine is not a member of %1."
msgstr "ເຄື່ອງນີ້ບໍ່ໄດ້ເປັນສະມາຊິກຂອງ %1."

#. translators: result message for joindomain command line action
#. Translators: Information popup, %1 is the name of the domain
#: src/clients/samba-client.rb:279 src/include/samba-client/routines.rb:280
#, ycp-format
msgid "Domain %1 joined successfully."
msgstr "ເຂົ້າຮ່ວມໂດເມນ %1 ສຳເລັດແລ້ວ."

