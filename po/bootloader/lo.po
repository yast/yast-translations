msgstr "ໂມດູນການຕັ້ງຄ່າບູດໂຫລດເດີ"

#. Represents bls compatile system calls which can be used
#. e.g. by grub2-bls and systemd-boot
#: src/lib/bootloader/bls.rb:29
#, perl-brace-format
msgid ""
"Cannot create boot menu entry:\n"
"Command `%{command}`.\n"
"Error output: %{stderr}"
msgstr ""
"ບໍ່ສາມາດສ້າງລາຍການເມນູບູດ:\n"
"ຄຳສັ່ງ `%{command}`.\n"
"ຜົນການເຮັດວຽກທີ່ຜິດພາດ: %{stderr}"

#: src/lib/bootloader/bls.rb:41
#, perl-brace-format
msgid ""
"Cannot install bootloader:\n"
"Command `%{command}`.\n"
"Error output: %{stderr}"
