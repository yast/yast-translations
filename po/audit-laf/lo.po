#. Read dialog help 1/2
#: src/include/audit-laf/helps.rb:35
msgid ""
"<p><b><big>Initializing Configuration of Linux Audit Framework</big></"
"b><br>\n"
"</p>\n"
msgstr ""
"<p><b><big>ກຳລັງເລີ່ມຕົ້ນການກຳນົດຄ່າໂຄງຮ່າງການກວດສອບຂອງ Linux</big></b><br>\n"
"</p>\n"

#. Read dialog help 2/2
#: src/include/audit-laf/helps.rb:39
msgid ""
"<p><b><big>Aborting Initialization:</big></b><br>\n"
"Safely abort the configuration utility by pressing <b>Abort</b> now.</p>\n"
msgstr ""
"<p><b><big>ການຍົກເລີກການເລີ່ມຕົ້ນ:</big></b><br>\n"
"ຍົກເລີກເຄື່ອງມືການກຳນົດຄ່າຢ່າງປອດໄພໂດຍການກົດ <b>ຍົກເລີກ</b> ດຽວນີ້.</p>\n"

#. Write dialog help 1/2
#: src/include/audit-laf/helps.rb:43
msgid ""
"<p><b><big>Saving auditd Configuration and Rules</big></b><br>\n"
"</p>\n"
msgstr ""
"<p><b><big>ກຳລັງບັນທຶກການກຳນົດຄ່າ ແລະ ກົດຂອງ auditd</big></b><br>\n"
"</p>\n"

#. Write dialog help 2/2
#: src/include/audit-laf/helps.rb:47
msgid ""
"<p><b><big>Aborting Saving:</big></b><br>\n"
"Abort the save procedure by pressing <b>Abort</b>.\n"
"An additional dialog informs whether it is safe to do so.\n"
"</p>\n"
msgstr ""
"<p><b><big>ການຍົກເລີກການບັນທຶກ:</big></b><br>\n"
"ຍົກເລີກຂັ້ນຕອນການບັນທຶກໂດຍການກົດ <b>ຍົກເລີກ</b>.\n"
"ຈະມີກ່ອງຂໍ້ຄວາມແຈ້ງເຕືອນວ່າການດຳເນີນການດັ່ງກ່າວປອດໄພຫຼືບໍ່.\n"
"</p>\n"

#. logfile_settings dialog help 1/8
#: src/include/audit-laf/helps.rb:54
msgid ""
"<p><b><big>Auditd Log File Configuration</big></b><br>\n"
"The audit daemon is the component of the Linux Auditing System which is "
"responsible for writing all relevant audit events to the log file <i>/var/"
"log/audit/audit.log</i> (default).\n"
"Events may come from the <i>apparmor</i> kernel module, from applications "
"which use <i>libaudit</i> (e.g. PAM) or incidents caused by rules (e.g. file "
"watches).</p>"
msgstr ""
"<p><b><big>ການກຳນົດຄ່າໄຟລ໌ບັນທຶກຂອງ Auditd</big></b><br>\n"
"ດີມອນການກວດສອບ (audit daemon) ແມ່ນສ່ວນປະກອບຂອງລະບົບການກວດສອບ Linux ເຊິ່ງມີໜ້າທີ່ໃນການຂຽ"
"ນເຫດການການກວດສອບທີ່ກ່ຽວຂ້ອງທັງໝົດລົງໃນໄຟລ໌ບັນທຶກ <i>/var/log/audit/audit.log</i> (ຄ່າມາດ"
"ຕະຖານ).\n"
"ເຫດການຕ່າງໆອາດມາຈາກໂມດູນເຄີເນິລ <i>apparmor</i>, ຈາກແອັບພລິເຄຊັນທີ່ໃຊ້ <i>libaudit</i> "
"(ເຊັ່ນ: PAM) ຫຼື ເຫດການທີ່ເກີດຈາກກົດຕ່າງໆ (ເຊັ່ນ: ການເຝົ້າເບິ່ງໄຟລ໌).</p>"

#. logfile_settings dialog help 2/8
#: src/include/audit-laf/helps.rb:60
msgid ""
"<p>The <b>Rules for auditctl</b> dialog offers more information about rules "
"and the possibility to add rules.\n"
"Detailed information about the log file settings can be obtained from the "
"manual page ('man auditd.conf').</p>"
msgstr ""
"<p>ກ່ອງຂໍ້ຄວາມ <b>ກົດສຳລັບ auditctl</b> ຈະໃຫ້ຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບກົດ ແລະ ຄວາມສາມາດໃນການເພີ່ມ"
"ກົດ.\n"
"ຂໍ້ມູນລະອຽດກ່ຽວກັບການກຳນົດຄ່າໄຟລ໌ບັນທຶກສາມາດເບິ່ງໄດ້ຈາກໜ້າຄູ່ມື ('man auditd.conf').</p>"

#. logfile_settings dialog help 3/8
#: src/include/audit-laf/helps.rb:64
msgid ""
"<p><b>Log File</b>: Enter the full path name to the log file\n"
"(or use <b>Select File</b>.)</p>"
msgstr ""
"<p><b>ໄຟລ໌ບັນທຶກ</b>: ປ້ອນຊື່ເສັ້ນທາງເຕັມຂອງໄຟລ໌ບັນທຶກ\n"
"(ຫຼື ໃຊ້ <b>ເລືອກໄຟລ໌</b>.)</p>"

#. logfile_settings dialog help 4/8
#: src/include/audit-laf/helps.rb:68
msgid ""
"<p><b>Format</b>: set <i>RAW</i> to log all data (store in a format exactly "
"as the kernel\n"
"sends it) or <i>NOLOG</i> to discard all audit information instead of "
"writing it on disk (does not affect\n"
"data sent to the dispatcher).</p> "
msgstr ""
"<p><b>ຮູບແບບ</b>: ກຳນົດເປັນ <i>RAW</i> ເພື່ອບັນທຶກຂໍ້ມູນທັງໝົດ (ເກັບໃນຮູບແບບດຽວກັບທີ່ເຄີເນິລສົ່ງມາ"
"ທຸກປະການ) ຫຼື <i>NOLOG</i> ເພື່ອຖິ້ມຂໍ້ມູນການກວດສອບທັງໝົດແທນທີ່ຈະຂຽນລົງດິດ (ບໍ່ມີຜົນຕໍ່ຂໍ້ມູນທີ່ສົ່ງໄປຫາຕົວ"
"ແຈກຈ່າຍ).</p> "

#. logfile_settings dialog help 5/8
#: src/include/audit-laf/helps.rb:74
msgid ""
"<p><b>Flush</b>: describes how to write the data to disk. If set to "
"<i>INCREMENTAL</i> the\n"
"<b>Frequency</b> parameter tells how many records to write before issuing an "
"explicit flush to disk.\n"
"<i>NONE</i> means: no special effort is made to flush data, <i>DATA</i>: "
"keep data portion synced,\n"
"<i>SYNC</i>: keep data and meta-data fully synced.</p>"
msgstr ""
"<p><b>Flush</b>: ອະທິບາຍວິທີການຂຽນຂໍ້ມູນລົງດິດ. ຖ້າກຳນົດເປັນ <i>INCREMENTAL</i>,\n"
"ພາລາມິເຕີ <b>ຄວາມຖີ່</b> ຈະບອກວ່າຕ້ອງຂຽນຈັກບັນທຶກກ່ອນທີ່ຈະສັ່ງລ້າງຂໍ້ມູນລົງດິດ.\n"
"<i>NONE</i> ໝາຍເຖິງ: ບໍ່ມີການຈັດການພິເສດໃນການລ້າງຂໍ້ມູນ, <i>DATA</i>: ເຮັດໃຫ້ສ່ວນຂອງຂໍ້ມູນຊິງຄ໌"
"ກັນ,\n"
"<i>SYNC</i>: ເຮັດໃຫ້ທັງຂໍ້ມູນ ແລະ ເມຕາເດຕາຊິງຄ໌ກັນຢ່າງສົມບູນ.</p>"

#. logfile_settings dialog help 6/8
#: src/include/audit-laf/helps.rb:81
msgid ""
"<p>Configure the maximum log file size (in megabytes) and the action to take "
"when this\n"
"value is reached via <b>Size and Action</b>.</p>\n"
msgstr ""
"<p>ກຳນົດຄ່າຂະໜາດສູງສຸດຂອງໄຟລ໌ບັນທຶກ (ເປັນເມກາໄບຕ໌) ແລະ ການດຳເນີນການທີ່ຈະເຮັດເມື່ອຮອດຄ່ານີ້ຜ່ານທາ"
"ງ <b>ຂະໜາດ ແລະ ການດຳເນີນການ</b>.</p>\n"

#. logfile_settings dialog help 7/8
#: src/include/audit-laf/helps.rb:85
msgid ""
"<p>If the action is set to <i>ROTATE</i> the <b>Number of Log Files</b> "
"specifies the number\n"
"of files to keep. Set to <i>SYSLOG</i>, the audit daemon will write a "
"warning\n"
"to /var/log/messages. With <i>SUSPEND</i> the daemon stops writing records "
"to\n"
"disk. <i>IGNORE</i> means do nothing, <i>KEEP_LOGS</i> is similar\n"
"to ROTATE, but log files are not overwritten.</p>\n"
msgstr ""
"<p>ຖ້າການດຳເນີນການຖືກກຳນົດເປັນ <i>ROTATE</i>, <b>ຈຳນວນໄຟລ໌ບັນທຶກ</b> ຈະກຳນົດຈຳນວນໄຟລ໌ທີ່ຈ"
"ະເກັບໄວ້. ຖ້າກຳນົດເປັນ <i>SYSLOG</i>, ດີມອນການກວດສອບຈະຂຽນຄຳເຕືອນລົງໃນ /var/log/"
"messages. ຖ້າໃຊ້ <i>SUSPEND</i> ດີມອນຈະຢຸດຂຽນບັນທຶກລົງດິດ. <i>IGNORE</i> ໝາຍເຖິງບໍ່ເຮັດຫຍັ"
"ງເລີຍ, <i>KEEP_LOGS</i> ຈະຄ້າຍຄືກັບ ROTATE ແຕ່ໄຟລ໌ບັນທຶກຈະບໍ່ຖືກຂຽນທັບ.</p>\n"

#. logfile_settings dialog help 8/8
#: src/include/audit-laf/helps.rb:93
msgid ""
"<p><b>Computer Name Format</b> describes how to write the computer name to "
"the\n"
"log file.  If <i>USER</i> is set, the <b>User Defined Name</b> is\n"
"used. <i>NONE</i> means no computer name is inserted. <i>HOSTNAME</i> uses "
"the\n"
"name returned by the 'gethostname' syscall.  <i>FQD</i> uses the fully "
"qualified\n"
"domain name.</p>\n"
msgstr ""
"<p><b>ຮູບແບບຊື່ຄອມພິວເຕີ</b> ອະທິບາຍວິທີການຂຽນຊື່\n"
"ຄອມພິວເຕີລົງໃນໄຟລ໌ບັນທຶກ. ຖ້າກຳນົດເປັນ <i>USER</i>, ຈະໃຊ້ <b>ຊື່ທີ່\n"
"ຜູ້ໃຊ້ກຳນົດເອງ</b>. <i>NONE</i> ໝາຍເຖິງບໍ່ມີການໃສ່ຊື່ຄອມພິວເຕີ. <i>HOSTNAME</i> ຈະໃຊ້\n"
"ຊື່ທີ່ໄດ້ຈາກ syscall 'gethostname'. <i>FQD</i> ຈະໃຊ້ຊື່\n"
"ໂດເມນທີ່ສົມບູນ.</p>\n"

#. dispatcher dialog help 1/5
#: src/include/audit-laf/helps.rb:101
msgid ""
"<p><b><big>Auditd Dispatcher Configuration</big></b><br>\n"
"Detailed information about the dispatcher settings can be obtained from the "
"manual page\n"
"('man auditd.conf').</p>"
msgstr ""
"<p><b><big>ການກຳນົດຄ່າຕົວແຈກຈ່າຍຂອງ Auditd</big></b><br>\n"
"ຂໍ້ມູນລະອຽດກ່ຽວກັບການກຳນົດຄ່າຕົວແຈກຈ່າຍສາມາດເບິ່ງໄດ້ຈາກໜ້າຄູ່ມື\n"
"('man auditd.conf').</p>"

#. dispatcher dialog help 2/5
#: src/include/audit-laf/helps.rb:107
msgid ""
"<p><b>Dispatcher</b>: The dispatcher program is started by the audit daemon "
"and\n"
"gets all audit events on stdin.</p>"
msgstr ""
"<p><b>ຕົວແຈກຈ່າຍ</b>: ໂປຣແກຣມຕົວແຈກຈ່າຍຖືກເລີ່ມຕົ້ນໂດຍດີມອນການກວດສອບ ແລະ\n"
"ຈະຮັບເຫດການການກວດສອບທັງໝົດຜ່ານ stdin.</p>"

#. dispatcher dialog help 3/5
#: src/include/audit-laf/helps.rb:111
msgid ""
"<p><b>Communication</b>: Controls the communication between the daemon and "
"the dispatcher\n"
"program. A <i>lossy</i> communication means that events going to the "
"dispatcher are discarded\n"
"when the queue (a 128kB buffer) is full. Choose <i>lossless</i> if you want "
"a blocking/lossless\n"
"communication.</p>"
msgstr ""
"<p><b>ການຕິດຕໍ່ສື່ສານ</b>: ຄວບຄຸມການຕິດຕໍ່ສື່ສານລະຫວ່າງດີມອນ ແລະ ໂປຣແກຣມຕົວແຈກຈ່າຍ. ການຕິດຕໍ່ແບ"
"ບ <i>lossy</i> ໝາຍຄວາມວ່າເຫດການທີ່ສົ່ງໄປຫາຕົວແຈກຈ່າຍຈະຖືກຖິ້ມເມື່ອຄິວ (ບັບເຟີຂະໜາດ 128kB) ເຕັ"
"ມ. ເລືອກ <i>lossless</i> ຖ້າທ່ານຕ້ອງການການຕິດຕໍ່ແບບບໍ່ໃຫ້ຂໍ້ມູນສູນເສຍ.</p>"

#. dispatcher dialog help 4/5
#: src/include/audit-laf/helps.rb:118
msgid ""
"<p>The dispatcher 'audispd' is an audit event multiplexor.\n"
"For more information see the manual pages ('man audispd' and 'man audispd."
"conf').</p>"
msgstr ""
"<p>ຕົວແຈກຈ່າຍ 'audispd' ແມ່ນຕົວລວມສັນຍານເຫດການການກວດສອບ (audit event multiplexor)"
".\n"
"ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ ເບິ່ງໜ້າຄູ່ມື ('man audispd' ແລະ 'man audispd.conf').</p>"

#. dispatcher dialog help 5/5
#: src/include/audit-laf/helps.rb:122
msgid ""
"<p><b>Note:</b> The dispatcher program must be owned by 'root', have '0750'\n"
" file permissions, and the full path name has to be entered.</p>\n"
msgstr ""
"<p><b>ໝາຍເຫດ:</b> ໂປຣແກຣມຕົວແຈກຈ່າຍຕ້ອງເປັນຂອງ 'root', ມີສິດການເຂົ້າເຖິງໄຟລ໌ເປັນ "
"'0750', ແລະ ຕ້ອງປ້ອນຊື່ເສັ້ນທາງເຕັມ.</p>\n"

#. disk space dialog help 1/6
#: src/include/audit-laf/helps.rb:126
msgid ""
"<p><b><big>Auditd Disk Space Configuration</big></b><br>\n"
"The settings made here refer to disk space on log partition.\n"
"For detailed information, refer to the manual page ('man auditd.conf').</p>\n"
msgstr ""
"<p><b><big>ການກຳນົດຄ່າພື້ນທີ່ດິດຂອງ Auditd</big></b><br>\n"
"ການກຳນົດຄ່າຢູ່ນີ້ໝາຍເຖິງພື້ນທີ່ດິດໃນພາທິຊັນທີ່ໃຊ້ບັນທຶກ.\n"
"ສຳລັບຂໍ້ມູນລະອຽດ, ໃຫ້ເບິ່ງທີ່ໜ້າຄູ່ມື ('man auditd.conf').</p>\n"

#. disk space dialog help 2/6
#: src/include/audit-laf/helps.rb:132
msgid ""
"<p><b>Space Left</b> (in megabytes) tells the audit daemon when to perform "
"an <b>Action</b> because\n"
"the system is starting to run low on space.</p>"
msgstr ""
"<p><b>ພື້ນທີ່ຄົງເຫຼືອ</b> (ເປັນເມກາໄບຕ໌) ຈະບອກດີມອນການກວດສອບວ່າເມື່ອໃດຄວນດຳເນີນ <b>ການດຳເນີນ"
"ການ</b> ເພາະລະບົບເລີ່ມມີພື້ນທີ່ເຫຼືອໜ້ອຍ.</p>"

#. disk space dialog help 3/6
#: src/include/audit-laf/helps.rb:136
msgid ""
"<p>The value for <b>Admin Space Left</b> should be lower than above. The "
"system <b>is running\n"
"low</b> on disk space if the value is reached and the specified <b>Action</"
"b> will be performed.</p>"
msgstr ""
"<p>ຄ່າຂອງ <b>ພື້ນທີ່ຜູ້ດູແລລະບົບຄົງເຫຼືອ</b> ຄວນຈະຕ່ຳກວ່າຄ່າຂ້າງເທິງ. ລະບົບຈະຖືວ່າ <b>ມີພື້ນທີ່ເຫຼືອໜ້ອຍຫຼ"
"າຍ</b> ຖ້າຮອດຄ່ານີ້ ແລະ ຈະປະຕິບັດ <b>ການດຳເນີນການ</b> ທີ່ລະບຸໄວ້.</p>"

#. disk space dialog hep 4/6
#: src/include/audit-laf/helps.rb:140
msgid ""
"<p>If an action is set to <i>EMAIL</i>, a warning mail will be sent to the\n"
"account specified in <b>Action Mail Account</b>.<br> <i>SYSLOG</i> means "
"the\n"
"disk space warning will be written to /var/log/messages. <i>IGNORE</i> "
"means\n"
"do nothing. <i>EXEC</i> runs the script specified in <b>Path to\n"
"Script</b>. <i>SUSPEND</i> stops writing records to disk. <i>SINGLE</i>\n"
"switches the system to single user mode. <i>HALT</i> shuts down the\n"
"system.</p>\n"
msgstr ""
"<p>ຖ້າການດຳເນີນການຖືກກຳນົດເປັນ <i>EMAIL</i>, ອີເມລແຈ້ງເຕືອນຈະຖືກສົ່ງໄປຍັງບັນຊີທີ່ລະບຸໃນ <b>ບັນຊີ"
"ອີເມລສຳລັບການດຳເນີນການ</b>.<br> <i>SYSLOG</i> ໝາຍເຖິງຄຳເຕືອນພື້ນທີ່ດິດຈະຖືກຂຽນລົງໃນ /var/"
"log/messages. <i>IGNORE</i> ໝາຍເຖິງບໍ່ເຮັດຫຍັງເລີຍ. <i>EXEC</i> ຈະລັນສະຄຣິບທີ່ລະບຸໃນ <b>"
"ເສັ້ນທາງໄປຫາສະຄຣິບ</b>. <i>SUSPEND</i> ຈະຢຸດການຂຽນບັນທຶກລົງດິດ. <i>SINGLE</i> ຈະປ່ຽນລະ"
"ບົບເຂົ້າສູ່ໂໝດຜູ້ໃຊ້ຄົນດຽວ. <i>HALT</i> ຈະປິດລະບົບ.</p>\n"

#. disk space dialog help 5/6
#: src/include/audit-laf/helps.rb:150
msgid ""
"<p>You can also specify a <b>Disk Full Action</b> (disk has become full "
"already) and\n"
"a <b>Disk Error Action</b> (performed whenever an error is detected while "
"writing to disk).\n"
"Available actions are the same as above (except for <i>EMAIL</i>).</p>"
msgstr ""
"<p>ທ່ານຍັງສາມາດລະບຸ <b>ການດຳເນີນການເມື່ອດິດເຕັມ</b> (ດິດເຕັມແລ້ວ) ແລະ <b>ການດຳເນີນການເມື່ອດິ"
"ດມີຂໍ້ຜິດພາດ</b> (ປະຕິບັດທຸກຄັ້ງທີ່ກວດພົບຂໍ້ຜິດພາດໃນຂະນະທີ່ຂຽນລົງດິດ).\n"
"ການດຳເນີນການທີ່ມີໃຫ້ແມ່ນຄືກັນກັບຂ້າງເທິງ (ຍົກເວັ້ນ <i>EMAIL</i>).</p>"

#. disk space dialog help 5/6
#: src/include/audit-laf/helps.rb:156
msgid ""
"<p><b>Note:</b> All scripts specified for <i>EXEC</i> must be owned\n"
"by 'root', have '0750' file permissions, and the full path name has to be "
"entered.</p>\n"
msgstr ""
"<p><b>ໝາຍເຫດ:</b> ສະຄຣິບທັງໝົດທີ່ລະບຸສຳລັບ <i>EXEC</i> ຕ້ອງເປັນຂອງ 'root', ມີສິດການເຂົ້າເຖິ"
"ງໄຟລ໌ເປັນ '0750', ແລະ ຕ້ອງປ້ອນຊື່ເສັ້ນທາງເຕັມ.</p>\n"

#. rules dialog help 1/6
#: src/include/audit-laf/helps.rb:160
msgid ""
"<p><b><big>Rules for auditctl</big></b><br>\n"
"This dialog offers the possibility to enable or to disable the syscall\n"
"auditing as well as to lock the audit configuration.\n"
"The selected flag from <b>Set Enabled Flag</b> will be added to the rules.</"
"p>"
msgstr ""
"<p><b><big>ກົດສຳລັບ auditctl</big></b><br>\n"
"ກ່ອງຂໍ້ຄວາມນີ້ໃຫ້ຄວາມສາມາດໃນການເປີດ ຫຼື ປິດການກວດສອບ syscall ລວມທັງການລັອກການກຳນົດຄ່າການກວດ"
"ສອບ.\n"
"ທຸງທີ່ເລືອກຈາກ <b>ກຳນົດທຸງການເປີດໃຊ້ງານ</b> ຈະຖືກເພີ່ມເຂົ້າໃນກົດ.</p>"

#. rules dialog help 2/6
#: src/include/audit-laf/helps.rb:167
msgid ""
"<p><b>Note:</b><br>Locking the rules means they cannot be changed until next "
"reboot.</p>"
msgstr ""
"<p><b>ໝາຍເຫດ:</b><br>ການລັອກກົດໝາຍຄວາມວ່າກົດຈະບໍ່ສາມາດຖືກປ່ຽນແປງໄດ້ຈົນກວ່າຈະມີການຣີສະຕາດເຄື່"
"ອງໃໝ່.</p>"

#. rules dialog help 3/6
#: src/include/audit-laf/helps.rb:171
msgid ""
"<p>Enabling auditing without additional rules will cause the\n"
" applications which use <i>libaudit</i>, e.g. PAM to log to /var/log/audit/"
"audit.log (default).</p> "
msgstr ""
"<p>ການເປີດໃຊ້ງານການກວດສອບໂດຍບໍ່ມີກົດເພີ່ມເຕີມຈະເຮັດໃຫ້ແອັບພລິເຄຊັນທີ່ໃຊ້ <i>libaudit</i> (ເຊັ່"
"ນ: PAM) ບັນທຶກລົງໃນ /var/log/audit/audit.log (ຄ່າມາດຕະຖານ).</p> "

#. rules dialog help 4/6
#: src/include/audit-laf/helps.rb:175
msgid ""
"<p>You can also edit the rules manually, which we only recommended for "
"advanced users.<br>\n"
"For more information about all options, see 'man auditctl'.</p>\n"
msgstr ""
"<p>ທ່ານຍັງສາມາດແກ້ໄຂກົດດ້ວຍຕົນເອງໄດ້, ເຊິ່ງພວກເຮົາແນະນຳສຳລັບຜູ້ໃຊ້ລະດັບສູງເທົ່ານັ້ນ.<br>\n"
"ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຕົວເລືອກທັງໝົດ, ເບິ່ງ 'man auditctl'.</p>\n"

#. rules dialog help 5/6
#: src/include/audit-laf/helps.rb:179
msgid ""
"<p><b>Check Syntax</b> sends the rules via <i>auditctl</i> to the audit "
"subsystem and checks the syntax.<br><b>Restore</b> restores the settings "
"from /etc/audit/audit.rules.</p>\n"
msgstr ""
"<p><b>ກວດສອບໄວຍາກອນ</b> ຈະສົ່ງກົດຜ່ານ <i>auditctl</i> ໄປຫາລະບົບຍ່ອຍການກວດສອບ ແລະ ກວ"
"ດສອບໄວຍາກອນ.<br><b>ກູ້ຄືນ</b> ຈະກູ້ຄືນການກຳນົດຄ່າຈາກ /etc/audit/audit.rules.</p>\n"

#. rules dialog help 6/6
#: src/include/audit-laf/helps.rb:183
msgid ""
"<p>Click <b>Restore and Reset</b> to restore the rules and reset\n"
"the changes (from previous syntax checks) by calling <i>auditctl</i>.<br>\n"
"Click <b>Load</b> to open a file selection dialog in which you can load\n"
"an example rules file.</p>\n"
msgstr ""
"<p>ຄລິກ <b>ກູ້ຄືນ ແລະ ຣີເຊັດ</b> ເພື່ອກູ້ຄືນກົດ ແລະ ຣີເຊັດການປ່ຽນແປງ (ຈາກການກວດສອບໄວຍາກອນກ່ອນ"
"ໜ້ານີ້) ໂດຍການເອີ້ນໃຊ້ <i>auditctl</i>.<br>\n"
"ຄລິກ <b>ໂຫຼດ</b> ເພື່ອເປີດກ່ອງຂໍ້ຄວາມເລືອກໄຟລ໌ ເຊິ່ງທ່ານສາມາດໂຫຼດໄຟລ໌ຕົວຢ່າງກົດໄດ້.</p>\n"

#. Header of tab in tab widget
#: src/include/audit-laf/wizards.rb:123
msgid "&Dispatcher"
msgstr "ຕົວແຈກ&ຈ່າຍ"

#. Header of tab in tab widget
#: src/include/audit-laf/wizards.rb:129
msgid "Disk &Space"
msgstr "ພື້ນທີ່&ດິດ"

#. Header of tab in tab widget
#. (auditctl is a program which sends the rules to the audit subsystem)
#: src/include/audit-laf/wizards.rb:136
msgid "&Rules for 'auditctl'"
msgstr "&ກົດສຳລັບ 'auditctl'"

#. Initialization dialog contents
#: src/include/audit-laf/wizards.rb:230
msgid "Initializing..."
msgstr "ກຳລັງເລີ່ມຕົ້ນ..."

#. Do not check UI when running in CommandLine mode
#: src/modules/AuditLaf.rb:227
msgid "The rules for auditctl are locked."
msgstr "ກົດສຳລັບ auditctl ຖືກລັອກໄວ້."

#. skip it during initial and second stage or when create AY profile
#: src/modules/AuditLaf.rb:314
#, ycp-format
msgid ""
"<p>To continue the configuration of Linux Auditing, the package <b>%1</b> "
"must be installed.</p>"
msgstr ""
"<p>ເພື່ອດຳເນີນການກຳນົດຄ່າການກວດສອບ Linux ຕໍ່ໄປ, ຕ້ອງຕິດຕັ້ງແພັກເກດ <b>%1</b> ກ່ອນ.</p>"

#: src/modules/AuditLaf.rb:317
msgid "<p>Install it now?</p>"
msgstr "<p>ຕິດຕັ້ງດຽວນີ້ເລີຍບໍ?</p>"

#. additionally save initial settings
#: src/modules/AuditLaf.rb:353
msgid ""
"Cannot start the audit daemon.\n"
"Please check /var/log/messages for auditd errors.\n"
"You can use the module 'System Log' from group\n"
"'Miscellaneous' in YaST Control Center."
msgstr ""
"ບໍ່ສາມາດເລີ່ມດີມອນການກວດສອບໄດ້.\n"
"ກະລຸນາກວດສອບ /var/log/messages ເພື່ອເບິ່ງຂໍ້ຜິດພາດຂອງ auditd.\n"
"ທ່ານສາມາດໃຊ້ໂມດູນ 'ບັນທຶກລະບົບ' (System Log) ຈາກກຸ່ມ\n"
"'ເບັດເຕະເລັດ' (Miscellaneous) ໃນສູນຄວບຄຸມ YaST."

#. AuditLaf read dialog caption
#: src/modules/AuditLaf.rb:372
msgid "Initializing Audit Configuration"
msgstr "ກຳລັງເລີ່ມຕົ້ນການກຳນົດຄ່າການກວດສອບ"

#. Progress stage 1/4
#: src/modules/AuditLaf.rb:387
msgid "Check for installed packages"
msgstr "ກວດສອບແພັກເກດທີ່ຕິດຕັ້ງແລ້ວ"

#. Progress stage 2/4
#: src/modules/AuditLaf.rb:389
msgid "Read the configuration of auditd"
msgstr "ອ່ານການກຳນົດຄ່າຂອງ auditd"

#. Progress stage 3/4
#: src/modules/AuditLaf.rb:391
msgid "Read the rules file"
msgstr "ອ່ານໄຟລ໌ກົດ"

#. Progress stage 4/4
#: src/modules/AuditLaf.rb:393
msgid "Check status of auditd"
msgstr "ກວດສອບສະຖານະຂອງ auditd"

#. Progress stage 1/4
#: src/modules/AuditLaf.rb:397
msgid "Checking for packages..."
msgstr "ກຳລັງກວດສອບແພັກເກດ..."

#. Progress step 2/4
#: src/modules/AuditLaf.rb:399
msgid "Reading the configuration..."
msgstr "ກຳລັງອ່ານການກຳນົດຄ່າ..."

#. Progress step 3/4
#: src/modules/AuditLaf.rb:401
msgid "Reading the rules file..."
msgstr "ກຳລັງອ່ານໄຟລ໌ກົດ..."

#. Progress step 4/4
#: src/modules/AuditLaf.rb:403
msgid "Checking status..."
msgstr "ກຳລັງກວດສອບສະຖານະ..."

#. Report error
#: src/modules/AuditLaf.rb:428
msgid "Cannot read auditd.conf."
msgstr "ບໍ່ສາມາດອ່ານ auditd.conf ໄດ້."

#. Error message
#: src/modules/AuditLaf.rb:438
msgid "Cannot read audit.rules."
msgstr "ບໍ່ສາມາດອ່ານ audit.rules ໄດ້."

#. question shown in a popup about start of audit daemon
#: src/modules/AuditLaf.rb:457
msgid ""
"Do you want to start it and enable start at boot\n"
"or only start the daemon for now?"
msgstr ""
"ທ່ານຕ້ອງການເລີ່ມຕົ້ນ ແລະ ເປີດໃຫ້ເຮັດວຽກຕອນບູດເຄື່ອງ\n"
"ຫຼື ພຽງແຕ່ເລີ່ມດີມອນໃນຕອນນີ້ເທົ່ານັ້ນ?"

#: src/modules/AuditLaf.rb:460
msgid "The daemon 'auditd' doesn't run.\n"
msgstr "ດີມອນ 'auditd' ບໍ່ໄດ້ເຮັດວຽກ.\n"

#. message about loaded kernel module
#: src/modules/AuditLaf.rb:464
msgid ""
"The 'apparmor' kernel module is loaded.\n"
"The kernel uses a running audit daemon to log audit\n"
"events to /var/log/audit/audit.log (default).\n"
msgstr ""
"ໂມດູນເຄີເນິລ 'apparmor' ຖືກໂຫຼດແລ້ວ.\n"
"ເຄີເນິລຈະໃຊ້ດີມອນການກວດສອບທີ່ເຮັດວຽກຢູ່ເພື່ອບັນທຶກເຫດການ\n"
"ລົງໃນ /var/log/audit/audit.log (ຄ່າມາດຕະຖານ).\n"

#. Headline of a popup
#: src/modules/AuditLaf.rb:471
msgid "Start of Audit Daemon"
msgstr "ການເລີ່ມຕົ້ນດີມອນການກວດສອບ"

#. label of three buttons belonging to the popup
#: src/modules/AuditLaf.rb:473
msgid "Start and &Enable"
msgstr "ເລີ່ມຕົ້ນ ແລະ ເປີດ&ໃຊ້ງານ"

#: src/modules/AuditLaf.rb:473
msgid "&Start"
msgstr "&ເລີ່ມຕົ້ນ"

#: src/modules/AuditLaf.rb:473
msgid "&Do not start"
msgstr "&ບໍ່ຕ້ອງເລີ່ມຕົ້ນ"

#: src/modules/AuditLaf.rb:482
msgid "Cannot start the audit daemon."
msgstr "ບໍ່ສາມາດເລີ່ມດີມອນການກວດສອບໄດ້."

#: src/modules/AuditLaf.rb:483
msgid ""
"The rules may be locked.\n"
"Continue to check the rules. You can change\n"
"the 'Enabled Flag', but to activate the change\n"
"a reboot is required afterwards.\n"
msgstr ""
"ກົດຕ່າງໆອາດຖືກລັອກໄວ້.\n"
"ດຳເນີນການກວດສອບກົດຕໍ່ໄປ. ທ່ານສາມາດປ່ຽນແປງ\n"
"'ທຸງການເປີດໃຊ້ງານ' ໄດ້, ແຕ່ເພື່ອໃຫ້ການປ່ຽນແປງມີຜົນ\n"
"ຈຳເປັນຕ້ອງຣີສະຕາດເຄື່ອງໃໝ່ຫຼັງຈາກນັ້ນ.\n"

#. Auditd read dialog caption
#: src/modules/AuditLaf.rb:539
msgid "Saving Audit Configuration"
msgstr "ກຳລັງບັນທຶກການກຳນົດຄ່າການກວດສອບ"

#. Progress stage 1/2
#: src/modules/AuditLaf.rb:555
msgid "Write the settings"
msgstr "ຂຽນການກຳນົດຄ່າ"

#. Progress stage 2/2
#: src/modules/AuditLaf.rb:557
msgid "Write the rules"
msgstr "ຂຽນກົດ"

#. Progress step 1/2
#: src/modules/AuditLaf.rb:561
msgid "Writing the settings..."
msgstr "ກຳລັງຂຽນການກຳນົດຄ່າ..."

#. Progress step 2/2
#: src/modules/AuditLaf.rb:563
msgid "Writing the rules..."
msgstr "ກຳລັງຂຽນກົດ..."

#. check first whether rules are already locked
#: src/modules/AuditLaf.rb:579
msgid "The rules are already locked."
msgstr "ກົດຖືກລັອກໄວ້ແລ້ວ."

#: src/modules/AuditLaf.rb:580
msgid ""
"Do you want to change the 'Enabled Flag'?\n"
"If yes, the new rules will be written to /etc/audit/audit.rules.\n"
"Reboot the system afterwards for the change to take effect.\n"
msgstr ""
"ທ່ານຕ້ອງການປ່ຽນແປງ 'ທຸງການເປີດໃຊ້ງານ' ບໍ່?\n"
"ຖ້າແມ່ນ, ກົດໃໝ່ຈະຖືກຂຽນລົງໃນ /etc/audit/audit.rules.\n"
"ຣີສະຕາດລະບົບໃໝ່ຫຼັງຈາກນັ້ນເພື່ອໃຫ້ການປ່ຽນແປງມີຜົນ.\n"

#. Error message
#: src/modules/AuditLaf.rb:605
msgid "Restart of the audit daemon failed."
msgstr "ການຣີສະຕາດດີມອນການກວດສອບລົ້ມເຫຼວ."

#. Error message
#: src/modules/AuditLaf.rb:612
msgid "Cannot write settings to auditd.conf."
msgstr "ບໍ່ສາມາດຂຽນການກຳນົດຄ່າລົງໃນ auditd.conf ໄດ້."

#. Error message, rules cannot be set
#: src/modules/AuditLaf.rb:641
msgid "Start yast2-audit-laf again and check the rules."
msgstr "ເລີ່ມຕົ້ນ yast2-audit-laf ອີກຄັ້ງ ແລະ ກວດສອບກົດ."

#: src/modules/AuditLaf.rb:647
msgid "Cannot write settings to auditd.rules."
msgstr "ບໍ່ສາມາດຂຽນການກຳນົດຄ່າລົງໃນ auditd.rules ໄດ້."

