#. Manage VPN client secrets.
#: src/lib/vpn/edit_client_secrets.rb:56
msgid "Pre-shared key for gateways"
msgstr "ກຸນແຈທີ່ແບ່ງປັນໄວ້ລ່ວງໜ້າສຳລັບປະຕູເຊື່ອມຕໍ່"

#: src/lib/vpn/edit_client_secrets.rb:57 src/lib/vpn/edit_client_secrets.rb:62
msgid "Gateway IP"
msgstr "IP ຂອງປະຕູເຊື່ອມຕໍ່"

#: src/lib/vpn/edit_client_secrets.rb:57
msgid "Pre-shared key"
msgstr "ກຸນແຈທີ່ແບ່ງປັນໄວ້ລ່ວງໜ້າ"

#: src/lib/vpn/edit_client_secrets.rb:59 src/lib/vpn/edit_client_secrets.rb:63
msgid "Set"
msgstr "ຕັ້ງຄ່າ"

#: src/lib/vpn/edit_client_secrets.rb:60 src/lib/vpn/edit_gw_secrets.rb:188
msgid "Show key"
msgstr "ສະແດງກຸນແຈ"

#: src/lib/vpn/edit_client_secrets.rb:61
msgid "Certificate/key pair for gateways"
msgstr "ຄູ່ໃບຢັ້ງຢືນ/ກຸນແຈ ສຳລັບປະຕູເຊື່ອມຕໍ່"

#: src/lib/vpn/edit_client_secrets.rb:62
msgid "Certificate"
msgstr "ໃບຢັ້ງຢືນ"

#: src/lib/vpn/edit_client_secrets.rb:62
msgid "Key"
msgstr "ກຸນແຈ"

#. Make sure that tables are filled, then save all settings.
#: src/lib/vpn/edit_client_secrets.rb:121
#, c-format
msgid ""
"Shared keys for the following gateways are still missing:\n"
"%s"
msgstr ""
"ຍັງຂາດກຸນແຈທີ່ໃຊ້ຮ່ວມກັນສຳລັບປະຕູເຊື່ອມຕໍ່ດັ່ງຕໍ່ໄປນີ້:\n"
"%s"

#: src/lib/vpn/edit_client_secrets.rb:127
#, c-format
msgid ""
"Certificates for the following gateways are still missing:\n"
"%s"
msgstr ""
"ຍັງຂາດໃບຢັ້ງຢືນສຳລັບປະຕູເຊື່ອມຕໍ່ດັ່ງຕໍ່ໄປນີ້:\n"
"%s"

#. Load PSKs
#. Reload gateway PSK text input.
#. Load XAuth
#. Load EAP
#: src/lib/vpn/edit_client_secrets.rb:140 src/lib/vpn/edit_gw_secrets.rb:224
#: src/lib/vpn/edit_gw_secrets.rb:233 src/lib/vpn/edit_gw_secrets.rb:239
msgid "(hidden)"
msgstr "(ເຊື່ອງໄວ້)"

#. Remove the selected EAP user.
#. Remove the selected XAuth user.
#: src/lib/vpn/edit_gw_secrets.rb:120 src/lib/vpn/edit_gw_secrets.rb:141
msgid "Please select a user to delete."
msgstr "ກະລຸນາເລືອກຜູ້ໃຊ້ທີ່ຕ້ອງການລຶບ."

#. Save PSK and certificate settings. Note that XAUTH and EAP user lists are already saved.
#: src/lib/vpn/edit_gw_secrets.rb:154
msgid "A pre-shared key is mandatory. Please enter a pre-shared key."
msgstr "ຈຳເປັນຕ້ອງມີກຸນແຈທີ່ແບ່ງປັນໄວ້ລ່ວງໜ້າ. ກະລຸນາປ້ອນກຸນແຈດັ່ງກ່າວ."

#: src/lib/vpn/edit_gw_secrets.rb:166
msgid "Please enter both certificate file path and key file path."
msgstr "ກະລຸນາປ້ອນທັງເສັ້ນທາງໄຟລ໌ໃບຢັ້ງຢືນ ແລະ ເສັ້ນທາງໄຟລ໌ກຸນແຈ."

#. Event handlers
#: src/lib/vpn/edit_gw_secrets.rb:175 src/lib/vpn/set_client_cert_dialog.rb:64
msgid "Pick a PEM encoded certificate file"
msgstr "ເລືອກໄຟລ໌ໃບຢັ້ງຢືນທີ່ເຂົ້າລະຫັດແບບ PEM"

#: src/lib/vpn/edit_gw_secrets.rb:180 src/lib/vpn/set_client_cert_dialog.rb:69
msgid "Pick a PEM encoded certificate key file"
msgstr "ເລືອກໄຟລ໌ກຸນແຈໃບຢັ້ງຢືນທີ່ເຂົ້າລະຫັດແບບ PEM"

#: src/lib/vpn/edit_gw_secrets.rb:186
msgid "Gateway pre-shared key"
msgstr "ກຸນແຈທີ່ແບ່ງປັນໄວ້ລ່ວງໜ້າຂອງປະຕູເຊື່ອມຕໍ່"

#: src/lib/vpn/edit_gw_secrets.rb:192
msgid "Gateway certificate"
msgstr "ໃບຢັ້ງຢືນປະຕູເຊື່ອມຕໍ່"

#: src/lib/vpn/edit_gw_secrets.rb:194
msgid "Path to certificate file"
msgstr "ເສັ້ນທາງໄປຫາໄຟລ໌ໃບຢັ້ງຢືນ"

#: src/lib/vpn/edit_gw_secrets.rb:197
msgid "Path to certificate key file"
msgstr "ເສັ້ນທາງໄປຫາໄຟລ໌ກຸນແຈໃບຢັ້ງຢືນ"

#: src/lib/vpn/edit_gw_secrets.rb:202
msgid "User credentials for Android, iOS, MacOS X clients"
msgstr "ຂໍ້ມູນການເຂົ້າລະບົບສຳລັບລູກຂ່າຍ Android, iOS, MacOS X"

#: src/lib/vpn/edit_gw_secrets.rb:203 src/lib/vpn/edit_gw_secrets.rb:212
msgid "Username"
msgstr "ຊື່ຜູ້ໃຊ້"

#: src/lib/vpn/edit_gw_secrets.rb:203 src/lib/vpn/edit_gw_secrets.rb:212
msgid "Password"
msgstr "ລະຫັດຜ່ານ"

#: src/lib/vpn/edit_gw_secrets.rb:205 src/lib/vpn/edit_gw_secrets.rb:214
msgid "Add"
msgstr "ເພີ່ມ"

#: src/lib/vpn/edit_gw_secrets.rb:206 src/lib/vpn/edit_gw_secrets.rb:215
msgid "Delete"
msgstr "ລຶບ"

#: src/lib/vpn/edit_gw_secrets.rb:207 src/lib/vpn/edit_gw_secrets.rb:216
msgid "Show Password"
msgstr "ສະແດງລະຫັດຜ່ານ"

#: src/lib/vpn/edit_gw_secrets.rb:211
msgid "User credentials for Windows 7, Windows 8 clients"
msgstr "ຂໍ້ມູນການເຂົ້າລະບົບສຳລັບລູກຂ່າຍ Windows 7, Windows 8"

#. Return a user-friendly brief description of the connection.
#: src/lib/vpn/ipsec.rb:199
msgid "Gateway - PSK"
msgstr "ປະຕູເຊື່ອມຕໍ່ - PSK"

#: src/lib/vpn/ipsec.rb:201
msgid "Gateway - Certificate"
msgstr "ປະຕູເຊື່ອມຕໍ່ - ໃບຢັ້ງຢືນ"

#: src/lib/vpn/ipsec.rb:203
msgid "Gateway - Mobile clients"
msgstr "ປະຕູເຊື່ອມຕໍ່ - ລູກຂ່າຍມືຖື"

#: src/lib/vpn/ipsec.rb:205
msgid "Gateway - Windows clients"
msgstr "ປະຕູເຊື່ອມຕໍ່ - ລູກຂ່າຍ Windows"

#: src/lib/vpn/ipsec.rb:207
msgid "Client - PSK"
msgstr "ລູກຂ່າຍ - PSK"

#: src/lib/vpn/ipsec.rb:209
msgid "Client - Certificate"
msgstr "ລູກຂ່າຍ - ໃບຢັ້ງຢືນ"

#. Load parameters from connections of known scenarios
#: src/lib/vpn/ipsec.rb:239
msgid ""
"ipsec.conf and ipsec.secrets have been manipulated outside of this module.\n"
"Continue using the module will remove your customisation."
msgstr ""
"ipsec.conf ແລະ ipsec.secrets ຖືກແກ້ໄຂຈາກພາຍນອກໂມດູນນີ້.\n"
"ການໃຊ້ໂມດູນນີ້ຕໍ່ໄປຈະເຮັດໃຫ້ການປັບແຕ່ງຂອງທ່ານຖືກລຶບອອກ."

#. Create a new connection, by default it is a site-to-site client. Return true if successful.
#: src/lib/vpn/ipsec.rb:310
msgid "The connection name is already used."
msgstr "ຊື່ການເຊື່ອມຕໍ່ນີ້ຖືກໃຊ້ແລ້ວ."

#. Find an unused gateway scenario
#: src/lib/vpn/ipsec.rb:327
msgid ""
"You may only have one gateway connection per scenario.\n"
"All of gateway scenarios are already used."
msgstr ""
"ທ່ານສາມາດມີການເຊື່ອມຕໍ່ປະຕູເຊື່ອມຕໍ່ໄດ້ພຽງໜຶ່ງອັນຕໍ່ໜຶ່ງຮູບແບບ.\n"
"ຮູບແບບປະຕູເຊື່ອມຕໍ່ທັງໝົດຖືກໃຊ້ໄປແລ້ວ."

#. Warn against duplicated configuration
#: src/lib/vpn/ipsec.rb:344
msgid ""
"The scenario is already configured with another gateway.\n"
"You may not have two gateways operating under one scenario."
msgstr ""
"ຮູບແບບນີ້ຖືກຕັ້ງຄ່າໄວ້ກັບປະຕູເຊື່ອມຕໍ່ອື່ນແລ້ວ.\n"
"ທ່ານບໍ່ສາມາດມີສອງປະຕູເຊື່ອມຕໍ່ທີ່ເຮັດວຽກພາຍໃຕ້ຮູບແບບດຽວກັນໄດ້."

#. Create the user (:xauth or :eap). Return true if successful.
#: src/lib/vpn/ipsec.rb:442
msgid "The user name is already used."
msgstr "ຊື່ຜູ້ໃຊ້ນີ້ຖືກໃຊ້ແລ້ວ."

#. Set client certificate/key for a connection to remote gateway. Return true if successful, otherwise false.
#: src/lib/vpn/ipsec.rb:506
msgid "Cannot find a matching client connection."
msgstr "ບໍ່ພົບການເຊື່ອມຕໍ່ລູກຂ່າຍທີ່ກົງກັນ."

#. Render global options, connection list, and connection configuration frames.
#: src/lib/vpn/main_dialog.rb:62
msgid "VPN Gateway and Client"
msgstr "ປະຕູເຊື່ອມຕໍ່ ແລະ ລູກຂ່າຍ VPN"

#. Left side: global config & connection management
#: src/lib/vpn/main_dialog.rb:68
msgid "Global Configuration"
msgstr "ການຕັ້ງຄ່າທົ່ວໄປ"

#: src/lib/vpn/main_dialog.rb:70
msgid "Enable VPN daemon"
msgstr "ເປີດໃຊ້ງານເດມອນ VPN"

#: src/lib/vpn/main_dialog.rb:72
msgid "Reduce TCP MSS"
msgstr "ຫຼຸດ TCP MSS"

#: src/lib/vpn/main_dialog.rb:75
msgid "All VPNs"
msgstr "VPN ທັງໝົດ"

#: src/lib/vpn/main_dialog.rb:78
msgid "New VPN"
msgstr "ສ້າງ VPN ໃໝ່"

#: src/lib/vpn/main_dialog.rb:79
msgid "Delete VPN"
msgstr "ລຶບ VPN"

#: src/lib/vpn/main_dialog.rb:81
msgid "View Connection Status"
msgstr "ເບິ່ງສະຖານະການເຊື່ອມຕໍ່"

#. Event handlers
#. Display a help text to let user know why reducing MSS is sometimes necessary.
#: src/lib/vpn/main_dialog.rb:105
msgid ""
"If VPN clients have trouble accessing certain Internet sites, it is possible "
"that the affected hosts prevent automatic MTU (maximum transmission unit) "
"discovery due to incorrect firewall configuration.\n"
"Reducing TCP-MSS will correct the situation; however, the available "
"bandwidth will be reduced by about 10%."
msgstr ""
"ຖ້າລູກຂ່າຍ VPN ມີບັນຫາໃນການເຂົ້າເຖິງເວັບໄຊອິນເຕີເນັດບາງແຫ່ງ, ເປັນໄປໄດ້ວ່າໂຮສທີ່ມີບັນຫາໄດ້ປ້ອງກັນການຄົ້"
"ນຫາ MTU (maximum transmission unit) ອັດຕະໂນມັດ ຍ້ອນການຕັ້ງຄ່າໄຟວໍທີ່ບໍ່ຖືກຕ້ອງ.\n"
"ການຫຼຸດ TCP-MSS ຈະຊ່ວຍແກ້ໄຂບັນຫານີ້ໄດ້; ແນວໃດກໍຕາມ, ແບນວິດທີ່ມີໃຫ້ໃຊ້ຈະຫຼຸດລົງປະມານ 10%."

#. Delete the chosen VPN connection.
#: src/lib/vpn/main_dialog.rb:126
msgid "Delete connection"
msgstr "ລຶບການເຊື່ອມຕໍ່"

#: src/lib/vpn/main_dialog.rb:127
msgid "Are you sure to delete connection "
msgstr "ທ່ານແນ່ໃຈບໍ່ວ່າຈະລຶບການເຊື່ອມຕໍ່ "

#. Check for incomplete configuration
#: src/lib/vpn/main_dialog.rb:146
msgid "Please complete configuration for the following connections:\n"
msgstr "ກະລຸນາຕັ້ງຄ່າໃຫ້ສຳເລັດສຳລັບການເຊື່ອມຕໍ່ດັ່ງຕໍ່ໄປນີ້:\n"

#. Consider enabling the daemon
#: src/lib/vpn/main_dialog.rb:153
msgid ""
"There are VPN connections but the daemon is not enabled.\n"
"Would you like to enable the VPN daemon?"
msgstr ""
"ມີການເຊື່ອມຕໍ່ VPN ແຕ່ເດມອນຍັງບໍ່ໄດ້ຖືກເປີດໃຊ້.\n"
"ທ່ານຕ້ອງການເປີດໃຊ້ງານເດມອນ VPN ບໍ່?"

#. Ask user whether he wants to view daemon log
#: src/lib/vpn/main_dialog.rb:174
msgid "Settings have been successfully applied."
msgstr "ນຳໃຊ້ການຕັ້ງຄ່າສຳເລັດແລ້ວ."

#: src/lib/vpn/main_dialog.rb:176
msgid "Failed to configure IPSec daemon."
msgstr "ບໍ່ສາມາດຕັ້ງຄ່າເດມອນ IPSec ໄດ້."

#: src/lib/vpn/main_dialog.rb:179
msgid "Would you like to view daemon log and connection status?"
msgstr "ທ່ານຕ້ອງການເບິ່ງບັນທຶກເດມອນ ແລະ ສະຖານະການເຊື່ອມຕໍ່ບໍ່?"

#. Open dialog to edit VPN client passwords/certificates.
#: src/lib/vpn/main_dialog.rb:292
msgid "Please enter gateway IP before editing credentials."
msgstr "ກະລຸນາປ້ອນ IP ຂອງປະຕູເຊື່ອມຕໍ່ກ່ອນທີ່ຈະແກ້ໄຂຂໍ້ມູນການເຂົ້າລະບົບ."

#. Render a table of configured gateway and client connections.
#: src/lib/vpn/main_dialog.rb:368
msgid "Name"
msgstr "ຊື່"

#: src/lib/vpn/main_dialog.rb:368
msgid "Description"
msgstr "ຄຳອະທິບາຍ"

#. Render configuration controls for the chosen connection.
#: src/lib/vpn/main_dialog.rb:383
msgid "Click 'New VPN' to create a gateway or client."
msgstr "ຄລິກ 'ສ້າງ VPN ໃໝ່' ເພື່ອສ້າງປະຕູເຊື່ອມຕໍ່ ຫຼື ລູກຂ່າຍ."

#. Make widgets for connection configuration
#: src/lib/vpn/main_dialog.rb:393
msgid "All IPv4 networks (0.0.0.0/0)"
msgstr "ເຄືອຂ່າຍ IPv4 ທັງໝົດ (0.0.0.0/0)"

#: src/lib/vpn/main_dialog.rb:394
msgid "All IPv6 networks (::/0)"
msgstr "ເຄືອຂ່າຍ IPv6 ທັງໝົດ (::/0)"

#: src/lib/vpn/main_dialog.rb:396
msgid "Limited CIDRs, comma separated:"
msgstr "CIDR ທີ່ຈຳກັດ, ແຍກດ້ວຍຈຸດ:"

#: src/lib/vpn/main_dialog.rb:402
msgid "Connection name: "
msgstr "ຊື່ການເຊື່ອມຕໍ່: "

#: src/lib/vpn/main_dialog.rb:403
msgid "Type"
msgstr "ປະເພດ"

#: src/lib/vpn/main_dialog.rb:405
msgid "Gateway (Server)"
msgstr "ປະຕູເຊື່ອມຕໍ່ (ເຊີບເວີ)"

#: src/lib/vpn/main_dialog.rb:406
msgid "Client"
msgstr "ລູກຂ່າຍ"

#: src/lib/vpn/main_dialog.rb:413
msgid "The scenario is"
msgstr "ຮູບແບບແມ່ນ"

#: src/lib/vpn/main_dialog.rb:415
msgid "Secure communication with a pre-shared key"
msgstr "ການສື່ສານທີ່ປອດໄພດ້ວຍກຸນແຈທີ່ແບ່ງປັນໄວ້ລ່ວງໜ້າ"

#: src/lib/vpn/main_dialog.rb:416
msgid "Secure communication with a certificate"
msgstr "ການສື່ສານທີ່ປອດໄພດ້ວຍໃບຢັ້ງຢືນ"

#: src/lib/vpn/main_dialog.rb:417
msgid "Provide access to Android, iOS, MacOS X clients"
msgstr "ໃຫ້ການເຂົ້າເຖິງແກ່ລູກຂ່າຍ Android, iOS, MacOS X"

#: src/lib/vpn/main_dialog.rb:418
msgid "Provide access to Windows 7, Windows 8 clients"
msgstr "ໃຫ້ການເຂົ້າເຖິງແກ່ລູກຂ່າຍ Windows 7, Windows 8"

#: src/lib/vpn/main_dialog.rb:420 src/lib/vpn/main_dialog.rb:434
msgid "Edit Credentials"
