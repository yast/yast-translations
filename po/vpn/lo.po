#: src/lib/vpn/main_dialog.rb:428
msgid "The gateway requires authentication"
msgstr "ປະຕູເຊື່ອມຕໍ່ຕ້ອງການການຢືນຢັນຕົວຕົນ"

#: src/lib/vpn/main_dialog.rb:430
msgid "By a pre-shared key"
msgstr "ໂດຍກຸນແຈທີ່ແບ່ງປັນໄວ້ລ່ວງໜ້າ"

#: src/lib/vpn/main_dialog.rb:431
msgid "By a certificate"
msgstr "ໂດຍໃບຢັ້ງຢືນ"

#: src/lib/vpn/main_dialog.rb:433
msgid "VPN gateway IP"
msgstr "IP ປະຕູເຊື່ອມຕໍ່ VPN"

#: src/lib/vpn/main_dialog.rb:437
msgid "Use the VPN tunnel to access"
msgstr "ໃຊ້ທໍ່ VPN ເພື່ອເຂົ້າເຖິງ"

#. They are however allowed in password
#: src/lib/vpn/new_user_dialog.rb:64
msgid "Please enter both username and password."
msgstr "ກະລຸນາປ້ອນທັງຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານ."

#: src/lib/vpn/new_user_dialog.rb:68
msgid ""
"Please refrain from using special characters and spaces in the username.\n"
"Acceptable characters are: A-Z, a-z, 0-9, dash, underscore"
msgstr ""
"ກະລຸນາຫຼີກເວັ້ນການໃຊ້ຕົວອັກສອນພິເສດ ແລະ ຍະຫວ່າງໃນຊື່ຜູ້ໃຊ້.\n"
"ຕົວອັກສອນທີ່ອະນຸຍາດຄື: A-Z, a-z, 0-9, ຂີດກາງ, ຂີດກ້ອງ"

#. Create a new VPN connection - by default it is a site-to-site gateway.
#: src/lib/vpn/new_vpn_dialog.rb:46
msgid "Please enter a name for the new VPN connection"
msgstr "ກະລຸນາປ້ອນຊື່ສຳລັບການເຊື່ອມຕໍ່ VPN ໃໝ່"

#. Return :ok if new VPN connection is created, otherwise :cancel.
#: src/lib/vpn/new_vpn_dialog.rb:58
msgid "Please enter a VPN connection name."
msgstr "ກະລຸນາປ້ອນຊື່ການເຊື່ອມຕໍ່ VPN."

#: src/lib/vpn/new_vpn_dialog.rb:62
msgid ""
"Please refrain from using special characters and spaces in the name.\n"
"Acceptable characters are: A-Z, a-z, 0-9, dash, underscore\n"
"Name has to begin with a letter."
msgstr ""
"ກະລຸນາຫຼີກເວັ້ນການໃຊ້ຕົວອັກສອນພິເສດ ແລະ ຍະຫວ່າງໃນຊື່.\n"
"ຕົວອັກສອນທີ່ອະນຸຍາດຄື: A-Z, a-z, 0-9, ຂີດກາງ, ຂີດກ້ອງ\n"
"ຊື່ຕ້ອງເລີ່ມຕົ້ນດ້ວຍຕົວອັກສອນ."

#. Ask for a new certificate/key combination for a VPN client
#: src/lib/vpn/set_client_cert_dialog.rb:49
msgid "Path to certificate file:"
msgstr "ເສັ້ນທາງໄປຫາໄຟລ໌ໃບຢັ້ງຢືນ:"

#: src/lib/vpn/set_client_cert_dialog.rb:52
msgid "Path to certificate key file:"
msgstr "ເສັ້ນທາງໄປຫາໄຟລ໌ກຸນແຈໃບຢັ້ງຢືນ:"

#: src/lib/vpn/set_client_cert_dialog.rb:54
msgid "Please do not store the key in the certificate file itself."
msgstr "ກະລຸນາຢ່າເກັບກຸນແຈໄວ້ໃນໄຟລ໌ໃບຢັ້ງຢືນເອງ."

#. Return tuple of certificate and certificate key locations.
#: src/lib/vpn/set_client_cert_dialog.rb:80
msgid "Please enter both certificate file and key file."
msgstr "ກະລຸນາປ້ອນທັງໄຟລ໌ໃບຢັ້ງຢືນ ແລະ ໄຟລ໌ກຸນແຈ."

#. Return password string.
#: src/lib/vpn/set_client_psk_dialog.rb:59
msgid "Please enter a password."
msgstr "ກະລຸນາປ້ອນລະຫັດຜ່ານ."

#. View log dialog displays current status about all IPSec connections.
#: src/lib/vpn/view_log_dialog.rb:47
msgid "VPN daemon status"
msgstr "ສະຖານະເດມອນ VPN"

#: src/lib/vpn/view_log_dialog.rb:48
msgid "All connection status"
msgstr "ສະຖານະການເຊື່ອມຕໍ່ທັງໝົດ"

#: src/lib/vpn/view_log_dialog.rb:49
msgid "The logs are refreshed automatically every 3 seconds."
msgstr "ບັນທຶກຈະຖືກໂຫຼດໃໝ່ອັດຕະໂນມັດທຸກໆ 3 ວິນາທີ."

#: src/lib/vpn/view_log_dialog.rb:51
