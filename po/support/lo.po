#. Read dialog help 1/2
#: src/include/support/helps.rb:36
msgid ""
"<p><b><big>Initializing Support Configuration</big></b><br>\n"
"</p>\n"
msgstr ""
"<p><b><big>ກຳລັງເລີ່ມຕົ້ນການຕັ້ງຄ່າການຊ່ວຍເຫຼືອ</big></b><br>\n"
"</p>\n"

#. Read dialog help 2/2
#: src/include/support/helps.rb:40
msgid ""
"<p><b><big>Aborting Initialization:</big></b><br>\n"
"Safely abort the configuration utility by pressing <b>Abort</b> now.</p>\n"
msgstr ""
"<p><b><big>ການຍົກເລີກການເລີ່ມຕົ້ນ:</big></b><br>\n"
"ຍົກເລີກເຄື່ອງມືການຕັ້ງຄ່າຢ່າງປອດໄພໂດຍການກົດ <b>ຍົກເລີກ</b> ດຽວນີ້.</p>\n"

#. Write dialog help 1/2
#: src/include/support/helps.rb:44
msgid ""
"<p><b><big>Saving Support Configuration</big></b><br>\n"
"</p>\n"
msgstr ""
"<p><b><big>ກຳລັງບັນທຶກການຕັ້ງຄ່າການຊ່ວຍເຫຼືອ</big></b><br>\n"
"</p>\n"

#. Write dialog help 2/2
#: src/include/support/helps.rb:48
msgid ""
"<p><b><big>Aborting Saving:</big></b><br>\n"
"Abort the save procedure by pressing <b>Abort</b>.\n"
"An additional dialog informs whether it is safe to do so.\n"
"</p>\n"
msgstr ""
"<p><b><big>ການຍົກເລີກການບັນທຶກ:</big></b><br>\n"
"ຍົກເລີກຂັ້ນຕອນການບັນທຶກໂດຍການກົດ <b>ຍົກເລີກ</b>.\n"
"ຈະມີກ່ອງໂຕ້ຕອບແຈ້ງເຕືອນວ່າສາມາດເຮັດໄດ້ຢ່າງປອດໄພຫຼືບໍ່.\n"
"</p>\n"

#. Summary dialog help 1/3
#: src/include/support/helps.rb:55
msgid ""
"<p><b><big>Support Configuration</big></b><br>\n"
"Configure support here.<br></p>\n"
msgstr ""
"<p><b><big>ການຕັ້ງຄ່າການຊ່ວຍເຫຼືອ</big></b><br>\n"
"ຕັ້ງຄ່າການຊ່ວຍເຫຼືອຢູ່ທີ່ນີ້.<br></p>\n"

#. Summary dialog help 2/3
#: src/include/support/helps.rb:59
msgid ""
"<p><b><big>Adding a support:</big></b><br>\n"
"Choose a support from the list of detected supports.\n"
"If your support was not detected, use <b>Other (not detected)</b>.\n"
"Then press <b>Configure</b>.</p>\n"
msgstr ""
"<p><b><big>ການເພີ່ມການຊ່ວຍເຫຼືອ:</big></b><br>\n"
"ເລືອກການຊ່ວຍເຫຼືອຈາກລາຍການທີ່ກວດພົບ.\n"
"ຖ້າຫາກບໍ່ພົບການຊ່ວຍເຫຼືອຂອງທ່ານ, ໃຫ້ໃຊ້ <b>ອື່ນໆ (ກວດບໍ່ພົບ)</b>.\n"
"ຈາກນັ້ນກົດ <b>ຕັ້ງຄ່າ</b>.</p>\n"

#. Summary dialog help 3/3
#: src/include/support/helps.rb:66
msgid ""
"<p><b><big>Editing or Deleting:</big></b><br>\n"
"If you press <b>Edit</b>, an additional dialog in which to change\n"
"the configuration opens.</p>\n"
msgstr ""
"<p><b><big>ການແກ້ໄຂ ຫຼື ລຶບ:</big></b><br>\n"
"ຖ້າຫາກທ່ານກົດ <b>ແກ້ໄຂ</b>, ຈະມີກ່ອງໂຕ້ຕອບເພີ່ມເຕີມເພື່ອປ່ຽນແປງ\n"
"ການຕັ້ງຄ່າເປີດຂຶ້ນມາ.</p>\n"

#. Ovreview dialog help 1/3
#: src/include/support/helps.rb:72
msgid ""
"\n"
"<p><b><big>Opening SUSE Support Center</big></b><br>\n"
"To start a Web browser that opens the SUSE Support Center Portal, use "
"<b>Open SUSE Support Center</b>.\n"
"You can then open a Service Request with Global Technical Support. Make sure "
"you write down\n"
"the Service Request number to include in the supportconfig data upload.</p>\n"
msgstr ""
"\n"
"<p><b><big>ການເປີດສູນການຊ່ວຍເຫຼືອ SUSE</big></b><br>\n"
"ເພື່ອເລີ່ມຕົ້ນເວັບເບຣົາເຊີສຳລັບເປີດພໍທໍສູນການຊ່ວຍເຫຼືອ SUSE, ໃຫ້ໃຊ້ <b>ເປີດສູນການຊ່ວຍເຫຼືອ SUSE</b>"
".\n"
"ຈາກນັ້ນທ່ານສາມາດເປີດການຮ້ອງຂໍການບໍລິການ (Service Request) ກັບຝ່າຍສະໜັບສະໜູນທາງເຕັກນິກທົ່ວໂລ"
"ກ. ກະລຸນາຈົດ\n"
"ໝາຍເລກການຮ້ອງຂໍການບໍລິການໄວ້ເພື່ອໃຊ້ໃນການອັບໂຫຼດຂໍ້ມູນ supportconfig.</p>\n"

#. Ovreview dialog help 2/3
#: src/include/support/helps.rb:80
msgid ""
"<p><b><big>Collecting Data</big></b><br>\n"
"To run the supportconfig data collection tool, use <b>Collect Data</b></p>"
msgstr ""
"<p><b><big>ການເກັບກຳຂໍ້ມູນ</big></b><br>\n"
"ເພື່ອໃຊ້ເຄື່ອງມືເກັບກຳຂໍ້ມູນ supportconfig, ໃຫ້ໃຊ້ <b>ເກັບກຳຂໍ້ມູນ</b></p>"

#. Ovreview dialog help 3/3
#: src/include/support/helps.rb:84
msgid ""
"<p><b><big>Uploading Collected Data</big></b><br>\n"
"To upload the data already collected to a server, use <b>Upload Data</b>.\n"
"The server may or may not be Global Technical Support.</p>"
msgstr ""
"<p><b><big>ການອັບໂຫຼດຂໍ້ມູນທີ່ເກັບກຳມາໄດ້</big></b><br>\n"
"ເພື່ອອັບໂຫຼດຂໍ້ມູນທີ່ເກັບກຳໄດ້ແລ້ວໄປຫາເຊີເວີ, ໃຫ້ໃຊ້ <b>ອັບໂຫຼດຂໍ້ມູນ</b>.\n"
"ເຊີເວີດັ່ງກ່າວອາດຈະແມ່ນ ຫຼື ບໍ່ແມ່ນຝ່າຍສະໜັບສະໜູນທາງເຕັກນິກທົ່ວໂລກກໍໄດ້.</p>"

#. Configure1 dialog help 1/3
#: src/include/support/helps.rb:90
msgid ""
"<p><b><big>Supportconfig Options</big></b><br>\n"
"Select an option to override the defaults. You can use the default "
"settings,\n"
"gather the most data or only gather a minimum amount of data."
msgstr ""
"<p><b><big>ຕົວເລືອກ Supportconfig</big></b><br>\n"
"ເລືອກຕົວເລືອກເພື່ອແທນທີ່ຄ່າເລີ່ມຕົ້ນ. ທ່ານສາມາດໃຊ້ຄ່າເລີ່ມຕົ້ນ,\n"
"ເກັບກຳຂໍ້ມູນໃຫ້ໄດ້ຫຼາຍທີ່ສຸດ ຫຼື ເກັບກຳຂໍ້ມູນພຽງແຕ່ສ່ວນທີ່ຈຳເປັນຕ່ຳສຸດ."

#. Configure1 dialog help 2/3
#: src/include/support/helps.rb:96
msgid ""
"<p><b><big>Expert Settings</big></b><br>\n"
"Select <b>Use Custom</b> and click the <b>Expert Settings</b> button\n"
"to select specific data sets to collect.</p>\n"
msgstr ""
"<p><b><big>ການຕັ້ງຄ່າແບບຊ່ຽວຊານ</big></b><br>\n"
"ເລືອກ <b>ໃຊ້ການກຳນົດເອງ</b> ແລະ ກົດປຸ່ມ <b>ການຕັ້ງຄ່າແບບຊ່ຽວຊານ</b>\n"
"ເພື່ອເລືອກຊຸດຂໍ້ມູນສະເພາະທີ່ຕ້ອງການເກັບກຳ.</p>\n"

#. Configure1 dialog help 3/3
#: src/include/support/helps.rb:102
msgid ""
"<p><b><big>Options</big></b><br>\n"
"Collect additional information. Usually these options are not\n"
"necessary, but can be included if circumstances require more information.</"
"p>\n"
msgstr ""
"<p><b><big>ຕົວເລືອກ</big></b><br>\n"
"ເກັບກຳຂໍ້ມູນເພີ່ມເຕີມ. ໂດຍປົກກະຕິຕົວເລືອກເຫຼົ່ານີ້ແມ່ນບໍ່\n"
"ຈຳເປັນ, ແຕ່ສາມາດລວມເອົາໄດ້ຖ້າຫາກສະຖານະການຕ້ອງການຂໍ້ມູນຫຼາຍຂຶ້ນ.</p>\n"

#. Expert dialog help 1/1
#: src/include/support/helps.rb:108
msgid ""
"<p><big><b>Default Options</b></big><br>\n"
"Select or deselect each of the data sets you would like to include in the "
"supportconfig tarball.</p>"
msgstr ""
"<p><big><b>ຕົວເລືອກເລີ່ມຕົ້ນ</b></big><br>\n"
"ເລືອກ ຫຼື ຍົກເລີກການເລືອກແຕ່ລະຊຸດຂໍ້ມູນທີ່ທ່ານຕ້ອງການລວມໄວ້ໃນໄຟລ໌ supportconfig tarball.</p>"

#. Contact dialog help 1/4
#: src/include/support/helps.rb:112
msgid ""
"<p><big><b>Contact Information</b></big><br>\n"
"Fill in each of the contact information fields that you would like to "
"include\n"
"in the supportconfig tarball. The fields are saved in the basic-environment."
"txt file.</p>"
msgstr ""
"<p><big><b>ຂໍ້ມູນຕິດຕໍ່</b></big><br>\n"
"ປ້ອນຂໍ້ມູນໃນແຕ່ລະຫ້ອງຂໍ້ມູນຕິດຕໍ່ທີ່ທ່ານຕ້ອງການລວມໄວ້\n"
"ໃນໄຟລ໌ supportconfig tarball. ຂໍ້ມູນເຫຼົ່ານີ້ຈະຖືກບັນທຶກໄວ້ໃນໄຟລ໌ basic-environment.txt.</"
"p>"

#. Contact dialog help 2/4
#: src/include/support/helps.rb:118
msgid ""
"<p><b><big>Upload Information</big></b><br>\n"
"The upload target is the supportconfig tarball's destination URI. Supported "
"upload services include\n"
"ftp, http, https, scp. If you need to include the supportconfig tarball "
"filename in your upload target,\n"
"use the <i>tarball</i> keyword. This will get replaced with the actual "
"tarball filename.\n"
"See <i>man supportconfig(1)</i> for further details.</p>"
msgstr ""
"<p><b><big>ຂໍ້ມູນການອັບໂຫຼດ</big></b><br>\n"
"ເປົ້າໝາຍການອັບໂຫຼດແມ່ນ URI ປາຍທາງຂອງໄຟລ໌ supportconfig tarball. ບໍລິການອັບໂຫຼດທີ່ຮອງຮັບລວມ"
"ມີ\n"
"ftp, http, https, scp. ຖ້າທ່ານຕ້ອງການລວມຊື່ໄຟລ໌ supportconfig tarball ເຂົ້າໃນເປົ້າໝາຍກາ"
"ນອັບໂຫຼດ,\n"
"ໃຫ້ໃຊ້ຄຳສຳຄັນ (keyword) <i>tarball</i>. ເຊິ່ງມັນຈະຖືກແທນທີ່ດ້ວຍຊື່ໄຟລ໌ tarball ຕົວຈິງ.\n"
"ເບິ່ງລາຍລະອຽດເພີ່ມເຕີມໄດ້ທີ່ <i>man supportconfig(1)</i>.</p>"

#. Contact dialog help 3/4
#: src/include/support/helps.rb:126
msgid ""
"<p><b><big>Upload Target Examples</big></b><br>\n"
"https://secure-www.novell.com/upload?appname=supportconfig&file=<i>tarball</"
"i><br>\n"
"ftp://ftp.novell.com/incoming<br>\n"
"scp://central.server.foo.com/supportconfig/archives</p>"
msgstr ""
"<p><b><big>ຕົວຢ່າງເປົ້າໝາຍການອັບໂຫຼດ</big></b><br>\n"
"https://secure-www.novell.com/upload?appname=supportconfig&file=<i>tarball</"
"i><br>\n"
"ftp://ftp.novell.com/incoming<br>\n"
"scp://central.server.foo.com/supportconfig/archives</p>"

#. Contact dialog help 4/4
#: src/include/support/helps.rb:133
msgid ""
"<p><b>Note:</b> If you are uploading a supportconfig tarball to Global "
"Technical Support,\n"
"make sure you include the service request number from your open service "
"request.\n"
msgstr ""
"<p><b>ໝາຍເຫດ:</b> ຖ້າຫາກທ່ານກຳລັງອັບໂຫຼດໄຟລ໌ supportconfig tarball ໄປຫາຝ່າຍສະໜັບສະໜູນທ"
"າງເຕັກນິກທົ່ວໂລກ,\n"
"ກະລຸນາແນ່ໃຈວ່າໄດ້ລວມເອົາໝາຍເລກການຮ້ອງຂໍການບໍລິການຈາກການຮ້ອງຂໍທີ່ທ່ານເປີດໄວ້.\n"

#. Collecting data dialkog help 1/1
#: src/include/support/helps.rb:137
msgid ""
"<p><b><big>Collecting Data</big></b>><br>\n"
"Data is being collected.</p>\n"
msgstr ""
"<p><b><big>ກຳລັງເກັບກຳຂໍ້ມູນ</big></b>><br>\n"
"ກຳລັງດຳເນີນການເກັບກຳຂໍ້ມູນ.</p>\n"

#. Data review dialog help 1/1
#: src/include/support/helps.rb:141
msgid ""
"<p><b><big>Collected Data Review</big></b><br>\n"
"Review the data collected by supportconfig. If you do not want to share some "
"of the collected data,\n"
"use <b>Remove from Data</b> and the selected file will be removed.</p>\n"
msgstr ""
"<p><b><big>ກວດສອບຂໍ້ມູນທີ່ເກັບກຳໄດ້</big></b><br>\n"
"ກວດສອບຂໍ້ມູນທີ່ເກັບກຳໂດຍ supportconfig. ຖ້າທ່ານບໍ່ຕ້ອງການແບ່ງປັນຂໍ້ມູນບາງສ່ວນ,\n"
"ໃຫ້ໃຊ້ <b>ລຶບອອກຈາກຂໍ້ມູນ</b> ແລະ ໄຟລ໌ທີ່ເລືອກຈະຖືກລຶບອອກ.</p>\n"

#. Configure1 dialog help 1/3
#: src/include/support/helps.rb:148
msgid ""
"<p><b><big>Upload supportconfig tarball to Global Technical Support</big></"
"b><br>\n"
"If you want to store a copy of the supportconfig tarball, select the target\n"
"directory and make sure that this option is checked.\n"
"<br></p>\n"
msgstr ""
"<p><b><big>ອັບໂຫຼດໄຟລ໌ supportconfig tarball ໄປຫາຝ່າຍສະໜັບສະໜູນທາງເຕັກນິກທົ່ວໂລກ</big>"
"</b><br>\n"
"ຖ້າທ່ານຕ້ອງການເກັບສຳເນົາໄຟລ໌ supportconfig tarball ໄວ້, ໃຫ້ເລືອກໂຟນເດີ\n"
"ເປົ້າໝາຍ ແລະ ແນ່ໃຈວ່າໄດ້ໝາຍເລືອກຕົວເລືອກນີ້.\n"
"<br></p>\n"

#. Configure1 dialog help 2/3
#. Configure1 dialog help 2/3
#: src/include/support/helps.rb:155 src/include/support/helps.rb:180
msgid ""
"<p><b><big>Upload URL</big></b><br>\n"
"This option has the location to which the supportconfig tarball will be "
"uploaded\n"
"as default value.\n"
"Change this value only in special cases.\n"
"</p>\n"
msgstr ""
"<p><b><big>URL ສຳລັບອັບໂຫຼດ</big></b><br>\n"
"ຕົວເລືອກນີ້ມີສະຖານທີ່ທີ່ຈະອັບໂຫຼດໄຟລ໌ supportconfig tarball ໄປຫາ\n"
"ເປັນຄ່າເລີ່ມຕົ້ນ.\n"
"ໃຫ້ປ່ຽນແປງຄ່ານີ້ສະເພາະໃນກໍລະນີພິເສດເທົ່ານັ້ນ.\n"
"</p>\n"

#. Configure1 dialog help 3/3, %1 is a URL
#. Configure1 dialog help 3/3
#: src/include/support/helps.rb:164 src/include/support/helps.rb:189
#, ycp-format
msgid ""
"<p><b><big>Privacy Policy</big></b><br>\n"
"Find SUSE's privacy policy at\n"
"<i>%1</i>.</p>\n"
msgstr ""
"<p><b><big>ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ</big></b><br>\n"
"ເບິ່ງນະໂຍບາຍຄວາມເປັນສ່ວນຕົວຂອງ SUSE ໄດ້ທີ່\n"
"<i>%1</i>.</p>\n"

#: src/include/support/helps.rb:173
msgid ""
"<p><b><big>Upload supportconfig tarball to Global Technical Support</big></"
"b><br>\n"
"If you have already created the supportconfig tarball, write the full path\n"
"into the <i>Package with log files</i> field.\n"
"<br></p>\n"
msgstr ""
"<p><b><big>ອັບໂຫຼດໄຟລ໌ supportconfig tarball ໄປຫາຝ່າຍສະໜັບສະໜູນທາງເຕັກນິກທົ່ວໂລກ</big>"
"</b><br>\n"
"ຖ້າທ່ານໄດ້ສ້າງໄຟລ໌ supportconfig tarball ແລ້ວ, ໃຫ້ພິມທີ່ຢູ່ໄຟລ໌ (path) ທັງໝົດ\n"
"ລົງໃນຫ້ອງ <i>ແພັກເກດທີ່ບັນຈຸໄຟລ໌ບັນທຶກ</i>.\n"
"<br></p>\n"

#. Configure2 dialog help 1/2
#: src/include/support/helps.rb:198
msgid ""
"<p><b><big>Configuration Part Two</big></b><br>\n"
"Press <b>Next</b> to continue.\n"
"<br></p>\n"
msgstr ""
"<p><b><big>ການຕັ້ງຄ່າສ່ວນທີສອງ</big></b><br>\n"
"ກົດ <b>ຖັດໄປ</b> ເພື່ອດຳເນີນການຕໍ່.\n"
"<br></p>\n"

#. Configure2 dialog help 2/2
#: src/include/support/helps.rb:204
msgid ""
"<p><b><big>Selecting Something</big></b><br>\n"
"It is not possible. You must code it first. :-)\n"
"</p>"
msgstr ""
"<p><b><big>ການເລືອກບາງສິ່ງ</big></b><br>\n"
"ມັນເປັນໄປບໍ່ໄດ້. ທ່ານຕ້ອງຂຽນໂຄ້ດມັນກ່ອນ. :-)\n"
"</p>"

