#. hint to error message
#: src/Ldap.rb:252
msgid "Verify that the LDAP Server is running and reachable."
msgstr "ກວດສອບວ່າເຊີເວີ LDAP ກຳລັງເຮັດວຽກ ແລະ ສາມາດເຊື່ອມຕໍ່ໄດ້."

#. hint to error message
#: src/Ldap.rb:256
msgid ""
"Failed to establish TLS encryption.\n"
"Verify that the correct CA Certificate is installed and the Server "
"Certificate is valid."
msgstr ""
"ບໍ່ສາມາດສ້າງການເຂົ້າລະຫັດ TLS ໄດ້.\n"
"ກວດສອບວ່າໄດ້ຕິດຕັ້ງໃບຢັ້ງຢືນ CA ທີ່ຖືກຕ້ອງແລ້ວ ແລະ ໃບຢັ້ງຢືນເຊີເວີຍັງໃຊ້ງານໄດ້."

#. hint to error message
#: src/Ldap.rb:260
msgid ""
"Failed to establish TLS encryption.\n"
"Verify that the Server has StartTLS support enabled."
msgstr ""
"ບໍ່ສາມາດສ້າງການເຂົ້າລະຫັດ TLS ໄດ້.\n"
"ກວດສອບວ່າເຊີເວີໄດ້ເປີດການຮອງຮັບ StartTLS ແລ້ວ."

#. error message:
#: src/Ldap.rb:537
msgid ""
"\n"
"The server could be down or unreachable.\n"
msgstr ""
"\n"
"ເຊີເວີອາດຈະປິດຢູ່ ຫຼື ບໍ່ສາມາດເຊື່ອມຕໍ່ໄດ້.\n"

#. error message:
#: src/Ldap.rb:541
msgid ""
"\n"
"The value of DN is missing or invalid.\n"
msgstr ""
"\n"
"ຄ່າຂອງ DN ຫາຍໄປ ຫຼື ບໍ່ຖືກຕ້ອງ.\n"

#. error message:
#: src/Ldap.rb:545
msgid ""
"\n"
"Attribute type not found.\n"
msgstr ""
"\n"
"ບໍ່ພົບປະເພດຄຸນລັກສະນະ.\n"

#. error message:
#: src/Ldap.rb:547
msgid ""
"\n"
"Object class not found.\n"
msgstr ""
"\n"
"ບໍ່ພົບຄລາສຂອງວັດຖຸ.\n"

#. error message, more specific description follows
#. error message
#. error message
#: src/Ldap.rb:552 src/Ldap.rb:789 src/Ldap.rb:855
msgid "Connection to the LDAP server cannot be established."
msgstr "ບໍ່ສາມາດສ້າງການເຊື່ອມຕໍ່ກັບເຊີເວີ LDAP ໄດ້."

#. error message, more specific description follows
#: src/Ldap.rb:556
msgid "A problem occurred while connecting to the LDAP server."
msgstr "ເກີດບັນຫາຂະນະທີ່ກຳລັງເຊື່ອມຕໍ່ກັບເຊີເວີ LDAP."

#. error message, more specific description follows
#: src/Ldap.rb:560
msgid "A problem occurred while reading data from the LDAP server."
msgstr "ເກີດບັນຫາຂະນະທີ່ກຳລັງອ່ານຂໍ້ມູນຈາກເຊີເວີ LDAP."

#. error message, more specific description follows
#: src/Ldap.rb:564
msgid "A problem occurred while writing LDAP users."
msgstr "ເກີດບັນຫາຂະນະທີ່ກຳລັງຂຽນຂໍ້ມູນຜູ້ໃຊ້ LDAP."

#. error message, more specific description follows
#: src/Ldap.rb:568
msgid "A problem occurred while writing LDAP groups."
msgstr "ເກີດບັນຫາຂະນະທີ່ກຳລັງຂຽນຂໍ້ມູນກຸ່ມ LDAP."

#. error message, more specific description follows
#: src/Ldap.rb:572
msgid "A problem occurred while writing data to the LDAP server."
msgstr "ເກີດບັນຫາຂະນະທີ່ກຳລັງຂຽນຂໍ້ມູນລົງໃນເຊີເວີ LDAP."

#. error message, more specific description follows
#: src/Ldap.rb:576
msgid "A problem occurred while reading schema from the LDAP server."
msgstr "ເກີດບັນຫາຂະນະທີ່ກຳລັງອ່ານ Schema ຈາກເຊີເວີ LDAP."

#. default error message
#: src/Ldap.rb:601
msgid "An unknown LDAP error occurred."
msgstr "ເກີດຂໍ້ຜິດພາດ LDAP ທີ່ບໍ່ຮູ້ຈັກ."

#. checkbox label
#. checkbox label
#. checkbox label
#: src/Ldap.rb:611 src/Ldap.rb:798 src/Ldap.rb:864
msgid "&Show Details"
msgstr "ສະແດງລາຍລະອຽດ (&S)"

#. error message
#. error message
#. error message
#: src/Ldap.rb:729 src/Ldap.rb:749 src/Ldap.rb:919
msgid "Unknown error. Perhaps 'yast2-ldap' is not available."
msgstr "ຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກ. ບາງທີ 'yast2-ldap' ອາດບໍ່ພ້ອມໃຊ້ງານ."

#. question following error message (yes/no buttons follow)
#: src/Ldap.rb:807
msgid "Really keep this configuration?"
msgstr "ຕ້ອງການເກັບການຕັ້ງຄ່ານີ້ໄວ້ແທ້ບໍ?"

#. question following error message (yes/no buttons follow)
#: src/Ldap.rb:872
msgid ""
"A possible reason for the failed connection may be that your client is\n"
"configured for TLS/SSL but the server does not support it.\n"
"\n"
"Retry connection without TLS/SSL?\n"
msgstr ""
"ສາເຫດທີ່ອາດເປັນໄປໄດ້ຂອງການເຊື່ອມຕໍ່ຫຼົ້ມເຫຼວແມ່ນ ເຄື່ອງລູກຂ່າຍຂອງທ່ານ\n"
"ຖືກຕັ້ງຄ່າສຳລັບ TLS/SSL ແຕ່ເຊີເວີບໍ່ຮອງຮັບ.\n"
"\n"
"ລອງເຊື່ອມຕໍ່ໃໝ່ໂດຍບໍ່ໃຊ້ TLS/SSL ບໍ?\n"

#. Asks user for bind_dn and password to LDAP server
#. @param anonymous if anonymous access could be allowed
#. @return password
#: src/Ldap.rb:980
msgid "BindDN"
msgstr "BindDN"

#. password entering label
#. password entering label
#: src/Ldap.rb:982 src/ldap_browser.rb:155
msgid "&LDAP Server Password"
msgstr "ລະຫັດຜ່ານເຊີເວີ LDAP (&L)"

#. label
#: src/Ldap.rb:986
#, ycp-format
msgid "Server: %1:%2"
msgstr "ເຊີເວີ: %1:%2"

#. button label
#: src/Ldap.rb:995
msgid "&Anonymous Access"
msgstr "ການເຂົ້າເຖິງແບບບໍ່ລະບຸຕົວຕົນ (&A)"

#. error message, %1 is DN
#: src/Ldap.rb:1337
#, ycp-format
msgid ""
"A direct parent for DN '%1' \n"
"does not exist in the LDAP directory.\n"
"The object with the selected DN cannot be created.\n"
msgstr ""
"ບໍ່ມີ Parent ໂດຍກົງສຳລັບ DN '%1' \n"
"ຢູ່ໃນໄດເຣັກທໍຣີ LDAP.\n"
"ບໍ່ສາມາດສ້າງວັດຖຸດ້ວຍ DN ທີ່ເລືອກໄດ້.\n"

#. error message
#: src/Ldap.rb:1438
msgid ""
"An object with the selected DN exists, but it is not a template object.\n"
"Select another one.\n"
msgstr ""
"ມີວັດຖຸທີ່ມີ DN ທີ່ເລືອກໄວ້ແລ້ວ, ແຕ່ມັນບໍ່ແມ່ນວັດຖຸແມ່ແບບ.\n"
"ກະລຸນາເລືອກອັນອື່ນ.\n"

#. yes/no popup, %1 is value of DN
#: src/Ldap.rb:1724
#, ycp-format
msgid ""
"No entry with DN '%1'\n"
"exists on the LDAP server. Create it now?\n"
msgstr ""
"ບໍ່ມີລາຍການທີ່ມີ DN '%1'\n"
"ຢູ່ໃນເຊີເວີ LDAP. ຕ້ອງການສ້າງດຽວນີ້ເລີຍບໍ?\n"

#. button label
#. button label
#: src/LdapPopup.rb:75 src/ldap_browser.rb:547
msgid "&Open"
msgstr "ເປີດ (&O)"

#. help text 1/3
#: src/LdapPopup.rb:262
msgid "<p>Set the new value for the current attribute.</p>"
msgstr "<p>ກຳນົດຄ່າໃໝ່ສຳລັບຄຸນລັກສະນະປັດຈຸບັນ.</p>"

#. help text 2/3
#: src/LdapPopup.rb:264
msgid ""
"<p>If the attribute can have more values, add new entries\n"
"with <b>Add Value</b>. Sometimes the button contains the list of\n"
"possible values to use for the current attribute.\n"
"If the value of the edited attribute should be a distinguished name (DN),\n"
"it is possible to choose it from the LDAP tree using <b>Browse</b>.\n"
"</p>\n"
msgstr ""
"<p>ຖ້າຄຸນລັກສະນະສາມາດມີໄດ້ຫຼາຍຄ່າ, ໃຫ້ເພີ່ມລາຍການໃໝ່\n"
"ດ້ວຍ <b>ເພີ່ມຄ່າ</b>. ບາງຄັ້ງປຸ່ມຈະມີລາຍຊື່ຂອງ\n"
"ຄ່າທີ່ເປັນໄປໄດ້ເພື່ອໃຊ້ສຳລັບຄຸນລັກສະນະປັດຈຸບັນ.\n"
"ຖ້າຄ່າຂອງຄຸນລັກສະນະທີ່ແກ້ໄຂຄວນເປັນຊື່ຈຳແນກ (DN),\n"
"ທ່ານສາມາດເລືອກມັນໄດ້ຈາກ LDAP tree ໂດຍໃຊ້ <b>ເບິ່ງຜ່ານ</b>.\n"
"</p>\n"

