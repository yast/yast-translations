msgstr "ຕ້ອງຕັ້ງຄ່າເນມເຊີເວີ NS ຢ່າງໜ້ອຍໜຶ່ງອັນ."

#. warning message, %1 is replaced with a zone name
#.
#. Automatically Generate Records From is a feature that makes YaST to generate
#. DNS records manually from selected zone
#: src/include/dns-server/dialog-masterzone.rb:2594
#, ycp-format
msgid ""
"Current zone records are automatically generated from %1 zone.\n"
"To change records manually disable the Automatically Generate Records From "
"feature."
msgstr ""
"ບັນທຶກເຂດປັດຈຸບັນຖືກສ້າງຂຶ້ນໂດຍອັດຕະໂນມັດຈາກເຂດ %1.\n"
"ຫາກຕ້ອງການປ່ຽນບັນທຶກດ້ວຍຕົນເອງ ໃຫ້ປິດຄຸນສົມບັດ 'ສ້າງບັນທຶກໂດຍອັດຕະໂນມັດຈາກ'."

#. TRANSLATORS: Text entry
#: src/include/dns-server/dialog-masterzone.rb:2682
msgid "&Primary DNS Server IP"
msgstr "IP ຂອງເຊີເວີ DNS &ຫຼັກ"

#. TRANSLATORS: Popup error headline
#. TRANSLATORS: Primary is new name for Master (zone)
#: src/include/dns-server/dialog-masterzone.rb:2747
msgid "Missing Primary Server"
msgstr "ຂາດເຊີເວີຫຼັກ"

#. TRANSLATORS: Popup error text
#: src/include/dns-server/dialog-masterzone.rb:2749
msgid ""
"Every secondary zone must have its primary server IP defined.\n"
"Configuration of a DNS server without a primary server would fail.\n"
"If you continue, the current zone will be removed."
msgstr ""
"ທຸກໆເຂດສຳຮອງຕ້ອງມີການກຳນົດ IP ຂອງເຊີເວີຫຼັກ.\n"
"ການກຳນົດຄ່າເຊີເວີ DNS ໂດຍບໍ່ມີເຊີເວີຫຼັກຈະຫຼົ້ມເຫຼວ.\n"
"ຫາກທ່ານດຳເນີນການຕໍ່, ເຂດປັດຈຸບັນຈະຖືກລຶບອອກ."

#. TRANSLATORS: A popup error message
#: src/include/dns-server/dialog-masterzone.rb:2769
msgid "No primary DNS server defined."
msgstr "ບໍ່ໄດ້ກຳນົດເຊີເວີ DNS ຫຼັກ."

#. A popup error message
#: src/include/dns-server/dialog-masterzone.rb:2781
msgid "The specified primary name server is not a valid IP address."
msgstr "ເນມເຊີເວີຫຼັກທີ່ລະບຸບໍ່ແມ່ນທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງ."

#. Textentry - adding forwarder
#: src/include/dns-server/dialog-masterzone.rb:2892
msgid "New &Forwarder IP Address"
msgstr "&ທີ່ຢູ່ IP ຂອງຜູ້ສົ່ງຕໍ່ໃໝ່"

#. Selectionbox - listing current forwarders
#: src/include/dns-server/dialog-masterzone.rb:2917
msgid "Current &Zone Forwarders"
msgstr "ຜູ້ສົ່ງຕໍ່ເ&ຂດປັດຈຸບັນ"

#. dialog caption
#: src/include/dns-server/dialog-masterzone.rb:2939
msgid "Forward Zone Editor"
msgstr "ຕົວແກ້ໄຂເຂດສົ່ງຕໍ່"

#. TRANSLATORS: popup question
#: src/include/dns-server/dialog-masterzone.rb:2975
msgid ""
"This forward zone has no forwarders defined, which means\n"
"that all DNS queries for this zone are denied.\n"
"Really deny these queries?"
msgstr ""
"ເຂດສົ່ງຕໍ່ນີ້ບໍ່ໄດ້ກຳນົດຜູ້ສົ່ງຕໍ່ໄວ້, ເຊິ່ງໝາຍຄວາມວ່າ\n"
"ການສອບຖາມ DNS ທັງໝົດສຳລັບເຂດນີ້ຈະຖືກປະຕິເສດ.\n"
"ຕ້ອງການປະຕິເສດການສອບຖາມເຫຼົ່ານີ້ແທ້ຫຼືບໍ່?"

#. yes-no popup
#: src/include/dns-server/dialogs.rb:34
msgid ""
"All changes will be lost.\n"
"Really exit?"
msgstr ""
"ການປ່ຽນແປງທັງໝົດຈະສູນຫາຍ.\n"
"ຕ້ອງການອອກແທ້ຫຼືບໍ່?"

#. message popup
#: src/include/dns-server/dialogs.rb:81
msgid "A zone of this type cannot be edited with this tool."
msgstr "ເຂດປະເພດນີ້ບໍ່ສາມາດແກ້ໄຂໄດ້ດ້ວຍເຄື່ອງມືນີ້."

#. Read dialog help 1/2
#: src/include/dns-server/helps.rb:20
msgid ""
"<p><b><big>Initializing DNS Server Configuration</big></b><br>\n"
"Please wait...<br></p>"
msgstr ""
"<p><b><big>ກຳລັງເລີ່ມຕົ້ນການກຳນົດຄ່າເຊີເວີ DNS</big></b><br>\n"
"ກະລຸນາລໍຖ້າ...<br></p>"

#. Read dialog help 2/2
#: src/include/dns-server/helps.rb:24
msgid ""
"<p><b><big>Aborting Initialization</big></b><br>\n"
"Safely abort the configuration utility by pressing <b>Abort</b> now.</p>"
msgstr ""
"<p><b><big>ກຳລັງຍົກເລີກການເລີ່ມຕົ້ນ</big></b><br>\n"
"ຍົກເລີກການໃຊ້ງານເຄື່ອງມືກຳນົດຄ່າໄດ້ຢ່າງປອດໄພໂດຍການກົດ <b>ຍົກເລີກ</b> ດຽວນີ້.</p>"

#. Write dialog help 1/2
#: src/include/dns-server/helps.rb:28
msgid ""
"<p><b><big>Saving DNS Server Configuration</big></b><br>\n"
"Please wait...<br></p>"
msgstr ""
"<p><b><big>ກຳລັງບັນທຶກການກຳນົດຄ່າເຊີເວີ DNS</big></b><br>\n"
"ກະລຸນາລໍຖ້າ...<br></p>"

#. Write dialog help 2/2
#: src/include/dns-server/helps.rb:32
msgid ""
"<p><b><big>Aborting Saving</big></b><br>\n"
"Abort the save procedure by pressing <b>Abort</b>.\n"
"An additional dialog informs you whether it is safe to do so.</p>"
msgstr ""
"<p><b><big>ກຳລັງຍົກເລີກການບັນທຶກ</big></b><br>\n"
"ຍົກເລີກຂັ້ນຕອນການບັນທຶກໂດຍການກົດ <b>ຍົກເລີກ</b>.\n"
"ຈະມີກ່ອງຂໍ້ຄວາມແຈ້ງໃຫ້ທ່ານຮູ້ວ່າມັນປອດໄພທີ່ຈະເຮັດແນວນັ້ນຫຼືບໍ່.</p>"

#. zone dialog
#. help 1/5
#: src/include/dns-server/helps.rb:39
msgid ""
"<p><b><big>Zone Name</big></b><br>\n"
"Enter the name of the zone (domain) in <b>Zone Name</b>.</p>"
msgstr ""
"<p><b><big>ຊື່ເຂດ</big></b><br>\n"
"ປ້ອນຊື່ຂອງເຂດ (ໂດເມນ) ໃນ <b>ຊື່ເຂດ</b>.</p>"

#. help 2/5, alt. 1
#: src/include/dns-server/helps.rb:43
msgid ""
"<p><b><big>Dynamic DNS Zone Updates</big></b><br>\n"
"The zone can be updated automatically, usually because of dynamically\n"
"assigned IP addresses by DHCP server. To allow DDNS updates, set\n"
"<b>Allow Dynamic Updates</b> and the <b>TSIG Key</b>\n"
"to use for authentication. The key must be the same for\n"
"both DHCP and DNS servers.</p>"
msgstr ""
"<p><b><big>ການອັບເດດເຂດ DNS ແບບໄດນາມິກ</big></b><br>\n"
"ເຂດສາມາດຖືກອັບເດດໄດ້ໂດຍອັດຕະໂນມັດ, ໂດຍປົກກະຕິແລ້ວແມ່ນຍ້ອນມີການກຳນົດ\n"
"ທີ່ຢູ່ IP ແບບໄດນາມິກໂດຍເຊີເວີ DHCP. ເພື່ອອະນຸຍາດໃຫ້ອັບເດດ DDNS, ໃຫ້ຕັ້ງຄ່າ\n"
"<b>ອະນຸຍາດໃຫ້ອັບເດດແບບໄດນາມິກ</b> ແລະ <b>ຄີ (Key) TSIG</b>\n"
"ທີ່ຈະໃຊ້ສຳລັບການຢືນຢັນຕົວຕົນ. ຄີຕ້ອງເປັນຄີດຽວກັນທັງ\n"
"ເຊີເວີ DHCP ແລະ DNS.</p>"

#. help 3/5, only for alt. 1
#: src/include/dns-server/helps.rb:52
msgid ""
"<p><b><big>Editing a DNS Zone</big></b><br>\n"
"To edit the zone settings, choose the appropriate\n"
"entry of the table then click <b>Edit</b>.</p>"
msgstr ""
"<p><b><big>ການແກ້ໄຂເຂດ DNS</big></b><br>\n"
"ຫາກຕ້ອງການແກ້ໄຂການຕັ້ງຄ່າເຂດ, ໃຫ້ເລືອກລາຍການທີ່ເໝາະສົມ\n"
"ໃນຕາຕະລາງ ແລ້ວກົດ <b>ແກ້ໄຂ</b>.</p>"

#. help 4/5, only for alt. 1
#: src/include/dns-server/helps.rb:58
msgid ""
"<p>To add a new record to the zone, click <b>Add</b>. To remove\n"
"a record, select it and click <b>Delete</b>.</p>"
msgstr ""
"<p>ຫາກຕ້ອງການເພີ່ມບັນທຶກໃໝ່ໃນເຂດ, ໃຫ້ກົດ <b>ເພີ່ມ</b>. ຫາກຕ້ອງການລຶບ\n"
"ບັນທຶກ, ໃຫ້ເລືອກມັນແລ້ວກົດ <b>ລຶບ</b>.</p>"

#. help 5/5, only for alt. 1
#: src/include/dns-server/helps.rb:62
msgid ""
"<p><b><big>SOA Record</big></b><br>\n"
"To edit the SOA (Start of Authority) record of the zone, click\n"
"<b>Edit SOA</b>.</p>"
msgstr ""
"<p><b><big>ບັນທຶກ SOA</big></b><br>\n"
"ຫາກຕ້ອງການແກ້ໄຂບັນທຶກ SOA (Start of Authority) ຂອງເຂດ, ໃຫ້ກົດ\n"
"<b>ແກ້ໄຂ SOA</b>.</p>"

#. help 2/5 alt. 2
#: src/include/dns-server/helps.rb:68
msgid ""
"<p><b><big>Primary Servers</big></b><br>\n"
"Set the IP addresses of the primary name servers for this zone. Use <b>Add</"
"b>\n"
"to add a new primary name server. Select an existing one then click "
"<b>Delete</b>\n"
"to remove an existing one.</p>"
msgstr ""
"<p><b><big>ເຊີເວີຫຼັກ</big></b><br>\n"
"ຕັ້ງຄ່າທີ່ຢູ່ IP ຂອງເນມເຊີເວີຫຼັກສຳລັບເຂດນີ້. ໃຊ້ <b>ເພີ່ມ</b>\n"
"ເພື່ອເພີ່ມເນມເຊີເວີຫຼັກໃໝ່. ເລືອກອັນທີ່ມີຢູ່ແລ້ວກົດ <b>ລຶບ</b>\n"
"ເພື່ອລຶບອັນນັ້ນອອກ.</p>"

#. help 1/2
#: src/include/dns-server/helps.rb:75
msgid ""
"<p><b><big>Zone Type</big></b><br>\n"
"To make this name server the primary source of the data of the zone,\n"
"select <b>Primary</b>. To make it the secondary name server, select "
"<b>Secondary</b>\n"
"or <b>Stub</b>, so the data of the zone will be mirrored from the primary\n"
"server.</p>"
msgstr ""
"<p><b><big>ປະເພດເຂດ</big></b><br>\n"
"ຫາກຕ້ອງການໃຫ້ເນມເຊີເວີນີ້ເປັນແຫຼ່ງຂໍ້ມູນຫຼັກຂອງເຂດ,\n"
"ໃຫ້ເລືອກ <b>ຫຼັກ (Primary)</b>. ຫາກຕ້ອງການໃຫ້ມັນເປັນເນມເຊີເວີສຳຮອງ, ໃຫ້ເລືອກ <b>ສຳຮອງ "
"(Secondary)</b>\n"
"ຫຼື <b>Stub</b>, ເພື່ອໃຫ້ຂໍ້ມູນຂອງເຂດຖືກຄັດລອກມາຈາກເຊີເວີ\n"
"ຫຼັກ.</p>"

#. help 2/2
#: src/include/dns-server/helps.rb:83
msgid ""
"<p><b><big>Zone Direction</big></b><br>\n"
"DNS is used both for translating from domain names to IP addresses and "
"back.\n"
"Select if this zone will be used to translate from domain names to IP\n"
"addresses (<b>Forward</b>) or from IP addresses to domain names\n"
"(<b>Reverse</b>).</p>\n"
msgstr ""
"<p><b><big>ທິດທາງຂອງເຂດ</big></b><br>\n"
"DNS ຖືກໃຊ້ທັງໃນການແປຈາກຊື່ໂດເມນເປັນທີ່ຢູ່ IP ແລະ ໃນທາງກັບກັນ.\n"
"ເລືອກວ່າເຂດນີ້ຈະຖືກໃຊ້ເພື່ອແປຈາກຊື່ໂດເມນເປັນທີ່ຢູ່\n"
"IP (<b>ສົ່ງຕໍ່ (Forward)</b>) ຫຼື ຈາກທີ່ຢູ່ IP ເປັນຊື່ໂດເມນ\n"
"(<b>ແປກັບ (Reverse)</b>).</p>\n"

#. firewall dialog
#. help text 1/2
#: src/include/dns-server/helps.rb:92
msgid ""
"<p><b><big>Interface Classes</big></b><br>\n"
"Select which interface classes should have access to the DNS server. The\n"
"interface classes are defined in the firewall configuration component.</p>\n"
msgstr ""
"<p><b><big>ຄລາສຂອງອິນເຕີເຟສ</big></b><br>\n"
"ເລືອກຄລາສຂອງອິນເຕີເຟສ (Interface classes) ທີ່ຄວນຈະເຂົ້າເຖິງເຊີເວີ DNS ໄດ້.\n"
"ຄລາສເຫຼົ່ານີ້ຖືກກຳນົດໄວ້ໃນສ່ວນປະກອບການກຳນົດຄ່າໄຟວໍ.</p>\n"

#. help text 2/2
#: src/include/dns-server/helps.rb:98
msgid ""
"<p><b><big>Adapting Firewall Settings</big></b><br>\n"
"To adapt the firewall settings so that the DNS server can be accessed\n"
"via all network interfaces to which it listens, check\n"
"<b>Adapt Firewall Settings</b>.</p>\n"
msgstr ""
"<p><b><big>ການປັບປ່ຽນການຕັ້ງຄ່າໄຟວໍ</big></b><br>\n"
"ຫາກຕ້ອງການປັບປ່ຽນການຕັ້ງຄ່າໄຟວໍເພື່ອໃຫ້ສາມາດເຂົ້າເຖິງເຊີເວີ DNS ໄດ້\n"
"ຜ່ານທຸກອິນເຕີເຟສເຄືອຂ່າຍທີ່ມັນກຳລັງລໍຖ້າການເຊື່ອມຕໍ່, ໃຫ້ໝາຍເລືອກ\n"
"<b>ປັບປ່ຽນການຕັ້ງຄ່າໄຟວໍ</b>.</p>\n"

#. soa dialog
#. help text 1/9
#. Zone Editor - Help for tab - Zone (SOA) 1/7
#: src/include/dns-server/helps.rb:106 src/include/dns-server/helps.rb:355
msgid ""
"<p><b><big>SOA Record Configuration</big></b><br>\n"
"Set the entries of the SOA record.</p>"
msgstr ""
"<p><b><big>ການກຳນົດຄ່າບັນທຶກ SOA</big></b><br>\n"
"ຕັ້ງຄ່າລາຍການຕ່າງໆຂອງບັນທຶກ SOA.</p>"

#. help text 2/9 - TTL
#: src/include/dns-server/helps.rb:110
msgid ""
"<p><b>$TTL</b> specifies the time to live for all records in the\n"
"zone that do not have an explicit TTL.</p>"
msgstr ""
"<p><b>$TTL</b> ລະບຸໄລຍະເວລາຄົງຢູ່ (time to live) ສຳລັບບັນທຶກທັງໝົດໃນ\n"
"ເຂດທີ່ບໍ່ໄດ້ມີການກຳນົດ TTL ໄວ້ຢ່າງຊັດເຈນ.</p>"

#. help text 3/9 - Primary source
#: src/include/dns-server/helps.rb:114
msgid ""
"<p><b>Primary Source</b> must contain the fully qualified domain name\n"
"of the primary name server.</p>"
msgstr ""
"<p><b>ແຫຼ່ງຂໍ້ມູນຫຼັກ</b> ຕ້ອງມີຊື່ໂດເມນແບບເຕັມ\n"
"ຂອງເນມເຊີເວີຫຼັກ.</p>"

#. help text 4/9 - Administrator's mail
#: src/include/dns-server/helps.rb:118
msgid ""
"<p><b>Administrator's Mail</b> must contain the e-mail address of\n"
"the administrator responsible for the zone.</p>\n"
msgstr ""
"<p><b>ເມລຂອງຜູ້ດູແລລະບົບ</b> ຕ້ອງມີທີ່ຢູ່ອີເມລຂອງ\n"
"ຜູ້ດູແລທີ່ຮັບຜິດຊອບສຳລັບເຂດນີ້.</p>\n"

#. help text 5/9 - Serial
#: src/include/dns-server/helps.rb:122
msgid ""
"<p><b>Serial</b> number is used for determining if the zone has changed on\n"
"the primary servers (so that secondary servers do not always need to "
"synchronize the\n"
"entire zone).</p>\n"
msgstr ""
"<p>ໝາຍເລກ <b>ຊີຣຽວ (Serial)</b> ຖືກໃຊ້ເພື່ອພິຈາລະນາວ່າມີການປ່ຽນແປງໃນເຂດຢູ່\n"
"ເຊີເວີຫຼັກຫຼືບໍ່ (ເພື່ອໃຫ້ເຊີເວີສຳຮອງບໍ່ຈຳເປັນຕ້ອງຊິງໂຄຣໄນ\n"
"ຂໍ້ມູນທັງໝົດຂອງເຂດຕະຫຼອດເວລາ).</p>\n"

#. help text 6/9 - Refresh
#. Zone Editor - Help for tab - Zone (SOA) 4/7
#: src/include/dns-server/helps.rb:128 src/include/dns-server/helps.rb:370
msgid ""
"<p><b>Refresh</b> sets how often the zone should be synchronized from\n"
"primary name server to secondary name servers.</p>"
msgstr ""
"<p><b>ຣີເຟຣຊ (Refresh)</b> ຕັ້ງຄ່າຄວາມຖີ່ໃນການຊິງໂຄຣໄນຂໍ້ມູນເຂດຈາກ\n"
"ເນມເຊີເວີຫຼັກໄປຫາເນມເຊີເວີສຳຮອງ.</p>"

#. help text 7/9 - Retry
#. Zone Editor - Help for tab - Zone (SOA) 5/7
#: src/include/dns-server/helps.rb:132 src/include/dns-server/helps.rb:374
msgid ""
"<p><b>Retry</b> sets how often secondary servers try to synchronize\n"
"the zone from the primary server if synchronization fails.</p>"
msgstr ""
"<p><b>ລອງໃໝ່ (Retry)</b> ຕັ້ງຄ່າຄວາມຖີ່ທີ່ເຊີເວີສຳຮອງຈະພະຍາຍາມຊິງໂຄຣໄນ\n"
"ຂໍ້ມູນເຂດຈາກເຊີເວີຫຼັກ ຫາກການຊິງໂຄຣໄນຫຼົ້ມເຫຼວ.</p>"

#. help text 8/9 - Expiry
#: src/include/dns-server/helps.rb:136
msgid ""
"<p><b>Expiry</b> means the period after which the zone expires on secondary\n"
"servers and secondary servers stop answering replies until it is "
"synchronized.\n"
"</p>"
msgstr ""
"<p><b>ໝົດອາຍຸ (Expiry)</b> ໝາຍເຖິງໄລຍະເວລາທີ່ເຂດຈະໝົດອາຍຸໃນ\n"
"ເຊີເວີສຳຮອງ ແລະ ເຊີເວີສຳຮອງຈະຢຸດການຕອບກັບຈົນກວ່າມັນຈະຖືກຊິງໂຄຣໄນໃໝ່.\n"
"</p>"

#. help text 9/9 - Minimum
#. Zone Editor - Help for tab - Zone (SOA) 7/7
#: src/include/dns-server/helps.rb:142 src/include/dns-server/helps.rb:384
msgid ""
"<p><b>Minimum</b> sets for how long the secondary servers should cache\n"
"negative answers (name resolution failed).</p>"
msgstr ""
"<p><b>ຕ່ຳສຸດ (Minimum)</b> ຕັ້ງຄ່າໄລຍະເວລາທີ່ເຊີເວີສຳຮອງຄວນເກັບແຄຊ (cache)\n"
"ຄຳຕອບທີ່ບໍ່ສຳເລັດ (ການແກ້ໄຂຊື່ຫຼົ້ມເຫຼວ).</p>"

#. ddns keys dialog
#. help text 1/1
#: src/include/dns-server/helps.rb:147
msgid ""
"<p><b><big>TSIG Key Management</big></b><br>\n"
"Define TSIG keys used for dynamic zone updates.\n"
"To add a new TSIG key, use the \n"
"<b>File Name</b> text field or the <b>Browse</b> button then click <b>Add</"
"b>.\n"
"To delete an existing TSIG key, select it in the list and click <b>Delete</"
"b>.\n"
"</p>"
msgstr ""
"<p><b><big>ການຈັດການຄີ (Key) TSIG</big></b><br>\n"
"ກຳນົດຄີ TSIG ທີ່ໃຊ້ສຳລັບການອັບເດດເຂດແບບໄດນາມິກ.\n"
"ຫາກຕ້ອງການເພີ່ມຄີ TSIG ໃໝ່, ໃຫ້ໃຊ້ຊ່ອງປ້ອນ \n"
"<b>ຊື່ໄຟລ໌</b> ຫຼື ປຸ່ມ <b>ເລືອກເບິ່ງ (Browse)</b> ແລ້ວກົດ <b>ເພີ່ມ</b>.\n"
"ຫາກຕ້ອງການລຶບຄີ TSIG ທີ່ມີຢູ່ແລ້ວ, ໃຫ້ເລືອກມັນໃນລາຍຊື່ແລ້ວກົດ <b>ລຶບ</b>.\n"
"</p>"

#. Expert Mode Configuration - Start Up 1/3
#: src/include/dns-server/helps.rb:156
msgid ""
"<p><b><big>Booting</big></b><br>\n"
"To start the DNS server every time your computer is booted, set\n"
"<b>On</b>. Otherwise set <b>Off</b>.</p> "
msgstr ""
"<p><b><big>ການບູດລະບົບ</big></b><br>\n"
"ຫາກຕ້ອງການເລີ່ມເຊີເວີ DNS ທຸກຄັ້ງທີ່ຄອມພິວເຕີຂອງທ່ານຖືກບູດ, ໃຫ້ຕັ້ງເປັນ\n"
"<b>ເປີດ (On)</b>. ບໍ່ດັ່ງນັ້ນໃຫ້ຕັ້ງເປັນ <b>ປິດ (Off)</b>.</p> "

#. Expert Mode Configuration - Start Up 1/3
#: src/include/dns-server/helps.rb:163
msgid ""
"<p><b><big>LDAP Support</big></b><br>\n"
"To store the DNS zones in LDAP instead of native configuration files,\n"
"set <b>LDAP Support Active</b>.</p>"
msgstr ""
"<p><b><big>ການຮອງຮັບ LDAP</big></b><br>\n"
"ຫາກຕ້ອງການເກັບຂໍ້ມູນເຂດ DNS ໃນ LDAP ແທນທີ່ຈະເປັນໄຟລ໌ກຳນົດຄ່າພື້ນຖານ,\n"
"ໃຫ້ຕັ້ງຄ່າ <b>ເປີດໃຊ້ການຮອງຮັບ LDAP</b>.</p>"

#. Expert Mode Configuration - Start Up 3/3
#: src/include/dns-server/helps.rb:170
msgid ""
"<p><b><big>Switch On or Off</big></b><br>\n"
"To start or stop the DNS server immediately, use \n"
"<b>Start DNS Server Now</b> or\n"
"<b>Stop DNS Server Now</b>.</p>\n"
msgstr ""
"<p><b><big>ເປີດ ຫຼື ປິດ</big></b><br>\n"
"ຫາກຕ້ອງການເລີ່ມ ຫຼື ຢຸດເຊີເວີ DNS ໃນທັນທີ, ໃຫ້ໃຊ້ \n"
"<b>ເລີ່ມເຊີເວີ DNS ດຽວນີ້</b> ຫຼື\n"
"<b>ຢຸດເຊີເວີ DNS ດຽວນີ້</b>.</p>\n"

#. Expert Mode Configuration - Forwarders 1/3
#: src/include/dns-server/helps.rb:177
msgid ""
"<p><b><big>Forwarders</big></b><br>\n"
"Forwarders are DNS servers to which your DNS server should send queries\n"
"it cannot answer.</p>\n"
msgstr ""
"<p><b><big>ຜູ້ສົ່ງຕໍ່</big></b><br>\n"
"ຜູ້ສົ່ງຕໍ່ແມ່ນເຊີເວີ DNS ທີ່ເຊີເວີ DNS ຂອງທ່ານຄວນສົ່ງການສອບຖາມໄປຫາ\n"
"ເມື່ອມັນບໍ່ສາມາດຕອບຄຳຖາມນັ້ນໄດ້ດ້ວຍຕົວເອງ.</p>\n"

#. Expert Mode Configuration - Forwarders 2/3
#. _("<p>To ask forwarders during name resolution and in case of fail do full
#. DNS lookup, set <b>Forward First</b>. To ask forwarders only, set
#. <b>Forwarders Only</b>. To do full DNS lookup always, do not check any
#. of these check boxes.</p>
#. ") +
#. Expert Mode Configuration - Forwarders 3/3
#: src/include/dns-server/helps.rb:190
msgid ""
"<p>To add a new forwarder, set its <b>IP Address</b> and click <b>Add</b>.\n"
"To delete a configured forwarder, select it and click <b>Delete</b>.</p>"
msgstr ""
"<p>ຫາກຕ້ອງການເພີ່ມຜູ້ສົ່ງຕໍ່ໃໝ່, ໃຫ້ຕັ້ງຄ່າ <b>ທີ່ຢູ່ IP</b> ຂອງມັນແລ້ວກົດ <b>ເພີ່ມ</b>.\n"
"ຫາກຕ້ອງການລຶບຜູ້ສົ່ງຕໍ່ທີ່ກຳນົດໄວ້, ໃຫ້ເລືອກມັນແລ້ວກົດ <b>ລຶບ</b>.</p>"

#. Expert Mode Configuration - Basic Options 1/2
#: src/include/dns-server/helps.rb:194
msgid ""
"<p><b><big>Edit DNS Server Options</big></b><br>\n"
"Use this dialog to edit options of the DNS server.</p>"
msgstr ""
"<p><b><big>ແກ້ໄຂຕົວເລືອກເຊີເວີ DNS</big></b><br>\n"
"ໃຊ້ກ່ອງຂໍ້ຄວາມນີ້ເພື່ອແກ້ໄຂຕົວເລືອກຕ່າງໆຂອງເຊີເວີ DNS.</p>"

#. Expert Mode Configuration - Basic Options 2/3
#: src/include/dns-server/helps.rb:198
msgid ""
"<p>To add new options, select the <b>Option</b>,\n"
"enter its <b>Value</b>, and click <b>Add</b>.</p>\n"
"<p>To modify a configured option, select it in the table,\n"
"change the <b>Value</b>, and click <b>Change</b>.</p>\n"
msgstr ""
"<p>ຫາກຕ້ອງການເພີ່ມຕົວເລືອກໃໝ່, ໃຫ້ເລືອກ <b>ຕົວເລືອກ</b>,\n"
"ປ້ອນ <b>ຄ່າ</b> ຂອງມັນ, ແລ້ວກົດ <b>ເພີ່ມ</b>.</p>\n"
"<p>ຫາກຕ້ອງການແກ້ໄຂຕົວເລືອກທີ່ກຳນົດໄວ້, ໃຫ້ເລືອກມັນໃນຕາຕະລາງ,\n"
"ປ່ຽນ <b>ຄ່າ</b>, ແລ້ວກົດ <b>ປ່ຽນແປງ</b>.</p>\n"

#. Expert Mode Configuration - Basic Options 3/3
#: src/include/dns-server/helps.rb:205
msgid "<p>To remove an option, select it and click <b>Delete</b>.</p>"
msgstr "<p>ຫາກຕ້ອງການລຶບຕົວເລືອກອອກ, ໃຫ້ເລືອກມັນແລ້ວກົດ <b>ລຶບ</b>.</p>"

#. Expert Mode Configuration - Logging 1/3
#: src/include/dns-server/helps.rb:207
msgid ""
"<p><b><big>Logging</big></b><br>\n"
"Use this dialog to define various options of the DNS server logging.</p>"
msgstr ""
"<p><b><big>ການບັນທຶກ</big></b><br>\n"
"ໃຊ້ກ່ອງຂໍ້ຄວາມນີ້ເພື່ອລະບຸຕົວເລືອກຕ່າງໆໃນການບັນທຶກເຫດການຂອງເຊີເວີ DNS.</p>"

#. Expert Mode Configuration - Logging 2/3
#: src/include/dns-server/helps.rb:211
msgid ""
"<p>\n"
"Select <b>Log to System Log</b> to save DNS server log messages to the "
"system log. \n"
"To save the DNS server log messages to a separate file, select \n"
"<b>Log to File</b> and set the <b>Filename</b> to which to save the log "
"and \n"
"the <b>Maximum Size</b> of the log file.\n"
"The DNS server automatically rotates the log files. Use <b>Maximum Versions</"
"b>\n"
"to specify how many log files should be saved.</p>\n"
msgstr ""
"<p>\n"
"ເລືອກ <b>ບັນທຶກລົງໃນບັນທຶກລະບົບ</b> ເພື່ອບັນທຶກຂໍ້ຄວາມເຫດການຂອງເຊີເວີ DNS ລົງໃນບັນທຶກຂອງລະບົບ. "
"\n"
"ຫາກຕ້ອງການບັນທຶກຂໍ້ຄວາມເຫດການລົງໃນໄຟລ໌ແຍກຕ່າງຫາກ, ໃຫ້ເລືອກ \n"
"<b>ບັນທຶກລົງໃນໄຟລ໌</b> ແລະ ຕັ້ງຄ່າ <b>ຊື່ໄຟລ໌</b> ທີ່ຈະບັນທຶກ ແລະ \n"
"<b>ຂະໜາດສູງສຸດ</b> ຂອງໄຟລ໌ບັນທຶກ.\n"
"ເຊີເວີ DNS ຈະໝຸນວຽນໄຟລ໌ບັນທຶກໂດຍອັດຕະໂນມັດ. ໃຊ້ <b>ເວີຊັນສູງສຸດ</b>\n"
"ເພື່ອລະບຸວ່າຄວນຈະເກັບໄຟລ໌ບັນທຶກໄວ້ຈັກໄຟລ໌.</p>\n"

#. Expert Mode Configuration - Logging 3/3
#: src/include/dns-server/helps.rb:221
msgid ""
"<p>In <b>Additional Logging</b>,\n"
"set which actions should be logged. Common actions are always logged.\n"
"<b>Log All DNS Queries</b> logs all queries from clients to the DNS server.\n"
"<b>Log Zone Updates</b> logs when DNS has been updated.\n"
"<b>Log Zone Transfers</b> logs when zone is completely transferred to the \n"
"secondary\n"
"name server.</p>\n"
msgstr ""
"<p>ໃນ <b>ການບັນທຶກເພີ່ມເຕີມ</b>,\n"
"ໃຫ້ຕັ້ງຄ່າວ່າການກະທຳໃດແດ່ທີ່ຄວນຈະຖືກບັນທຶກ. ການກະທຳທົ່ວໄປແມ່ນຖືກບັນທຶກໄວ້ສະເໝີ.\n"
"<b>ບັນທຶກການສອບຖາມ DNS ທັງໝົດ</b> ຈະບັນທຶກທຸກການສອບຖາມຈາກໄຄລແອນຫາເຊີເວີ DNS.\n"
"<b>ບັນທຶກການອັບເດດເຂດ</b> ຈະບັນທຶກເມື່ອມີການອັບເດດ DNS.\n"
"<b>ບັນທຶກການສົ່ງຂໍ້ມູນເຂດ</b> ຈະບັນທຶກເມື່ອເຂດຖືກສົ່ງຂໍ້ມູນໄປຫາ\n"
"ເນມເຊີເວີ\n"
"ສຳຮອງຢ່າງສົມບູນ.</p>\n"

#. Expert Mode Configuration - ACLs 1/2
#: src/include/dns-server/helps.rb:231
msgid ""
"<p><b><big>ACLs</big></b><br>\n"
"In this dialog, define access control lists to control\n"
"access to zones.</p>\n"
msgstr ""
"<p><b><big>ACLs</big></b><br>\n"
"ໃນກ່ອງຂໍ້ຄວາມນີ້, ໃຫ້ກຳນົດລາຍການຄວບຄຸມການເຂົ້າເຖິງ (ACLs) ເພື່ອຄວບຄຸມ\n"
"ການເຂົ້າເຖິງເຂດຕ່າງໆ.</p>\n"

#. Expert Mode Configuration - ACLs 2/2
#: src/include/dns-server/helps.rb:237
msgid ""
"<p>To add a new ACL entry, just enter the option's <b>Name</b>\n"
"and <b>Value</b> then click <b>Add</b>.  To remove an \n"
"ACL entry, select it and click <b>Delete</b>.</p>\n"
msgstr ""
"<p>ຫາກຕ້ອງການເພີ່ມລາຍການ ACL ໃໝ່, ພຽງແຕ່ປ້ອນ <b>ຊື່</b> ຂອງຕົວເລືອກ\n"
"ແລະ <b>ຄ່າ</b> ແລ້ວກົດ <b>ເພີ່ມ</b>. ຫາກຕ້ອງການລຶບ \n"
"ລາຍການ ACL, ໃຫ້ເລືອກມັນແລ້ວກົດ <b>ລຶບ</b>.</p>\n"

#. Expert Mode Configuration - Keys 1/3
#: src/include/dns-server/helps.rb:243
msgid ""
"<p><b><big>TSIG Keys</big></b><br>\n"
"TSIG keys are used for authentication when remotely\n"
"changing the configuration of the DNS server. This is needed\n"
"for the dynamic updates of DNS zones (DDNS).</p>\n"
msgstr ""
"<p><b><big>ຄີ (Key) TSIG</big></b><br>\n"
"ຄີ TSIG ຖືກໃຊ້ສຳລັບການຢືນຢັນຕົວຕົນເມື່ອມີການປ່ຽນແປງ\n"
"ການກຳນົດຄ່າຂອງເຊີເວີ DNS ຈາກໄລຍະໄກ. ນີ້ແມ່ນສິ່ງຈຳເປັນ\n"
"ສຳລັບການອັບເດດແບບໄດນາມິກຂອງເຂດ DNS (DDNS).</p>\n"

#. Expert Mode Configuration - Keys 2/3
#: src/include/dns-server/helps.rb:250
msgid ""
"<p>To add an already created key, set the <b>Filename</b>\n"
"(or use the <b>Browse</b> button to select it) and click <b>Add</b>.\n"
"To generate a new key, enter the <b>Filename</b> and the <b>Key ID</b>\n"
"then click <b>Generate</b>. The new key will be generated and also added.</"
"p>\n"
msgstr ""
"<p>ຫາກຕ້ອງການເພີ່ມຄີທີ່ສ້າງໄວ້ແລ້ວ, ໃຫ້ຕັ້ງຄ່າ <b>ຊື່ໄຟລ໌</b>\n"
"(ຫຼື ໃຊ້ປຸ່ມ <b>ເລືອກເບິ່ງ (Browse)</b> ເພື່ອເລືອກມັນ) ແລ້ວກົດ <b>ເພີ່ມ</b>.\n"
"ຫາກຕ້ອງການສ້າງຄີໃໝ່, ໃຫ້ປ້ອນ <b>ຊື່ໄຟລ໌</b> ແລະ <b>ID ຂອງຄີ (Key ID)</b>\n"
"ແລ້ວກົດ <b>ສ້າງ (Generate)</b>. ຄີໃໝ່ຈະຖືກສ້າງຂຶ້ນ ແລະ ຖືກເພີ່ມເຂົ້າໄປ.</p>\n"

#. Expert Mode Configuration - Keys 3/3
#: src/include/dns-server/helps.rb:257
msgid ""
"<p>To remove an existing key, select it and\n"
"click <b>Delete</b>.</p>"
msgstr ""
"<p>ຫາກຕ້ອງການລຶບຄີທີ່ມີຢູ່ແລ້ວ, ໃຫ້ເລືອກມັນແລ້ວ\n"
"ກົດ <b>ລຶບ</b>.</p>"

#. Expert Mode Configuration - Zones #1
#: src/include/dns-server/helps.rb:263
msgid ""
"<p><b><big>DNS Zones</big></b><br>\n"
"Use this dialog to manage the DNS zones.</p>\n"
msgstr ""
"<p><b><big>ເຂດ DNS</big></b><br>\n"
"ໃຊ້ກ່ອງຂໍ້ຄວາມນີ້ເພື່ອຈັດການເຂດ DNS ຕ່າງໆ.</p>\n"

#. Expert Mode Configuration - Zones #2
#: src/include/dns-server/helps.rb:267
msgid ""
"<p>To add a new zone, enter its <b>Zone Name</b>, select the <b>Zone Type</"
"b>,\n"
"and click <b>Add</b>.</p>\n"
msgstr ""
"<p>ຫາກຕ້ອງການເພີ່ມເຂດໃໝ່, ໃຫ້ປ້ອນ <b>ຊື່ເຂດ</b>, ເລືອກ <b>ປະເພດເຂດ</b>,\n"
"ແລະ ກົດ <b>ເພີ່ມ</b>.</p>\n"

#. Expert Mode Configuration - Zones #3
#: src/include/dns-server/helps.rb:271
msgid ""
"<p>To add a new IPv4 reverse zone, enter a part of the reverse IPv4 address "
"followed by\n"
"<tt>.in-addr.arpa</tt> as its <b>Zone Name</b> (for example, zone name\n"
"<tt>0.168.192.in-addr.arpa</tt> for network <tt>192.168.0.0/24</tt>), "
"select\n"
"the <b>Zone Type</b>, and click <b>Add</b>.</p>\n"
msgstr ""
"<p>ຫາກຕ້ອງການເພີ່ມເຂດການແປກັບ IPv4 ໃໝ່, ໃຫ້ປ້ອນສ່ວນຂອງທີ່ຢູ່ IPv4 ແບບຖອຍຫຼັງ ຕາມດ້ວຍ\n"
"<tt>.in-addr.arpa</tt> ເປັນ <b>ຊື່ເຂດ</b> ຂອງມັນ (ຕົວຢ່າງ, ຊື່ເຂດ\n"
"<tt>0.168.192.in-addr.arpa</tt> ສຳລັບເຄືອຂ່າຍ <tt>192.168.0.0/24</tt>), ເລືອກ\n"
"<b>ປະເພດເຂດ</b>, ແລະ ກົດ <b>ເພີ່ມ</b>.</p>\n"

#. Expert Mode Configuration - Zones #4
#. %1, %2, %3, and %4 are replaced with examples
#: src/include/dns-server/helps.rb:280
#, ycp-format
msgid ""
"<p>To add a new IPv6 reverse zone, enter a part of the reverse IPv6 address "
"followed by\n"
"<tt>%1</tt> as its <b>Zone Name</b>. Several formats for entering the zone "
"name are\n"
"supported: Standard form: <tt>%2</tt>;\n"
"Forward form: <tt>%3</tt>;\n"
"Forward form without netmask bits: <tt>%4</tt>\n"
"(by default <tt>64</tt> netmask bits are used).</p>\n"
msgstr ""
"<p>ຫາກຕ້ອງການເພີ່ມເຂດການແປກັບ IPv6 ໃໝ່, ໃຫ້ປ້ອນສ່ວນຂອງທີ່ຢູ່ IPv6 ແບບຖອຍຫຼັງ ຕາມດ້ວຍ\n"
"<tt>%1</tt> ເປັນ <b>ຊື່ເຂດ</b> ຂອງມັນ. ມີຫຼາຍຮູບແບບໃນການປ້ອນຊື່ເຂດທີ່\n"
"ຮອງຮັບ: ຮູບແບບມາດຕະຖານ: <tt>%2</tt>;\n"
"ຮູບແບບສົ່ງຕໍ່: <tt>%3</tt>;\n"
"ຮູບແບບສົ່ງຕໍ່ໂດຍບໍ່ມີບິດເນັດມາກ (netmask bits): <tt>%4</tt>\n"
"(ໂດຍຄ່າເລີ່ມຕົ້ນຈະໃຊ້ບິດເນັດມາກ <tt>64</tt> ບິດ).</p>\n"

#. Expert Mode Configuration - Zones #5
#: src/include/dns-server/helps.rb:295
msgid ""
"<p>To modify settings for a zone, such as zone transport and name and\n"
"mail servers, select it, and click <b>Edit</b>.\n"
"To remove a configured zone, select it and click <b>Delete</b>.</p>\n"
msgstr ""
"<p>ຫາກຕ້ອງການແກ້ໄຂການຕັ້ງຄ່າສຳລັບເຂດ, ເຊັ່ນ ການສົ່ງຂໍ້ມູນເຂດ ແລະ ເນມເຊີເວີ\n"
"ແລະ ເມລເຊີເວີ, ໃຫ້ເລືອກມັນ, ແລ້ວກົດ <b>ແກ້ໄຂ</b>.\n"
"ຫາກຕ້ອງການລຶບເຂດທີ່ກຳນົດໄວ້, ໃຫ້ເລືອກມັນແລ້ວກົດ <b>ລຶບ</b>.</p>\n"

#. Zone Editor - Help for tab - Basics  1/3
#: src/include/dns-server/helps.rb:303
msgid ""
"<p><b><big>DDNS and Zone Transport</big></b><br>\n"
"Use this dialog to change dynamic DNS settings of the zone and control "
"access\n"
"to the zone.</p>\n"
msgstr ""
"<p><b><big>DDNS ແລະ ການສົ່ງຂໍ້ມູນເຂດ</big></b><br>\n"
"ໃຊ້ກ່ອງຂໍ້ຄວາມນີ້ເພື່ອປ່ຽນການຕັ້ງຄ່າ DNS ແບບໄດນາມິກຂອງເຂດ ແລະ ຄວບຄຸມການເຂົ້າເຖິງ\n"
"ເຂດນັ້ນ.</p>\n"

#. Zone Editor - Help for tab - Basics  2/3
#: src/include/dns-server/helps.rb:311
msgid ""
"<p>\n"
"To allow dynamic updates of the zone, set <b>Allow Dynamic Updates</b>\n"
"and select the <b>TSIG Key</b>. At least one TSIG key must be defined\n"
"before the zone can be updated dynamically.</p>\n"
msgstr ""
"<p>\n"
"ຫາກຕ້ອງການອະນຸຍາດໃຫ້ອັບເດດເຂດແບບໄດນາມິກ, ໃຫ້ຕັ້ງຄ່າ <b>ອະນຸຍາດໃຫ້ອັບເດດແບບໄດນາມິກ</b>\n"
"ແລະ ເລືອກ <b>ຄີ TSIG</b>. ຕ້ອງມີການກຳນົດຄີ TSIG ຢ່າງໜ້ອຍໜຶ່ງອັນ\n"
"ກ່ອນທີ່ເຂດຈະສາມາດອັບເດດແບບໄດນາມິກໄດ້.</p>\n"

#. Zone Editor - Help for tab - Basics  3/3
#: src/include/dns-server/helps.rb:319
msgid ""
"<p>\n"
"To allow transports of the zone, set <b>Enable Zone Transport</b>\n"
"and select the <b>ACLs</b> to check when a remote host\n"
"attempts to transfer the zone. At least one ACL must be defined\n"
"to allow zone transports.</p>"
msgstr ""
"<p>\n"
"ຫາກຕ້ອງການອະນຸຍາດໃຫ້ສົ່ງຂໍ້ມູນເຂດ, ໃຫ້ຕັ້ງຄ່າ <b>ເປີດໃຊ້ການສົ່ງຂໍ້ມູນເຂດ</b>\n"
"ແລະ ເລືອກ <b>ACLs</b> ທີ່ຈະກວດສອບເມື່ອມີໂຮສຈາກໄລຍະໄກ\n"
"ພະຍາຍາມຈະຖ່າຍໂອນຂໍ້ມູນເຂດ. ຕ້ອງມີການກຳນົດ ACL ຢ່າງໜ້ອຍໜຶ່ງອັນ\n"
"ເພື່ອອະນຸຍາດໃຫ້ມີການສົ່ງຂໍ້ມູນເຂດ.</p>"

#. Zone Editor - Help
#: src/include/dns-server/helps.rb:327
msgid ""
"<p>\n"
"Reverse zone records can be generated from another primary zone.\n"
"Select the <b>Automatically Generate Records From</b>\n"
"check-box and choose the zone to generate the records from.</p>\n"
msgstr ""
"<p>\n"
"ບັນທຶກເຂດການແປກັບສາມາດຖືກສ້າງຂຶ້ນມາຈາກເຂດຫຼັກອື່ນໄດ້.\n"
"ໃຫ້ໝາຍເລືອກຊ່ອງ <b>ສ້າງບັນທຶກໂດຍອັດຕະໂນມັດຈາກ</b>\n"
"ແລະ ເລືອກເຂດທີ່ຈະໃຊ້ເພື່ອສ້າງບັນທຶກ.</p>\n"

#. Zone Editor - Help
#: src/include/dns-server/helps.rb:334
msgid ""
"<p>\n"
"If this is not a reverse zone, you can see which zones are generated\n"
"from the current on in the <b>Connected Reverse Zones</b> field.</p>"
msgstr ""
"<p>\n"
"ຫາກນີ້ບໍ່ແມ່ນເຂດການແປກັບ, ທ່ານສາມາດເບິ່ງໄດ້ວ່າເຂດໃດແດ່ທີ່ຖືກສ້າງຂຶ້ນມາ\n"
"ຈາກເຂດປັດຈຸບັນໃນຊ່ອງ <b>ເຂດການແປກັບທີ່ເຊື່ອມຕໍ່</b>.</p>"

#. Zone Editor - Help for tab - Name Servers
#: src/include/dns-server/helps.rb:340
msgid ""
"<p><b><big>NS Records</big></b><br>\n"
"To add a new name server, enter the name server address and click <b>Add</"
"b>.\n"
"To remove one of the listed name servers, select it and click\n"
"<b>Delete</b>.</p>\n"
msgstr ""
"<p><b><big>ບັນທຶກ NS</big></b><br>\n"
"ຫາກຕ້ອງການເພີ່ມເນມເຊີເວີໃໝ່, ໃຫ້ປ້ອນທີ່ຢູ່ຂອງເນມເຊີເວີແລ້ວກົດ <b>ເພີ່ມ</b>.\n"
"ຫາກຕ້ອງການລຶບເນມເຊີເວີທີ່ມີຢູ່ໃນລາຍຊື່, ໃຫ້ເລືອກມັນແລ້ວກົດ\n"
"<b>ລຶບ</b>.</p>\n"

#. Zone Editor - Help for tab - Mail Servers
#: src/include/dns-server/helps.rb:347
msgid ""
"<p><b><big>MX Records</big></b><br>\n"
"To add a new mail server, enter the <b>Address</b> and <b>Priority</b>\n"
"and click <b>Add</b>.\n"
"To remove one of the listed mail servers, select it and click\n"
"<b>Delete</b>.</p>\n"
msgstr ""
"<p><b><big>ບັນທຶກ MX</big></b><br>\n"
"ຫາກຕ້ອງການເພີ່ມເມລເຊີເວີໃໝ່, ໃຫ້ປ້ອນ <b>ທີ່ຢູ່</b> ແລະ <b>ລຳດັບຄວາມສຳຄັນ</b>\n"
"ແລ້ວກົດ <b>ເພີ່ມ</b>.\n"
"ຫາກຕ້ອງການລຶບເມລເຊີເວີທີ່ມີຢູ່ໃນລາຍຊື່, ໃຫ້ເລືອກມັນແລ້ວກົດ\n"
"<b>ລຶບ</b>.</p>\n"

#. Zone Editor - Help for tab - Zone (SOA) 2/7
#: src/include/dns-server/helps.rb:359
msgid ""
"<p><b>Serial</b> is the number used for determining if the zone has \n"
"changed on\n"
"the primary servers (then secondary servers do not always need to "
"synchronize the\n"
"entire zone).</p>\n"
msgstr ""
"<p><b>ຊີຣຽວ (Serial)</b> ແມ່ນໝາຍເລກທີ່ໃຊ້ເພື່ອພິຈາລະນາວ່າມີ\n"
"ການປ່ຽນແປງໃນເຂດຢູ່\n"
"ເຊີເວີຫຼັກຫຼືບໍ່ (ເຊິ່ງເຮັດໃຫ້ເຊີເວີສຳຮອງບໍ່ຈຳເປັນຕ້ອງຊິງໂຄຣໄນຂໍ້ມູນທັງໝົດ\n"
"ຂອງເຂດຕະຫຼອດເວລາ).</p>\n"

#. Zone Editor - Help for tab - Zone (SOA) 3/7
#: src/include/dns-server/helps.rb:366
msgid ""
"<p><b>TTL</b> specifies the time to live for all records in the\n"
"zone that do not have an explicit TTL.</p>"
msgstr ""
"<p><b>TTL</b> ລະບຸໄລຍະເວລາຄົງຢູ່ (time to live) ສຳລັບບັນທຶກທັງໝົດໃນ\n"
"ເຂດທີ່ບໍ່ໄດ້ມີການກຳນົດ TTL ໄວ້ຢ່າງຊັດເຈນ.</p>"

#. Zone Editor - Help for tab - Zone (SOA) 6/7
#: src/include/dns-server/helps.rb:378
msgid ""
"<p><b>Expiration</b> means the period after which the zone expires on "
"secondary\n"
"servers and secondary servers stop answering replies until it is "
"synchronized.\n"
"</p>"
msgstr ""
"<p><b>ການໝົດອາຍຸ (Expiration)</b> ໝາຍເຖິງໄລຍະເວລາທີ່ເຂດຈະໝົດອາຍຸໃນ\n"
"ເຊີເວີສຳຮອງ ແລະ ເຊີເວີສຳຮອງຈະຢຸດການຕອບກັບຈົນກວ່າມັນຈະຖືກຊິງໂຄຣໄນໃໝ່.\n"
"</p>"

#. Zone Editor - Help for tab - Records 1/7  or 1/5
#: src/include/dns-server/helps.rb:388
msgid ""
"<p><b><big>Records</big></b><br>\n"
"In this dialog, edit the resource records of the zone. To add new resource\n"
"records, set the <b>Record Key</b>, <b>Type</b>, and <b>Value</b> then\n"
"click <b>Add</b>.</p>"
msgstr ""
"<p><b><big>ບັນທຶກ</big></b><br>\n"
"ໃນກ່ອງຂໍ້ຄວາມນີ້, ໃຫ້ແກ້ໄຂບັນທຶກຊັບພະຍາກອນຂອງເຂດ. ຫາກຕ້ອງການເພີ່ມບັນທຶກຊັບພະຍາກອນ\n"
"ໃໝ່, ໃຫ້ຕັ້ງຄ່າ <b>ຄີ (Key) ບັນທຶກ</b>, <b>ປະເພດ</b>, ແລະ <b>ຄ່າ</b> ແລ້ວ\n"
"ກົດ <b>ເພີ່ມ</b>.</p>"

#. Zone Editor - Help for tab - Records 2/7 or 2/5
#: src/include/dns-server/helps.rb:395
msgid ""
"<p>To change an existing record, select it, modify the desired entries,\n"
"and click <b>Change</b>. To delete a record, select it and click\n"
"<b>Delete</b>.</p>"
msgstr ""
"<p>ຫາກຕ້ອງການປ່ຽນບັນທຶກທີ່ມີຢູ່ແລ້ວ, ໃຫ້ເລືອກມັນ, ແກ້ໄຂລາຍການທີ່ຕ້ອງການ,\n"
"ແລ້ວກົດ <b>ປ່ຽນແປງ</b>. ຫາກຕ້ອງການລຶບບັນທຶກ, ໃຫ້ເລືອກມັນແລ້ວກົດ\n"
"<b>ລຶບ</b>.</p>"

#. Zone Editor - Help for tab - Records 3/7 or 3/5
#: src/include/dns-server/helps.rb:401
msgid ""
"<p>\n"
"Each type of record has its own syntax defined in the RFC.</p>\n"
msgstr ""
"<p>\n"
"ບັນທຶກແຕ່ລະປະເພດຈະມີຮູບແບບໄວຍາກອນຂອງມັນເອງທີ່ກຳນົດໄວ້ໃນ RFC.</p>\n"

#. Zone Editor - Help for tab - Records 4/7 (alt. 1)
#: src/include/dns-server/helps.rb:405
msgid ""
"<p><b>A: Domain Name Translation</b>:\n"
"<b>Record Key</b> is a hostname without domain or a fully qualified \n"
"hostname followed by a dot.\n"
" <b>Value</b> is an IP address.</p>"
msgstr ""
"<p><b>A: ການແປຊື່ໂດເມນ</b>:\n"
"<b>ຄີ (Key) ບັນທຶກ</b> ແມ່ນຊື່ໂຮສທີ່ບໍ່ມີໂດເມນ ຫຼື ຊື່ໂຮສແບບ\n"
"ເຕັມທີ່ຕາມດ້ວຍຈຸດ.\n"
" <b>ຄ່າ</b> ແມ່ນທີ່ຢູ່ IP.</p>"

#. Zone Editor - Help for tab - Records 5/7 (alt. 1)
#: src/include/dns-server/helps.rb:412
msgid ""
"<p><b>CNAME: Alias for Domain Name</b>:\n"
"<b>Record Key</b> is a hostname relative to the current zone or a fully\n"
"qualified hostname followed by a dot.\n"
"<b>Value</b> is a hostname relative to the current zone or a fully\n"
"qualified hostname followed by a dot. It must be represented by\n"
"an A record.</p>\n"
msgstr ""
"<p><b>CNAME: ຊື່ຫຼິ້ນສຳລັບຊື່ໂດເມນ</b>:\n"
"<b>ຄີ (Key) ບັນທຶກ</b> ແມ່ນຊື່ໂຮສທີ່ກ່ຽວຂ້ອງກັບເຂດປັດຈຸບັນ ຫຼື ຊື່ໂຮສ\n"
"ແບບເຕັມທີ່ຕາມດ້ວຍຈຸດ.\n"
"<b>ຄ່າ</b> ແມ່ນຊື່ໂຮສທີ່ກ່ຽວຂ້ອງກັບເຂດປັດຈຸບັນ ຫຼື ຊື່ໂຮສ\n"
"ແບບເຕັມທີ່ຕາມດ້ວຍຈຸດ. ມັນຕ້ອງຖືກສະແດງໂດຍ\n"
"ບັນທຶກ A.</p>\n"

#. Zone Editor - Help for tab - Records 6/7 (alt. 1)
#. Zone Editor - Help for tab - Records 5/5 (alt. 2)
#: src/include/dns-server/helps.rb:421 src/include/dns-server/helps.rb:448
msgid ""
"<p><b>NS: Name Server</b>:\n"
"<b>Record Key</b> is a zone name relative to the current zone or an "
"absolute\n"
"domain name followed by a dot.\n"
"<b>Value</b> is a hostname relative to the current zone or fully qualified\n"
"hostname followed by a dot.  It must be represented by an A record.</p>\n"
msgstr ""
"<p><b>NS: ເນມເຊີເວີ</b>:\n"
"<b>ຄີ (Key) ບັນທຶກ</b> ແມ່ນຊື່ເຂດທີ່ກ່ຽວຂ້ອງກັບເຂດປັດຈຸບັນ ຫຼື ຊື່ໂດເມນ\n"
"ແບບສົມບູນທີ່ຕາມດ້ວຍຈຸດ.\n"
"<b>ຄ່າ</b> ແມ່ນຊື່ໂຮສທີ່ກ່ຽວຂ້ອງກັບເຂດປັດຈຸບັນ ຫຼື ຊື່ໂຮສແບບເຕັມ\n"
"ທີ່ຕາມດ້ວຍຈຸດ. ມັນຕ້ອງຖືກສະແດງໂດຍບັນທຶກ A.</p>\n"

#. Zone Editor - Help for tab - Records 7/7 (alt. 1)
#: src/include/dns-server/helps.rb:429
msgid ""
"<p><b>MX: Mail Relay</b>:\n"
"<b>Record Key</b> is a hostname or zone name relative to the current zone\n"
"or an absolute hostname or zone name followed by a dot.\n"
"<b>Value</b> is a hostname relative to the current zone or fully qualified\n"
"hostname followed by a dot.  It must be represented by an A record.</p>\n"
msgstr ""
"<p><b>MX: ເມລຣີເລ (Mail Relay)</b>:\n"
"<b>ຄີ (Key) ບັນທຶກ</b> ແມ່ນຊື່ໂຮສ ຫຼື ຊື່ເຂດທີ່ກ່ຽວຂ້ອງກັບເຂດປັດຈຸບັນ\n"
"ຫຼື ຊື່ໂຮສ ຫຼື ຊື່ເຂດແບບສົມບູນທີ່ຕາມດ້ວຍຈຸດ.\n"
"<b>ຄ່າ</b> ແມ່ນຊື່ໂຮສທີ່ກ່ຽວຂ້ອງກັບເຂດປັດຈຸບັນ ຫຼື ຊື່ໂຮສແບບເຕັມ\n"
"ທີ່ຕາມດ້ວຍຈຸດ. ມັນຕ້ອງຖືກສະແດງໂດຍບັນທຶກ A.</p>\n"

#. Zone Editor - Help for tab - Records 4/5 (alt. 2)
#: src/include/dns-server/helps.rb:437
msgid ""
"<p><b>PTR: Reverse Translation</b>:\n"
"<b>Record Key</b> is a full reverse zone name (derived from the IP address)\n"
"followed by a dot\n"
"(such as <tt>1.0.168.192.in-addr.arpa.</tt> for IP address <tt>192.168.0.1</"
"tt>)\n"
" or a part of reverse zone name relative to the current zone\n"
"(such as <tt>1</tt> for IP address <tt>192.168.0.1</tt> in zone\n"
"<tt>0.168.192.in-addr.arpa.</tt>).\n"
"<b>Value</b> is a fully qualified hostname followed by a dot.</p>\n"
msgstr ""
"<p><b>PTR: ການແປກັບ</b>:\n"
"<b>ຄີ (Key) ບັນທຶກ</b> ແມ່ນຊື່ເຂດການແປກັບແບບເຕັມ (ທີ່ມາຈາກທີ່ຢູ່ IP)\n"
"ຕາມດ້ວຍຈຸດ\n"
"(ເຊັ່ນ <tt>1.0.168.192.in-addr.arpa.</tt> ສຳລັບທີ່ຢູ່ IP <tt>192.168.0.1</tt>)\n"
" ຫຼື ສ່ວນຂອງຊື່ເຂດການແປກັບທີ່ກ່ຽວຂ້ອງກັບເຂດປັດຈຸບັນ\n"
"(ເຊັ່ນ <tt>1</tt> ສຳລັບທີ່ຢູ່ IP <tt>192.168.0.1</tt> ໃນເຂດ\n"
"<tt>0.168.192.in-addr.arpa.</tt>).\n"
"<b>ຄ່າ</b> ແມ່ນຊື່ໂຮສແບບເຕັມທີ່ຕາມດ້ວຍຈຸດ.</p>\n"

#. Final step of the installation wizard - 1/5
#: src/include/dns-server/helps.rb:456
msgid ""
"<p><b><big>Finishing the Configuration</big></b></p>\n"
"<p>Check the entered settings before finishing the configuration.</p> \n"
msgstr ""
"<p><b><big>ກຳລັງສິ້ນສຸດການກຳນົດຄ່າ</big></b></p>\n"
"<p>ກວດສອບການຕັ້ງຄ່າທີ່ປ້ອນເຂົ້າກ່ອນທີ່ຈະສິ້ນສຸດການກຳນົດຄ່າ.</p> \n"

#. Final step of the installation wizard - 2/5
#: src/include/dns-server/helps.rb:460
msgid ""
"<p>Select <b>Open Port in Firewall</b> to adapt the\n"
"SuSEfirewall2 settings to allow all connections to your DNS server.</p>"
msgstr ""
"<p>ເລືອກ <b>ເປີດພອດໃນໄຟວໍ</b> ເພື່ອປັບປ່ຽນການຕັ້ງຄ່າ\n"
"SuSEfirewall2 ໃຫ້ອະນຸຍາດທຸກການເຊື່ອມຕໍ່ຫາເຊີເວີ DNS ຂອງທ່ານ.</p>"

#. Final step of the installation wizard - 3/5
#: src/include/dns-server/helps.rb:464
msgid ""
"<p>\n"
"To start the DNS server every time your computer is booted, set the \n"
"start-up behavior to <b>On</b>. Otherwise set it to <b>Off</b>.</p> \n"
msgstr ""
"<p>\n"
"ຫາກຕ້ອງການເລີ່ມເຊີເວີ DNS ທຸກຄັ້ງທີ່ຄອມພິວເຕີຖືກບູດ, ໃຫ້ຕັ້ງຄ່າ\n"
"ພຶດຕິກຳການເລີ່ມລະບົບເປັນ <b>ເປີດ (On)</b>. ບໍ່ດັ່ງນັ້ນໃຫ້ຕັ້ງເປັນ <b>ປິດ (Off)</b>.</p> \n"

#. Final step of the installation wizard - 4/5
#: src/include/dns-server/helps.rb:471
msgid ""
"<p>\n"
"To store the DNS zones in LDAP instead of native configuration files,\n"
"set <b>LDAP Support Active</b>.</p>"
msgstr ""
"<p>\n"
"ຫາກຕ້ອງການເກັບຂໍ້ມູນເຂດ DNS ໃນ LDAP ແທນທີ່ຈະເປັນໄຟລ໌ກຳນົດຄ່າພື້ນຖານ,\n"
"ໃຫ້ຕັ້ງຄ່າ <b>ເປີດໃຊ້ການຮອງຮັບ LDAP</b>.</p>"

#. Final step of the installation wizard - 5/5
#: src/include/dns-server/helps.rb:478
msgid ""
"<p>\n"
"To enter the expert mode of the DNS server configuration, click\n"
"<b>DNS Server Expert Configuration</b>.</p>"
msgstr ""
"<p>\n"
"ຫາກຕ້ອງການເຂົ້າສູ່ໂໝດຊ່ຽວຊານຂອງການກຳນົດຄ່າເຊີເວີ DNS, ໃຫ້ກົດ\n"
"<b>ການກຳນົດຄ່າເຊີເວີ DNS ແບບຊ່ຽວຊານ</b>.</p>"

#. slave zone help text 1/2
#: src/include/dns-server/helps.rb:484
msgid ""
"<p><big><b>Secondary DNS Zone</b></big><br>\n"
"Each secondary zone must have the primary name server defined. Use\n"
"<b>Primary DNS Server IP</b> to define the primary name server.</p>"
msgstr ""
"<p><big><b>ເຂດ DNS ສຳຮອງ</b></big><br>\n"
"ທຸກໆເຂດສຳຮອງຕ້ອງມີການກຳນົດເນມເຊີເວີຫຼັກ. ໃຫ້ໃຊ້\n"
"<b>IP ຂອງເຊີເວີ DNS ຫຼັກ</b> ເພື່ອກຳນົດເນມເຊີເວີຫຼັກ.</p>"

#. secondary zone help text 2/2
#: src/include/dns-server/helps.rb:490
msgid ""
"<p><big><b>Zone Transport</b></big><br>\n"
"To allow transports of the zone, set <b>Enable Zone Transport</b>\n"
"and select the <b>ACLs</b> to check when a remote host\n"
"attempts to transfer the zone. At least one ACL must be defined\n"
"to allow zone transports.</p>"
msgstr ""
"<p><big><b>ການສົ່ງຂໍ້ມູນເຂດ</b></big><br>\n"
"ຫາກຕ້ອງການອະນຸຍາດໃຫ້ສົ່ງຂໍ້ມູນເຂດ, ໃຫ້ຕັ້ງຄ່າ <b>ເປີດໃຊ້ການສົ່ງຂໍ້ມູນເຂດ</b>\n"
"ແລະ ເລືອກ <b>ACLs</b> ທີ່ຈະກວດສອບເມື່ອມີໂຮສຈາກໄລຍະໄກ\n"
"ພະຍາຍາມຈະຖ່າຍໂອນຂໍ້ມູນເຂດ. ຕ້ອງມີການກຳນົດ ACL ຢ່າງໜ້ອຍໜຶ່ງອັນ\n"
"ເພື່ອອະນຸຍາດໃຫ້ມີການສົ່ງຂໍ້ມູນເຂດ.</p>"

#. forward zone help text 1/2
#: src/include/dns-server/helps.rb:498
msgid ""
"<p><big><b>Forward DNS Zone</b></big><br>\n"
"This type of DNS zone only forwards DNS queries to forwarders\n"
"defined in it.</p>"
msgstr ""
"<p><big><b>ເຂດ DNS ສົ່ງຕໍ່</b></big><br>\n"
"ເຂດ DNS ປະເພດນີ້ຈະສົ່ງຕໍ່ການສອບຖາມ DNS ໄປຫາຜູ້ສົ່ງຕໍ່\n"
"ທີ່ກຳນົດໄວ້ໃນເຂດນີ້ເທົ່ານັ້ນ.</p>"

#. forward zone help text 2/2
#: src/include/dns-server/helps.rb:504
msgid ""
"<p>If there are no forwarders defined, all DNS queries\n"
"for the respective zone are denied, because there is no DNS\n"
"server to which that query should be forwarded.</p>"
msgstr ""
"<p>ຫາກບໍ່ມີການກຳນົດຜູ້ສົ່ງຕໍ່ໄວ້, ການສອບຖາມ DNS ທັງໝົດ\n"
"ສຳລັບເຂດນັ້ນຈະຖືກປະຕິເສດ, ເພາະວ່າບໍ່ມີເຊີເວີ DNS\n"
"ໃດໆ ທີ່ການສອບຖາມນັ້ນຄວນຈະຖືກສົ່ງຕໍ່ໄປຫາ.</p>"

