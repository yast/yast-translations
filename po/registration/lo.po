msgstr "ຄັງຊອບແວທີ່ໃຊ້ສຳລັບການຍ້າຍລະບົບ"

#. TRANSLATORS: help text
#: src/lib/registration/ui/migration_repos_selection_dialog.rb:50
msgid ""
"<p>In this dialog you can manually select which repositories willbe used for "
"online migration. The packages will be upgraded to thehighest version found "
"in the selected repositories.</p>"
msgstr ""
"<p>ໃນໜ້າຕ່າງນີ້ທ່ານສາມາດເລືອກດ້ວຍຕົນເອງວ່າຈະໃຊ້ຄັງຊອບແວໃດສຳລັບການຍ້າຍລະບົບແບບອອນລາຍ. ແພັກເກດ"
"ຕ່າງໆຈະຖືກອັບເກຣດເປັນເວີຊັນສູງສຸດທີ່ພົບໃນຄັງຊອບແວທີ່ເລືອກ.</p>"

#. TRANSLATORS: Multiselection widget label
#: src/lib/registration/ui/migration_repos_selection_dialog.rb:85
msgid "Select the Repositories used for Migration"
msgstr "ເລືອກຄັງຊອບແວທີ່ໃຊ້ສຳລັບການຍ້າຍລະບົບ"

#. TRANSLATORS: Push button label, starts the repository management module
#: src/lib/registration/ui/migration_repos_selection_dialog.rb:88
msgid "Manage Repositories..."
msgstr "ຈັດການຄັງຊອບແວ..."

#. TRANSLATORS: summary text, %s is a repository URL
#: src/lib/registration/ui/migration_repos_selection_dialog.rb:113
#, c-format
msgid "URL: %s"
msgstr "URL: %s"

#. TRANSLATORS: summary text, %s is a repository priority (1-99)
#: src/lib/registration/ui/migration_repos_selection_dialog.rb:115
#, c-format
msgid "Priority: %s"
msgstr "ລຳດັບຄວາມສຳຄັນ: %s"

#. TRANSLATORS: a popup message with [Continue] [Cancel] buttons,
#. pressing [Continue] starts the registration module, [Cancel] aborts
#. the online migration
#: src/lib/registration/ui/migration_repos_workflow.rb:185
msgid ""
"The system is not registered,\n"
"to run the online migration you need\n"
"to register the system first."
msgstr ""
"ລະບົບຍັງບໍ່ໄດ້ລົງທະບຽນ,\n"
"ເພື່ອດຳເນີນການຍ້າຍລະບົບແບບອອນລາຍ ທ່ານຈຳເປັນຕ້ອງ\n"
"ລົງທະບຽນລະບົບກ່ອນ."

#. TRANSLATORS: Error message
#: src/lib/registration/ui/migration_repos_workflow.rb:252
msgid "No installed product found."
msgstr "ບໍ່ພົບຜະລິດຕະພັນທີ່ຕິດຕັ້ງໄວ້."

#. TRANSLATORS: Popup question, merge this addon that are registered but not
#. installed to the current migration products list.
#. %s is an addon friendly name, e.g 'SUSE Enterprise Storage 2 x86_64'
#: src/lib/registration/ui/migration_repos_workflow.rb:275
#, c-format
msgid ""
"The '%s' extension is registered but not installed.\n"
"If you accept it will be added for be installed, in other case it will be "
"unregistered at the end of the migration.\n"
"\n"
"Do you want to add it?"
msgstr ""
"ສ່ວນເສີມ '%s' ຖືກລົງທະບຽນແລ້ວແຕ່ຍັງບໍ່ທັນໄດ້ຕິດຕັ້ງ.\n"
"ຖ້າທ່ານຕົກລົງ ມັນຈະຖືກເພີ່ມເຂົ້າເພື່ອຕິດຕັ້ງ, ບໍ່ດັ່ງນັ້ນມັນຈະຖືກຍົກເລີກການລົງທະບຽນເມື່ອສິ້ນສຸດການຍ້າຍລະບົບ.\n"
"\n"
"ທ່ານຕ້ອງການເພີ່ມມັນບໍ່?"

#. TRANSLATORS: Error message
#. TRANSLATORS. Error message
#: src/lib/registration/ui/migration_repos_workflow.rb:329
#: src/lib/registration/ui/migration_repos_workflow.rb:369
msgid "No migration product found."
msgstr "ບໍ່ພົບຜະລິດຕະພັນການຍ້າຍລະບົບ."

#. TRANSLATORS: Error message
#: src/lib/registration/ui/migration_repos_workflow.rb:343
msgid "Cannot find a base product to upgrade."
msgstr "ບໍ່ພົບຜະລິດຕະພັນຫຼັກເພື່ອອັບເກຣດ."

#. TRANSLATORS: Help message, %{product} is the product name
#: src/lib/registration/ui/migration_repos_workflow.rb:371
#, perl-brace-format
msgid ""
"Please, boot the original system and make sure that all registerable "
"products are correctly registered.\n"
"Also check that the installed system is supported for upgrade to \n"
"%{product}."
msgstr ""
"ກະລຸນາບູດລະບົບເດີມ ແລະ ກວດສອບໃຫ້ແນ່ໃຈວ່າຜະລິດຕະພັນທັງໝົດທີ່ລົງທະບຽນໄດ້ນັ້ນຖືກລົງທະບຽນຢ່າງຖືກຕ້ອງແລ້"
"ວ.\n"
"ນອກຈາກນັ້ນໃຫ້ກວດສອບວ່າລະບົບທີ່ຕິດຕັ້ງໄວ້ນັ້ນຮອງຮັບການອັບເກຣດເປັນ \n"
"%{product}."

#. TRANSLATORS: Continue/Cancel popup question, confirm the migration by user,
#. %s is a product name, e.g. "SUSE Linux Enterprise Server 15"
#: src/lib/registration/ui/migration_repos_workflow.rb:405
#, c-format
msgid ""
"The product %s\n"
"is already activated on this system.\n"
"\n"
"Migrating again to the same product might not work properly."
msgstr ""
"ຜະລິດຕະພັນ %s\n"
"ຖືກເປີດໃຊ້ງານໃນລະບົບນີ້ແລ້ວ.\n"
"\n"
"ການຍ້າຍລະບົບໄປຫາຜະລິດຕະພັນເດີມອີກຄັ້ງອາດຈະເຮັດວຽກບໍ່ຖືກຕ້ອງ."

#. TRANSLATORS: progress message
#: src/lib/registration/ui/migration_repos_workflow.rb:502
msgid "Preparing Migration Repositories..."
msgstr "ກຳລັງກຽມຄັງຊອບແວການຍ້າຍລະບົບ..."

#. TRANSLATORS: Unregistered system message (1/3)
#. Message displayed during upgrade for unregistered systems.
#. The user can either boot the old system and register it or use the
#. DVD media for upgrade. Use the RichText format.
#. TRANSLATORS: Unregistered system message (1/3)
#. Message displayed during upgrade for unregistered systems.
#. The user can either boot the old system and register it or use the
#. Full media for upgrade. Use the RichText format.
#: src/lib/registration/ui/migration_repos_workflow.rb:761
#: src/lib/registration/ui/migration_repos_workflow.rb:778
msgid ""
"<h2>Unregistered System</h2><p>The system is not registered, that means the "
"installer cannot add the new software repositories required for migration "
"automatically.</p>"
msgstr ""
"<h2>ລະບົບຍັງບໍ່ໄດ້ລົງທະບຽນ</h2><p>ລະບົບຍັງບໍ່ໄດ້ລົງທະບຽນ, ນັ້ນໝາຍຄວາມວ່າຕົວຕິດຕັ້ງບໍ່ສາມາດເພີ່ມຄັງຊອບ"
"ແວໃໝ່ທີ່ຈຳເປັນສຳລັບການຍ້າຍລະບົບໂດຍອັດຕະໂນມັດໄດ້.</p>"

#. TRANSLATORS: Unregistered system message (2/3)
#. TRANSLATORS: Media based upgrade requested by user (2/3)
#: src/lib/registration/ui/migration_repos_workflow.rb:765
#: src/lib/registration/ui/migration_repos_workflow.rb:813
msgid "<p>Please add the installation media manually in the next step.</p>"
msgstr "<p>ກະລຸນາເພີ່ມສື່ການຕິດຕັ້ງດ້ວຍຕົນເອງໃນຂັ້ນຕອນຖັດໄປ.</p>"

#. TRANSLATORS: Unregistered system message (3/3)
#: src/lib/registration/ui/migration_repos_workflow.rb:767
msgid ""
"<p>If you cannot provide the installation media you can abort the migration "
"and boot the original system to register it. Then start the migration again."
"</p>"
msgstr ""
"<p>ຖ້າທ່ານບໍ່ສາມາດລະບຸສື່ການຕິດຕັ້ງໄດ້ ທ່ານສາມາດຍົກເລີກການຍ້າຍລະບົບ ແລະ ບູດລະບົບເດີມເພື່ອລົງທະບຽນ. "
"ຈາກນັ້ນຈຶ່ງເລີ່ມການຍ້າຍລະບົບໃໝ່ອີກຄັ້ງ.</p>"

#. TRANSLATORS: Unregistered system message (2/3)
#: src/lib/registration/ui/migration_repos_workflow.rb:782
msgid "<p>Please use Full media instead of Online one.</p>"
msgstr "<p>ກະລຸນາໃຊ້ສື່ການຕິດຕັ້ງແບບເຕັມ (Full media) ແທນແບບອອນລາຍ.</p>"

#. TRANSLATORS: Unregistered system message (3/3)
#: src/lib/registration/ui/migration_repos_workflow.rb:784
msgid ""
"<p>Another option is booting the original system and registering it.</p>"
msgstr "<p>ອີກທາງເລືອກໜຶ່ງແມ່ນການບູດລະບົບເດີມແລ້ວເຮັດການລົງທະບຽນ.</p>"

#. TRANSLATORS: Media upgrade forced but the Online medium was detected (1/2)
#. Message displayed during upgrade when the Online medium is used
#. with the "media_upgrade=1" boot option. The Online medium does not
#. contain any packages and it cannot be used in this case, Full medium
#. is required. Use the RichText format.
#: src/lib/registration/ui/migration_repos_workflow.rb:795
msgid ""
"<h2>Online Medium</h2><p>The media based upgrade was requested, but you are "
"using the Online medium which does not provide any packages to install.</p>"
msgstr ""
"<h2>ສື່ແບບອອນລາຍ</h2><p>ມີການຮ້ອງຂໍການອັບເກຣດໂດຍໃຊ້ສື່, ແຕ່ທ່ານກຳລັງໃຊ້ສື່ແບບອອນລາຍເຊິ່ງບໍ່ມີແພັກເ"
"ກດໃດໆໃຫ້ຕິດຕັ້ງ.</p>"

#. TRANSLATORS: Force media upgrade, Online medium detected (2/2)
#: src/lib/registration/ui/migration_repos_workflow.rb:799
msgid "<p>Please use the Full medium instead of the Online.</p>"
msgstr "<p>ກະລຸນາໃຊ້ສື່ແບບເຕັມແທນແບບອອນລາຍ.</p>"

#. TRANSLATORS: Media based upgrade requested by user (1/3)
#. User requested media based upgrade which does not use SCC/SMT/RMT
#. but the downloaded media (physical DVD or shared repo on a local server).
#: src/lib/registration/ui/migration_repos_workflow.rb:809
msgid ""
"<h2>Media Based Upgrade</h2><p>The media based upgrade is requested. In this "
"mode YaST will not contact the registration server to obtain the new "
"software repositories required for migration.</p>"
msgstr ""
"<h2>ການອັບເກຣດຜ່ານສື່</h2><p>ມີການຮ້ອງຂໍການອັບເກຣດຜ່ານສື່. ໃນໂໝດນີ້ YaST ຈະບໍ່ຕິດຕໍ່ກັບເຊີເວີການລົງ"
"ທະບຽນເພື່ອຂໍເອົາຄັງຊອບແວໃໝ່ທີ່ຈຳເປັນສຳລັບການຍ້າຍລະບົບ.</p>"

#. TRANSLATORS: a warning message, upgrading the registered systems
#. using media is not supported
#: src/lib/registration/ui/migration_repos_workflow.rb:819
msgid ""
"<h2>Warning!</h2><p><b>The media based upgrade for registered systems is not "
"supported!<b></p>"
msgstr ""
"<h2>ຄຳເຕືອນ!</h2><p><b>ບໍ່ຮອງຮັບການອັບເກຣດໂດຍໃຊ້ສື່ສຳລັບລະບົບທີ່ລົງທະບຽນແລ້ວ!<b></p>"

#: src/lib/registration/ui/migration_repos_workflow.rb:821
msgid ""
"<p>If you upgrade the system using media the registration status will not be "
"updated and the system will be still registered using the previous product. "
"The packages from the registration repositories can conflict with the new "
"packages.</p>"
msgstr ""
"<p>ຖ້າທ່ານອັບເກຣດລະບົບໂດຍໃຊ້ສື່ ສະຖານະການລົງທະບຽນຈະບໍ່ຖືກອັບເດດ ແລະ ລະບົບຈະຍັງຄົງຖືກລົງທະບຽນໂດ"
"ຍໃຊ້ຜະລິດຕະພັນກ່ອນໜ້າ. ແພັກເກດຈາກຄັງຊອບແວການລົງທະບຽນອາດຈະຂັດແຍ້ງກັບແພັກເກດໃໝ່.</p>"

#. TRANSLATORS: dialog title
#: src/lib/registration/ui/migration_selection_dialog.rb:64
msgid "Select the Migration Target"
msgstr "ເລືອກເປົ້າໝາຍການຍ້າຍລະບົບ"

#. TRANSLATORS: help text (1/3)
#: src/lib/registration/ui/migration_selection_dialog.rb:67
msgid ""
"<p>Here you can select the migration target products. The registrationserver "
"may offer several possible migration to new products.</p>"
msgstr ""
"<p>ຢູ່ບ່ອນນີ້ທ່ານສາມາດເລືອກຜະລິດຕະພັນເປົ້າໝາຍການຍ້າຍລະບົບ. ເຊີເວີການລົງທະບຽນອາດຈະມີຫຼາຍທາງເລືອກໃ"
"ນການຍ້າຍໄປຫາຜະລິດຕະພັນໃໝ່.</p>"

#. TRANSLATORS: help text (2/3)
#: src/lib/registration/ui/migration_selection_dialog.rb:70
msgid "<p>Only one migration target from the list can be selected.</p>"
msgstr "<p>ສາມາດເລືອກເປົ້າໝາຍການຍ້າຍລະບົບໄດ້ພຽງຢ່າງດຽວຈາກລາຍຊື່.</p>"

#. TRANSLATORS: help text (3/3), %s is replaced by the (translated) check box label
#: src/lib/registration/ui/migration_selection_dialog.rb:72
#, c-format
msgid ""
"<p>Use the <b>%s</b> check box to manually select the migration repositories "
"later.</p>"
msgstr ""
"<p>ໃຊ້ກ່ອງເຄື່ອງໝາຍ <b>%s</b> ເພື່ອເລືອກຄັງຊອບແວການຍ້າຍລະບົບດ້ວຍຕົນເອງໃນພາຍຫຼັງ.</p>"

#: src/lib/registration/ui/migration_selection_dialog.rb:73
msgid "Manually Select Migration Repositories"
msgstr "ເລືອກຄັງຊອບແວການຍ້າຍລະບົບດ້ວຍຕົນເອງ"

#. TRANSLATORS: error popup, no target migration is selected
#: src/lib/registration/ui/migration_selection_dialog.rb:99
msgid "Select the target migration."
msgstr "ເລືອກເປົ້າໝາຍການຍ້າຍລະບົບ."

#. TRANSLATORS: check button label
#: src/lib/registration/ui/migration_selection_dialog.rb:138
msgid "Manually Adjust the Repositories for Migration"
msgstr "ປັບແຕ່ງຄັງຊອບແວສຳລັບການຍ້າຍລະບົບດ້ວຍຕົນເອງ"

#. TRANSLATORS: selection box label
#: src/lib/registration/ui/migration_selection_dialog.rb:153
msgid "Possible Migration Targets"
msgstr "ເປົ້າໝາຍການຍ້າຍລະບົບທີ່ເປັນໄປໄດ້"

#. TRANSLATORS: Upgrade target. The first %s stands for base product name and
#. the second for extensions or modules count.
#. Example: SUSE Linux Enterprise Server 15 x86_64 including 8 modules
#: src/lib/registration/ui/migration_selection_dialog.rb:171
#, c-format
msgid "%s including %s"
msgstr "%s ລວມທັງ %s"

#. TRANSLATORS: Upgrade target. The first %s stands for base product name,
#. the second for modules count and the third for extensions count.
#. Example: SUSE Linux Enterprise Server 15 x86_64 including 8 modules and 2 extensions
#: src/lib/registration/ui/migration_selection_dialog.rb:176
#, c-format
msgid "%s including %s and %s"
msgstr "%s ລວມທັງ %s ແລະ %s"

#. TRANSLATORS: number of extensions to upgrade. Will be used later to
#. construct whole status of upgrade
#: src/lib/registration/ui/migration_selection_dialog.rb:196
#, c-format
msgid "%i extension"
msgid_plural "%i extensions"
msgstr[0] "%i ສ່ວນເສີມ"
msgstr[1] "%i ສ່ວນເສີມ"

#. TRANSLATORS: number of modules to upgrade. Will be used later to
#. construct whole status of upgrade
#: src/lib/registration/ui/migration_selection_dialog.rb:206
#, c-format
msgid "%i module"
msgid_plural "%i modules"
msgstr[0] "%i ໂມດູນ"
msgstr[1] "%i ໂມດູນ"

#. TRANSLATORS: RichText header (details for the selected item)
#: src/lib/registration/ui/migration_selection_dialog.rb:255
msgid "Migration Summary"
msgstr "ບົດສະຫຼຸບການຍ້າຍລະບົບ"

#. TRANSLATORS: Summary message in rich text format
#. %s is a product name, e.g. "SUSE Linux Enterprise Server 12 SP1 x86_64"
#: src/lib/registration/ui/migration_selection_dialog.rb:276
#, c-format
msgid ""
"The registration server does not offer migrations for Product <b>%s</b> so "
"it will <b>stay unchanged</b>. We recommend you to check if it's correct and "
"to configure the repositories manually when needed."
msgstr ""
"ເຊີເວີການລົງທະບຽນບໍ່ມີການຍ້າຍລະບົບສຳລັບຜະລິດຕະພັນ <b>%s</b> ດັ່ງນັ້ນມັນຈະ <b>ບໍ່ມີການປ່ຽນແປງ</b>"
". ພວກເຮົາແນະນຳໃຫ້ທ່ານກວດສອບວ່າຖືກຕ້ອງຫຼືບໍ່ ແລະ ຕັ້ງຄ່າຄັງຊອບແວດ້ວຍຕົນເອງເມື່ອຈຳເປັນ."

#. TRANSLATORS: An error message displayed in the migration details.
#. The product has not been mirrored to the SMT/RMT server and cannot be used
#. for migration. The SMT/RMT admin has to mirror the product to allow
#. using the selected migration.
#. %{url} is the URL of the SMT/RMT registration server
#. %{product} is a full product name, e.g. "SUSE Linux Enterprise Server 12"
#: src/lib/registration/ui/migration_selection_dialog.rb:299
#, perl-brace-format
msgid ""
"ERROR: Product <b>%{product}</b> is not available at the registration server "
"(%{url}). Make the product available to allow using this migration."
msgstr ""
"ຂໍ້ຜິດພາດ: ຜະລິດຕະພັນ <b>%{product}</b> ບໍ່ມີໃຫ້ໃຊ້ງານຢູ່ທີ່ເຊີເວີການລົງທະບຽນ (%{url}). ກະລຸນາເ"
"ຮັດໃຫ້ຜະລິດຕະພັນພ້ອມໃຊ້ງານເພື່ອໃຫ້ສາມາດໃຊ້ການຍ້າຍລະບົບນີ້ໄດ້."

