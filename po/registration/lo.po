msgid "Extensions and Modules"
msgstr "ສ່ວນເສີມ ແລະ ໂມດູນ"

#: src/data/registration/certificate_error.erb:6
msgid "Secure Connection Error"
msgstr "ການເຊື່ອມຕໍ່ທີ່ປອດໄພຜິດພາດ"

#: src/data/registration/certificate_error.erb:10
msgid "Details:"
msgstr "ລາຍລະອຽດ:"

#: src/data/registration/certificate_error.erb:18
msgid ""
"The issuer certificate cannot be found, it needs to be installed manually."
msgstr "ບໍ່ພົບໃບຢັ້ງຢືນຂອງຜູ້ອອກບັດ, ຕ້ອງຕິດຕັ້ງດ້ວຍຕົນເອງ."

#: src/data/registration/certificate_error.erb:26
#, perl-brace-format
msgid "Save the server certificate in PEM format to file %{file}"
msgstr "ບັນທຶກໃບຢັ້ງຢືນເຊີເວີໃນຮູບແບບ PEM ໄປຍັງໄຟລ໌ %{file}"

#: src/data/registration/certificate_error.erb:32
msgid "Run command:"
msgstr "ດຳເນີນການຄຳສັ່ງ:"

#: src/data/registration/certificate_error.erb:37
msgid "Run registration again"
msgstr "ດຳເນີນການລົງທະບຽນຄືນໃໝ່"

#: src/data/registration/certificate_error.erb:47
msgid "Failed Certificate Details"
msgstr "ລາຍລະອຽດໃບຢັ້ງຢືນທີ່ລົ້ມເຫຼວ"

#: src/data/registration/certificate_summary.erb:4
#: src/lib/registration/ssl_certificate_details.rb:33
msgid "Issued To"
msgstr "ອອກໃຫ້ແກ່"

#. label followed by the SSL certificate identification
#: src/data/registration/certificate_summary.erb:7
#: src/data/registration/certificate_summary.erb:16
#: src/lib/registration/ssl_certificate_details.rb:59
msgid "Common Name (CN): "
msgstr "ຊື່ສາມັນ (CN): "

#. label followed by the SSL certificate identification
#: src/data/registration/certificate_summary.erb:8
#: src/data/registration/certificate_summary.erb:17
#: src/lib/registration/ssl_certificate_details.rb:61
msgid "Organization (O): "
msgstr "ອົງກອນ (O): "

#. label followed by the SSL certificate identification
#: src/data/registration/certificate_summary.erb:9
#: src/data/registration/certificate_summary.erb:18
#: src/lib/registration/ssl_certificate_details.rb:63
msgid "Organization Unit (OU): "
msgstr "ໜ່ວຍງານອົງກອນ (OU): "

#: src/data/registration/certificate_summary.erb:13
#: src/lib/registration/ssl_certificate_details.rb:34
msgid "Issued By"
msgstr "ອອກໂດຍ"

#: src/data/registration/certificate_summary.erb:22
msgid "Validity"
msgstr "ໄລຍະເວລາການນຳໃຊ້"

#: src/data/registration/certificate_summary.erb:26
msgid "Issued On: "
msgstr "ອອກໃຫ້ເມື່ອ: "

#: src/data/registration/certificate_summary.erb:29
msgid "WARNING: The certificate is not valid yet!"
msgstr "ຄຳເຕືອນ: ໃບຢັ້ງຢືນຍັງບໍ່ທັນມີຜົນນຳໃຊ້!"

#: src/data/registration/certificate_summary.erb:32
msgid "Expires On: "
msgstr "ໝົດອາຍຸເມື່ອ: "

#: src/data/registration/certificate_summary.erb:35
msgid "WARNING: The certificate has expired!"
msgstr "ຄຳເຕືອນ: ໃບຢັ້ງຢືນໝົດອາຍຸແລ້ວ!"

#: src/data/registration/certificate_summary.erb:43
msgid "Serial Number: "
msgstr "ເລກລຳດັບ: "

#: src/data/registration/certificate_summary.erb:44
#: src/lib/registration/ssl_certificate_details.rb:34
msgid "SHA1 Fingerprint: "
msgstr "ລາຍນິ້ວມື SHA1: "

#: src/data/registration/certificate_summary.erb:46
#: src/lib/registration/ssl_certificate_details.rb:36
msgid "SHA256 Fingerprint: "
msgstr "ລາຍນິ້ວມື SHA256: "

