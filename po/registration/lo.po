msgstr "ການຕັ້ງຄ່າການລົງທະບຽນ"

#: src/data/registration/autoyast_summary.erb:17
#, c-format
msgid "E-mail Address: %s"
msgstr "ທີ່ຢູ່ອີເມວ: %s"

#: src/data/registration/autoyast_summary.erb:19
