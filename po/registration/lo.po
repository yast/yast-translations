#. Find all available addons
#.
#. @return [:next]
#: src/lib/registration/clients/online_search.rb:151
msgid "Initializing..."
msgstr "ກຳລັງເລີ່ມຕົ້ນລະບົບ..."

#: src/lib/registration/clients/online_search.rb:151
msgid "Fetching the list of known modules/extensions"
msgstr "ກຳລັງດຶງຂໍ້ມູນລາຍຊື່ໂມດູນ/ສ່ວນເສີມທີ່ຮູ້ຈັກ"

#. TRANSLATORS: 'name' is the package's name
#: src/lib/registration/clients/online_search.rb:246
#, perl-brace-format
msgid "Package %{name} could not be selected for installation."
msgstr "ແພັກເກດ %{name} ບໍ່ສາມາດຖືກເລືອກເພື່ອຕິດຕັ້ງໄດ້."

#. Returns a message about unregistered systems not being able to use the online search feature
#.
#. @return [String]
#: src/lib/registration/clients/online_search.rb:259
msgid ""
"YaST requires your system to be registered in order to perform an online "
"search. Alternatively, use the web version at 'https://scc.suse.com/"
"packages/'."
msgstr ""
"YaST ຕ້ອງການໃຫ້ລະບົບຂອງທ່ານລົງທະບຽນກ່ອນເພື່ອເຮັດການຄົ້ນຫາອອນລາຍ. ຫຼື ອີກທາງເລືອກໜຶ່ງ, ໃຫ້ໃຊ້ເວີຊັນ"
"ເວັບໄດ້ທີ່ 'https://scc.suse.com/packages/'."

#. Returns a message about SMT/RMT not supporting the online search feature
#.
#. @return [String]
#: src/lib/registration/clients/online_search.rb:273
msgid ""
"This system is registered through an SMT/RMT server. Unfortunately, the "
"online search feature is not supported in this scenario. Alternatively, use "
"the web version at'https://scc.suse.com/packages/'."
msgstr ""
"ລະບົບນີ້ຖືກລົງທະບຽນຜ່ານເຊີເວີ SMT/RMT. ໜ້າເສຍດາຍ, ຄຸນສົມບັດການຄົ້ນຫາອອນລາຍບໍ່ຮອງຮັບໃນກໍລະນີນີ້ນ. "
"ຫຼື ອີກທາງເລືອກໜຶ່ງ, ໃຫ້ໃຊ້ເວີຊັນເວັບໄດ້ທີ່ 'https://scc.suse.com/packages/'."

#. TRANSLATORS: error message, %s is the XML path, e.g. "software/products"
#: src/lib/registration/clients/scc_auto.rb:215
#, c-format
msgid "Missing product specification in the %s section"
msgstr "ຂາດຂໍ້ມູນຜະລິດຕະພັນໃນພາກສ່ວນ %s"

#. TRANSLATORS: error message, %s is a product ID, e.g. "SLES"
#: src/lib/registration/clients/scc_auto.rb:225
#, c-format
msgid "Product %s not found"
msgstr "ບໍ່ພົບຜະລິດຕະພັນ %s"

#. popup message: registration finished properly
#: src/lib/registration/clients/scc_auto.rb:254
msgid "Registration was successfull."
msgstr "ການລົງທະບຽນສຳເລັດແລ້ວ."

#. remove possible duplicates
#: src/lib/registration/clients/scc_auto.rb:274
msgid "SLP discovery failed, no server found"
msgstr "ການຄົ້ນຫາ SLP ລົ້ມເຫຼວ, ບໍ່ພົບເຊີເວີ"

#. download and install the specified SSL certificate to the system
#. @param url [String] URL of the certificate
#: src/lib/registration/clients/scc_auto.rb:293
msgid "Downloading SSL Certificate"
msgstr "ກຳລັງດາວໂຫຼດໃບຢັ້ງຢືນ SSL"

#: src/lib/registration/clients/scc_auto.rb:297
msgid "Importing SSL Certificate"
msgstr "ກຳລັງນຳເຂົ້າໃບຢັ້ງຢືນ SSL"

#. TRANSLATORS: profile wants to do registration, but old system is not registered.
#: src/lib/registration/clients/scc_auto.rb:410
msgid ""
"The old system is not registered and the AutoYaST profile requires "
"registration.\n"
"Either register the old system before running the upgrade or \n"
"remove the registration section from the AutoYaST profile \n"
"and use full medium."
msgstr ""
"ລະບົບເກົ່າຍັງບໍ່ໄດ້ລົງທະບຽນ ແລະ ໂປຣໄຟລ໌ AutoYaST ຕ້ອງການການລົງທະບຽນ.\n"
"ໃຫ້ລົງທະບຽນລະບົບເກົ່າກ່ອນດຳເນີນການອັບເກຣດ ຫຼື \n"
"ລຶບພາກສ່ວນການລົງທະບຽນອອກຈາກໂປຣໄຟລ໌ AutoYaST \n"
"ແລ້ວໃຊ້ສື່ການຕິດຕັ້ງແບບເຕັມແທນ."

#. Error popup
#: src/lib/registration/connect_helpers.rb:81
msgid "Connection timed out."
msgstr "ໝົດເວລາການເຊື່ອມຕໍ່."

#: src/lib/registration/connect_helpers.rb:82
msgid ""
"Make sure that the registration server is reachable and\n"
"the connection is reliable."
msgstr ""
"ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າສາມາດເຊື່ອມຕໍ່ຫາເຊີເວີການລົງທະບຽນໄດ້ ແລະ\n"
"ການເຊື່ອມຕໍ່ມີຄວາມສະຖຽນ."

#. TRANSLATORS: %d is an integer
#: src/lib/registration/connect_helpers.rb:90
#, c-format
msgid "HTTP error code: %d\n"
msgstr "ລະຫັດຂໍ້ຜິດພາດ HTTP: %d\n"

#. update the message when an old SMT/RMT server is found
#. Error popup
#: src/lib/registration/connect_helpers.rb:94
#: src/lib/registration/connect_helpers.rb:99
#: src/lib/registration/connect_helpers.rb:106
#: src/lib/registration/connect_helpers.rb:116
#: src/lib/registration/connect_helpers.rb:145
msgid "Connection to registration server failed."
msgstr "ການເຊື່ອມຕໍ່ຫາເຊີເວີການລົງທະບຽນລົ້ມເຫຼວ."

#: src/lib/registration/connect_helpers.rb:110
msgid "Registration client error."
msgstr "ຂໍ້ຜິດພາດຈາກໄຄເອັນການລົງທະບຽນ."

#: src/lib/registration/connect_helpers.rb:113
msgid ""
"Registration server error.\n"
"Retry the operation later."
msgstr ""
"ຂໍ້ຜິດພາດຈາກເຊີເວີການລົງທະບຽນ.\n"
"ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ."

#. update the message when an old SMT/RMT server is found
#: src/lib/registration/connect_helpers.rb:140
msgid "Cannot parse the data from server."
msgstr "ບໍ່ສາມາດວິເຄາະຂໍ້ມູນຈາກເຊີເວີໄດ້."

#. %s are error details
#: src/lib/registration/connect_helpers.rb:187
#, c-format
msgid "Details: %s"
msgstr "ລາຍລະອຽດ: %s"

#. error message
#: src/lib/registration/connect_helpers.rb:226
msgid "Received SSL Certificate does not match the expected certificate."
msgstr "ໃບຢັ້ງຢືນ SSL ທີ່ໄດ້ຮັບບໍ່ກົງກັບໃບຢັ້ງຢືນທີ່ຄາດໄວ້."

#. TRANSLATORS: multiline error message - a SSL certificate has been
#. imported but the registration server still cannot be accessed securely,
#. user has to solve the certificate issue manually.
#: src/lib/registration/connect_helpers.rb:266
msgid ""
"A certificate has been already imported\n"
"but the server connection still cannot be trusted.\n"
"\n"
"Please fix the certificate issue manually, ensure that the server\n"
"can be connected securely and start the YaST module again."
msgstr ""
"ມີການນຳເຂົ້າໃບຢັ້ງຢືນແລ້ວ\n"
"ແຕ່ການເຊື່ອມຕໍ່ເຊີເວີຍັງບໍ່ທັນເປັນທີ່ໜ້າເຊື່ອຖື.\n"
"\n"
"ກະລຸນາແກ້ໄຂບັນຫາໃບຢັ້ງຢືນດ້ວຍຕົນເອງ, ກວດສອບໃຫ້ແນ່ໃຈວ່າເຊີເວີ\n"
"ສາມາດເຊື່ອມຕໍ່ໄດ້ຢ່າງປອດໄພ ແລ້ວເລີ່ມໂມດູນ YaST ໃໝ່."

