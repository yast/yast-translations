msgstr "Ajutor"

#. TRANSLATORS: help text
#: keyboard/src/lib/y2keyboard/dialogs/layout_selector.rb:128
msgid ""
"\n"
"<p><big><b>Keyboard Configuration</b></big></p><p>\n"
"Choose the <b>Keyboard Layout</b> to use for installation and in the "
"installed system.<br>Test the layout in <b>Test</b>.</p>"
msgstr ""
"\n"
"<p><big><b>Configurația tastaturii</b></big></p><p>\n"
"Alegeți <b>Aranjamentul de tastatură</b> care urmează să fie utilizat pentru "
"instalare și în sistemul instalat.<br>Testați aspectul în <b>Test</b>.</p>"

#. TRANSLATORS: the "%s" is the kaymap name
#: keyboard/src/modules/Keyboard.rb:294
#, c-format
msgid "Cannot find keymap: %s. Taking default one."
msgstr "Nu se poate găsi harta tastelor: %s. Luând implicit una."

