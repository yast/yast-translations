#. heading text
#: language/src/clients/select_language.rb:115
msgid "Languages"
msgstr "Limbi"

#. heading text
#: language/src/clients/select_language.rb:123
msgid "Welcome to System Repair"
msgstr "Bine ați venit la utilitarul de reparare a sistemului"

#. button label
#: language/src/clients/select_language.rb:165
msgid "&Details"
msgstr "&Detalii"

#. multiselection box label
#: language/src/clients/select_language.rb:178
msgid "&Secondary Languages"
msgstr "&Limbi secundare"

#. combo box label
#: language/src/clients/select_language.rb:189
msgid "Primary &Language"
msgstr "&Limba principală"

#. frame label
#: language/src/clients/select_language.rb:199
msgid "Primary Language Settings"
msgstr "Setările limbii principale"

#. help text (language dependent packages) - at the end of help
#: language/src/clients/select_language.rb:231
msgid ""
"<p>\n"
"Additional packages with support for the selected primary and secondary "
"languages will be installed. Packages no longer needed will be removed.\n"
"</p>"
msgstr ""
"<p>\n"
"Vor fi instalate pachete suplimentare cu suport pentru limbile principale și "
"secundare selectate. Pachetele care nu mai sunt necesare vor fi eliminate.\n"
"</p>"

#. help text for initial (first time) language screen
#: language/src/clients/select_language.rb:239
msgid ""
"<p>\n"
"Choose the <b>Language</b> to use during installation and for\n"
"the installed system.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Alegeți <b>Limba</b> de utilizat în timpul instalării și pentru\n"
"sistemul instalat.\n"
"</p>\n"

#. help text, continued
#: language/src/clients/select_language.rb:249
msgid ""
"<p>\n"
"Click <b>Next</b> to proceed to the next dialog.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Faceți clic pe <b>Următorul</b> pentru a trece la următoarea fereastră de "
"dialog.\n"
"</p>\n"

#. help text, continued
#: language/src/clients/select_language.rb:259
msgid ""
"<p>\n"
"Nothing will happen to your computer until you confirm\n"
"all your settings in the last installation dialog.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Nu se va întâmpla nimic cu calculatorul dvs. până când nu confirmați\n"
"toate setările din ultima fereastră de dialog de instalare.\n"
"</p>\n"

#. help text, continued
#: language/src/clients/select_language.rb:270
msgid ""
"<p>\n"
"You can select <b>Abort</b> at any time to abort the\n"
"installation process.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Puteți selecta <b>Anulare</b> în orice moment pentru a întrerupe\n"
"procesul de instalare.\n"
"</p>\n"

#. different help text when called after installation
#. in an installed system
#: language/src/clients/select_language.rb:281
msgid ""
"<p>\n"
"Choose the new <b>Language</b> for your system.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Alegeți noua <b>Limbă</b> pentru sistemul dvs.\n"
"</p>\n"

#. help text when "multiple languages" are suported 1/2
#: language/src/clients/select_language.rb:290
msgid ""
"<p>\n"
"Choose the new <b>Primary Language</b> for your system.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Alegeți noua <b>Limbă principală</b> pentru sistemul dvs.\n"
"</p>\n"

#. help text for 'adapt keyboard checkbox'
#: language/src/clients/select_language.rb:300
msgid ""
"<p>\n"
"Check <b>Adapt Keyboard Layout</b> to change the keyboard layout to the "
"primary language.\n"
"Check <b>Adapt Time Zone</b> to change the current time zone according to "
"the primary language. If the keyboard layout or time zone is already adapted "
"to the default language setting, the respective option is disabled.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Bifați <b>Adaptare aranjament tastatură</b> pentru a schimba aranjamentul "
"tastaturii la limba principală.\n"
"Bifați <b>Adaptare fus orar</b> pentru a schimba fusul orar curent în "
"funcție de limba principală. În cazul în care aranjamentul tastaturii sau "
"fusul orar este deja adaptat la setarea implicită a limbii, opțiunea "
"respectivă este dezactivată.\n"
"</p>\n"

#. help text when "multiple languages" are suported 2/2
#: language/src/clients/select_language.rb:312
msgid ""
"<p>\n"
"<b>Secondary Languages</b><br>\n"
"In the selection box, specify additional languages to use on your system.\n"
"</p>\n"
msgstr ""
"<p>\n"
"<b>Limbi secundare</b><br>\n"
"În caseta de selecție, specificați limbile suplimentare care urmează să fie "
"utilizate pe sistemul dvs.\n"
"</p>\n"

#. error message - package solver failed
#: language/src/clients/select_language.rb:533
msgid "There are unresolved package dependencies."
msgstr "Există dependențe de pachete nerezolvate."

#. error message
#: language/src/clients/select_language.rb:550
msgid ""
"There is not enough space to install all additional packages.\n"
"Remove some languages from the selection."
msgstr ""
"Nu există suficient spațiu pentru a instala toate pachetele suplimentare.\n"
"Eliminați unele limbi din selecție."

#. help text for langauge expert screen
#: language/src/clients/select_language.rb:572
msgid ""
"<p>\n"
"Here, fine-tune settings for the language handling.\n"
"These settings are written into the file <tt>/etc/sysconfig/language</tt>.\n"
"If unsure, use the default values already selected.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Aici faceți ajustările pentru configurarea limbii.\n"
"Aceste setări sunt scrise în fișierul <tt>/etc/sysconfig/language</tt>.\n"
"Dacă nu sunteți sigur, folosiți valorile implicite deja selectate.\n"
"</p>\n"

#. help text for langauge expert screen
#: language/src/clients/select_language.rb:584
msgid ""
"<p>Use <b>Detailed Locale Setting</b> to set a locale for the primary "
"language that is not offered in the list in the main dialog. Translation may "
"not be available for the selected locale.</p>"
msgstr ""
"<p>Utilizați <b>Setare locală detaliată</b> pentru a seta o locație pentru "
"limba principală care nu este oferită în lista din fereastra de dialog "
"principală. Este posibil ca traducerea să nu fie disponibilă pentru "
"localitatea selectată.</p>"

#. heading text
#: language/src/clients/select_language.rb:617
msgid "Language Details"
msgstr "Detalii limbă"

#. checkbox label
#: language/src/clients/select_language.rb:623
msgid "Use &UTF-8 Encoding"
msgstr "Utilizare codare &UTF-8"

#. combo box label
#: language/src/clients/select_language.rb:632
msgid "&Detailed Locale Setting"
msgstr "&Setare locală detaliată"

#. check box label (%1 is keyboard layout name)
#: language/src/clients/select_language.rb:686
#, ycp-format
msgid "Adapt &Keyboard Layout to %1"
msgstr "Adaptare aranjament tastatură la %1"

#. check box label (%1 is country name)
#: language/src/clients/select_language.rb:693
#, ycp-format
msgid "Adapt &Time Zone to %1"
msgstr "Adaptați &fusul orar la %1"

#. Widget help text
#.
#. @return [String]
#: language/src/lib/y2country/widgets/language_selection.rb:67
msgid ""
"<p>\n"
"Choose the <b>Language</b> to be used during\n"
"installation and on the installed system.\n"
"</p>\n"
msgstr ""
"<p>\n"
"Alegeți <b>Limba</b> care va fi utilizată în timpul\n"
"instalării și pe sistemul instalat.\n"
"</p>\n"

#. busy message
#: language/src/modules/Language.rb:374
msgid "Downloading installation system language extension..."
msgstr "Se descarcă extensia de limbă a sistemului de instalare..."

#. TRANSLATORS: Error message. Strings marked %{...} will be replaced
#. with variable content - do not translate them, please.
#: language/src/modules/Language.rb:406
#, perl-brace-format
msgid ""
"Language '%{language}' was not found within the list of supported languages\n"
"available at %{directory}.\n"
"\n"
"Fallback language %{fallback} will be used."
msgstr ""
"Limba '%{language}' nu a fost găsită în lista de limbi acceptate\n"
"disponibile la %{directory}.\n"
"\n"
"Se va utiliza o limbă de rezervă %{fallback}."

#. summary label
#. summary label
#: language/src/modules/Language.rb:787 language/src/modules/Language.rb:859
#, ycp-format
msgid "Primary Language: %1"
msgstr "Limba principală: %1"

#. TRANSLATORS: the "%s" is replaced by the executed command
#: language/src/modules/Language.rb:929
#, c-format
msgid ""
"Could not save the language setting, the command\n"
"%s\n"
"failed."
msgstr ""
"Nu s-a putut salva setarea limbii, comanda\n"
"%s\n"
