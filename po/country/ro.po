#. Main dialog where the layouts are listed and can be selected.
#: keyboard/src/lib/y2keyboard/dialogs/layout_selector.rb:57
msgid "System Keyboard Configuration"
msgstr "Configurarea tastaturii sistemului"

#: keyboard/src/lib/y2keyboard/dialogs/layout_selector.rb:64
msgid "&Test"
msgstr "&Test"

#. not in AY configuration module
#: keyboard/src/lib/y2keyboard/dialogs/layout_selector.rb:116
