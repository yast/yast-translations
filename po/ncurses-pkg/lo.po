msgstr "ຖືກປ້ອງກັນ"

#: libyui-ncurses-pkg/src/NCPkgFilterInstSummary.cc:57
msgid "Keep"
msgstr "ຮັກສາໄວ້"

#: libyui-ncurses-pkg/src/NCPkgFilterInstSummary.cc:59
msgid "Do not install"
