#. fill selection box
#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:57
msgid "Suggested Packages"
msgstr "ແພັກເກດທີ່ແນະນຳໃຫ້ໃຊ້"

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:60
msgid "Recommended Packages"
msgstr "ແພັກເກດທີ່ຄວນຕິດຕັ້ງ"

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:63
msgid "Orphaned Packages"
msgstr "ແພັກເກດທີ່ບໍ່ມີແຫຼ່ງທີ່ມາ"

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:66
msgid "Unneeded Packages"
msgstr "ແພັກເກດທີ່ບໍ່ຈຳເປັນ"

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:69
msgid "Multiversion Packages"
msgstr "ແພັກເກດທີ່ມີຫຼາຍລຸ້ນ"

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:72
msgid "Retracted Packages"
msgstr "ແພັກເກດທີ່ຖືກຖອນຄືນ"

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:75
msgid "Retracted Installed Packages"
msgstr "ແພັກເກດທີ່ຕິດຕັ້ງແລ້ວເຊິ່ງຖືກຖອນຄືນ"

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:78
msgid "All Packages"
msgstr "ແພັກເກດທັງໝົດ"

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:199
msgid ""
"This is a list of useful packages. They will be additionally installed if "
"recommended by a newly installed package."
msgstr ""
"ນີ້ແມ່ນລາຍການແພັກເກດທີ່ມີປະໂຫຍດ. ພວກມັນຈະຖືກຕິດຕັ້ງເພີ່ມເຕີມຫາກໄດ້ຮັບການແນະນຳໂດຍແພັກເກດທີ່ຕິດຕັ້ງໃໝ່."

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:203
msgid ""
"It's suggested to install these packages because they fit to already "
"installed packages. The decision to install it is by the user."
msgstr ""
"ຂໍແນະນຳໃຫ້ຕິດຕັ້ງແພັກເກດເຫຼົ່ານີ້ເພາະມັນເໝາະສົມກັບແພັກເກດທີ່ຕິດຕັ້ງແລ້ວ. ການຕັດສິນໃຈຕິດຕັ້ງແມ່ນຂຶ້ນກັບຜູ້ໃຊ້."

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:207
msgid ""
"The solver has detected that these packages are without a repository, i.e. "
"updates aren't possible."
msgstr ""
"ລະບົບກວດພົບວ່າແພັກເກດເຫຼົ່ານີ້ບໍ່ມີຄັງເກັບຊອບແວ, ເຊິ່ງເຮັດໃຫ້ບໍ່ສາມາດອັບເດດໄດ້."

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:211
msgid ""
"These packages might be unneeded because former dependencies don't apply any "
"longer."
msgstr ""
"ແພັກເກດເຫຼົ່ານີ້ອາດຈະບໍ່ຈຳເປັນອີກຕໍ່ໄປ ເພາະການຂຶ້ນຕໍ່ກັນໃນເມື່ອກ່ອນບໍ່ມີຜົນແລ້ວ."

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:215
msgid "These packages might be installed in several versions in parallel."
msgstr "ແພັກເກດເຫຼົ່ານີ້ອາດຈະຖືກຕິດຕັ້ງຫຼາຍລຸ້ນພ້ອມໆກັນ."

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:219
msgid ""
"These packages have versions that are retracted. Using those versions is "
"strongly discouraged."
msgstr ""
"ແພັກເກດເຫຼົ່ານີ້ມີລຸ້ນທີ່ຖືກຖອນຄືນ. ບໍ່ແນະນຳໃຫ້ໃຊ້ລຸ້ນເຫຼົ່ານີ້ຢ່າງເດັດຂາດ."

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:223
msgid ""
"These packages have a retracted version installed. Consider up- or "
"downgrading them to a different version."
msgstr ""
"ແພັກເກດເຫຼົ່ານີ້ມີລຸ້ນທີ່ຖືກຖອນຄືນຕິດຕັ້ງຢູ່. ກະລຸນາພິຈາລະນາອັບເກຣດ ຫຼື ດາວເກຣດໄປໃຊ້ລຸ້ນອື່ນ."

#: libyui-ncurses-pkg/src/NCPkgFilterClassification.cc:227
msgid "All packages known by the package manager, no filtering applied."
msgstr "ທຸກແພັກເກດທີ່ຕົວຈັດການແພັກເກດຮູ້ຈັກ, ໂດຍບໍ່ມີການໃຊ້ຕົວຕອງ."

