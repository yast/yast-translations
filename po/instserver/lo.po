#: src/include/instserver/dialogs.rb:1225
msgid "Invalid repository name."
msgstr "ຊື່ຄັງເກັບບໍ່ຖືກຕ້ອງ."

#. an error message - entered repository name already exists
#: src/include/instserver/dialogs.rb:1233
#, ycp-format
msgid ""
"Repository '%1' already exists,\n"
"enter another name."
msgstr ""
"ມີຄັງເກັບ '%1' ຢູ່ແລ້ວ,\n"
"ກະລຸນາໃສ່ຊື່ອື່ນ."

#. create directory only for a new repository
#: src/include/instserver/dialogs.rb:1246
#, ycp-format
msgid ""
"Error while creating <tt>repository</tt> directory.\n"
"Verify that the directory \n"
" %1 \n"
"is writable and try again.\n"
msgstr ""
"ເກີດຂໍ້ຜິດພາດຂະນະສ້າງໄດເຣັກທໍຣີ <tt>ຄັງເກັບ</tt>.\n"
"ກວດສອບວ່າໄດເຣັກທໍຣີ \n"
" %1 \n"
"ສາມາດຂຽນຂໍ້ມູນລົງໄດ້ຫຼືບໍ່ ແລ້ວລອງໃໝ່ອີກຄັ້ງ.\n"

#. confirm removal of a repository, the action is done immediately and cannot be reverted
#: src/include/instserver/dialogs.rb:1265
#, ycp-format
msgid ""
"Repository '%1' has been marked to delete.\n"
"When adding a new repository with the same name\n"
"the old content must deleted right now.\n"
"\n"
"Really delete the old content and create it from scratch?"
msgstr ""
"ຄັງເກັບ '%1' ຖືກໝາຍໄວ້ເພື່ອລຶບ.\n"
"ເມື່ອມີການເພີ່ມຄັງເກັບໃໝ່ທີ່ມີຊື່ດຽວກັນ\n"
"ເນື້ອໃນເກົ່າຕ້ອງຖືກລຶບຖິ້ມທັນທີ.\n"
"\n"
"ຕ້ອງການລຶບເນື້ອໃນເກົ່າ ແລະ ສ້າງໃໝ່ທັງໝົດແທ້ຫຼືບໍ່?"

