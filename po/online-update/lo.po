#: src/clients/online_update_select.rb:49
msgid "Initializing for CD update..."
msgstr "ກຳລັງເລີ່ມຕົ້ນການອັບເດດຈາກຊີດີ..."

#. error popup: cancel/retry buttons follow
#: src/clients/online_update_select.rb:61
msgid ""
"Initialization failed. Check that\n"
"you have inserted the correct CD.\n"
msgstr ""
"ການເລີ່ມຕົ້ນລົ້ມເຫຼວ. ກະລຸນາກວດສອບວ່າ\n"
"ທ່ານໄດ້ໃສ່ແຜ່ນຊີດີທີ່ຖືກຕ້ອງແລ້ວ.\n"

#. FATE#312509: Show if patch needs a reboot and offer
#. to delay the patch installation
#: src/clients/online_update_select.rb:189
#, ycp-format
msgid ""
"Cannot configure online update repository \n"
"without having package %1 installed"
msgstr ""
"ບໍ່ສາມາດຕັ້ງຄ່າຄັງອັບເດດອອນລາຍໄດ້ \n"
"ໂດຍທີ່ບໍ່ມີແພັກເກດ %1 ຕິດຕັ້ງໄວ້"

#. popup message
#: src/modules/OnlineUpdate.rb:46
msgid ""
"At least one of the updates installed requires restart of the session.\n"
"Log out and in again as soon as possible.\n"
msgstr ""
"ຢ່າງໜ້ອຍມີການອັບເດດໜຶ່ງລາຍການທີ່ຕິດຕັ້ງແລ້ວຕ້ອງການໃຫ້ເລີ່ມເຊດຊັນໃໝ່.\n"
"ກະລຸນາອອກຈາກລະບົບ ແລະ ເຂົ້າໃໝ່ໂດຍໄວທີ່ສຸດ.\n"

#. popup message
#: src/modules/OnlineUpdate.rb:51
msgid ""
"Packages for package management were updated.\n"
"Finishing and restarting YaST now."
msgstr ""
"ແພັກເກດສຳລັບການຈັດການແພັກເກດໄດ້ຮັບການອັບເດດແລ້ວ.\n"
"ກຳລັງຈະປິດ ແລະ ເລີ່ມ YaST ໃໝ່ຕອນນີ້."

#. popup message
#: src/modules/OnlineUpdate.rb:62
msgid ""
"At least one of the updates installed requires a system reboot to function\n"
"properly. Reboot the system as soon as possible."
msgstr ""
"ຢ່າງໜ້ອຍມີການອັບເດດໜຶ່ງລາຍການທີ່ຕິດຕັ້ງແລ້ວຕ້ອງການໃຫ້ເລີ່ມລະບົບໃໝ່ເພື່ອໃຫ້ເຮັດວຽກ\n"
"ໄດ້ຢ່າງຖືກຕ້ອງ. ກະລຸນາເລີ່ມລະບົບໃໝ່ໂດຍໄວທີ່ສຸດ."

#. popup message
#: src/modules/OnlineUpdate.rb:67
#, ycp-format
msgid ""
"These updates require a system reboot to function properly:\n"
"\n"
"%1.\n"
"\n"
"Reboot the system as soon as possible."
msgstr ""
"ການອັບເດດເຫຼົ່ານີ້ຕ້ອງການໃຫ້ເລີ່ມລະບົບໃໝ່ເພື່ອໃຫ້ເຮັດວຽກໄດ້ຢ່າງຖືກຕ້ອງ:\n"
"\n"
"%1.\n"
"\n"
"ກະລຸນາເລີ່ມລະບົບໃໝ່ໂດຍໄວທີ່ສຸດ."

#. continue/cancel popup text
#: src/modules/OnlineUpdate.rb:76
msgid ""
"There are patches for package management available that require a restart of "
"YaST.\n"
"They should be installed first and all other patches after the restart.\n"
"\n"
"You selected some other patches to be installed now.\n"
"\n"
"Continue with installing your selection?"
msgstr ""
"ມີແພັດຊ໌ສຳລັບການຈັດການແພັກເກດທີ່ຕ້ອງການໃຫ້ເລີ່ມ YaST ໃໝ່.\n"
"ຄວນຕິດຕັ້ງແພັດຊ໌ເຫຼົ່ານີ້ກ່ອນ ແລະ ແພັດຊ໌ອື່ນໆທັງໝົດຫຼັງຈາກເລີ່ມໃໝ່.\n"
"\n"
"ທ່ານໄດ້ເລືອກບາງແພັດຊ໌ອື່ນເພື່ອຕິດຕັ້ງຕອນນີ້.\n"
"\n"
"ຕ້ອງການສືບຕໍ່ຕິດຕັ້ງສິ່ງທີ່ທ່ານເລືອກໄວ້ບໍ?"

#. progress log item (%1 is name of package)
#: src/modules/OnlineUpdateCallbacks.rb:111
#, ycp-format
msgid "Retrieving %1..."
msgstr "ກຳລັງດຶງຂໍ້ມູນ %1..."

#. progress bar label
#: src/modules/OnlineUpdateCallbacks.rb:117
msgid "Package Download Progress"
msgstr "ຄວາມຄືບໜ້າການດາວໂຫຼດແພັກເກດ"

#. progress log action (what is being done with the package)
#: src/modules/OnlineUpdateCallbacks.rb:146
msgid "Removing"
msgstr "ກຳລັງຖອນການຕິດຕັ້ງ"

#: src/modules/OnlineUpdateCallbacks.rb:146
msgid "Installing"
msgstr "ກຳລັງຕິດຕັ້ງ"

#. progress bar label
#: src/modules/OnlineUpdateCallbacks.rb:161
msgid "Package Installation Progress"
msgstr "ຄວາມຄືບໜ້າການຕິດຕັ້ງແພັກເກດ"

#. progress log item (=previous action finished correctly)
#: src/modules/OnlineUpdateCallbacks.rb:174
msgid "OK"
msgstr "ຕົກລົງ"

#. Progress log. Leave the space at the end, some other text may follow
#: src/modules/OnlineUpdateCallbacks.rb:230
#, ycp-format
msgid "Downloading delta RPM %1 "
msgstr "ກຳລັງດາວໂຫຼດເດວຕ້າ RPM %1 "

#. progress bar label
#: src/modules/OnlineUpdateCallbacks.rb:236
msgid "Delta RPM Download Progress"
msgstr "ຄວາມຄືບໜ້າການດາວໂຫຼດເດວຕ້າ RPM"

#. progress log item (previous action failed(%1 is reason)
#: src/modules/OnlineUpdateCallbacks.rb:262
#, ycp-format
msgid "Failed to download delta RPM: %1"
msgstr "ດາວໂຫຼດເດວຕ້າ RPM ລົ້ມເຫຼວ: %1"

#. Progress log item (%1 is name of delta RPM).
#. Leave the space at the end, some other text may follow.
#: src/modules/OnlineUpdateCallbacks.rb:277
#, ycp-format
msgid "Applying delta RPM: %1 "
msgstr "ກຳລັງນຳໃຊ້ເດວຕ້າ RPM: %1 "

#. progress bar label
#: src/modules/OnlineUpdateCallbacks.rb:284
msgid "Delta RPM Application Progress"
msgstr "ຄວາມຄືບໜ້າການນຳໃຊ້ເດວຕ້າ RPM"

#. progress log item (previous action failed(%1 is reason)
#: src/modules/OnlineUpdateCallbacks.rb:313
#, ycp-format
msgid "Failed to apply delta RPM: %1"
msgstr "ນຳໃຊ້ເດວຕ້າ RPM ລົ້ມເຫຼວ: %1"

#. progress bar label
#: src/modules/OnlineUpdateCallbacks.rb:354
msgid "Script Execution Progress"
msgstr "ຄວາມຄືບໜ້າການເຮັດວຽກຂອງສະຄຣິບ"

#. log entry, %1 is name of the patch which contains the script
#: src/modules/OnlineUpdateCallbacks.rb:360
#, ycp-format
msgid "Starting script %1"
msgstr "ກຳລັງເລີ່ມສະຄຣິບ %1"

#. label, %1 is patch name with version and architecture
#: src/modules/OnlineUpdateCallbacks.rb:430
