#: src/lib/authui/sssd/params.rb:308 src/lib/authui/sssd/params.rb:320
#: src/lib/authui/sssd/params.rb:332 src/lib/authui/sssd/params.rb:350
msgid ""
"Level of details for logging. Can be numeric (0-9) or a big mask such as "
"0x0010 (lowest level) or 0xFFF (highest level)"
msgstr ""
"ລະດັບການບັນທຶກ Log. ສາມາດເປັນຕົວເລກ (0-9) ຫຼື mask ເຊັ່ນ 0x0010 (ຕ່ຳສຸດ) ຫຼື 0xFFF (ສູງສຸດ)"

#: src/lib/authui/sssd/params.rb:151
msgid "Add a timestamp to the debug messages"
msgstr "ເພີ່ມເວລາ (timestamp) ໃນຂໍ້ຄວາມແກ້ໄຂຂໍ້ຜິດພາດ (debug)"

#: src/lib/authui/sssd/params.rb:156
msgid "Add microseconds to the timestamp in debug messages"
msgstr "ເພີ່ມເສຍວວິນາທີ (microseconds) ໃນເວລາຂອງຂໍ້ຄວາມ debug"

#: src/lib/authui/sssd/params.rb:161
msgid "Timeout in seconds between heartbeats for this service"
msgstr "ໄລຍະເວລາລໍຖ້າ (ວິນາທີ) ລະຫວ່າງການກວດສອບການເຮັດວຽກ (heartbeats)"

#: src/lib/authui/sssd/params.rb:171
msgid ""
"Maximum number of file descriptors that may be opened at a time by SSSD "
"service process"
msgstr "ຈຳນວນ file descriptors ສູງສຸດທີ່ SSSD ສາມາດເປີດໄດ້ໃນເວລາດຽວກັນ"

#: src/lib/authui/sssd/params.rb:176
msgid ""
"Number of seconds a client of SSSD process can hold onto a file descriptor "
"without any communication"
msgstr ""
"ຈຳນວນວິນາທີທີ່ໄຄເອັນທ໌ຂອງ SSSD ສາມາດຖື file descriptor ໄວ້ໂດຍບໍ່ມີການຕິດຕໍ່"

#: src/lib/authui/sssd/params.rb:181
msgid ""
"The service will receive SIGTERM after this number of seconds of consecutive "
"ping check failure"
msgstr ""
"ບໍລິການຈະໄດ້ຮັບ SIGTERM ຫຼັງຈາກລົ້ມເຫຼວໃນການ ping ຕິດຕໍ່ກັນຕາມຈຳນວນວິນາທີນີ້"

#: src/lib/authui/sssd/params.rb:193
msgid ""
"How many seconds should cache nss_sss enumerations (requests for info about "
"all users)?"
msgstr ""
"ຄວນເກັບແຄຊການຮ້ອງຂໍຂໍ້ມູນຜູ້ໃຊ້ທັງໝົດ (nss_sss enumerations) ໄວ້ຈັກວິນາທີ?"

#: src/lib/authui/sssd/params.rb:198
msgid ""
"The entry cache can be set to automatically update entries in the background "
"if they are requested beyond a percentage of the entry_cache_timeout value "
"for the domain."
msgstr ""
"ສາມາດຕັ້ງຄ່າໃຫ້ແຄຊອັບເດດອັດຕະໂນມັດຢູ່ເບື້ອງຫຼັງ ຖ້າການຮ້ອງຂໍເກີນເປີເຊັນຂອງຄ່າ "
"entry_cache_timeout."

#: src/lib/authui/sssd/params.rb:203
msgid ""
"Specifies for how many seconds nss_sss should cache negative cache hits "
"(that is, queries for invalid database entries, like nonexistent ones) "
"before asking the back end again."
msgstr ""
"ກຳນົດຈຳນວນວິນາທີທີ່ nss_sss ຄວນເກັບແຄຊສຳລັບລາຍການທີ່ບໍ່ມີຢູ່ ກ່ອນທີ່ຈະຖາມລະບົບເບື້ອງຫຼັງໃໝ່."

#: src/lib/authui/sssd/params.rb:209
msgid "Exclude certain users from being fetched by SSS backend"
msgstr "ຍົກເວັ້ນຜູ້ໃຊ້ບາງຄົນບໍ່ໃຫ້ຖືກດຶງຂໍ້ມູນໂດຍ SSS backend"

#: src/lib/authui/sssd/params.rb:215
msgid "Exclude certain groups from being fetched by SSS backend"
msgstr "ຍົກເວັ້ນບາງກຸ່ມບໍ່ໃຫ້ຖືກດຶງຂໍ້ມູນໂດຍ SSS backend"

#: src/lib/authui/sssd/params.rb:220
msgid ""
"If you want filtered user to still be group members set this option to false."
msgstr ""
"ຖ້າຕ້ອງການໃຫ້ຜູ້ໃຊ້ທີ່ຖືກກອງອອກຍັງເປັນສະມາຊິກກຸ່ມຢູ່ ໃຫ້ຕັ້ງຄ່ານີ້ເປັນ false."

#: src/lib/authui/sssd/params.rb:224 src/lib/authui/sssd/params.rb:510
msgid ""
"Override the user's home directory. You can either provide an absolute value "
"or a template."
msgstr ""
"ຂຽນທັບໄດເຣັກທໍຣີຫຼັກຂອງຜູ້ໃຊ້. ເຈົ້າສາມາດລະບຸເປັນຄ່າໂດຍກົງ ຫຼື ເປັນຮູບແບບ (template)."

#: src/lib/authui/sssd/params.rb:228 src/lib/authui/sssd/params.rb:1256
msgid ""
"Set a default template for a user's home directory if one is not specified "
"explicitly by the domain's data provider."
msgstr "ຕັ້ງຄ່າຮູບແບບເລີ່ມຕົ້ນສຳລັບໄດເຣັກທໍຣີຫຼັກ ຖ້າບໍ່ໄດ້ລະບຸໄວ້ໂດຍກົງ."

#: src/lib/authui/sssd/params.rb:232
msgid "Override the login shell for all users."
msgstr "ຂຽນທັບ login shell ສຳລັບຜູ້ໃຊ້ທັງໝົດ."

#: src/lib/authui/sssd/params.rb:236
msgid "Restrict user shell to one of the listed values."
msgstr "ຈຳກັດ shell ຂອງຜູ້ໃຊ້ໃຫ້ເປັນໄປຕາມຄ່າທີ່ລະບຸໄວ້ເທົ່ານັ້ນ."

#: src/lib/authui/sssd/params.rb:240
msgid "Replace any instance of these shells with the shell_fallback"
msgstr "ແທນທີ່ shell ເຫຼົ່ານີ້ດ້ວຍ shell_fallback"

#: src/lib/authui/sssd/params.rb:245
msgid ""
"The default shell to use if an allowed shell is not installed on the machine."
msgstr "shell ເລີ່ມຕົ້ນທີ່ຈະໃຊ້ ຖ້າ shell ທີ່ອະນຸຍາດບໍ່ໄດ້ຕິດຕັ້ງຢູ່ໃນເຄື່ອງ."

#: src/lib/authui/sssd/params.rb:249 src/lib/authui/sssd/params.rb:1260
msgid ""
"The default shell to use if the provider does not return one during lookup."
msgstr "shell ເລີ່ມຕົ້ນທີ່ຈະໃຊ້ ຖ້າບໍ່ໄດ້ຮັບຄ່າຈາກຜູ້ໃຫ້ບໍລິການໃນເວລາຄົ້ນຫາ."

#: src/lib/authui/sssd/params.rb:254 src/lib/authui/sssd/params.rb:301
msgid ""
"Specifies time in seconds for which the list of subdomains will be "
"considered valid."
msgstr "ກຳນົດເວລາ (ວິນາທີ) ທີ່ລາຍຊື່ໂດເມນຍ່ອຍຈະຖືກຖືວ່າໃຊ້ໄດ້."

#: src/lib/authui/sssd/params.rb:259
msgid ""
"Specifies time in seconds for which records in the in-memory cache will be "
"valid."
msgstr "ກຳນົດເວລາ (ວິນາທີ) ທີ່ຂໍ້ມູນໃນແຄຊ (in-memory cache) ຈະຖືກຖືວ່າໃຊ້ໄດ້."

#: src/lib/authui/sssd/params.rb:271
msgid ""
"If the authentication provider is offline, how long we should allow cached "
"logins (in days since the last successful online login)."
msgstr ""
"ຖ້າຜູ້ໃຫ້ບໍລິການຢືນຢັນຕົວຕົນອອບລາຍ, ຈະອະນຸຍາດໃຫ້ເຂົ້າລະບົບດ້ວຍຂໍ້ມູນແຄຊໄດ້ຈັກມື້ (ນັບຈາກມື້ເຂົ້າລະບົບອອນລາ"
"ຍຫຼ້າສຸດ)."

#: src/lib/authui/sssd/params.rb:276 src/lib/authui/sssd/params.rb:281
msgid ""
"The time in minutes which has to pass after offline_failed_login_attempts "
"has been reached before a new login attempt is possible."
msgstr ""
"ເວລາ (ນາທີ) ທີ່ຕ້ອງລໍຖ້າຫຼັງຈາກເຂົ້າລະບົບອອບລາຍລົ້ມເຫຼວຄົບຕາມຈຳນວນ ກ່ອນທີ່ຈະລອງໃໝ່ໄດ້."

#: src/lib/authui/sssd/params.rb:286
msgid ""
"Controls what kind of messages are shown to the user during authentication."
msgstr "ຄວບຄຸມຂໍ້ຄວາມທີ່ຈະສະແດງໃຫ້ຜູ້ໃຊ້ເຫັນໃນລະຫວ່າງການຢືນຢັນຕົວຕົນ."

#: src/lib/authui/sssd/params.rb:291
msgid ""
"For any PAM request while SSSD is online, the SSSD will attempt to "
"immediately update the cached identity information for the user in order to "
"ensure that authentication takes place with the latest information."
msgstr ""
"ເມື່ອມີການຮ້ອງຂໍ PAM ໃນຂະນະທີ່ SSSD ອອນລາຍ, ມັນຈະພະຍາຍາມອັບເດດຂໍ້ມູນຕົວຕົນໃນແຄຊທັນທີເພື່ອໃຫ້ຂໍ້ມູນເ"
"ປັນປັດຈຸບັນທີ່ສຸດ."

#. The kerberos domain section
#: src/lib/authui/sssd/params.rb:296 src/lib/authui/sssd/params.rb:814
#: src/lib/authui/sssd/params.rb:1143
msgid "Display a warning N days before the password expires."
msgstr "ສະແດງຄຳເຕືອນກ່ອນລະຫັດຜ່ານຈະໝົດອາຍຸ N ມື້."

#: src/lib/authui/sssd/params.rb:313
msgid ""
"Whether or not to evaluate the sudoNotBefore and sudoNotAfter attributes "
"that implement time-dependent sudoers entries."
msgstr ""
"ຈະໃຫ້ກວດສອບຄຸນລັກສະນະ sudoNotBefore ແລະ sudoNotAfter ທີ່ກ່ຽວກັບເວລາຂອງ sudoers ຫຼືບໍ່."

#: src/lib/authui/sssd/params.rb:325
msgid ""
"Specifies for how many seconds the autofs responder should cache negative "
"hits before asking the back end again."
msgstr ""
"ກຳນົດຈຳນວນວິນາທີທີ່ autofs responder ຄວນເກັບແຄຊສຳລັບລາຍການທີ່ບໍ່ມີຢູ່ ກ່ອນທີ່ຈະຖາມໃໝ່."

#: src/lib/authui/sssd/params.rb:337
msgid ""
"Whether or not to hash host names and addresses in the managed known_hosts "
"file."
msgstr "ຈະໃຫ້ເຮັດ hash ຊື່ໂຮສ (host) ແລະ ທີ່ຢູ່ໃນໄຟລ໌ known_hosts ຫຼືບໍ່."

#: src/lib/authui/sssd/params.rb:342
msgid ""
"How many seconds to keep a host in the managed known_hosts file after its "
"host keys were requested."
msgstr ""
"ຈະເກັບຊື່ໂຮສໄວ້ໃນໄຟລ໌ known_hosts ຈັກວິນາທີ ຫຼັງຈາກທີ່ມີການຮ້ອງຂໍ host keys."

#: src/lib/authui/sssd/params.rb:355 src/lib/authui/sssd/params.rb:360
msgid ""
"UID and GID limits for the domain. If a domain contains an entry that is "
"outside these limits, it is ignored."
msgstr ""
"ຂີດຈຳກັດ UID ແລະ GID ສຳລັບໂດເມນ. ຖ້າມີຄ່າຢູ່ນອກຂີດຈຳກັດນີ້ ມັນຈະຖືກລະເລີຍ."

#: src/lib/authui/sssd/params.rb:366
msgid "Read all entities from backend database (increase server load)"
msgstr "ອ່ານຂໍ້ມູນທັງໝົດຈາກຖານຂໍ້ມູນ backend (ອາດເຮັດໃຫ້ເຊີເວີເຮັດວຽກໜັກຂຶ້ນ)"

#: src/lib/authui/sssd/params.rb:371
msgid ""
"If the service does not terminate after “force_timeout” seconds, the monitor "
"will forcibly shut it down by sending a SIGKILL signal."
msgstr ""
"ຖ້າບໍລິການບໍ່ຢຸດຫຼັງຈາກ “force_timeout” ວິນາທີ, ລະບົບຈະບັງຄັບປິດໂດຍການສົ່ງ SIGKILL."

#: src/lib/authui/sssd/params.rb:376
msgid ""
"How many seconds nss_sss should consider entries valid before asking the "
"backend again."
msgstr ""
"ຈຳນວນວິນາທີທີ່ nss_sss ຄວນຖືວ່າຂໍ້ມູນຍັງໃຊ້ໄດ້ ກ່ອນທີ່ຈະຖາມ backend ໃໝ່."

#: src/lib/authui/sssd/params.rb:381
msgid ""
"How many seconds nss_sss should consider user entries valid before asking "
"the backend again."
msgstr ""
"ຈຳນວນວິນາທີທີ່ nss_sss ຄວນຖືວ່າຂໍ້ມູນຜູ້ໃຊ້ຍັງໃຊ້ໄດ້ ກ່ອນທີ່ຈະຖາມ backend ໃໝ່."

#: src/lib/authui/sssd/params.rb:386
msgid ""
"How many seconds nss_sss should consider group entries valid before asking "
"the backend again."
msgstr ""
"ຈຳນວນວິນາທີທີ່ nss_sss ຄວນຖືວ່າຂໍ້ມູນກຸ່ມຍັງໃຊ້ໄດ້ ກ່ອນທີ່ຈະຖາມ backend ໃໝ່."

#: src/lib/authui/sssd/params.rb:391
msgid ""
"How many seconds nss_sss should consider netgroup entries valid before "
"asking the backend again."
msgstr ""
"ຈຳນວນວິນາທີທີ່ nss_sss ຄວນຖືວ່າຂໍ້ມູນ netgroup ຍັງໃຊ້ໄດ້ ກ່ອນທີ່ຈະຖາມ backend ໃໝ່."

#: src/lib/authui/sssd/params.rb:396
msgid ""
"How many seconds nss_sss should consider service entries valid before asking "
"the backend again."
msgstr ""
"ຈຳນວນວິນາທີທີ່ nss_sss ຄວນຖືວ່າຂໍ້ມູນການບໍລິການຍັງໃຊ້ໄດ້ ກ່ອນທີ່ຈະຖາມ backend ໃໝ່."

#: src/lib/authui/sssd/params.rb:401
msgid ""
"How many seconds sudo should consider rules valid before asking the backend "
"again."
msgstr ""
"ຈຳນວນວິນາທີທີ່ sudo ຄວນຖືວ່າກົດ (rules) ຍັງໃຊ້ໄດ້ ກ່ອນທີ່ຈະຖາມ backend ໃໝ່."

#: src/lib/authui/sssd/params.rb:406
msgid ""
"How many seconds the autofs service should consider automounter maps valid "
"before asking the backend again."
msgstr ""
"ຈຳນວນວິນາທີທີ່ autofs ຄວນຖືວ່າ automounter maps ຍັງໃຊ້ໄດ້ ກ່ອນທີ່ຈະຖາມ backend ໃໝ່."

#: src/lib/authui/sssd/params.rb:412
msgid "Cache credentials for offline use"
msgstr "ເກັບແຄຊຂໍ້ມູນການເຂົ້າລະບົບໄວ້ໃຊ້ຕອນອອບລາຍ"

#: src/lib/authui/sssd/params.rb:417
msgid ""
"Number of days entries are left in cache after last successful login before "
"being removed during a cleanup of the cache."
msgstr "ຈຳນວນມື້ທີ່ຂໍ້ມູນຈະຢູ່ໃນແຄຊຫຼັງຈາກເຂົ້າລະບົບສຳເລັດ ກ່ອນທີ່ຈະຖືກລຶບອອກ."

#: src/lib/authui/sssd/params.rb:424
msgid "The identification provider used for the domain."
msgstr "ຜູ້ໃຫ້ບໍລິການລະບຸຕົວຕົນ (identification provider) ທີ່ໃຊ້ສຳລັບໂດເມນ."

#: src/lib/authui/sssd/params.rb:429
msgid ""
"Use the full name and domain (as formatted by the domain's full_name_format) "
"as the user's login name reported to NSS."
msgstr "ໃຊ້ຊື່ເຕັມ ແລະ ໂດເມນ ເປັນຊື່ເຂົ້າລະບົບຂອງຜູ້ໃຊ້ທີ່ຈະລາຍງານຕໍ່ NSS."

#: src/lib/authui/sssd/params.rb:436
msgid "The authentication provider used for the domain"
msgstr "ຜູ້ໃຫ້ບໍລິການຢືນຢັນຕົວຕົນ (authentication provider) ທີ່ໃຊ້ສຳລັບໂດເມນ"

#: src/lib/authui/sssd/params.rb:442
msgid "The access control provider used for the domain."
msgstr ""
"ຜູ້ໃຫ້ບໍລິການຄວບຄຸມການເຂົ້າເຖິງ (access control provider) ທີ່ໃຊ້ສຳລັບໂດເມນ."

#: src/lib/authui/sssd/params.rb:447
msgid ""
"The provider which should handle change password operations for the domain."
msgstr "ຜູ້ໃຫ້ບໍລິການທີ່ຄວນຈັດການການປ່ຽນລະຫັດຜ່ານສຳລັບໂດເມນ."

#: src/lib/authui/sssd/params.rb:453
msgid "The SUDO provider used for the domain."
msgstr "ຜູ້ໃຫ້ບໍລິການ SUDO ທີ່ໃຊ້ສຳລັບໂດເມນ."

#: src/lib/authui/sssd/params.rb:459
msgid "The provider which should handle loading of selinux settings."
msgstr "ຜູ້ໃຫ້ບໍລິການທີ່ຄວນຈັດການການໂຫຼດການຕັ້ງຄ່າ selinux."

#: src/lib/authui/sssd/params.rb:465
msgid "The provider which should handle fetching of subdomains."
msgstr "ຜູ້ໃຫ້ບໍລິການທີ່ຄວນຈັດການການດຶງຂໍ້ມູນໂດເມນຍ່ອຍ."

#: src/lib/authui/sssd/params.rb:471
msgid "The autofs provider used for the domain."
msgstr "ຜູ້ໃຫ້ບໍລິການ autofs ທີ່ໃຊ້ສຳລັບໂດເມນ."

#: src/lib/authui/sssd/params.rb:477
msgid "The provider used for retrieving host identity information."
msgstr "ຜູ້ໃຫ້ບໍລິການທີ່ໃຊ້ສຳລັບການດຶງຂໍ້ມູນຕົວຕົນຂອງໂຮສ (host)."

#: src/lib/authui/sssd/params.rb:482
msgid ""
"Regular expression for this domain that describes how to parse the string "
"containing user name and domain into these components."
msgstr "Regular expression ສຳລັບໂດເມນນີ້ ທີ່ໃຊ້ແຍກຊື່ຜູ້ໃຊ້ ແລະ ໂດເມນ."

#: src/lib/authui/sssd/params.rb:487
msgid ""
"A printf(3)-compatible format that describes how to translate a (name, "
"domain) tuple for this domain into a fully qualified name."
msgstr ""
"ຮູບແບບທີ່ເຂົ້າກັນໄດ້ກັບ printf(3) ເຊິ່ງອະທິບາຍວິທີການແປງຊຸດຂໍ້ມູນ (ຊື່, ໂດເມນ) ສຳລັບໂດເມນນີ້ໃຫ້ກາຍເປັ"
"ນຊື່ທີ່ລະບຸຄົບຖ້ວນ."

#: src/lib/authui/sssd/params.rb:493
msgid ""
"Provides the ability to select preferred address family to use when "
"performing DNS lookups."
msgstr ""
"ໃຫ້ຄວາມສາມາດໃນການເລືອກຮູບແບບທີ່ຢູ່ (address family) ທີ່ຕ້ອງການເມື່ອຄົ້ນຫາ DNS."

#: src/lib/authui/sssd/params.rb:498
msgid ""
"Defines the amount of time (in seconds) to wait for a reply from the DNS "
"resolver before assuming that it is unreachable."
msgstr ""
"ກຳນົດເວລາ (ວິນາທີ) ທີ່ຈະລໍຖ້າການຕອບກັບຈາກ DNS ກ່ອນທີ່ຈະຖືວ່າຕິດຕໍ່ບໍ່ໄດ້."

#: src/lib/authui/sssd/params.rb:502
msgid ""
"If service discovery is used in the back end, specifies the domain part of "
"the service discovery DNS query."
msgstr "ຖ້າໃຊ້ service discovery, ໃຫ້ລະບຸສ່ວນຂອງໂດເມນໃນການສອບຖາມ DNS."

#: src/lib/authui/sssd/params.rb:506
msgid "Override the primary GID value with the one specified."
msgstr "ຂຽນທັບຄ່າ GID ຫຼັກດ້ວຍຄ່າທີ່ລະບຸ."

#: src/lib/authui/sssd/params.rb:516
msgid "Treat user and group names as case sensitive."
msgstr "ຖືວ່າຊື່ຜູ້ໃຊ້ ແລະ ກຸ່ມ ມີຄວາມແຕກຕ່າງກັນລະຫວ່າງຕົວອັກສອນໃຫຍ່ ແລະ ນ້ອຍ."

#: src/lib/authui/sssd/params.rb:521
msgid ""
"When a user or group is looked up by name in the proxy provider, a second "
"lookup by ID is performed to 'canonicalize' the name in case the requested "
"name was an alias."
msgstr ""
"ເມື່ອຄົ້ນຫາຊື່ຜ່ານ proxy provider, ຈະມີການຄົ້ນຫາດ້ວຍ ID ອີກຄັ້ງເພື່ອຢືນຢັນຊື່ທີ່ຖືກຕ້ອງໃນກໍລະນີທີ່ຊື່ນັ້ນເປັນຊື່"
"ແຝງ."

#: src/lib/authui/sssd/params.rb:526
msgid ""
"Use this homedir as default value for all subdomains within this domain."
msgstr "ໃຊ້ໄດເຣັກທໍຣີຫຼັກນີ້ເປັນຄ່າເລີ່ມຕົ້ນສຳລັບທຸກໂດເມນຍ່ອຍພາຍໃນໂດເມນນີ້."

#. Following options will be provided by SSSD's 'simple' access-control provider
#: src/lib/authui/sssd/params.rb:532
msgid "Comma separated list of users who are allowed to log in."
msgstr "ລາຍຊື່ຜູ້ໃຊ້ທີ່ໄດ້ຮັບອະນຸຍາດໃຫ້ເຂົ້າລະບົບ (ແຍກດ້ວຍຈຸດ)."

#: src/lib/authui/sssd/params.rb:537
msgid ""
"Comma separated list of groups who are allowed to log in. This applies only "
"to groups within this SSSD domain."
msgstr ""
"ລາຍຊື່ກຸ່ມທີ່ໄດ້ຮັບອະນຸຍາດໃຫ້ເຂົ້າລະບົບ (ໃຊ້ໄດ້ສະເພາະກຸ່ມໃນໂດເມນ SSSD ນີ້)."

#: src/lib/authui/sssd/params.rb:542
msgid ""
"Comma separated list of groups that are explicitly denied access. This "
"applies only to groups within this SSSD domain."
msgstr ""
"ລາຍຊື່ກຸ່ມທີ່ຖືກປະຕິເສດການເຂົ້າເຖິງຢ່າງຊັດເຈນ (ໃຊ້ໄດ້ສະເພາະກຸ່ມໃນໂດເມນ SSSD ນີ້)."

#: src/lib/authui/sssd/params.rb:547
msgid ""
"Do not return group members for group lookups. If set to true, the group "
"membership attribute is not requested from the ldap server, and group "
"members are not returned when processing group lookup calls."
msgstr ""
"ບໍ່ຕ້ອງສົ່ງຄືນສະມາຊິກກຸ່ມສຳລັບການຄົ້ນຫາກຸ່ມ. ຫາກກຳນົດເປັນ true, ຄຸນລັກສະນະການເປັນສະມາຊິກກຸ່ມຈະບໍ່ຖືກຮ້ອ"
"ງຂໍຈາກເຊີເວີ ldap ແລະ ຈະບໍ່ມີການສົ່ງຄືນສະມາຊິກກຸ່ມເມື່ອປະມວນຜົນການຮ້ອງຂໍຄົ້ນຫາກຸ່ມ."

#. The local domain section
#. This section contains settings for domain that stores users and groups in SSSD native database, that is, a domain that uses id_provider=local.
#: src/lib/authui/sssd/params.rb:556
msgid ""
"The tools append the login name to base_directory and use that as the home "
"directory."
msgstr ""
"ເຄື່ອງມືຈະຕໍ່ທ້າຍຊື່ເຂົ້າລະບົບໃສ່ base_directory ແລະ ໃຊ້ເປັນໄດເຣັກທໍຣີຫຼັກ."

#: src/lib/authui/sssd/params.rb:561
msgid ""
"Indicate if a home directory should be created by default for new users."
msgstr "ລະບຸວ່າຄວນສ້າງໄດເຣັກທໍຣີຫຼັກໃຫ້ຜູ້ໃຊ້ໃໝ່ໂດຍອັດຕະໂນມັດຫຼືບໍ່."

#: src/lib/authui/sssd/params.rb:566
msgid ""
"Indicate if a home directory should be removed by default for deleted users."
msgstr "ລະບຸວ່າຄວນລຶບໄດເຣັກທໍຣີຫຼັກອອກຫຼືບໍ່ ເມື່ອລຶບຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:571
msgid ""
"Used by sss_useradd(8) to specify the default permissions on a newly created "
"home directory."
msgstr ""
"ໃຊ້ໂດຍ sss_useradd(8) ເພື່ອກຳນົດສິດ (permissions) ເລີ່ມຕົ້ນຂອງໄດເຣັກທໍຣີຫຼັກທີ່ສ້າງໃໝ່."

#: src/lib/authui/sssd/params.rb:576
msgid ""
"The skeleton directory, which contains files and directories to be copied in "
"the user's home directory, when the home directory is created by "
"sss_useradd(8)"
msgstr ""
"ໄດເຣັກທໍຣີຕົ້ນແບບ, ເຊິ່ງບັນຈຸໄຟລ໌ ແລະ ໄດເຣັກທໍຣີ ທີ່ຈະຖືກສຳເນົາໄປຍັງໄດເຣັກທໍຣີຫຼັກຂອງຜູ້ໃຊ້, ໃນເວລາທີ່ໄດເ"
"ຣັກທໍຣີຫຼັກຖືກສ້າງຂຶ້ນໂດຍ sss_useradd(8)"

#: src/lib/authui/sssd/params.rb:581
msgid "The mail spool directory."
msgstr "ໄດເຣັກທໍຣີ mail spool."

#: src/lib/authui/sssd/params.rb:585
msgid "The command that is run after a user is removed."
msgstr "ຄຳສັ່ງທີ່ຈະເຮັດວຽກຫຼັງຈາກລຶບຜູ້ໃຊ້."

#. The ldap domain section
#: src/lib/authui/sssd/params.rb:594
msgid "(Active Directory specific) Use token-groups attribute if available"
msgstr "(ສະເພາະ Active Directory) ນຳໃຊ້ຄຸນລັກສະນະ token-groups ຫາກມີໃຫ້ໃຊ້"

#: src/lib/authui/sssd/params.rb:599
msgid "URIs (ldap://) of LDAP servers (comma separated)"
msgstr "URIs (ldap://) ຂອງເຊີເວີ LDAP (ແຍກດ້ວຍຈຸດ)"

#: src/lib/authui/sssd/params.rb:604
msgid ""
"An optional base DN to restrict LDAP sudo-rule searches. The default value "
"is ldap_search_base."
msgstr "Base DN (ຖ້າມີ) ເພື່ອຈຳກັດການຄົ້ນຫາ sudo-rule ໃນ LDAP."

#: src/lib/authui/sssd/params.rb:608
msgid ""
"Specifies the comma-separated list of URIs of the LDAP servers to which SSSD "
"should connect in the order of preference."
msgstr "ລາຍຊື່ URIs ຂອງເຊີເວີ LDAP ທີ່ SSSD ຄວນເຊື່ອມຕໍ່ ຕາມລຳດັບຄວາມຕ້ອງການ."

#: src/lib/authui/sssd/params.rb:613 src/lib/authui/sssd/params.rb:618
msgid ""
"Specifies the comma-separated list of URIs of the LDAP servers to which SSSD "
"should connect in the order of preference to change the password of a user."
msgstr "ລາຍຊື່ URIs ຂອງເຊີເວີ LDAP ທີ່ຈະໃຊ້ປ່ຽນລະຫັດຜ່ານ."

#: src/lib/authui/sssd/params.rb:623
msgid "Base DN for LDAP search"
msgstr "Base DN ສຳລັບການຄົ້ນຫາ LDAP"

#: src/lib/authui/sssd/params.rb:630
msgid "LDAP schema type"
msgstr "ປະເພດ LDAP schema"

#: src/lib/authui/sssd/params.rb:634
msgid "The default bind DN to use for performing LDAP operations."
msgstr "Bind DN ເລີ່ມຕົ້ນທີ່ຈະໃຊ້ໃນການເຮັດວຽກກັບ LDAP."

#: src/lib/authui/sssd/params.rb:640
msgid "The type of the authentication token of the default bind DN."
msgstr "ປະເພດຂອງ token ຢືນຢັນຕົວຕົນຂອງ bind DN."

#: src/lib/authui/sssd/params.rb:644
msgid "The authentication token of the default bind DN."
msgstr "Token ຢືນຢັນຕົວຕົນຂອງ bind DN."

#: src/lib/authui/sssd/params.rb:649
msgid "The object class of a user entry in LDAP."
msgstr "Object class ຂອງຜູ້ໃຊ້ໃນ LDAP."

#: src/lib/authui/sssd/params.rb:654
msgid "The LDAP attribute that corresponds to the user's login name."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ກົງກັບຊື່ເຂົ້າລະບົບຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:659
msgid "The LDAP attribute that corresponds to the user's id."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ກົງກັບ ID ຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:664
msgid "The LDAP attribute that corresponds to the user's primary group id."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ກົງກັບ ID ກຸ່ມຫຼັກຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:669
msgid "The LDAP attribute that corresponds to the user's gecos field."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ກົງກັບ gecos field ຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:674
msgid ""
" The LDAP attribute that contains the name of the user's home directory."
msgstr " ຄຸນລັກສະນະ LDAP ທີ່ເກັບຊື່ໄດເຣັກທໍຣີຫຼັກຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:679
msgid "The LDAP attribute that contains the path to the user's default shell."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບເສັ້ນທາງໄປຫາ shell ເລີ່ມຕົ້ນຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:684
msgid "The LDAP attribute that contains the UUID/GUID of an LDAP user object."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບ UUID/GUID ຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:689
msgid "The LDAP attribute that contains the objectSID of an LDAP user object."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບ objectSID ຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:694 src/lib/authui/sssd/params.rb:899
msgid ""
"The LDAP attribute that contains timestamp of the last modification of the "
"parent object."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບເວລາການແກ້ໄຂຫຼ້າສຸດຂອງ parent object."

#: src/lib/authui/sssd/params.rb:699
msgid ""
"When using ldap_pwd_policy=shadow, this parameter contains the name of an "
"LDAP attribute corresponding to its shadow(5) counterpart (date of the last "
"password change)."
msgstr ""
"ເມື່ອໃຊ້ ldap_pwd_policy=shadow, ພາຣາມິເຕີນີ້ຈະເກັບຄຸນລັກສະນະ LDAP ທີ່ກົງກັບວັນທີປ່ຽນລະຫັດຜ່ານຫຼ້າ"
"ສຸດ."

#: src/lib/authui/sssd/params.rb:704
msgid ""
"When using ldap_pwd_policy=shadow, this parameter contains the name of an "
"LDAP attribute corresponding to its shadow(5) counterpart (minimum password "
"age)."
msgstr ""
"ເມື່ອໃຊ້ ldap_pwd_policy=shadow, ພາຣາມິເຕີນີ້ຈະເກັບຄຸນລັກສະນະ LDAP ທີ່ກົງກັບອາຍຸຕ່ຳສຸດຂອງລະຫັດຜ່"
"ານ."

#: src/lib/authui/sssd/params.rb:709
msgid ""
"When using ldap_pwd_policy=shadow, this parameter contains the name of an "
"LDAP attribute corresponding to its shadow(5) counterpart (maximum password "
"age)."
msgstr ""
"ເມື່ອໃຊ້ ldap_pwd_policy=shadow, ພາຣາມິເຕີນີ້ຈະເກັບຄຸນລັກສະນະ LDAP ທີ່ກົງກັບອາຍຸສູງສຸດຂອງລະຫັດຜ່"
"ານ."

#: src/lib/authui/sssd/params.rb:714
msgid ""
"When using ldap_pwd_policy=shadow, this parameter contains the name of an "
"LDAP attribute corresponding to its shadow(5) counterpart (password warning "
"period)."
msgstr ""
"ເມື່ອໃຊ້ ldap_pwd_policy=shadow, ພາຣາມິເຕີນີ້ຈະເກັບຄຸນລັກສະນະ LDAP ທີ່ກົງກັບໄລຍະເວລາເຕືອນລະຫັ"
"ດຜ່ານ."

#: src/lib/authui/sssd/params.rb:719
msgid ""
"When using ldap_pwd_policy=shadow, this parameter contains the name of an "
"LDAP attribute corresponding to its shadow(5) counterpart (password "
"inactivity period)."
msgstr ""
"ເມື່ອໃຊ້ ldap_pwd_policy=shadow, ພາຣາມິເຕີນີ້ຈະເກັບຄຸນລັກສະນະ LDAP ທີ່ກົງກັບໄລຍະເວລາທີ່ລະຫັດຜ່າ"
"ນບໍ່ໄດ້ໃຊ້ງານ."

#: src/lib/authui/sssd/params.rb:724
msgid ""
"When using ldap_pwd_policy=shadow or ldap_account_expire_policy=shadow, this "
"parameter contains the name of an LDAP attribute corresponding to its "
"shadow(5) counterpart (account expiration date)."
msgstr "ພາຣາມິເຕີທີ່ເກັບຄຸນລັກສະນະ LDAP ກ່ຽວກັບວັນໝົດອາຍຸຂອງບັນຊີ."

#: src/lib/authui/sssd/params.rb:729
msgid ""
"When using ldap_pwd_policy=mit_kerberos, this parameter contains the name of "
"an LDAP attribute storing the date and time of last password change in "
"kerberos."
msgstr ""
"ເມື່ອໃຊ້ ldap_pwd_policy=mit_kerberos, ພາຣາມິເຕີນີ້ຈະເກັບວັນທີ ແລະ ເວລາທີ່ປ່ຽນລະຫັດຜ່ານຫຼ້າສຸດໃ"
"ນ Kerberos."

#: src/lib/authui/sssd/params.rb:734
msgid ""
"When using ldap_pwd_policy=mit_kerberos, this parameter contains the name of "
"an LDAP attribute storing the date and time when current password expires."
msgstr ""
"ເມື່ອໃຊ້ ldap_pwd_policy=mit_kerberos, ພາຣາມິເຕີນີ້ຈະເກັບວັນທີໝົດອາຍຸຂອງລະຫັດຜ່ານ."

#: src/lib/authui/sssd/params.rb:739
msgid ""
"When using ldap_account_expire_policy=ad, this parameter contains the name "
"of an LDAP attribute storing the expiration time of the account."
msgstr ""
"ເມື່ອໃຊ້ ldap_account_expire_policy=ad, ພາຣາມິເຕີນີ້ຈະເກັບເວລາໝົດອາຍຸຂອງບັນຊີ."

#: src/lib/authui/sssd/params.rb:744
msgid ""
"When using ldap_account_expire_policy=ad, this parameter contains the name "
"of an LDAP attribute storing the user account control bit field."
msgstr ""
"ເມື່ອໃຊ້ ldap_account_expire_policy=ad, ພາຣາມິເຕີນີ້ຈະເກັບຄ່າ user account control "
"bit field."

#: src/lib/authui/sssd/params.rb:749
msgid ""
"When using ldap_account_expire_policy=rhds or equivalent, this parameter "
"determines if access is allowed or not."
msgstr ""
"ເມື່ອໃຊ້ ldap_account_expire_policy=rhds, ພາຣາມິເຕີນີ້ຈະກຳນົດວ່າອະນຸຍາດໃຫ້ເຂົ້າເຖິງຫຼືບໍ່."

#: src/lib/authui/sssd/params.rb:754
msgid ""
"When using ldap_account_expire_policy=nds, this attribute determines if "
"access is allowed or not."
msgstr ""
"ເມື່ອໃຊ້ ldap_account_expire_policy=nds, ຄຸນລັກສະນະນີ້ຈະກຳນົດການອະນຸຍາດເຂົ້າເຖິງ."

#: src/lib/authui/sssd/params.rb:759
msgid ""
"When using ldap_account_expire_policy=nds, this attribute determines until "
"which date access is granted."
msgstr ""
"ເມື່ອໃຊ້ ldap_account_expire_policy=nds, ຄຸນລັກສະນະນີ້ຈະກຳນົດວັນທີທີ່ສິ້ນສຸດການອະນຸຍາດ."

#: src/lib/authui/sssd/params.rb:764
msgid ""
"When using ldap_account_expire_policy=nds, this attribute determines the "
"hours of a day in a week when access is granted."
msgstr ""
"ເມື່ອໃຊ້ ldap_account_expire_policy=nds, ຄຸນລັກສະນະນີ້ຈະກຳນົດຊົ່ວໂມງໃນແຕ່ລະມື້ທີ່ອະນຸຍາດໃຫ້ເຂົ້າ"
"ເຖິງ."

#: src/lib/authui/sssd/params.rb:769
msgid ""
"The LDAP attribute that contains the user's Kerberos User Principal Name "
"(UPN)."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບ Kerberos User Principal Name (UPN) ຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:773
msgid "The LDAP attribute that contains the user's SSH public keys."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບ SSH public keys ຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:778
msgid ""
"Some directory servers, for example Active Directory, might deliver the "
"realm part of the UPN in lower case, which might cause the authentication to "
"fail."
msgstr ""
"ເຊີເວີບາງແຫ່ງ ເຊັ່ນ AD ອາດຈະສົ່ງຊື່ realm ເປັນຕົວອັກສອນນ້ອຍ ເຊິ່ງອາດເຮັດໃຫ້ການຢືນຢັນຕົວຕົນລົ້ມເຫຼວ."

#: src/lib/authui/sssd/params.rb:779
msgid "Set this option to true if you want to use an upper-case realm."
msgstr "ຕັ້ງຄ່ານີ້ເປັນ true ຖ້າຕ້ອງການໃຊ້ realm ເປັນຕົວອັກສອນໃຫຍ່."

#: src/lib/authui/sssd/params.rb:784
msgid ""
"Specifies how many seconds SSSD has to wait before refreshing its cache of "
"enumerated records."
msgstr "ກຳນົດວ່າ SSSD ຕ້ອງລໍຖ້າຈັກວິນາທີກ່ອນທີ່ຈະອັບເດດແຄຊ."

#: src/lib/authui/sssd/params.rb:789
msgid ""
"Determine how often to check the cache for inactive entries (such as groups "
"with no members and users who have never logged in) and remove them to save "
"space."
msgstr ""
"ກຳນົດຄວາມຖີ່ໃນການກວດສອບ ແລະ ລຶບຂໍ້ມູນໃນແຄຊທີ່ບໍ່ໄດ້ໃຊ້ງານ ເພື່ອປະຢັດພື້ນທີ່."

#: src/lib/authui/sssd/params.rb:794
msgid "The LDAP attribute that corresponds to the user's full name."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ກົງກັບຊື່ເຕັມຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:799
msgid "The LDAP attribute that lists the user's group memberships."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ສະແດງລາຍຊື່ກຸ່ມທີ່ຜູ້ໃຊ້ເປັນສະມາຊິກ."

#: src/lib/authui/sssd/params.rb:804
msgid ""
"If access_provider=ldap and ldap_access_order=authorized_service, SSSD will "
"use the presence of the authorizedService attribute in the user's LDAP entry "
"to determine access privilege."
msgstr ""
"ຖ້າຕັ້ງຄ່າແບບ authorized_service, SSSD ຈະກວດສອບຄຸນລັກສະນະ authorizedService ເພື່ອໃຫ້ສິດ"
"ການເຂົ້າເຖິງ."

#: src/lib/authui/sssd/params.rb:809
msgid ""
"If access_provider=ldap and ldap_access_order=host, SSSD will use the "
"presence of the host attribute in the user's LDAP entry to determine access "
"privilege."
msgstr ""
"ຖ້າຕັ້ງຄ່າແບບ host, SSSD ຈະກວດສອບຄຸນລັກສະນະ host ໃນ LDAP ເພື່ອໃຫ້ສິດການເຂົ້າເຖິງ."

#: src/lib/authui/sssd/params.rb:819
msgid "The object class of a group entry in LDAP."
msgstr "Object class ຂອງກຸ່ມໃນ LDAP."

#: src/lib/authui/sssd/params.rb:824
msgid "The LDAP attribute that corresponds to the group name."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ກົງກັບຊື່ກຸ່ມ."

#: src/lib/authui/sssd/params.rb:829
msgid "The LDAP attribute that corresponds to the group's id."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ກົງກັບ ID ຂອງກຸ່ມ."

#: src/lib/authui/sssd/params.rb:834
msgid "The LDAP attribute that contains the names of the group's members."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບລາຍຊື່ສະມາຊິກຂອງກຸ່ມ."

#: src/lib/authui/sssd/params.rb:839
msgid "The LDAP attribute that contains the UUID/GUID of an LDAP group object."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບ UUID/GUID ຂອງກຸ່ມ."

#: src/lib/authui/sssd/params.rb:844
msgid "The LDAP attribute that contains the objectSID of an LDAP group object."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບ objectSID ຂອງກຸ່ມ."

#: src/lib/authui/sssd/params.rb:849
msgid ""
" The LDAP attribute that contains timestamp of the last modification of the "
"parent object."
msgstr " ຄຸນລັກສະນະ LDAP ທີ່ເກັບເວລາການແກ້ໄຂຫຼ້າສຸດຂອງ parent object."

#: src/lib/authui/sssd/params.rb:855
msgid ""
"If ldap_schema is set to a schema format that supports nested groups (e.g. "
"RFC2307bis), then this option controls how many levels of nesting SSSD will "
"follow."
msgstr ""
"ຖ້າ LDAP ຮອງຮັບກຸ່ມຊ້ອນກຸ່ມ (nested groups), ຕົວເລືອກນີ້ຈະຄວບຄຸມວ່າ SSSD ຈະໄລ່ຕາມລົງໄປຈັກລະດັ"
"ບ."

#: src/lib/authui/sssd/params.rb:861
msgid ""
"This option tells SSSD to take advantage of an Active Directory-specific "
"feature which may speed up group lookup operations on deployments with "
"complex or deep nested groups."
msgstr ""
"ຕົວເລືອກນີ້ບອກໃຫ້ SSSD ໃຊ້ຟີເຈີສະເພາະຂອງ AD ເພື່ອຊ່ວຍໃຫ້ການຄົ້ນຫາກຸ່ມທີ່ຊ້ອນກັນຫຼາຍໆເຮັດວຽກໄດ້ໄວຂຶ້ນ."

#: src/lib/authui/sssd/params.rb:867
msgid ""
"This option tells SSSD to take advantage of an Active Directory-specific "
"feature which might speed up initgroups operations (most notably when "
"dealing with complex or deep nested groups)."
msgstr ""
"ຕົວເລືອກນີ້ບອກໃຫ້ SSSD ໃຊ້ຟີເຈີຂອງ AD ເພື່ອເລັ່ງການເຮັດວຽກຂອງ initgroups."

#: src/lib/authui/sssd/params.rb:873
msgid "           The object class of a netgroup entry in LDAP."
msgstr "           Object class ຂອງ netgroup ໃນ LDAP."

#: src/lib/authui/sssd/params.rb:879
msgid "The LDAP attribute that corresponds to the netgroup name."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ກົງກັບຊື່ netgroup."

#: src/lib/authui/sssd/params.rb:884
msgid "The LDAP attribute that contains the names of the netgroup's members."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບລາຍຊື່ສະມາຊິກຂອງ netgroup."

#: src/lib/authui/sssd/params.rb:889
msgid ""
"The LDAP attribute that contains the (host, user, domain) netgroup triples."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບຄ່າ (ໂຮສ, ຜູ້ໃຊ້, ໂດເມນ) ຂອງ netgroup."

#: src/lib/authui/sssd/params.rb:894
msgid ""
"The LDAP attribute that contains the UUID/GUID of an LDAP netgroup object."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບ UUID/GUID ຂອງ netgroup."

#: src/lib/authui/sssd/params.rb:904
msgid "The object class of a service entry in LDAP."
msgstr "Object class ຂອງການບໍລິການໃນ LDAP."

#: src/lib/authui/sssd/params.rb:909
msgid ""
"The LDAP attribute that contains the name of service attributes and their "
"aliases."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບຊື່ບໍລິການ ແລະ ຊື່ແຝງ."

#: src/lib/authui/sssd/params.rb:914
msgid "The LDAP attribute that contains the port managed by this service."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບໝາຍເລກພອດ (port) ຂອງບໍລິການນີ້."

#: src/lib/authui/sssd/params.rb:919
msgid ""
"The LDAP attribute that contains the protocols understood by this service."
msgstr "ຄຸນລັກສະນະ LDAP ທີ່ເກັບໂປຣໂຕຄໍ (protocols) ທີ່ບໍລິການນີ້ຮອງຮັບ."

#: src/lib/authui/sssd/params.rb:924
msgid ""
"An optional base DN, search scope and LDAP filter to restrict LDAP service "
"searches for this attribute type. The default value is ldap_search_base."
msgstr "Base DN, ຂອບເຂດ ແລະ ຕົວຕອງ ເພື່ອຈຳກັດການຄົ້ນຫາບໍລິການໃນ LDAP."

#: src/lib/authui/sssd/params.rb:929
msgid ""
" Specifies the timeout (in seconds) that ldap searches are allowed to run "
"before they are cancelled and cached results are returned (and offline mode "
"is entered)."
msgstr ""
" ກຳນົດເວລາ (ເປັນວິນາທີ) ທີ່ອະນຸຍາດໃຫ້ການຄົ້ນຫາ ldap ເຮັດວຽກ ກ່ອນທີ່ຈະຖືກຍົກເລີກ ແລະ ສົ່ງຄືນຜົນລັດທີ່ເ"
"ກັບໄວ້ໃນແຄຊ໌ (ແລະ ເຂົ້າສູ່ໂໝດອອບລາຍ)."

#: src/lib/authui/sssd/params.rb:934
msgid ""
"Specifies the timeout (in seconds) that ldap searches for user and group "
"enumerations are allowed to run before they are cancelled and cached results "
"are returned (and offline mode is entered)."
msgstr ""
"ກຳນົດເວລາ (ເປັນວິນາທີ) ທີ່ອະນຸຍາດໃຫ້ການຄົ້ນຫາ ldap ສຳລັບການໄລ່ລຽງລາຍຊື່ຜູ້ໃຊ້ ແລະ ກຸ່ມ ເຮັດວຽກ ກ່ອ"
"ນທີ່ຈະຖືກຍົກເລີກ ແລະ ສົ່ງຄືນຜົນລັດທີ່ເກັບໄວ້ໃນແຄຊ໌ (ແລະ ເຂົ້າສູ່ໂໝດອອບລາຍ)."

#: src/lib/authui/sssd/params.rb:939
msgid ""
"Specifies the timeout (in seconds) after which the poll(2)/select(2) "
"following a connect(2) returns in case of no activity."
msgstr "ກຳນົດເວລາລໍຖ້າຫຼັງຈາກການເຊື່ອມຕໍ່ ຫາກບໍ່ມີການເຄື່ອນໄຫວ."

#: src/lib/authui/sssd/params.rb:944
msgid ""
"Specifies a timeout (in seconds) after which calls to synchronous LDAP APIs "
"will abort if no response is received."
msgstr ""
"ກຳນົດເວລາລໍຖ້າ (ວິນາທີ) ສຳລັບການຮ້ອງຂໍ LDAP API ກ່ອນທີ່ຈະຍົກເລີກຫາກບໍ່ມີການຕອບກັບ."

#: src/lib/authui/sssd/params.rb:949
msgid ""
"Specifies a timeout (in seconds) that a connection to an LDAP server will be "
"maintained."
msgstr "ກຳນົດເວລາ (ວິນາທີ) ທີ່ຈະຮັກສາການເຊື່ອມຕໍ່ກັບເຊີເວີ LDAP ໄວ້."

#: src/lib/authui/sssd/params.rb:954
msgid ""
"Specify the number of records to retrieve from LDAP in a single request. "
"Some LDAP servers enforce a maximum limit per-request."
msgstr ""
"ກຳນົດຈຳນວນຂໍ້ມູນທີ່ຈະດຶງຈາກ LDAP ໃນແຕ່ລະຄັ້ງ (ບາງເຊີເວີມີການຈຳກັດຈຳນວນສູງສຸດ)."

#: src/lib/authui/sssd/params.rb:959
msgid "Disable the LDAP paging control."
msgstr "ປິດການໃຊ້ງານ LDAP paging control."

#: src/lib/authui/sssd/params.rb:963
msgid ""
"When communicating with an LDAP server using SASL, specify the minimum "
"security level necessary to establish the connection."
msgstr "ລະບຸລະດັບຄວາມປອດໄພຕ່ຳສຸດທີ່ຈຳເປັນເມື່ອຕິດຕໍ່ກັບ LDAP ຜ່ານ SASL."

#: src/lib/authui/sssd/params.rb:968
msgid ""
"Specify the number of group members that must be missing from the internal "
"cache in order to trigger a dereference lookup."
msgstr "ລະບຸຈຳນວນສະມາຊິກກຸ່ມທີ່ຂາດຫາຍໄປຈາກແຄຊພາຍໃນ ເພື່ອໃຫ້ເລີ່ມການຄົ້ນຫາໃໝ່."

#: src/lib/authui/sssd/params.rb:975
msgid "Validate server certification in LDAP TLS session"
msgstr "ກວດສອບໃບຢັ້ງຢືນ (certificate) ຂອງເຊີເວີໃນ LDAP TLS session"

#: src/lib/authui/sssd/params.rb:979
msgid ""
"Specifies the file that contains certificates for all of the Certificate "
"Authorities that sssd will recognize."
msgstr ""
"ກຳນົດໄຟລ໌ທີ່ບັນຈຸໃບຢັ້ງຢືນສຳລັບທຸກໆ ອົງກອນອອກໃບຢັ້ງຢືນ (Certificate Authorities) ທີ່ sssd ຈະຮັບ"
"ຮູ້."

#: src/lib/authui/sssd/params.rb:983
msgid ""
"Specifies the path of a directory that contains Certificate Authority "
"certificates in separate individual files."
msgstr ""
"ກຳນົດເສັ້ນທາງຂອງໄດເຣັກທໍຣີທີ່ບັນຈຸໃບຢັ້ງຢືນຂອງອົງກອນອອກໃບຢັ້ງຢືນ ໂດຍແຍກເປັນແຕ່ລະໄຟລ໌ຕ່າງຫາກ."

#: src/lib/authui/sssd/params.rb:987
msgid "Specifies the file that contains the certificate for the client's key."
msgstr "ລະບຸໄຟລ໌ທີ່ເກັບໃບຢັ້ງຢືນສຳລັບ client's key."

#: src/lib/authui/sssd/params.rb:991
msgid "Specifies the file that contains the client's key."
msgstr "ລະບຸໄຟລ໌ທີ່ເກັບ client's key."

#: src/lib/authui/sssd/params.rb:996
msgid "Specifies acceptable cipher suites."
msgstr "ລະບຸຊຸດລະຫັດລັບ (cipher suites) ທີ່ຍອມຮັບ."

#: src/lib/authui/sssd/params.rb:1001
msgid ""
"Specifies that the id_provider connection must also use tls to protect the "
"channel."
msgstr ""
"ກຳນົດໃຫ້ການເຊື່ອມຕໍ່ id_provider ຕ້ອງໃຊ້ tls ເພື່ອປົກປ້ອງຊ່ອງທາງການສື່ສານ."

#: src/lib/authui/sssd/params.rb:1006
msgid ""
"Specifies that SSSD should attempt to map user and group IDs from the "
"ldap_user_objectsid and ldap_group_objectsid attributes instead of relying "
"on ldap_user_uid_number and ldap_group_gid_number."
msgstr ""
"ລະບຸໃຫ້ SSSD ພະຍາຍາມຈັບຄູ່ ID ຈາກ objectsid ແທນທີ່ຈະໃຊ້ uid_number ຫຼື gid_number."

#: src/lib/authui/sssd/params.rb:1010
msgid "Specify the SASL mechanism to use."
msgstr "ລະບຸ SASL mechanism ທີ່ຈະໃຊ້."

#: src/lib/authui/sssd/params.rb:1015
msgid "Specify the SASL authorization id to use."
msgstr "ລະບຸ SASL authorization id ທີ່ຈະໃຊ້."

#: src/lib/authui/sssd/params.rb:1020
msgid "Specify the SASL realm to use."
msgstr "ລະບຸ SASL realm ທີ່ຈະໃຊ້."

#: src/lib/authui/sssd/params.rb:1025
msgid ""
"If set to true, the LDAP library would perform a reverse lookup to "
"canonicalize the host name during a SASL bind."
msgstr ""
"ຖ້າເປັນ true, ຫ້ອງສະໝຸດ LDAP ຈະເຮັດ reverse lookup ເພື່ອຢືນຢັນຊື່ໂຮສໃນລະຫວ່າງ SASL bind."

#: src/lib/authui/sssd/params.rb:1030
msgid "Specify the keytab to use when using SASL/GSSAPI."
msgstr "ລະບຸ keytab ທີ່ຈະໃຊ້ເມື່ອໃຊ້ SASL/GSSAPI."

#: src/lib/authui/sssd/params.rb:1035
msgid "Specifies that the id_provider should init Kerberos credentials (TGT)."
msgstr "ລະບຸໃຫ້ id_provider ເລີ່ມສ້າງ Kerberos credentials (TGT)."

#: src/lib/authui/sssd/params.rb:1040
msgid "Specifies the lifetime in seconds of the TGT if GSSAPI is used."
msgstr "ກຳນົດອາຍຸ (ວິນາທີ) ຂອງ TGT ຫາກໃຊ້ GSSAPI."

#: src/lib/authui/sssd/params.rb:1045
msgid ""
"Select the policy to evaluate the password expiration on the client side."
msgstr "ເລືອກນະໂຍບາຍໃນການກວດສອບການໝົດອາຍຸຂອງລະຫັດຜ່ານຢູ່ຝັ່ງໄຄເອັນທ໌."

#: src/lib/authui/sssd/params.rb:1050
msgid "Specifies whether automatic referral chasing should be enabled."
msgstr "ລະບຸວ່າຈະເປີດໃຊ້ automatic referral chasing ຫຼືບໍ່."

#: src/lib/authui/sssd/params.rb:1055
msgid "Specifies the service name to use when service discovery is enabled."
msgstr "ລະບຸຊື່ບໍລິການທີ່ຈະໃຊ້ເມື່ອເປີດ service discovery."

#: src/lib/authui/sssd/params.rb:1059
msgid ""
"Specifies the service name to use to find an LDAP server which allows "
"password changes when service discovery is enabled."
msgstr "ລະບຸຊື່ບໍລິການເພື່ອຄົ້ນຫາເຊີເວີ LDAP ທີ່ອະນຸຍາດໃຫ້ປ່ຽນລະຫັດຜ່ານ."

#: src/lib/authui/sssd/params.rb:1064
msgid ""
"Specifies whether to update the ldap_user_shadow_last_change attribute with "
"days since the Epoch after a password change operation."
msgstr "ລະບຸວ່າຈະອັບເດດຄຸນລັກສະນະ last_change ຫຼັງຈາກປ່ຽນລະຫັດຜ່ານຫຼືບໍ່."

#: src/lib/authui/sssd/params.rb:1069
msgid ""
"If using access_provider = ldap and ldap_access_order = filter (default), "
"this option is mandatory. It specifies an LDAP search filter criterion that "
"must be met for the user to be granted access on this host."
msgstr ""
"ຖ້າໃຊ້ access_provider ເປັນ ldap, ຕົວເລືອກນີ້ຈຳເປັນຕ້ອງລະບຸເງື່ອນໄຂໃນການກອງຂໍ້ມູນເພື່ອໃຫ້ສິດຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:1074
msgid ""
" With this option a client side evaluation of access control attributes can "
"be enabled."
msgstr ""
" ຕົວເລືອກນີ້ຊ່ວຍໃຫ້ສາມາດເປີດໃຊ້ການກວດສອບສິດການເຂົ້າເຖິງຢູ່ຝັ່ງໄຄເອັນທ໌ໄດ້."

#: src/lib/authui/sssd/params.rb:1080
msgid "Comma separated list of access control options."
msgstr "ລາຍຊື່ຕົວເລືອກການຄວບຄຸມການເຂົ້າເຖິງ (ແຍກດ້ວຍຈຸດ)."

#: src/lib/authui/sssd/params.rb:1085
msgid "Specifies how alias dereferencing is done when performing a search."
msgstr "ກຳນົດວິທີການຈັດການກັບ alias ໃນເວລາຄົ້ນຫາ."

#: src/lib/authui/sssd/params.rb:1090
msgid ""
"Allows to retain local users as members of an LDAP group for servers that "
"use the RFC2307 schema."
msgstr ""
"ອະນຸຍາດໃຫ້ເກັບຜູ້ໃຊ້ພາຍໃນເຄື່ອງເປັນສະມາຊິກຂອງກຸ່ມ LDAP ສຳລັບເຊີເວີທີ່ໃຊ້ RFC2307."

#: src/lib/authui/sssd/params.rb:1095
msgid ""
"An optional base DN, search scope and LDAP filter to restrict LDAP autofs "
"searches for this attribute type. The default value is ldap_search_base."
msgstr "Base DN, ຂອບເຂດ ແລະ ຕົວຕອງ (ຖ້າມີ) ເພື່ອຈຳກັດການຄົ້ນຫາ autofs ໃນ LDAP."

#: src/lib/authui/sssd/params.rb:1100
msgid ""
"An optional base DN, search scope and LDAP filter to restrict LDAP group "
"searches for this attribute type. The default value is ldap_search_base."
msgstr "Base DN, ຂອບເຂດ ແລະ ຕົວຕອງ (ຖ້າມີ) ເພື່ອຈຳກັດການຄົ້ນຫາກຸ່ມໃນ LDAP."

#: src/lib/authui/sssd/params.rb:1105
msgid ""
"An optional base DN, search scope and LDAP filter to restrict LDAP netgroup "
"searches for this attribute type. The default value is ldap_search_base."
msgstr ""
"Base DN, ຂອບເຂດ ແລະ ຕົວຕອງ (ຖ້າມີ) ເພື່ອຈຳກັດການຄົ້ນຫາ netgroup ໃນ LDAP."

#: src/lib/authui/sssd/params.rb:1110
msgid ""
"An optional base DN, search scope and LDAP filter to restrict LDAP user "
"searches for this attribute type. The default value is ldap_search_base."
msgstr "Base DN, ຂອບເຂດ ແລະ ຕົວຕອງ (ຖ້າມີ) ເພື່ອຈຳກັດການຄົ້ນຫາຜູ້ໃຊ້ໃນ LDAP."

#: src/lib/authui/sssd/params.rb:1115 src/lib/authui/sssd/params.rb:1125
msgid "The object class of an automount map entry in LDAP."
msgstr "Object class ຂອງ automount map ໃນ LDAP."

#: src/lib/authui/sssd/params.rb:1120
msgid "The name of an automount map entry in LDAP."
msgstr "ຊື່ຂອງ automount map ໃນ LDAP."

#: src/lib/authui/sssd/params.rb:1130 src/lib/authui/sssd/params.rb:1135
msgid ""
"The key of an automount entry in LDAP. The entry usually corresponds to a "
"mount point."
msgstr "Key ຂອງ automount ໃນ LDAP ເຊິ່ງປົກກະຕິຈະກົງກັບ mount point."

#: src/lib/authui/sssd/params.rb:1148
msgid "IP address or host names of Kerberos servers (comma separated)"
msgstr "ທີ່ຢູ່ IP ຫຼື ຊື່ໂຮສຂອງເຊີເວີ Kerberos (ແຍກດ້ວຍຈຸດ)"

#: src/lib/authui/sssd/params.rb:1152
msgid ""
"Specifies the comma-separated list of IP addresses or hostnames of the "
"Kerberos servers to which SSSD should connect, in the order of preference."
msgstr ""
"ລາຍຊື່ທີ່ຢູ່ IP ຫຼື ຊື່ໂຮສຂອງເຊີເວີ Kerberos ທີ່ SSSD ຄວນເຊື່ອມຕໍ່ ຕາມລຳດັບຄວາມຕ້ອງການ."

#: src/lib/authui/sssd/params.rb:1157
msgid "Kerberos realm (e.g. EXAMPLE.COM)"
msgstr "Kerberos realm (ເຊັ່ນ EXAMPLE.COM)"

#: src/lib/authui/sssd/params.rb:1161 src/lib/authui/sssd/params.rb:1166
msgid ""
"If the change password service is not running on the KDC, alternative "
"servers can be defined here."
msgstr ""
"ຖ້າບໍລິການປ່ຽນລະຫັດຜ່ານບໍ່ໄດ້ເຮັດວຽກຢູ່ KDC, ສາມາດລະບຸເຊີເວີສຳຮອງໄດ້ທີ່ນີ້."

#: src/lib/authui/sssd/params.rb:1171
msgid "Directory to store credential caches."
msgstr "ໄດເຣັກທໍຣີສຳລັບເກັບ credential caches."

#: src/lib/authui/sssd/params.rb:1176
msgid "Location of the user's credential cache."
msgstr "ສະຖານທີ່ເກັບ credential cache ຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:1181
msgid ""
" Timeout in seconds after an online authentication request or change "
"password request is aborted."
msgstr ""
" ເວລາລໍຖ້າ (ວິນາທີ) ກ່ອນທີ່ຈະຍົກເລີກການຢືນຢັນຕົວຕົນ ຫຼື ການປ່ຽນລະຫັດຜ່ານ."

#: src/lib/authui/sssd/params.rb:1186
msgid ""
"Verify with the help of krb5_keytab that the TGT obtained has not been "
"spoofed."
msgstr "ກວດສອບໂດຍໃຊ້ krb5_keytab ເພື່ອໃຫ້ແນ່ໃຈວ່າ TGT ທີ່ໄດ້ຮັບບໍ່ໄດ້ຖືກປອມແປງ."

#: src/lib/authui/sssd/params.rb:1191
msgid ""
"The location of the keytab to use when validating credentials obtained from "
"KDCs."
msgstr "ສະຖານທີ່ຂອງ keytab ທີ່ຈະໃຊ້ກວດສອບຂໍ້ມູນຈາກ KDCs."

#: src/lib/authui/sssd/params.rb:1196
msgid ""
"Store the password of the user if the provider is offline and use it to "
"request a TGT when the provider comes online again."
msgstr ""
"ເກັບລະຫັດຜ່ານໄວ້ຖ້າລະບົບອອບລາຍ ເພື່ອໃຊ້ຮ້ອງຂໍ TGT ເມື່ອລະບົບກັບມາອອນລາຍ."

#: src/lib/authui/sssd/params.rb:1200
msgid ""
"Request a renewable ticket with a total lifetime, given as an integer "
"immediately followed by a time unit."
msgstr "ຮ້ອງຂໍ renewable ticket ທີ່ມີອາຍຸການໃຊ້ງານຕາມທີ່ລະບຸ."

#: src/lib/authui/sssd/params.rb:1204
msgid ""
"Request ticket with a with a lifetime, given as an integer immediately "
"followed by a time unit."
msgstr "ຮ້ອງຂໍ ticket ທີ່ມີອາຍຸການໃຊ້ງານຕາມທີ່ລະບຸ."

#: src/lib/authui/sssd/params.rb:1208
msgid "The time in seconds between two checks if the TGT should be renewed."
msgstr "ໄລຍະເວລາ (ວິນາທີ) ລະຫວ່າງການກວດສອບວ່າຄວນຕໍ່ອາຍຸ TGT ຫຼືບໍ່."

#: src/lib/authui/sssd/params.rb:1213
msgid ""
"Enables flexible authentication secure tunneling (FAST) for Kerberos pre-"
"authentication."
msgstr "ເປີດໃຊ້ FAST ສຳລັບ Kerberos pre-authentication."

#: src/lib/authui/sssd/params.rb:1217
msgid "Specifies the server principal to use for FAST."
msgstr "ລະບຸ server principal ທີ່ຈະໃຊ້ສຳລັບ FAST."

#: src/lib/authui/sssd/params.rb:1222
msgid "Specifies if the host and user principal should be canonicalized."
msgstr "ລະບຸວ່າຄວນເຮັດໃຫ້ຊື່ host ແລະ user principal ຢູ່ໃນຮູບແບບມາດຕະຖານຫຼືບໍ່."

#. The Active Directory domain section
#: src/lib/authui/sssd/params.rb:1234
msgid "Specifies the name of the Active Directory domain."
msgstr "ລະບຸຊື່ຂອງໂດເມນ Active Directory."

#: src/lib/authui/sssd/params.rb:1239
msgid "Host names of AD servers (comma separated)."
msgstr "ຊື່ໂຮສຂອງເຊີເວີ AD (ແຍກດ້ວຍຈຸດ)."

#: src/lib/authui/sssd/params.rb:1243
msgid "Host names of backup AD servers (comma separated)."
msgstr "ຊື່ໂຮສຂອງເຊີເວີ AD ສຳຮອງ (ແຍກດ້ວຍຈຸດ)."

#: src/lib/authui/sssd/params.rb:1248
msgid ""
"AD hostname (optional) - may be set if hostname(5) does not reflect the FQDN "
"used by AD to identify this host."
msgstr ""
"ຊື່ໂຮສ AD (ຖ້າມີ) - ໃຊ້ໃນກໍລະນີທີ່ຊື່ໂຮສຂອງເຄື່ອງບໍ່ກົງກັບ FQDN ທີ່ AD ໃຊ້."

#: src/lib/authui/sssd/params.rb:1252
msgid "Override the user's home directory."
msgstr "ຂຽນທັບໄດເຣັກທໍຣີຫຼັກຂອງຜູ້ໃຊ້."

#: src/lib/authui/sssd/params.rb:1265
msgid ""
" Specifies the lower bound of the range of POSIX IDs to use for mapping "
"Active Directory user and group SIDs."
msgstr " ກຳນົດຄ່າຕ່ຳສຸດຂອງ POSIX IDs ທີ່ຈະໃຊ້ໃນການຈັບຄູ່ກັບ SID ຂອງ AD."

#: src/lib/authui/sssd/params.rb:1270
msgid ""
"Specifies the upper bound of the range of POSIX IDs to use for mapping "
"Active Directory user and group SIDs."
msgstr "ກຳນົດຄ່າສູງສຸດຂອງ POSIX IDs ທີ່ຈະໃຊ້ໃນການຈັບຄູ່ກັບ SID ຂອງ AD."

#: src/lib/authui/sssd/params.rb:1275
msgid "Specifies the number of IDs available for each slice."
msgstr "ລະບຸຈຳນວນ ID ທີ່ມີໃຫ້ໃນແຕ່ລະສ່ວນ (slice)."

#: src/lib/authui/sssd/params.rb:1279
msgid "Specify the domain SID of the default domain."
msgstr "ລະບຸ SID ຂອງໂດເມນເລີ່ມຕົ້ນ."

#: src/lib/authui/sssd/params.rb:1283
msgid "Specify the name of the default domain."
msgstr "ລະບຸຊື່ຂອງໂດເມນເລີ່ມຕົ້ນ."

#: src/lib/authui/sssd/params.rb:1288
msgid ""
"Changes the behavior of the ID-mapping algorithm to behave more similarly to "
"winbind's “idmap_autorid” algorithm."
msgstr ""
"ປ່ຽນພຶດຕິກຳຂອງອັນກໍຣິທຶມ ID-mapping ໃຫ້ຄ້າຍຄືກັບ “idmap_autorid” ຂອງ winbind."

#. The Active Directory domain section
#: src/lib/authui/sssd/params.rb:1300
msgid "Specifies the name of the IPA domain."
msgstr "ລະບຸຊື່ຂອງໂດເມນ IPA."

#: src/lib/authui/sssd/params.rb:1305
msgid "IP addresses or host names of IPA servers (comma separated)"
msgstr "ທີ່ຢູ່ IP ຫຼື ຊື່ໂຮສຂອງເຊີເວີ IPA (ແຍກດ້ວຍຈຸດ)"

#: src/lib/authui/sssd/params.rb:1310
msgid ""
"IPA hostname (optional) - may be set if hostname(5) does not reflect the "
"FQDN used by IPA to identify this host."
msgstr ""
"ຊື່ໂຮສ IPA (ຖ້າມີ) - ໃຊ້ໃນກໍລະນີທີ່ຊື່ໂຮສຂອງເຄື່ອງບໍ່ກົງກັບ FQDN ທີ່ IPA ໃຊ້."

#: src/lib/authui/sssd/params.rb:1315
msgid "The automounter location this IPA client will be using."
msgstr "ສະຖານທີ່ automounter ທີ່ IPA client ນີ້ຈະໃຊ້."

#: src/lib/authui/sssd/params.rb:1320
msgid ""
"This option tells SSSD to automatically update the DNS server built into "
"FreeIPA v2 with the IP address of this client."
msgstr ""
"ຕົວເລືອກນີ້ບອກໃຫ້ SSSD ອັບເດດທີ່ຢູ່ IP ຂອງເຄື່ອງນີ້ລົງໃນ DNS ຂອງ FreeIPA v2 ໂດຍອັດຕະໂນມັດ."

#: src/lib/authui/sssd/params.rb:1325
msgid "The TTL to apply to the client DNS record when updating it."
msgstr "ຄ່າ TTL ທີ່ຈະໃຊ້ກັບ DNS record ຂອງໄຄເອັນທ໌ເມື່ອມີການອັບເດດ."

#: src/lib/authui/sssd/params.rb:1329
msgid ""
"Choose the interface whose IP address should be used for dynamic DNS updates."
msgstr ""
"ເລືອກອິນເຕີເຟດ (interface) ທີ່ຈະໃຊ້ທີ່ຢູ່ IP ສຳລັບການອັບເດດ DNS ແບບໄດນາມິກ."
