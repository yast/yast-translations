msgstr "ໄຟລ໌"

#: src/include/sysconfig/dialogs.rb:136
msgid "Description"
msgstr "ຄຳອະທິບາຍ"

#. text entry label
#: src/include/sysconfig/dialogs.rb:179
msgid "&Variable Name"
msgstr "ຊື່ຕົວປ່ຽນ (&V)"

#. text entry label
#: src/include/sysconfig/dialogs.rb:181
msgid "V&alue"
msgstr "ຄ່າ (&A)"

#. text entry label
#: src/include/sysconfig/dialogs.rb:186
msgid "&File Name"
msgstr "ຊື່ໄຟລ໌ (&F)"

#. warning popup message - variable name is empty
#: src/include/sysconfig/dialogs.rb:210
msgid "Missing variable name value."
msgstr "ຂາດຂໍ້ມູນຊື່ຕົວປ່ຽນ."

#. warning popup message - file name is empty
#: src/include/sysconfig/dialogs.rb:214
msgid "Missing file name value."
msgstr "ຂາດຂໍ້ມູນຊື່ໄຟລ໌."

#. warning popup message - file name is required with absolute path
#: src/include/sysconfig/dialogs.rb:218
msgid "Missing absolute path in file name."
msgstr "ຂາດທີ່ຢູ່ໄຟລ໌ແບບເຕັມ (absolute path)."

#. Read dialog help
#: src/include/sysconfig/helps.rb:17
msgid ""
"<p><b><big>Initializing sysconfig Configuration</big></b><br>\n"
"Please wait...<br></p>\n"
msgstr ""
"<p><b><big>ກຳລັງເລີ່ມຕົ້ນການກຳນົດຄ່າ sysconfig</big></b><br>\n"
"ກະລຸນາລໍຖ້າ...<br></p>\n"

#. Write dialog help
#: src/include/sysconfig/helps.rb:21
msgid ""
"<p><b><big>Saving sysconfig Configuration</big></b><br>\n"
"Please wait...<br></p>\n"
"\n"
msgstr ""
"<p><b><big>ກຳລັງບັນທຶກການກຳນົດຄ່າ sysconfig</big></b><br>\n"
"ກະລຸນາລໍຖ້າ...<br></p>\n"
"\n"

#. Translation: Progress bar label
#: src/modules/Sysconfig.rb:163
msgid "Searching..."
msgstr "ກຳລັງຄົ້ນຫາ..."

#. button label
#: src/modules/Sysconfig.rb:882
msgid "S&kip"
msgstr "ຂ້າມ (&K)"

#. write dialog caption
#: src/modules/Sysconfig.rb:910
msgid "Saving sysconfig Configuration"
msgstr "ກຳລັງບັນທຶກການກຳນົດຄ່າ sysconfig"

#. progress bar item
#: src/modules/Sysconfig.rb:924
msgid "Write the new settings"
msgstr "ຂຽນການຕັ້ງຄ່າໃໝ່"

#: src/modules/Sysconfig.rb:925
msgid "Activate the changes"
msgstr "ເປີດໃຊ້ການປ່ຽນແປງ"

#: src/modules/Sysconfig.rb:935
msgid "Saving changes to the files..."
msgstr "ກຳລັງບັນທຶກການປ່ຽນແປງລົງໃນໄຟລ໌..."

#. start generic commands
#: src/modules/Sysconfig.rb:966
msgid "Finished"
msgstr "ສຳເລັດແລ້ວ"

#. configuration summary headline
#: src/modules/Sysconfig.rb:1049
msgid "Configuration Summary"
msgstr "ບົດສະຫຼຸບການກຳນົດຄ່າ"

#. Executes a bash command using #exec_action
#. @see #exec_action
#. @param cmd [String] command to execute
#. @return [Symbol] result returned by #exec_action
#: src/modules/Sysconfig.rb:1133
#, ycp-format
msgid "Starting command: %1..."
msgstr "ກຳລັງເລີ່ມຄຳສັ່ງ: %1..."

#: src/modules/Sysconfig.rb:1134
#, ycp-format
msgid "Command %1 failed"
msgstr "ຄຳສັ່ງ %1 ລົ້ມເຫຼວ"

#: src/modules/Sysconfig.rb:1135
msgid "A command will be executed"
msgstr "ຄຳສັ່ງຈະຖືກປະຕິບັດ"

#: src/modules/Sysconfig.rb:1135
msgid "Command: "
msgstr "ຄຳສັ່ງ: "

#. Restarts or reloads a service using #exec_action
#. @see #exec_action
#. @param name [String] service name
#. @param type [Symbol] :reload or :restart
#. @return [Symbol] result returned by #exec_action
#: src/modules/Sysconfig.rb:1173
#, c-format
msgid "Reloading service %s..."
msgstr "ກຳລັງໂຫຼດບໍລິການ %s ໃໝ່..."

#: src/modules/Sysconfig.rb:1174
#, c-format
msgid "Reload of the service %s failed"
msgstr "ການໂຫຼດບໍລິການ %s ໃໝ່ລົ້ມເຫຼວ"

#: src/modules/Sysconfig.rb:1175
#, c-format
msgid "Service %s will be reloaded"
msgstr "ບໍລິການ %s ຈະຖືກໂຫຼດໃໝ່"

#: src/modules/Sysconfig.rb:1177
#, c-format
msgid "Restarting service %s..."
msgstr "ກຳລັງເລີ່ມບໍລິການ %s ໃໝ່..."

#: src/modules/Sysconfig.rb:1178
#, c-format
msgid "Restart of the service %s failed"
msgstr "ການເລີ່ມບໍລິການ %s ໃໝ່ລົ້ມເຫຼວ"

#: src/modules/Sysconfig.rb:1179
#, c-format
msgid "Service %s will be restarted"
msgstr "ບໍລິການ %s ຈະຖືກເລີ່ມໃໝ່"

#. Returns whether given service is active (info from systemd)
#. If service is not found, reports error in UI and returns nil
#.
#. @param service_name
#. @return [Boolean] active?
#: src/modules/Sysconfig.rb:1204
msgid "Cannot determine service state, systemd service does not exist:"
msgstr "ບໍ່ສາມາດກວດສອບສະຖານະບໍລິການໄດ້, ບໍ່ມີບໍລິການ systemd ນີ້ຢູ່:"

#. progress bar label, %1 is variable name (e.g. DISPLAYMANAGER)
#: src/modules/Sysconfig.rb:1283
#, ycp-format
msgid "Saving variable %1..."
msgstr "ກຳລັງບັນທຶກຕົວປ່ຽນ %1..."

#. error popup: %1 - variable name (e.g. DISPLAYMANAGER), %2 - file name (/etc/sysconfig/displaymanager)
#: src/modules/Sysconfig.rb:1290
#, ycp-format
msgid "Saving variable %1 to the file %2 failed."
msgstr "ການບັນທຶກຕົວປ່ຽນ %1 ລົງໃນໄຟລ໌ %2 ລົ້ມເຫຼວ."
