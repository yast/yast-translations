#. help text header - sysconfig editor
#: src/clients/sysconfig.rb:34
msgid "Editor for /etc/sysconfig Files"
msgstr "ເຄື່ອງມືແກ້ໄຂໄຟລ໌ /etc/sysconfig"

#. help text for command 'list'
#: src/clients/sysconfig.rb:48
msgid "Display configuration summary"
msgstr "ສະແດງບົດສະຫຼຸບການກຳນົດຄ່າ"

#. help text for command 'set' 1/3
#. Split string because of technical issues with line breaks.
#. Adjust translation with other two parts to give a clear final text.
#: src/clients/sysconfig.rb:58
msgid "Set value of the variable. Requires options 'variable' and 'value'"
msgstr "ກຳນົດຄ່າຂອງຕົວປ່ຽນ. ຕ້ອງການຕົວເລືອກ 'variable' ແລະ 'value'"

#. help text for command 'set' 2/3
#. Split string because of technical issues with line breaks.
#. Adjust translation with other two parts to give a clear final text.
#: src/clients/sysconfig.rb:64
msgid "or 'variable=value', for example, variable=DISPLAYMANAGER value=gdm"
msgstr "ຫຼື 'variable=value', ຕົວຢ່າງ: variable=DISPLAYMANAGER value=gdm"

#. help text for command 'set' 3/3
#. Split string because of technical issues with line breaks.
#. Adjust translation with other two parts to give a clear final text.
#: src/clients/sysconfig.rb:70
msgid "or simply DISPLAYMANAGER=gdm"
msgstr "ຫຼື ພິມພຽງແຕ່ DISPLAYMANAGER=gdm"

#. help text for command 'set'
#: src/clients/sysconfig.rb:80
msgid "Set empty value (\"\")"
msgstr "ກຳນົດໃຫ້ເປັນຄ່າຫວ່າງ (\"\")"

#. help text for command 'details'
#: src/clients/sysconfig.rb:90
msgid "Show details about selected variable"
msgstr "ສະແດງລາຍລະອຽດກ່ຽວກັບຕົວປ່ຽນທີ່ເລືອກ"

#. help text for option 'all'
#: src/clients/sysconfig.rb:102
msgid "Display all variables"
msgstr "ສະແດງຕົວປ່ຽນທັງໝົດ"

#. help text for option 'variable'
#: src/clients/sysconfig.rb:107
msgid "Selected variable"
msgstr "ຕົວປ່ຽນທີ່ເລືອກ"

#: src/clients/sysconfig.rb:108
msgid "If the variable is available in several files use"
msgstr "ຖ້າຫາກຕົວປ່ຽນມີຢູ່ໃນຫຼາຍໄຟລ໌ ໃຫ້ໃຊ້"

#: src/clients/sysconfig.rb:109
msgid "<variable>$<file_name> syntax,"
msgstr "ຮູບແບບ <variable>$<file_name>,"

#: src/clients/sysconfig.rb:110
msgid "for example CONFIG_TYPE$/etc/sysconfig/mail."
msgstr "ຕົວຢ່າງ: CONFIG_TYPE$/etc/sysconfig/mail."

#. help text for option 'value'
#: src/clients/sysconfig.rb:116
msgid "New value"
msgstr "ຄ່າໃໝ່"

#. header (command line mode output)
#: src/include/sysconfig/cmdline.rb:43
msgid "All Variables:\n"
msgstr "ຕົວປ່ຽນທັງໝົດ:\n"

#: src/include/sysconfig/cmdline.rb:43
msgid "Modified Variables:\n"
msgstr "ຕົວປ່ຽນທີ່ຖືກປ່ຽນແປງ:\n"

#. status message - %1 is a device name (/dev/hdc), %2 is a mode name (udma2), %3 is a result (translated Success/Failed text)
#: src/include/sysconfig/cmdline.rb:77
#, ycp-format
msgid ""
"\n"
"Setting variable '%1' to '%2': %3"
msgstr ""
"\n"
"ກຳລັງຕັ້ງຄ່າຕົວປ່ຽນ '%1' ເປັນ '%2': %3"

#. result message
#: src/include/sysconfig/cmdline.rb:82
msgid "Success"
msgstr "ສຳເລັດ"

#: src/include/sysconfig/cmdline.rb:83
msgid "Failed"
msgstr "ລົ້ມເຫຼວ"

#. display a new value for modified variables
#: src/include/sysconfig/cmdline.rb:164
msgid "New Value: "
msgstr "ຄ່າໃໝ່: "

#: src/include/sysconfig/cmdline.rb:167
msgid "Value: "
msgstr "ຄ່າ: "

#. command line output
#: src/include/sysconfig/cmdline.rb:194
#, ycp-format
msgid "Variable %1 was not found."
msgstr "ບໍ່ພົບຕົວປ່ຽນ %1."

#. variable name conflict - full name (with file name) is required
#: src/include/sysconfig/cmdline.rb:217
#, ycp-format
msgid ""
"\n"
"Use a full variable name in the form <VARIABLE_NAME>$<FILE_NAME>\n"
"(e.g., %1$%2).\n"
msgstr ""
"\n"
"ໃຫ້ໃຊ້ຊື່ຕົວປ່ຽນແບບເຕັມໃນຮູບແບບ <VARIABLE_NAME>$<FILE_NAME>\n"
"(ຕົວຢ່າງ: %1$%2).\n"

#. error popup message
#: src/include/sysconfig/complex.rb:65
msgid "An error occurred while saving and activating the changes."
msgstr "ເກີດຂໍ້ຜິດພາດໃນຂະນະທີ່ກຳລັງບັນທຶກ ແລະ ເປີດໃຊ້ການປ່ຽນແປງ."

#. suffix added to the allowed (predefined) values
#: src/include/sysconfig/complex.rb:127
msgid "or any value"
msgstr "ຫຼື ຄ່າໃດໆກໍໄດ້"

#. Translation: description of possible values, regular expression string is added after the text
#: src/include/sysconfig/complex.rb:135
msgid "Value Matching Regular Expression:"
msgstr "ຄ່າທີ່ກົງກັບ Regular Expression:"

#. allowed value description
#: src/include/sysconfig/complex.rb:141
msgid "Any integer value"
msgstr "ຄ່າຈຳນວນຖ້ວນໃດໆ"

#. allowed value description
#: src/include/sysconfig/complex.rb:154
#, ycp-format
msgid "Integer value greater or equal to %1"
msgstr "ຄ່າຈຳນວນຖ້ວນທີ່ຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ %1"

#. allowed value description
#: src/include/sysconfig/complex.rb:163
#, ycp-format
msgid "Integer value less or equal to %1"
msgstr "ຄ່າຈຳນວນຖ້ວນທີ່ໜ້ອຍກວ່າ ຫຼື ເທົ່າກັບ %1"

#. Translation: allowed value description, %1 is minimum value, %2 is maximum integer value
#: src/include/sysconfig/complex.rb:172
#, ycp-format
msgid "Any integer value from %1 to %2"
msgstr "ຄ່າຈຳນວນຖ້ວນໃດໆ ແຕ່ %1 ຫາ %2"

#. allowed value description - any value is allowed
#: src/include/sysconfig/complex.rb:179
msgid "Any value"
msgstr "ຄ່າໃດໆກໍໄດ້"

#. allowed value description - IP adress
#: src/include/sysconfig/complex.rb:183
msgid "IPv4 or IPv6 address"
msgstr "ທີ່ຢູ່ IPv4 ຫຼື IPv6"

#. allowed value description - IPv4 adress
#: src/include/sysconfig/complex.rb:187
msgid "IPv4 address"
msgstr "ທີ່ຢູ່ IPv4"

#. allowed value description - IPv6 adress
#: src/include/sysconfig/complex.rb:191
msgid "IPv6 address"
msgstr "ທີ່ຢູ່ IPv6"

#. rich text item
#: src/include/sysconfig/complex.rb:220
msgid "File: "
msgstr "ໄຟລ໌: "

#. rich text item
#: src/include/sysconfig/complex.rb:236
msgid "Possible Values: "
msgstr "ຄ່າທີ່ເປັນໄປໄດ້: "

#. TODO: replace empty value by special text (e.g. "</I>empty</I>")
#. rich text value
#: src/include/sysconfig/complex.rb:255
msgid "Default Value: "
msgstr "ຄ່າເລີ່ມຕົ້ນ: "

#. rich text value
#: src/include/sysconfig/complex.rb:277
msgid "Original Value: "
msgstr "ຄ່າເດີມ: "

#. header in the variable description text, bash command is appended
#: src/include/sysconfig/complex.rb:303
msgid "Prepare Command: "
msgstr "ຄຳສັ່ງກຽມຄວາມພ້ອມ: "

#. header in the variable description text
#: src/include/sysconfig/complex.rb:323
msgid "Configuration Script: "
msgstr "ສະຄຣິບການກຳນົດຄ່າ: "

#. header in the variable description text, service names (e.g. "apache") are appended
#: src/include/sysconfig/complex.rb:341
msgid "Service to Reload: "
msgstr "ບໍລິການທີ່ຈະໂຫຼດໃໝ່: "

#. header in the variable description text, service names (e.g. "apache") are appended
#: src/include/sysconfig/complex.rb:359
msgid "Service to Restart: "
msgstr "ບໍລິການທີ່ຈະເລີ່ມໃໝ່: "

#. header in the variable description text, bash command is appended
#: src/include/sysconfig/complex.rb:376
msgid "Activation Command: "
msgstr "ຄຳສັ່ງເປີດໃຊ້ງານ: "

#. rich text value
#: src/include/sysconfig/complex.rb:424
msgid "Description: "
msgstr "ຄຳອະທິບາຍ: "

#. modification flag added to variable name (if it was changed)
#: src/include/sysconfig/complex.rb:592
msgid "(changed)"
msgstr "(ປ່ຽນແປງແລ້ວ)"

#. combo box widget label - variable name is appended to the string
#. combo box widget label - variable name is appended to the string
#. combo box label
#: src/include/sysconfig/complex.rb:602 src/include/sysconfig/complex.rb:613
#: src/include/sysconfig/complex.rb:850
msgid "S&etting of: "
msgstr "ການຕັ້ງຄ່າຂອງ: "

#. current value has more than one line - it is displayed incorrectly
#. because combobox widget has single line entry (lines are merged)
#: src/include/sysconfig/complex.rb:640
msgid ""
"The currently selected value has more than one line.\n"
"Joined lines are displayed in the combo box.\n"
msgstr ""
"ຄ່າທີ່ເລືອກໃນປັດຈຸບັນມີຫຼາຍກວ່າໜຶ່ງບັນທັດ.\n"
"ບັນທັດທີ່ລວມກັນຈະຖືກສະແດງໃນກ່ອງລາຍການ.\n"

#. header label
#. label widget
#: src/include/sysconfig/complex.rb:671 src/include/sysconfig/complex.rb:837
msgid "Current Selection: "
msgstr "ລາຍການທີ່ເລືອກປັດຈຸບັນ: "

#. popup question dialog: variable value does not match defined type - ask user to set value (%1 is value entered by user, %2 is allowed type - e.g. integer
#: src/include/sysconfig/complex.rb:713
#, ycp-format
msgid ""
"Value '%1'\n"
"does not match type '%2'.\n"
"\n"
"Really set this value?\n"
msgstr ""
"ຄ່າ '%1'\n"
"ບໍ່ກົງກັບປະເພດ '%2'.\n"
"\n"
"ຕ້ອງການຕັ້ງຄ່ານີ້ແທ້ຫຼືບໍ່?\n"

#. when a comment is too long to display it in the table
#. it is shortened and mark (three dot characters) is added to the end
#: src/include/sysconfig/complex.rb:764
msgid "..."
msgstr "..."

#. Translation: push button label
#. push button label
#: src/include/sysconfig/complex.rb:804 src/include/sysconfig/complex.rb:889
msgid "&Search"
msgstr "ຄົ້ນຫາ (&S)"

#. tree widget label
#. term help_space_content = `Tree(`id(`tree), `opt(`notify, `vstretch), _("&Configuration Options"), Sysconfig::tree_content);
#. Wizard::OpenCustomDialog(help_space_content, button_box);
#: src/include/sysconfig/complex.rb:815
msgid "&Configuration Options"
msgstr "ຕົວເລືອກການກຳນົດຄ່າ (&C)"

#. helptext for popup - part 1/2
#: src/include/sysconfig/complex.rb:819
msgid ""
"<p>After you save your changes, this editor changes the variables in the\n"
"corresponding sysconfig file. Then it starts activation commands, which "
"changes the underlying configuration files, stops and starts daemons,\n"
"and runs low-level configuration tools so your configuration in sysconfig "
"takes effect.</p>\n"
msgstr ""
"<p>ຫຼັງຈາກທ່ານບັນທຶກການປ່ຽນແປງ, ເຄື່ອງມືນີ້ຈະປ່ຽນຕົວປ່ຽນຕ່າງໆໃນ\n"
"ໄຟລ໌ sysconfig ທີ່ກ່ຽວຂ້ອງ. ຈາກນັ້ນມັນຈະເລີ່ມຄຳສັ່ງເປີດໃຊ້ງານ, ເຊິ່ງຈະ\n"
"ປ່ຽນແປງໄຟລ໌ກຳນົດຄ່າລະບົບ, ຢຸດ ຫຼື ເລີ່ມການເຮັດວຽກຂອງ daemon,\n"
"ແລະ ລັນເຄື່ອງມືກຳນົດຄ່າລະດັບຕ່ຳເພື່ອໃຫ້ການຕັ້ງຄ່າຂອງທ່ານໃນ sysconfig ມີຜົນສັກສິດ.</p>\n"

#. helptext for popup - part 2/2
#: src/include/sysconfig/complex.rb:825
msgid ""
"<p><b>Important:</b> You still can edit each individual configuration file "
"manually. The name of file is displayed in the variable description.</p>"
msgstr ""
"<p><b>ຂໍ້ຄວນລະວັງ:</b> ທ່ານຍັງສາມາດແກ້ໄຂແຕ່ລະໄຟລ໌ກຳນົດຄ່າດ້ວຍຕົນເອງໄດ້. ຊື່ຂອງໄຟລ໌ຈະຖືກສະແດງຢູ່ໃ"
"ນຄຳອະທິບາຍຕົວປ່ຽນ.</p>"

#: src/include/sysconfig/complex.rb:830
msgid "/etc/sysconfig Editor"
msgstr "ເຄື່ອງມືແກ້ໄຂ /etc/sysconfig"

#. push button label
#: src/include/sysconfig/complex.rb:859
msgid "&Default"
msgstr "ຄ່າເລີ່ມຕົ້ນ (&D)"

#. help rich text displayed after module start (1/2)
#: src/include/sysconfig/complex.rb:866
msgid ""
"<P><B>System Configuration Editor</B></P><P>With the system configuration "
"editor, you can change some system settings. You can also use YaST to "
"configure your hardware and system settings.</P>"
msgstr ""
"<P><B>ເຄື່ອງມືແກ້ໄຂການກຳນົດຄ່າລະບົບ</B></P><P>ດ້ວຍເຄື່ອງມືນີ້, ທ່ານສາມາດປ່ຽນແປງການຕັ້ງຄ່າບາງຢ່າງ"
"ຂອງລະບົບໄດ້. ທ່ານຍັງສາມາດໃຊ້ YaST ເພື່ອກຳນົດຄ່າຮາດແວ ແລະ ການຕັ້ງຄ່າລະບົບຂອງທ່ານໄດ້ອີກດ້ວຍ.</P>"

#. help rich text displayed after module start (2/2)
#: src/include/sysconfig/complex.rb:870
msgid ""
"<P><B>Note:</B> Descriptions are not translated because they are read "
"directly from configuration files.</P>"
msgstr ""
"<P><B>ໝາຍເຫດ:</B> ຄຳອະທິບາຍບໍ່ໄດ້ຖືກແປ ເພາະວ່າພວກມັນຖືກອ່ານໂດຍກົງຈາກໄຟລ໌ກຳນົດຄ່າ.</P>"

#. push button label - displayed only in autoinstallation config mode
#: src/include/sysconfig/complex.rb:877
msgid "&Use Current Value"
msgstr "ໃຊ້ຄ່າປັດຈຸບັນ (&U)"

#. push button label - displayed only in autoinstallation config mode
#: src/include/sysconfig/complex.rb:879
msgid "&Add New Variable..."
msgstr "ເພີ່ມຕົວປ່ຽນໃໝ່... (&A)"

#. popup dialog header - confirm to save the changes
#: src/include/sysconfig/complex.rb:921
msgid "Save Modified Variables"
msgstr "ບັນທຶກຕົວປ່ຽນທີ່ຖືກແກ້ໄຂ"

#. checkbox label
#: src/include/sysconfig/complex.rb:927
msgid "Confirm Each Activation Command"
msgstr "ຢືນຢັນແຕ່ລະຄຳສັ່ງເປີດໃຊ້ງານ"

#. // popup dialog header
#: src/include/sysconfig/complex.rb:949
msgid "Search Result"
msgstr "ຜົນການຄົ້ນຫາ"

#. help text in popup dialog
#: src/include/sysconfig/complex.rb:951
msgid ""
"The search results are displayed here. If you see the item you want, select "
"it then click \"Go to\". Otherwise, click \"Cancel\" to close this dialog."
msgstr ""
"ຜົນການຄົ້ນຫາຈະຖືກສະແດງຢູ່ບ່ອນນີ້. ຖ້າທ່ານເຫັນລາຍການທີ່ຕ້ອງການ, ໃຫ້ເລືອກມັນແລ້ວຄລິກ \"ໄປຫາ\". ຖ້າບໍ່ດັ່"
"ງນັ້ນ, ໃຫ້ຄລິກ \"ຍົກເລີກ\" ເພື່ອປິດໜ້າຈໍນີ້."

#. push button label
#: src/include/sysconfig/complex.rb:956
msgid "&Go to"
msgstr "ໄປຫາ (&G)"

#. popup message - search result message
#: src/include/sysconfig/complex.rb:981
msgid "No entries found"
msgstr "ບໍ່ພົບລາຍການ"

#. popup window header
#: src/include/sysconfig/complex.rb:992
msgid "Help"
msgstr "ຊ່ວຍເຫຼືອ"

#. search popup window header
#: src/include/sysconfig/dialogs.rb:33
msgid "Search for a Configuration Variable"
msgstr "ຄົ້ນຫາຕົວປ່ຽນການກຳນົດຄ່າ"

#. text entry label
#: src/include/sysconfig/dialogs.rb:41
msgid "&Search for:"
msgstr "ຄົ້ນຫາ: (&S)"

#. check box label
#: src/include/sysconfig/dialogs.rb:44
msgid "&Case Sensitive Search"
msgstr "ຄົ້ນຫາແບບແຍກຕົວອັກສອນນ້ອຍ-ໃຫຍ່ (&C)"

#. check box label
#: src/include/sysconfig/dialogs.rb:46
msgid "Search &Variable Name"
msgstr "ຄົ້ນຫາຕາມຊື່ຕົວປ່ຽນ (&V)"

#. check box label
#: src/include/sysconfig/dialogs.rb:48
msgid "Search &description"
