#. Command line help text for the Xfcoe-client module
#: src/clients/fcoe-client.rb:54
msgid "Configuration of fcoe-client"
msgstr "ການຕັ້ງຄ່າ fcoe-client"

#. progress step title
#: src/clients/fcoe-client_finish.rb:70
msgid "Saving fcoe configuration..."
msgstr "ກຳລັງບັນທຶກການຕັ້ງຄ່າ fcoe..."

#. Rich text title for FcoeClient in proposals
#: src/clients/fcoe-client_proposal.rb:82
msgid "FcoeClient"
msgstr "FcoeClient"

#. Menu title for FcoeClient in proposals
#: src/clients/fcoe-client_proposal.rb:86
msgid "&FcoeClient"
msgstr "&FcoeClient"

#. setting of config value is 'yes'
#: src/include/fcoe-client/complex.rb:51
msgid "yes"
msgstr "ແມ່ນ"

#. setting of config value is 'no'
#: src/include/fcoe-client/complex.rb:53
msgid "no"
msgstr "ບໍ່"

#. text of an error popup
#: src/include/fcoe-client/complex.rb:105
#, ycp-format
msgid ""
"Cannot remove the FCoE interface.\n"
"Command %1 failed."
msgstr ""
"ບໍ່ສາມາດລົບອິນເຕີເຟສ FCoE ອອກໄດ້.\n"
"ຄຳສັ່ງ %1 ຫຼົ້ມເຫຼວ."

#. FCoE is not available on the interface
#: src/include/fcoe-client/complex.rb:197
msgid "not available"
msgstr "ບໍ່ພ້ອມໃຊ້ງານ"

#. the interface is not configured for FCoE
#: src/include/fcoe-client/complex.rb:199
msgid "not configured"
msgstr "ບໍ່ທັນໄດ້ຕັ້ງຄ່າ"

#. the flag is 'true'
#: src/include/fcoe-client/complex.rb:205
msgid "true"
msgstr "ແມ່ນ"

#. the flag is 'false'
#: src/include/fcoe-client/complex.rb:207
msgid "false"
msgstr "ບໍ່ແມ່ນ"

#. the flag is not set at all
#: src/include/fcoe-client/complex.rb:209
msgid "not set"
msgstr "ບໍ່ທັນໄດ້ກຳນົດ"

#. headline of the edit dialog - configuration of values for a certain network interface
#: src/include/fcoe-client/complex.rb:308
#, ycp-format
msgid "Configuration of VLAN interface %1 on %2"
msgstr "ການຕັ້ງຄ່າອິນເຕີເຟສ VLAN %1 ໃນ %2"

#. text of an error popup
#: src/include/fcoe-client/complex.rb:369
#, ycp-format
msgid ""
"Cannot start FCoE on VLAN interface %1\n"
"because FCoE is already configured on\n"
"network interface %2 itself."
msgstr ""
"ບໍ່ສາມາດເລີ່ມ FCoE ໃນອິນເຕີເຟສ VLAN %1 ໄດ້\n"
"ເພາະວ່າ FCoE ໄດ້ຖືກຕັ້ງຄ່າໄວ້ແລ້ວໃນ\n"
"ອິນເຕີເຟສເຄືອຂ່າຍ %2."

#. text of an error popup
#: src/include/fcoe-client/complex.rb:381
#, ycp-format
msgid ""
"Cannot start FCoE on network interface %1 itself\n"
"because FCoE is already configured on\n"
"VLAN interface(s) %2."
msgstr ""
"ບໍ່ສາມາດເລີ່ມ FCoE ໃນອິນເຕີເຟສເຄືອຂ່າຍ %1 ໄດ້\n"
"ເພາະວ່າ FCoE ໄດ້ຖືກຕັ້ງຄ່າໄວ້ແລ້ວໃນ\n"
"ອິນເຕີເຟສ VLAN %2."

#. headline of a popup: creating and starting Fibre Channel over Ethernet
#: src/include/fcoe-client/complex.rb:412
msgid "Creating and Starting FCoE on Detected VLAN Device"
msgstr "ກຳລັງສ້າງ ແລະ ເລີ່ມ FCoE ໃນອຸປະກອນ VLAN ທີ່ກວດພົບ"

#. question to the user: really create and start FCoE
#: src/include/fcoe-client/complex.rb:415
#, ycp-format
msgid ""
"Do you really want to create a FCoE network\n"
"interface for discovered VLAN interface %1\n"
"on %2 and start the FCoE initiator?"
msgstr ""
"ເຈົ້າຕ້ອງການສ້າງອິນເຕີເຟສເຄືອຂ່າຍ FCoE ສຳລັບອິນເຕີເຟສ\n"
"VLAN %1 ທີ່ກວດພົບໃນ %2\n"
"ແລະ ເລີ່ມ FCoE initiator ແທ້ຫຼືບໍ່?"

#. text of an error popup
#: src/include/fcoe-client/complex.rb:433
#, ycp-format
msgid "Cannot create and start FCoE on %1."
msgstr "ບໍ່ສາມາດສ້າງ ແລະ ເລີ່ມ FCoE ໃນ %1 ໄດ້."

#. text of an error popup: command failed on the network interface
#: src/include/fcoe-client/complex.rb:464
#, ycp-format
msgid "Command \"%1\" on %2 failed."
msgstr "ຄຳສັ່ງ \"%1\" ໃນ %2 ຫຼົ້ມເຫຼວ."

#: src/include/fcoe-client/complex.rb:472
msgid ""
"Creating FCoE interface failed.\n"
"Continue because running in test mode"
msgstr ""
"ການສ້າງອິນເຕີເຟສ FCoE ຫຼົ້ມເຫຼວ.\n"
"ດຳເນີນການຕໍ່ເນື່ອງຈາກກຳລັງຢູ່ໃນໂໝດທົດລອງ"

#. popup text: really remove FCoE VLAN interface
#: src/include/fcoe-client/complex.rb:567
#, ycp-format
msgid "Do you really want to remove the FCoE interface %1?"
msgstr "ເຈົ້າຕ້ອງການລົບອິນເຕີເຟສ FCoE %1 ອອກແທ້ຫຼືບໍ່?"

#. popup text continues
#: src/include/fcoe-client/complex.rb:575
msgid ""
"Attention:\n"
"Make sure the interface is not essential for a used device.\n"
"Removing it may result in an unusable system."
msgstr ""
"ຂໍ້ຄວນລະວັງ:\n"
"ໃຫ້ແນ່ໃຈວ່າອິນເຕີເຟສນີ້ບໍ່ຈຳເປັນສຳລັບອຸປະກອນທີ່ໃຊ້ງານຢູ່.\n"
"ການລົບມັນອາດເຮັດໃຫ້ລະບົບບໍ່ສາມາດໃຊ້ງານໄດ້."

#. popup text continues
#: src/include/fcoe-client/complex.rb:585
msgid ""
"Don't remove the interface if it's related\n"
"to an already activated multipath device."
msgstr ""
"ຢ່າລົບອິນເຕີເຟສອອກ ຫາກມັນກ່ຽວຂ້ອງກັບ\n"
"ອຸປະກອນ multipath ທີ່ຖືກເປີດໃຊ້ງານໄວ້ແລ້ວ."

#. replace values in table
#: src/include/fcoe-client/complex.rb:730
#, ycp-format
msgid "Removing of interface %1 failed."
msgstr "ການລົບອິນເຕີເຟສ %1 ຫຼົ້ມເຫຼວ."

#: src/include/fcoe-client/complex.rb:742
#, ycp-format
msgid "Destroying interface %1 failed."
msgstr "ການທຳລາຍອິນເຕີເຟສ %1 ຫຼົ້ມເຫຼວ."

#. text of a warning popup
#: src/include/fcoe-client/complex.rb:772
msgid ""
"DCB Required is set to \"yes\" but the\n"
"interface isn't DCB capable."
msgstr ""
"DCB Required ຖືກຕັ້ງເປັນ \"ແມ່ນ\" ແຕ່\n"
"ອິນເຕີເຟສນີ້ບໍ່ຮອງຮັບ DCB."

#. text of an information (notify)  popup
#: src/include/fcoe-client/complex.rb:809
msgid ""
"Service 'fcoe' requires enabled service 'lldpad'.\n"
"Enabling start on boot of service 'lldpad'."
msgstr ""
"ບໍລິການ 'fcoe' ຕ້ອງການການເປີດໃຊ້ງານບໍລິການ 'lldpad'.\n"
"ກຳລັງເປີດການເລີ່ມຕົ້ນບໍລິການ 'lldpad' ເມື່ອບູດເຄື່ອງ."

#. radio button: start service on boot
#. radio button: start service on boot
#: src/include/fcoe-client/dialogs.rb:48 src/include/fcoe-client/dialogs.rb:69
msgid "When Booting"
msgstr "ເມື່ອບູດເຄື່ອງ"

#. radio button: start service manually
#. radio button: start service manually
#: src/include/fcoe-client/dialogs.rb:56 src/include/fcoe-client/dialogs.rb:77
msgid "Manually"
msgstr "ດ້ວຍຕົນເອງ"

#. combo box label: enable FCoE (yes/no)
#: src/include/fcoe-client/dialogs.rb:109
msgid "&FCoE Enable"
msgstr "&ເປີດໃຊ້ FCoE"

#: src/include/fcoe-client/dialogs.rb:110
#: src/include/fcoe-client/dialogs.rb:118
#: src/include/fcoe-client/dialogs.rb:125
#: src/include/fcoe-client/dialogs.rb:230
#: src/include/fcoe-client/dialogs.rb:241
msgid "Yes"
msgstr "ແມ່ນ"

#: src/include/fcoe-client/dialogs.rb:110
#: src/include/fcoe-client/dialogs.rb:118
#: src/include/fcoe-client/dialogs.rb:125
#: src/include/fcoe-client/dialogs.rb:230
#: src/include/fcoe-client/dialogs.rb:241
msgid "No"
msgstr "ບໍ່"

#. combo box label: require DCB (yes/no)
#: src/include/fcoe-client/dialogs.rb:117
msgid "&DCB Required"
msgstr "&ຕ້ອງການ DCB"

#. combo box label: AUTO_VLAN setting (yes/no)
#: src/include/fcoe-client/dialogs.rb:124
msgid "&AUTO_VLAN"
msgstr "&AUTO_VLAN"

#. frame containing radio buttons for fcoe service start
#: src/include/fcoe-client/dialogs.rb:150
msgid "FCoE Service Start"
msgstr "ການເລີ່ມບໍລິການ FCoE"

#. frame containing radio buttons for lldpad service start
#: src/include/fcoe-client/dialogs.rb:155
msgid "Lldpad Service Start"
msgstr "ການເລີ່ມບໍລິການ Lldpad"

#. column headers of table of network interfaces (keep them short)
#: src/include/fcoe-client/dialogs.rb:179
msgid "Device"
msgstr "ອຸປະກອນ"

#: src/include/fcoe-client/dialogs.rb:180
msgid "MAC Address"
msgstr "ທີ່ຢູ່ MAC"

#: src/include/fcoe-client/dialogs.rb:181
msgid "Model"
msgstr "ລຸ້ນ"

#: src/include/fcoe-client/dialogs.rb:182
msgid "VLAN"
msgstr "VLAN"

#: src/include/fcoe-client/dialogs.rb:183
msgid "FCoE VLAN Interface"
msgstr "ອິນເຕີເຟສ FCoE VLAN"

#: src/include/fcoe-client/dialogs.rb:184
msgid "FCoE Enable"
msgstr "ເປີດໃຊ້ FCoE"

#: src/include/fcoe-client/dialogs.rb:185
msgid "DCB Required"
msgstr "ຕ້ອງການ DCB"

#: src/include/fcoe-client/dialogs.rb:186
msgid "AUTO VLAN"
msgstr "AUTO VLAN"

#: src/include/fcoe-client/dialogs.rb:187
msgid "DCB capable"
msgstr "ຮອງຮັບ DCB"

#: src/include/fcoe-client/dialogs.rb:188
msgid "Driver"
msgstr "ໄດເວີ"

#: src/include/fcoe-client/dialogs.rb:189
msgid "Flag FCoE"
msgstr "ແຟລັກ FCoE"

#: src/include/fcoe-client/dialogs.rb:190
msgid "Flag iSCSI"
msgstr "ແຟລັກ iSCSI"

#: src/include/fcoe-client/dialogs.rb:191
msgid "Storage Only"
msgstr "ສະເພາະບ່ອນເກັບຂໍ້ມູນ"

#. button labels
#: src/include/fcoe-client/dialogs.rb:198
msgid "Retry &Detection"
msgstr "ກວດຫາຄືນໃໝ່"

#: src/include/fcoe-client/dialogs.rb:199
msgid "Change &Settings"
msgstr "ປ່ຽນການຕັ້ງຄ່າ"

#: src/include/fcoe-client/dialogs.rb:200
msgid "Create &FCoE Interface"
msgstr "ສ້າງອິນເຕີເຟສ FCoE"

#: src/include/fcoe-client/dialogs.rb:201
msgid "&Remove Interface"
msgstr "ລົບອິນເຕີເຟສອອກ"

#. frame label - configuration settings of FCoE
#: src/include/fcoe-client/dialogs.rb:222
msgid "Configuration Settings"
msgstr "ການຕັ້ງຄ່າ"

#. combo box label (debug setting yes/no)
#: src/include/fcoe-client/dialogs.rb:229
msgid "&Debug"
msgstr "&ດີບັກ"

#. combo box label (use syslog yes/no)
#: src/include/fcoe-client/dialogs.rb:240
msgid "&Use syslog"
msgstr "&ໃຊ້ syslog"

#. Read dialog help 1/2
#: src/include/fcoe-client/helps.rb:35
msgid ""
"<p><b><big>Initializing fcoe-client Configuration</big></b><br>\n"
"Please wait...<br></p>\n"
msgstr ""
"<p><b><big>ກຳລັງເລີ່ມຕົ້ນການຕັ້ງຄ່າ fcoe-client</big></b><br>\n"
"ກະລຸນາລໍຖ້າ...<br></p>\n"

#. Read dialog help 2/2
#: src/include/fcoe-client/helps.rb:39
msgid ""
"<p><b><big>Aborting Initialization:</big></b><br>\n"
"Safely abort the configuration utility by pressing <b>Abort</b> now.</p>\n"
msgstr ""
"<p><b><big>ກຳລັງຍົກເລີກການເລີ່ມຕົ້ນ:</big></b><br>\n"
"ຍົກເລີກເຄື່ອງມືຕັ້ງຄ່າຢ່າງປອດໄພໂດຍການກົດ <b>ຍົກເລີກ</b> ດຽວນີ້.</p>\n"

#. Write dialog help 1/2
#: src/include/fcoe-client/helps.rb:43
msgid ""
"<p><b><big>Saving fcoe-client Configuration</big></b><br>\n"
"Please wait...<br></p>\n"
msgstr ""
"<p><b><big>ກຳລັງບັນທຶກການຕັ້ງຄ່າ fcoe-client</big></b><br>\n"
"ກະລຸນາລໍຖ້າ...<br></p>\n"

#. Write dialog help 2/2
#: src/include/fcoe-client/helps.rb:47
msgid ""
"<p><b><big>Aborting Saving:</big></b><br>\n"
"Abort the save procedure by pressing <b>Abort</b>.\n"
"An additional dialog informs whether it is safe to do so.\n"
"</p>\n"
msgstr ""
"<p><b><big>ການຍົກເລີກການບັນທຶກ:</big></b><br>\n"
"ຍົກເລີກຂັ້ນຕອນການບັນທຶກໂດຍການກົດ <b>ຍົກເລີກ</b>.\n"
"ຈະມີກ່ອງຂໍ້ຄວາມແຈ້ງເຕືອນວ່າສາມາດເຮັດໄດ້ຢ່າງປອດໄພຫຼືບໍ່.\n"
"</p>\n"

#. Summary dialog help 1/3
#: src/include/fcoe-client/helps.rb:54
msgid ""
"<p><b><big>FcoeClient Configuration</big></b><br>\n"
"Configure fcoe-client here.<br></p>\n"
msgstr ""
"<p><b><big>ການຕັ້ງຄ່າ FcoeClient</big></b><br>\n"
"ຕັ້ງຄ່າ fcoe-client ຢູ່ທີ່ນີ້.<br></p>\n"

#. Summary dialog help 2/3
#: src/include/fcoe-client/helps.rb:58
msgid ""
"<p><b><big>Adding a fcoe-client:</big></b><br>\n"
"Choose a fcoe-client from the list of detected fcoe-clients.\n"
"If your fcoe-client was not detected, use <b>Other (not detected)</b>.\n"
"Then press <b>Configure</b>.</p>\n"
msgstr ""
"<p><b><big>ການເພີ່ມ fcoe-client:</big></b><br>\n"
"ເລືອກ fcoe-client ຈາກລາຍຊື່ທີ່ກວດພົບ.\n"
"ຫາກບໍ່ພົບ fcoe-client ຂອງທ່ານ, ໃຫ້ໃຊ້ <b>ອື່ນໆ (ກວດບໍ່ພົບ)</b>.\n"
"ຈາກນັ້ນກົດ <b>ຕັ້ງຄ່າ</b>.</p>\n"

#. Summary dialog help 3/3
#: src/include/fcoe-client/helps.rb:65
msgid ""
"<p><b><big>Editing or Deleting:</big></b><br>\n"
"If you press <b>Edit</b>, an additional dialog in which to change\n"
"the configuration opens.</p>\n"
msgstr ""
"<p><b><big>ການແກ້ໄຂ ຫຼື ການລົບ:</big></b><br>\n"
"ຫາກທ່ານກົດ <b>ແກ້ໄຂ</b>, ຈະມີກ່ອງຂໍ້ຄວາມເປີດຂຶ້ນມາເພື່ອປ່ຽນແປງ\n"
"ການຕັ້ງຄ່າ.</p>\n"

#. Services dialog help 1/3
#: src/include/fcoe-client/helps.rb:71
msgid ""
"<p><b><big>Starting of services</big><br></b><br>Enable or disable the start "
"of the services <b>fcoe</b> and <b>lldpad</b> at boot time.</p>"
msgstr ""
"<p><b><big>ການເລີ່ມຕົ້ນບໍລິການ</big><br></b><br>ເປີດ ຫຼື ປິດການເລີ່ມຕົ້ນຂອງບໍລິການ <b>fcoe</"
"b> ແລະ <b>lldpad</b> ໃນເວລາບູດເຄື່ອງ.</p>"

#. Services dialog help 2/3
#: src/include/fcoe-client/helps.rb:76
msgid ""
"<p>Starting the service <b>fcoe</b> means starting the <i>Fibre Channel over "
"Ethernet</i> service daemon <i>fcoemon</i> which controls the FCoE "
"interfaces and establishes a connection with the daemon <i>lldpad</i>.</p>"
msgstr ""
"<p>ການເລີ່ມບໍລິການ <b>fcoe</b> ແມ່ນການເລີ່ມ <i>Fibre Channel over Ethernet</i> "
"service daemon <i>fcoemon</i> ເຊິ່ງເຮັດໜ້າທີ່ຄວບຄຸມອິນເຕີເຟສ FCoE ແລະ ສ້າງການເຊື່ອມຕໍ່ກັບ "
"daemon <i>lldpad</i>.</p>"

#. Services dialog help 3/3
#: src/include/fcoe-client/helps.rb:82
msgid ""
"<p>The <b>lldpad</b> service provides the <i>Link Layer Discovery Protocol</"
"i> agent daemon <i>lldpad</i>, which informs <i>fcoemon</i> about DCB (Data "
"Center Bridging) features and configuration of the interfaces.</p>"
msgstr ""
"<p>ບໍລິການ <b>lldpad</b> ຈະໃຫ້ບໍລິການ <i>Link Layer Discovery Protocol</i> agent "
"daemon <i>lldpad</i>, ເຊິ່ງຈະແຈ້ງໃຫ້ <i>fcoemon</i> ຊາບກ່ຽວກັບຄຸນສົມບັດ DCB (Data "
"Center Bridging) ແລະ ການຕັ້ງຄ່າຂອງອິນເຕີເຟສ.</p>"

#. Interfaces dialog help 1/5
#: src/include/fcoe-client/helps.rb:88
msgid "<p><b><big>Network interface overview</big></b></p>"
msgstr "<p><b><big>ພາບລວມອິນເຕີເຟສເຄືອຂ່າຍ</big></b></p>"

#. Interfaces dialog help 2/5
#: src/include/fcoe-client/helps.rb:92
msgid ""
"<p>The interfaces dialog shows all detected netcards including the status of "
"VLAN and FCoE configuration.<br>FCoE is possible if a VLAN interface is "
"configured for FCoE on the switch.<br>For every netcard (network interface), "
"this is shown in column <i>FCoE VLAN Interface</i>.</p>"
msgstr ""
"<p>ກ່ອງຂໍ້ຄວາມອິນເຕີເຟສຈະສະແດງກາດເຄືອຂ່າຍທັງໝົດທີ່ກວດພົບ ລວມທັງສະຖານະຂອງການຕັ້ງຄ່າ VLAN ແລະ "
"FCoE.<br>FCoE ຈະສາມາດໃຊ້ງານໄດ້ຫາກອິນເຕີເຟສ VLAN ຖືກຕັ້ງຄ່າສຳລັບ FCoE ໃນສະວິດ.<br>ສຳລັບທຸກ"
"ໆກາດເຄືອຂ່າຍ, ຂໍ້ມູນນີ້ຈະສະແດງໃນຖັນ <i>ອິນເຕີເຟສ FCoE VLAN</i>.</p>"

#. Interfaces dialog help 3/5
#: src/include/fcoe-client/helps.rb:99
msgid ""
"<p>It's possible to retry the check for FCoE services by using <b>Retry "
"Detection</b>(might be required for interfaces needing some time to get up)."
"</p>"
msgstr ""
"<p>ມັນເປັນໄປໄດ້ທີ່ຈະລອງກວດສອບການບໍລິການ FCoE ຄືນໃໝ່ໂດຍການໃຊ້ <b>ການກວດຫາຄືນໃໝ່</b> (ອາດຈະ"
"ຈຳເປັນສຳລັບອິນເຕີເຟດທີ່ຕ້ອງການເວລາໃນການເລີ່ມລະບົບ).</p>"

#. Interfaces dialog help 4/5
#: src/include/fcoe-client/helps.rb:103
msgid ""
"<p>The values for <i>FCoE VLAN Interface</i> in detail:<br><b>not available</"
"b>: Fibre Channel over Ethernet is not possible (must be enabled on the "
"switch first).<br><b>not configured</b>: FCoE is possible but not yet "
"activated.<br>Press <b>Create FCoE VLAN Interface</b> to activate.<br>If the "
"FCoE VLAN interface has already been created, the name is shown in the "
"column, e.g. eth3.200.</p>"
msgstr ""
"<p>ລາຍລະອຽດຄ່າຂອງ <i>ອິນເຕີເຟສ FCoE VLAN</i>:<br><b>ບໍ່ພ້ອມໃຊ້ງານ</b>: ບໍ່ສາມາດໃຊ້ "
"Fibre Channel over Ethernet ໄດ້ (ຕ້ອງເປີດໃຊ້ໃນສະວິດກ່ອນ).<br><b>ບໍ່ທັນໄດ້ຕັ້ງຄ່າ</b>: ສາມາ"
"ດໃຊ້ FCoE ໄດ້ແຕ່ຍັງບໍ່ທັນໄດ້ເປີດໃຊ້ງານ.<br>ກົດ <b>ສ້າງອິນເຕີເຟສ FCoE VLAN</b> ເພື່ອເປີດໃຊ້ງາ"
"ນ.<br>ຫາກອິນເຕີເຟສ FCoE VLAN ຖືກສ້າງແລ້ວ, ຊື່ຈະສະແດງໃນຖັນ, ເຊັ່ນ eth3.200.</p>"

#. Interfaces dialog help 4/5
#: src/include/fcoe-client/helps.rb:113
msgid ""
"<p>To change the configuration of a FCoE VLAN interface, click on <b>Change "
"Settings</b>.</p>"
msgstr ""
"<p>ເພື່ອປ່ຽນການຕັ້ງຄ່າຂອງອິນເຕີເຟສ FCoE VLAN, ໃຫ້ຄລິກທີ່ <b>ປ່ຽນການຕັ້ງຄ່າ</b>.</p>"

#. Configuration dialog help 1/3
#: src/include/fcoe-client/helps.rb:117
msgid "<p><b><big>General Configuration of FCoE</big></b></p>"
msgstr "<p><b><big>ການຕັ້ງຄ່າທົ່ວໄປຂອງ FCoE</big></b></p>"

#. Configuration dialog help 2/3
#: src/include/fcoe-client/helps.rb:121
msgid ""
"<p>Configure the general settings for the FCoE system service. The settings "
"are written to '/etc/fcoe/config'.</p>"
msgstr ""
"<p>ຕັ້ງຄ່າທົ່ວໄປສຳລັບບໍລິການລະບົບ FCoE. ການຕັ້ງຄ່າຈະຖືກບັນທຶກໄວ້ໃນ '/etc/fcoe/config'.</p>"

#. Configuration dialog help 3/3
#: src/include/fcoe-client/helps.rb:125
msgid ""
"<p>The values are:<br>\n"
"<b>Debug</b>: <i>yes</i> or <i>no</i><br>This is used to enable or disable "
"debugging messages from the fcoe service script and <i>fcoemon</i>."
"<br><b>Use syslog</b>: <i>yes</i> or <i>no</i><br>Messages are sent to the "
"system log if set to <i>yes</i> (data are logged to /var/log/messages).</p>"
msgstr ""
"<p>ຄ່າຕ່າງໆຄື:<br>\n"
"<b>ດີບັກ</b>: <i>ແມ່ນ</i> ຫຼື <i>ບໍ່</i><br>ໃຊ້ເພື່ອເປີດ ຫຼື ປິດຂໍ້ຄວາມດີບັກຈາກສະຄຣິບບໍລິການ fcoe "
"ແລະ <i>fcoemon</i>.<br><b>ໃຊ້ syslog</b>: <i>ແມ່ນ</i> ຫຼື <i>ບໍ່</i><br>ຂໍ້ຄວາມຈະຖືກສົ່ງ"
"ໄປທີ່ບັນທຶກລະບົບຫາກຕັ້ງເປັນ <i>ແມ່ນ</i> (ຂໍ້ມູນຈະຖືກບັນທຶກໄວ້ໃນ /var/log/messages).</p>"

#. edit dialog help 1/3
#: src/include/fcoe-client/helps.rb:133
msgid "<p>Edit Settings in /etc/fcoe/ethx</p>"
msgstr "<p>ແກ້ໄຂການຕັ້ງຄ່າໃນ /etc/fcoe/ethx</p>"

#. Edit dialog help 2/3
#: src/include/fcoe-client/helps.rb:137
msgid ""
"<p>The daemon <i>fcoemon</i> reads these configuration files on "
"initialization.<br>There is a file for every interface and the values "
"indicate whether FCoE instances should be created and if DCB is required.</p>"
msgstr ""
"<p>Daemon <i>fcoemon</i> ຈະອ່ານໄຟລ໌ຕັ້ງຄ່າເຫຼົ່ານີ້ໃນເວລາເລີ່ມຕົ້ນ.<br>ຈະມີໄຟລ໌ສຳລັບແຕ່ລະອິນເຕີເຟ"
"ສ ແລະ ຄ່າຕ່າງໆຈະລະບຸວ່າຄວນສ້າງ FCoE instances ຫຼື ບໍ່ ແລະ ຕ້ອງການ DCB ຫຼື ບໍ່.</p>"

#. Edit dialog help 3/3
#: src/include/fcoe-client/helps.rb:143
msgid ""
"<p>The values are:<br><b>FCoE Enable</b>: <i>yes</i> or <i>no</i><br>Enable "
"or disable the creation of FCoE instances.<br><b>DCB Required</b>: <i>yes</"
"i> or <i>no</i><br>The default is <i>yes</i>, DCB is usually required."
"<br><b>AUTO VLAN</b>: <i>yes</i> or <i>no</i><br>If set to <i>yes</i> "
"'fcoemon' will create the VLAN interfaces automatically.</p>"
msgstr ""
"<p>ຄ່າຕ່າງໆຄື:<br><b>ເປີດໃຊ້ FCoE</b>: <i>ແມ່ນ</i> ຫຼື <i>ບໍ່</i><br>ເປີດ ຫຼື ປິດການສ້າງ "
"FCoE instances.<br><b>ຕ້ອງການ DCB</b>: <i>ແມ່ນ</i> ຫຼື <i>ບໍ່</i><br>ຄ່າເລີ່ມຕົ້ນຄື <i>ແມ່"
"ນ</i>, ປົກກະຕິແລ້ວຈຳເປັນຕ້ອງມີ DCB.<br><b>AUTO VLAN</b>: <i>ແມ່ນ</i> ຫຼື <i>ບໍ່</i><br>ຫ"
"າກຕັ້ງເປັນ <i>ແມ່ນ</i> 'fcoemon' ຈະສ້າງອິນເຕີເຟສ VLAN ໃຫ້ໂດຍອັດຕະໂນມັດ.</p>"

