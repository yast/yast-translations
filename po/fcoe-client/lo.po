#: src/modules/FcoeClient.rb:1501
msgid "Cannot write settings to /etc/fcoe/config."
msgstr "ບໍ່ສາມາດຂຽນການຕັ້ງຄ່າລົງໃນ /etc/fcoe/config ໄດ້."

#: src/modules/FcoeClient.rb:1507
msgid ""
"Cannot write settings for FCoE interfaces.\n"
"For details, see /var/log/YaST2/y2log."
msgstr ""
"ບໍ່ສາມາດຂຽນການຕັ້ງຄ່າສຳລັບອິນເຕີເຟສ FCoE ໄດ້.\n"
"ສຳລັບລາຍລະອຽດ, ໃຫ້ເບິ່ງທີ່ /var/log/YaST2/y2log."

#. Error message
#: src/modules/FcoeClient.rb:1519
msgid "Restarting of service fcoe failed."
msgstr "ການເລີ່ມບໍລິການ fcoe ຄືນໃໝ່ຫຼົ້ມເຫຼວ."

#. Error message
#: src/modules/FcoeClient.rb:1526
msgid "Cannot write /etc/sysconfig/network/ifcfg-files."
msgstr "ບໍ່ສາມາດຂຽນ /etc/sysconfig/network/ifcfg-files ໄດ້."

#. Configuration summary text for autoyast
#: src/modules/FcoeClient.rb:1583
msgid "<b>General FCoE configuration</b>"
msgstr "<b>ການຕັ້ງຄ່າ FCoE ທົ່ວໄປ</b>"

#. options from config file, not meant for translation
#: src/modules/FcoeClient.rb:1597
msgid "<b>Interfaces</b>"
msgstr "<b>ອິນເຕີເຟສ</b>"

#. network card, e.g. eth0
#: src/modules/FcoeClient.rb:1605
msgid "<i>Netcard</i>:"
msgstr "<i>ກາດເຄືອຂ່າຍ</i>:"

#. nothing to translate here (abbreviation for
#. Fibre Channel over Ethernet Virtual LAN interface)
