#. help text 1/3
#: src/include/nis_server/details.rb:66
msgid ""
"<p>You can change NIS server source directory (usually\n"
"<i>'/etc'</i>).</p>"
msgstr ""
"<p>ເຈົ້າສາມາດປ່ຽນໄດເຣັກທໍຣີຕົ້ນທາງຂອງເຊີເວີ NIS (ປົກກະຕິແມ່ນ\n"
"<i>'/etc'</i>).</p>"

#. help text 2/3
#: src/include/nis_server/details.rb:73
msgid ""
"<p>Select if your <i>passwd</i> file should be merged with the <i>shadow</"
"i>\n"
"file (only possible if the <i>shadow</i> file exists).</p>\n"
msgstr ""
"<p>ເລືອກຖ້າຫາກເຈົ້າຕ້ອງການລວມໄຟລ໌ <i>passwd</i> ເຂົ້າກັບໄຟລ໌ <i>shadow</i>\n"
"(ສາມາດເຮັດໄດ້ກໍຕໍ່ເມື່ອມີໄຟລ໌ <i>shadow</i> ຢູ່ແລ້ວ).</p>\n"

#. help text 3/3
#: src/include/nis_server/details.rb:81
msgid "<p>You can also adjust the minimum user and group id.</p>"
msgstr "<p>ທ່ານຍັງສາມາດປັບປ່ຽນຄ່າຕ່ຳສຸດຂອງໄອດີຜູ້ໃຊ້ ແລະ ກຸ່ມ.</p>"

#. To translators: intfield label
#: src/include/nis_server/details.rb:86
msgid "Minimum &UID"
msgstr "&UID ຕໍ່າສຸດ"

#. To translators: intfield label
#: src/include/nis_server/details.rb:89
msgid "Minimum &GID"
msgstr "&GID ຕໍ່າສຸດ"

#. To translators: textentry label
#: src/include/nis_server/details.rb:98
msgid "&YP Source directory"
msgstr "ໄດເຣັກທໍຣີຕົ້ນທາງ &YP"

#. check box label
#: src/include/nis_server/details.rb:103
msgid "Merge pa&sswords"
msgstr "ລວມລະຫັດຜ່&ານ"

#. To translators: dialog label
#: src/include/nis_server/details.rb:111
msgid "NIS Master Server Details Setup"
msgstr "ຕັ້ງຄ່າລາຍລະອຽດເຊີເວີຫຼັກ NIS"

#. help text 1/1
#. Translators: the text was truncated because now there's
#. a MultiSelectionBox instead of two SelectionBoxes that
#. were a pain to use.
#: src/include/nis_server/maps.rb:61
msgid "<p>With this dialog, adjust which maps will be available.</p>"
msgstr "<p>ໃຊ້ກ່ອງຂໍ້ຄວາມນີ້ເພື່ອປັບແຕ່ງວ່າຈະໃຫ້ມີແຜນຜັງ (maps) ໃດແດ່.</p>"

#. multilesection box label
#: src/include/nis_server/maps.rb:103
msgid "&Maps"
msgstr "ແຜນ&ຜັງ (Maps)"

#. To translators: dialog label
#: src/include/nis_server/maps.rb:109
msgid "NIS Server Maps Setup"
msgstr "ຕັ້ງຄ່າແຜນຜັງເຊີເວີ NIS"

#. help text 1/3
#: src/include/nis_server/master.rb:71
msgid ""
"<p>Enter a NIS <b>domain</b>. If this host is also a NIS client using this "
"machine as a server, check\n"
"the corresponding option.</p>\n"
msgstr ""
"<p>ປ້ອນ <b>ໂດເມນ</b> NIS. ຖ້າໂຮສນີ້ເປັນລູກຂ່າຍ (NIS client) ທີ່ໃຊ້ເຄື່ອງນີ້ເປັນເຊີເວີ, ໃຫ້ໝາຍຕິກ"
"ເອົາ\n"
"ຕົວເລືອກທີ່ກ່ຽວຂ້ອງ.</p>\n"

#. help text 2/3
#. TRANSLATORS: workers or worker servers used to be known as slave servers before
#: src/include/nis_server/master.rb:79
msgid ""
"<p>For worker servers to cooperate with this master, check\n"
"<i>Active Worker NIS server exists</i>. If you check\n"
"<i>Fast Map distribution</i>, it will speed up the transfer of maps to the\n"
"workers.</p>\n"
msgstr ""
"<p>ເພື່ອໃຫ້ເຊີເວີຜູ້ຊ່ວຍເຮັດວຽກຮ່ວມກັບເຊີເວີຫຼັກນີ້, ໃຫ້ໝາຍເລືອກ\n"
"<i>ມີເຊີເວີ NIS ຜູ້ຊ່ວຍທີ່ເຮັດວຽກຢູ່</i>. ຖ້າທ່ານໝາຍເລືອກ\n"
"<i>ການກະຈາຍແຜນຜັງແບບໄວ</i>, ມັນຈະຊ່ວຍເລັ່ງຄວາມໄວໃນການສົ່ງຕໍ່ແຜນຜັງໄປຍັງ\n"
"ບັນດາຜູ້ຊ່ວຍ.</p>\n"

#. help text 3/3
#: src/include/nis_server/master.rb:90
msgid ""
"<p><i>Allow changes to passwords</i> lets the users change their\n"
"passwords in the presence of NIS. Buttons to allow\n"
"changing the login shell or GECOS (full name and related information) can\n"
"be used to set up these more specific options.</p>\n"
msgstr ""
"<p><i>ອະນຸຍາດໃຫ້ປ່ຽນລະຫັດຜ່ານ</i> ຊ່ວຍໃຫ້ຜູ້ໃຊ້ສາມາດປ່ຽນ\n"
"ລະຫັດຜ່ານຂອງເຂົາເຈົ້າໃນລະບົບ NIS ໄດ້. ປຸ່ມອະນຸຍາດໃຫ້\n"
"ປ່ຽນແປງ login shell ຫຼື GECOS (ຊື່ເຕັມ ແລະ ຂໍ້ມູນທີ່ກ່ຽວຂ້ອງ) ສາມາດ\n"
"ໃຊ້ເພື່ອຕັ້ງຄ່າຕົວເລືອກສະເພາະເຫຼົ່ານີ້ໄດ້.</p>\n"

#. To translators: checkbox label
#: src/include/nis_server/master.rb:107
msgid "Allow changes to &GECOS field"
msgstr "ອະນຸຍາດໃຫ້ປ່ຽນແປງຫ້ອງຂໍ້ມູນ &GECOS"

#. To translators: checkbox label
#: src/include/nis_server/master.rb:115
msgid "Allow changes to login &shell"
msgstr "ອະນຸຍາດໃຫ້ປ່ຽນແປງ login &shell"

#. To translators: checkbox label
#: src/include/nis_server/master.rb:131
msgid "Allow changes to &passwords"
msgstr "ອະນຸຍາດໃຫ້ປ່ຽນແປງລະຫັດຜ່&ານ"

#. To translators: checkbox label
#. checkbox label
#: src/include/nis_server/master.rb:151 src/include/nis_server/slave.rb:98
msgid "This host is also a NIS &client"
msgstr "ໂຮສນີ້ຍັງເປັນລູກຂ່າຍ (&client) NIS"

#. To translators: frame label
#: src/include/nis_server/master.rb:165
msgid "NIS &Domain Name"
msgstr "ຊື່ໂດ&ເມນ NIS"

#. To translators: checkbox label
#: src/include/nis_server/master.rb:171
msgid "Active Worker NIS server &exists"
msgstr "ມີເຊີເວີຜູ້ຊ່ວຍ NIS ທີ່ກຳລັງເຮັດວຽກຢູ&່"

#. To translators: checkbox label
#: src/include/nis_server/master.rb:180
msgid "&Fast Map distribution (rpc.ypxfrd)"
msgstr "ການແຈກຢາຍແຜນຜັງແບບໄ&ວ (rpc.ypxfrd)"

#. To translators: frame label
#: src/include/nis_server/master.rb:186
msgid "Changing of passwords"
msgstr "ການປ່ຽນແປງລະຫັດຜ່ານ"

#. To translators: pushbutton label
#: src/include/nis_server/master.rb:194
msgid "&Other global settings ..."
msgstr "ການຕັ້ງຄ່າທົ່ວໄປ&ອື່ນໆ..."

#. To translators: dialog label
#: src/include/nis_server/master.rb:202
msgid "Master Server Setup"
msgstr "ການຕັ້ງຄ່າເຊີເວີຫຼັກ"

#. warning popup
#: src/include/nis_server/routines.rb:72
msgid ""
"Your machine is set up to change the NIS domain name via DHCP.\n"
"This may replace the domain name just entered. Check your\n"
"settings and consider not running a DHCP client on a NIS server.\n"
msgstr ""
"ເຄື່ອງຂອງເຈົ້າຖືກຕັ້ງຄ່າໃຫ້ປ່ຽນຊື່ໂດເມນ NIS ຜ່ານ DHCP.\n"
"ສິ່ງນີ້ອາດຈະປ່ຽນແທນຊື່ໂດເມນທີ່ຫາກໍ່ປ້ອນໄປ. ກະລຸນາກວດສອບ\n"
"ການຕັ້ງຄ່າ ແລະ ພິຈາລະນາບໍ່ເປີດໃຊ້ DHCP client ໃນເຊີເວີ NIS.\n"

#. firewall openning help
#: src/include/nis_server/routines.rb:93
msgid ""
"<p><b>Firewall Settings</b><br>\n"
"To open the firewall to allow accessing the NIS server\n"
"from remote computers, set <b>Open Port in Firewall</b>.\n"
"To select interfaces on which to open the port, click <b>Firewall Details</"
"b>.\n"
"This option is only available if the firewall is enabled.</p>\n"
msgstr ""
"<p><b>ການຕັ້ງຄ່າໄຟວໍ (Firewall)</b><br>\n"
"ເພື່ອເປີດໄຟວໍໃຫ້ອະນຸຍາດການເຂົ້າເຖິງເຊີເວີ NIS\n"
"ຈາກຄອມພິວເຕີທາງໄກ, ໃຫ້ຕັ້ງຄ່າ <b>ເປີດພອດໃນໄຟວໍ</b>.\n"
"ເພື່ອເລືອກອິນເຕີເຟດທີ່ຈະເປີດພອດ, ໃຫ້ຄລິກ <b>ລາຍລະອຽດໄຟວໍ</b>.\n"
"ຕົວເລືອກນີ້ຈະໃຊ້ໄດ້ກໍຕໍ່ເມື່ອເປີດໃຊ້ງານໄຟວໍເທົ່ານັ້ນ.</p>\n"

